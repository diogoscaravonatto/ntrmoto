);
const fotosTrofeus = [imgTrofeu01, imgTrofeu02, imgTrofeu03, imgTrofeu04, imgTrofeu05, imgTrofeu06, imgTrofeu07, imgTrofeu08, imgTrofeu09];

const faqs = [
  {
    q: "Qual a diferença entre o Acesso por 1 Ano (R$ 299) e o Acesso Vitalício (R$ 899)?",
