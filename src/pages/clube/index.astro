    /* ==========================================================================
       CARROSSEL 3D COVERFLOW (EXTRAÍDO DIRETAMENTE DA REFERÊNCIA TWINS)
       ========================================================================== */
    .bfuv {
      --r: #ff2a2a;
      color: #F4F5F0;
      padding: 10px 0 20px;
      overflow: hidden;
      position: relative;
    }
    .bfuv * {
      box-sizing: border-box;
    }
    .bfuv .stage {
      position: relative;
      height: 520px;
      max-width: 1400px;
      margin: 0 auto;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    }
    .bfuv .card {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 230px;
      aspect-ratio: 300/440;
      border-radius: 22px;
      overflow: hidden;
      transition: transform .6s cubic-bezier(.2,.8,.2,1), opacity .6s, filter .6s, box-shadow .6s;
      cursor: pointer;
      background: #0f0f0f;
      border: 1px solid rgba(255,255,255,.08);
      transform: translate(-50%, -50%);
    }
    .bfuv .card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      pointer-events: none;
    }
    .bfuv .card.on {
      border: 2px solid var(--r);
      box-shadow: 0 0 0 1px rgba(255,42,42,.35), 0 0 45px rgba(255,42,42,.6), 0 30px 80px -20px rgba(255,42,42,.65);
      overflow: visible;
      z-index: 60 !important;
    }
    .bfuv .card.on img {
      border-radius: 20px;
    }
    .bfuv .pill {
      position: absolute;
      top: -13px;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(90deg, #ff2a2a, #ff5722);
      color: #fff;
      font-size: 10px;
