];
---

<BaseLayout
  title="Clube de Preparadores NTR | Black Friday Oficial"
  description="Domine a preparação de motores com os 18 cursos completos do Clube NTR. Oferta Especial de Black Friday: Plano Anual (R$ 297) ou Acesso Vitalício (R$ 897)."
>
  <div class="bg-black text-white selection:bg-[#e50914] selection:text-white overflow-x-hidden">

    {/* ==========================================================================
        SEÇÃO 1: HERO
        - Desktop: Copy + CTA na esquerda | Imagem na direita (alinhada à base, sem margem inferior)
        - Mobile: Imagem no topo | Copy + CTA abaixo
        - Fundo escuro absoluto (#000000) perfeitamente integrado à imagem
        - Badge PNG sobreposto na parte inferior centralizada com efeito glow infinito
       ========================================================================== */}
    <section class="relative pt-6 sm:pt-10 md:pt-14 pb-12 sm:pb-16 lg:pb-16 px-4 bg-black overflow-visible">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">

          {/* COLUNA ESQUERDA (DESKTOP) / ABAIXO DA IMAGEM (MOBILE): COPY + CTA */}
          <div class="lg:col-span-6 order-2 lg:order-1 text-center lg:text-left flex flex-col justify-center">

            {/* HEADLINE */}
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[44px] xl:text-[48px] font-black uppercase italic tracking-tight leading-[1.18] text-white mb-6">
              CHEGOU A MAIOR BLACK FRIDAY DA{" "}
              <span class="grad-text-red">
                PREPARAÇÃO DE MOTORES
              </span>
            </h1>

            {/* 3 BULLETS SOLICITADOS */}
            <ul class="flex flex-col gap-3.5 mb-8 max-w-md mx-auto lg:mx-0 text-left">
              <li class="flex items-center gap-3 text-base sm:text-lg font-bold text-gray-200">
                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[#e50914]/20 border border-[#e50914]/40 flex items-center justify-center text-[#ff3333] text-sm">
                  ✓
                </span>
                <span>18 Cursos de Preparação</span>
              </li>
              <li class="flex items-center gap-3 text-base sm:text-lg font-bold text-gray-200">
                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[#e50914]/20 border border-[#e50914]/40 flex items-center justify-center text-[#ff3333] text-sm">
                  ✓
                </span>
                <span>Técnicas Avançadas</span>
              </li>
              <li class="flex items-start gap-3 text-base sm:text-lg font-bold text-gray-200">
                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[#e50914]/20 border border-[#e50914]/40 flex items-center justify-center text-[#ff3333] text-sm mt-0.5">
                  ✓
                </span>
                <div>
                  <span class="block text-white">
                    Sorteio 01 <span class="text-[#fbbf24]">Cabeçote Torkmax PREPARADO</span>
                  </span>
                  <span class="block text-xs sm:text-sm text-emerald-400 italic font-semibold mt-0.5">
                    (valor estimado do cabeçote R$ 2.500)
                  </span>
                </div>
              </li>
            </ul>

            {/* BOTÃO CTA EM VERDE VIBRANTE DE ALTO DESTAQUE */}
            <div class="max-w-md mx-auto lg:mx-0 w-full">
              <a
                href="#oferta"
                class="group flex items-center justify-center gap-3 w-full py-4.5 px-8 bg-gradient-to-r from-[#00b341] via-[#00d254] to-[#009b36] hover:from-[#00d254] hover:to-[#00b341] text-white text-lg sm:text-xl font-black uppercase italic tracking-tight rounded-full shadow-[0_0_40px_rgba(0,210,84,0.55)] hover:shadow-[0_0_60px_rgba(0,210,84,0.85)] transition-all duration-300 transform hover:-translate-y-1"
              >
                <span>GARANTIR MINHA VAGA NA BLACK</span>
                <span class="text-2xl leading-none transition-transform duration-300 group-hover:translate-x-1.5">→</span>
              </a>

              {/* SOCIAL PROOF (APENAS ALUNOS FORMADOS) */}
              <div class="mt-4 flex items-center justify-center lg:justify-start gap-2 text-sm text-gray-300 font-bold">
                <span class="text-[#fbbf24] tracking-wide">★★★★★</span>
                <span>+12.000 Alunos Formados</span>
              </div>
            </div>

          </div>

          {/* COLUNA DIREITA (DESKTOP) / TOPO (MOBILE): IMAGEM INTEGRADA + BADGE */}
          <div class="lg:col-span-6 order-1 lg:order-2 relative flex items-center justify-center w-full mb-6 lg:mb-0">
            <div class="relative w-full max-w-[560px] lg:max-w-none mx-auto pb-10 sm:pb-12 lg:pb-14">
              <Image
                src={imgHeroCompleta}
                alt="Clube de Preparadores NTR - Fábio Scaravonatto e Todos os Cursos"
                widths={[480, 720, 960]}
                sizes="(max-width: 640px) 92vw, (max-width: 1024px) 560px, 540px"
                format="webp"
                quality={80}
                class="w-full h-auto object-contain mx-auto select-none pointer-events-none block"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />

              {/* SOBREPOSIÇÃO DO PNG BLACK FRIDAY 2026 CENTRALIZADO NA BASE COM FOLGA COMPLETA */}
              <div class="absolute bottom-0 left-1/2 -translate-x-1/2 z-20 w-48 sm:w-64 md:w-72 max-w-[85%] pointer-events-none">
                <div class="relative flex items-center justify-center">
                  {/* Glow volumétrico pulsante de horizonte infinito */}
                  <div class="absolute inset-0 bg-[#e50914]/65 blur-2xl rounded-full scale-125 animate-pulse"></div>
                  <Image
                    src={imgBadgeBF2026}
                    alt="Black Friday 2026 NTR"
                    width={360}
                    format="webp"
                    quality={80}
                    class="relative z-10 w-full h-auto object-contain drop-shadow-[0_10px_35px_rgba(229,9,20,0.85)]"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    {/* ==========================================================================
        FAIXA FITAS CRUZADAS 3D (ESTILO EXATO DA REFERÊNCIA)
        - Faixa vermelha: no fundo, com desfoque de profundidade (blur)
        - Faixa escura: na frente, nítida, passando por cima
       ========================================================================== */}
    <div class="relative py-14 sm:py-20 bg-black overflow-hidden select-none pointer-events-none">
      {/* Gradientes nas bordas para profundidade e fade infinito */}
