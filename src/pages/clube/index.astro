      opacity: 0;
      transition: opacity .4s;
      box-shadow: 0 4px 18px rgba(255,42,42,.7);
      z-index: 30;
    }
    .bfuv .card.on .pill {
      opacity: 1;
    }
    .bfuv .glow {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 560px;
      height: 440px;
      transform: translate(-50%,-50%);
      background: radial-gradient(ellipse at center, rgba(255,42,42,.32), transparent 65%);
