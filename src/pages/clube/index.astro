      -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    }
    .depo-uv .depo-card {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 310px;
      max-height: 500px;
      border-radius: 22px;
      overflow: hidden;
      transition: transform .65s cubic-bezier(.2,.8,.2,1), opacity .65s, filter .65s, box-shadow .65s, border-color .65s;
      cursor: pointer;
      background: #ffffff;
      border: 2px solid rgba(255,255,255,.15);
      transform: translate(-50%, -50%);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .depo-uv .depo-card img {
      width: 100%;
      height: auto;
      max-height: 496px;
      object-fit: contain;
      display: block;
      pointer-events: none;
    }
    .depo-uv .depo-card.on {
      border: 2px solid #ff2a2a;
      box-shadow: 0 0 0 1px rgba(255,42,42,.35), 0 0 40px rgba(255,42,42,.45), 0 25px 70px -15px rgba(0,0,0,.9);
      z-index: 60 !important;
    }
    .depo-uv .depo-glow {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 520px;
      height: 460px;
      transform: translate(-50%, -50%);
      background: radial-gradient(ellipse at center, rgba(255,42,42,.25), transparent 68%);
      pointer-events: none;
    }
    .depo-uv .depo-nav {
      display: flex;
      justify-content: center;
      gap: 14px;
      margin-top: 16px;
    }
    .depo-uv .depo-nav button {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,.2);
      background: rgba(255,255,255,.06);
      color: #fff;
      font-size: 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all .25s ease;
    }
    .depo-uv .depo-nav button:hover {
      border-color: #ff2a2a;
      color: #ff4d4d;
      background: rgba(255,42,42,.15);
      transform: scale(1.08);
    }
    @media(max-width: 767px) {
      .depo-uv .depo-stage { height: 440px; }
      .depo-uv .depo-card { width: 255px; max-height: 410px; }
      .depo-uv .depo-card img { max-height: 406px; }
    }

    /* ==========================================================================
       ANIMAÇÃO DESTAQUE CABEÇOTE TORKMAX (LEVITAÇÃO SUAVE + REFLEXO METÁLICO)
       ========================================================================== */
    @keyframes cabecoteFloat {
      0%, 100% {
        transform: translateY(0px) rotate(0deg);
      }
      50% {
        transform: translateY(-10px) rotate(0.4deg);
      }
    }
    @keyframes cabecoteShadow {
      0%, 100% {
        transform: scale(1);
        opacity: 0.35;
      }
      50% {
        transform: scale(0.9);
        opacity: 0.18;
      }
    }
    @keyframes cabecoteShine {
      0% {
        transform: translateX(-160%) skewX(-25deg);
        opacity: 0;
      }
      15% {
        opacity: 0.75;
      }
      35% {
        transform: translateX(260%) skewX(-25deg);
        opacity: 0;
      }
      100% {
        transform: translateX(260%) skewX(-25deg);
        opacity: 0;
      }
    }
    .cabecote-anim-wrap {
      position: relative;
      overflow: hidden;
      border-radius: 16px;
      animation: cabecoteFloat 4s ease-in-out infinite;
      will-change: transform;
    }
    .cabecote-floor-shadow {
      animation: cabecoteShadow 4s ease-in-out infinite;
      will-change: transform, opacity;
    }
    .cabecote-shine-layer {
      position: absolute;
      top: -10%;
      bottom: -10%;
      left: 0;
      width: 40%;
      background: linear-gradient(
        90deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.45) 45%,
        rgba(255, 255, 255, 0.85) 50%,
        rgba(255, 255, 255, 0.45) 55%,
        rgba(255, 255, 255, 0) 100%
      );
      pointer-events: none;
      animation: cabecoteShine 4.5s ease-in-out infinite;
    }
  </style>

  <script is:inline>
    // Scroll suave garantido com precisão absoluta para a seção dos planos (#oferta)
    document.querySelectorAll('a[href="#oferta"]').forEach(function(a) {
      a.addEventListener('click', function(e) {
        e.preventDefault();
        var target = document.getElementById('oferta');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          // Verificação e ajuste de precisão caso haja carregamento de imagem durante o scroll
          setTimeout(function() {
            var rect = target.getBoundingClientRect();
            if (Math.abs(rect.top) > 80) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }, 450);
        }
      });
    });
  </script>

  {/* Script do Carrossel 3D Coverflow (Mecânica da Referência Twins) */}
  <script is:inline define:vars={{ carrosselCursosData }}>
    (function(){
      var root = document.getElementById('bfuv');
      if (!root || root.dataset.ok) return;
      root.dataset.ok = "1";
      
      var C = carrosselCursosData;
      var stage = root.querySelector('.stage'), N = C.length, cur = 0, els = [];
      
      C.forEach(function(c, i) {
        var d = document.createElement('div');
        d.className = 'card';
        d.innerHTML = '<span class="pill">' + (c.badge || 'NOVO EM 2026') + '</span><img decoding="async" loading="lazy" src="' + c.src + '" alt="' + c.title + '">';
        d.onclick = function() { go(i); reset(); };
        stage.appendChild(d);
        els.push(d);
      });
      
      function lay() {
        var w = window.innerWidth < 768 ? 125 : 185;
        els.forEach(function(el, i) {
          var o = ((i - cur) % N + N) % N;
          if (o > N / 2) o -= N;
          var a = Math.abs(o);
          var s = a === 0 ? 1.15 : Math.max(.78, 1 - a * .06);
          el.style.transform = 'translate(-50%,-50%) translateX(' + (o * w) + 'px) scale(' + s + ')';
          el.style.zIndex = String(50 - a);
          el.style.opacity = a > 4 ? "0" : (a === 0 ? "1" : String(Math.max(.25, .7 - a * .12)));
          el.style.filter = a === 0 ? 'none' : 'brightness(.55) saturate(.8)';
          el.classList.toggle('on', a === 0);
        });
        
        var c = C[cur];
        var nEl = root.querySelector('.cap .n');
        var tEl = root.querySelector('.cap .t');
        var pEl = root.querySelector('.cap p');
        if (nEl) nEl.textContent = String(cur + 1).padStart(2, '0') + ' / ' + N;
        if (tEl) tEl.textContent = c.title;
        if (pEl) pEl.textContent = c.desc || '';
      }
      
      function go(i) {
        cur = (i + N) % N;
        lay();
      }
      
      root.querySelectorAll('.nav button').forEach(function(b) {
        b.onclick = function() {
          go(cur + (+b.dataset.d));
          reset();
        };
      });
      
      var t;
      function reset() {
        clearInterval(t);
        t = setInterval(function() { go(cur + 1); }, 3400);
      }
      
      lay();
      window.addEventListener('resize', lay);
      var seen = 0;
      function start() {
        if (seen) return;
        seen = 1;
        cur = 0;
        lay();
        reset();
      }
      
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function(e) {
          e.forEach(function(x) {
            if (x.isIntersecting) {
              start();
            } else if (seen) {
              clearInterval(t);
              seen = 0;
              cur = 0;
              lay();
            }
          });
        }, { threshold: .35 });
        io.observe(stage);
      } else {
        reset();
      }
    })();
  </script>

  {/* Script do Carrossel de Prints de Depoimentos (Direita -> Esquerda com pausa no centro e laterais mais escuras) */}
  <script is:inline define:vars={{ printsCarouselData }}>
    (function(){
      var root = document.getElementById('depo-uv');
      if (!root || root.dataset.ok) return;
      root.dataset.ok = "1";

      var D = printsCarouselData;
      var stage = root.querySelector('.depo-stage'), N = D.length, cur = 0, els = [];

      D.forEach(function(item, i) {
        var d = document.createElement('div');
        d.className = 'depo-card';
        d.innerHTML = '<img decoding="async" loading="lazy" src="' + item.src + '" alt="' + item.alt + '">';
        d.onclick = function() { go(i); reset(); };
        stage.appendChild(d);
        els.push(d);
      });

      function lay() {
        var w = window.innerWidth < 768 ? 210 : 305;
        els.forEach(function(el, i) {
          var o = ((i - cur) % N + N) % N;
          if (o > N / 2) o -= N;
          var a = Math.abs(o);
          var s = a === 0 ? 1.06 : Math.max(.82, 1 - a * .09);
          el.style.transform = 'translate(-50%,-50%) translateX(' + (o * w) + 'px) scale(' + s + ')';
          el.style.zIndex = String(50 - a);
          el.style.opacity = a > 2 ? "0" : (a === 0 ? "1" : String(Math.max(.35, .75 - a * .18)));
          el.style.filter = a === 0 ? 'none' : 'brightness(.42) saturate(.85)';
          el.classList.toggle('on', a === 0);
        });
      }

      function go(i) {
        cur = (i + N) % N;
        lay();
      }

      root.querySelectorAll('.depo-nav button').forEach(function(b) {
        b.onclick = function() {
          go(cur + (+b.dataset.d));
          reset();
        };
      });

      var timer;
      function reset() {
        clearInterval(timer);
        timer = setInterval(function() { go(cur + 1); }, 2800);
      }

      lay();
      window.addEventListener('resize', lay);
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              reset();
            } else {
              clearInterval(timer);
            }
          });
        }, { threshold: 0.25 });
        io.observe(stage);
      } else {
        reset();
      }
    })();
  </script>
