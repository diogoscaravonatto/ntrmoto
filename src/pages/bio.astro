---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";

const links = [
    {
        label: "Orçamento Rápido (WhatsApp)",
        url: "https://wa.me/5545991586405?text=Ol%C3%A1%2C%20vim%20pelo%20Instagram%20e%20gostaria%20de%20um%20or%C3%A7amento",
        primary: true,
        icon: `<svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.414 0 0 5.414 0 12.05c0 2.123.554 4.197 1.608 6.02L0 24l6.132-1.61c1.767.962 3.75 1.47 5.766 1.488h.005c6.632 0 12.045-5.414 12.045-12.05 0-3.212-1.25-6.232-3.52-8.502"></path></svg>`,
    },
    {
        label: "Visitar Site Oficial",
        url: "/",
        icon: `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>`,
    },
    {
        label: "Nossos Serviços",
        url: "/#servicos",
        icon: `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>`,
    },
    {
        label: "Pragas que Combatemos",
        url: "/#pragas",
        icon: `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>`,
    },
    {
        label: "Por que a VetPragas?",
        url: "/#sobre",
        icon: `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`,
    },
];
---

<BaseLayout
    title="VetPragas | Links Oficiais"
    description="Acesse nossos canais de atendimento e saiba mais sobre nossos serviços especializados de controle de pragas."
>
    <!-- Fundo Primary padrão do site (Azul Escuro) -->
    <div
        class="min-h-screen bg-primary flex flex-col items-center py-12 px-4 relative overflow-hidden"
    >
        <!-- Textura de fundo suave -->
        <div
            class="absolute inset-0 bg-brand-pattern opacity-10 pointer-events-none"
        >
        </div>

        <!-- Gradiente para dar volume ao fundo -->
        <div
            class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-lg h-full bg-linear-to-b from-white/5 to-transparent pointer-events-none"
        >
        </div>

        <div
            class="w-full max-w-md mx-auto relative z-10 flex flex-col items-center"
        >
            <!-- Foto de Perfil / Ícone -->
            <div
                class="w-24 h-24 bg-white rounded-full flex items-center justify-center p-3 mb-4 shadow-[0_0_30px_rgba(0,0,0,0.3)] animate-reveal"
            >
                <img
                    src="/favicon_vetpragas96x96.png"
                    alt="VetPragas Logo Ícone"
                    width="96"
                    height="96"
                    class="w-full h-full object-contain"
                />
            </div>

            <!-- Título & Bio -->
            <h1
                class="text-2xl font-black text-white mb-2 text-center animate-reveal"
                style="animation-delay: 100ms;"
            >
                @vetpragas
            </h1>
            <p
                class="text-white/80 text-center text-sm mb-8 font-medium max-w-[280px] leading-relaxed animate-reveal"
                style="animation-delay: 200ms;"
            >
                Controle de Pragas com supervisão de <strong class="text-white"
                    >Médico Veterinário</strong
                > e <strong class="text-white">ISO 9001</strong>.
            </p>

            <!-- Lista de Links -->
            <div
                class="w-full flex flex-col gap-4 animate-reveal"
                style="animation-delay: 300ms;"
            >
                {
                    links.map((link, index) => (
                        <a
                            href={link.url}
                            target={
                                link.url.startsWith("http") ? "_blank" : "_self"
                            }
                            rel={
                                link.url.startsWith("http")
                                    ? "noopener noreferrer"
                                    : ""
                            }
                            class:list={[
                                "w-full flex items-center gap-4 py-4 px-6 font-bold text-sm uppercase tracking-widest rounded-xl transition-all shadow-lg text-left",
                                link.primary
                                    ? "bg-accent text-white hover:bg-accent-dark hover:shadow-accent/20 hover:-translate-y-1 border border-accent"
                                    : "bg-white/10 backdrop-blur-sm border border-white/10 text-white hover:bg-white hover:text-primary hover:-translate-y-1",
                            ]}
                            style={`animation-delay: ${400 + index * 100}ms`}
                        >
                            <div
                                class="flex items-center justify-center w-8"
                                set:html={link.icon}
                            />
                            <span class="flex-1 text-center pr-8">
                                {link.label}
                            </span>
                        </a>
                    ))
                }
            </div>

            <!-- Logo oficial no rodapé do link tree -->
            <div
                class="mt-16 text-center animate-reveal flex flex-col items-center gap-4"
                style="animation-delay: 800ms;"
            >
                <a href="/">
                    <img
                        src="/logovetpragas1.3.svg"
                        alt="VetPragas Logo"
                        class="h-10 opacity-70 hover:opacity-100 transition-opacity"
                    />
                </a>
                <p class="text-xs text-white/40">
                    &copy; {new Date().getFullYear()} VetPragas. Todos os direitos
                    reservados.
                </p>
            </div>
        </div>
    </div>
</BaseLayout>
