---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página não encontrada | NTR Escola de Motores" noindex={true}>
  <section class="relative flex min-h-[75vh] flex-col items-center justify-center p-6 text-center">
    <div class="group relative">
      <h1 class="bg-gradient-to-b from-white to-zinc-800 bg-clip-text text-[9rem] leading-none font-black tracking-tighter text-transparent opacity-20 md:text-[12rem]">
        404
      </h1>
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="text-3xl font-black tracking-tight text-white uppercase md:text-4xl">
          Página não encontrada
        </span>
      </div>
    </div>

    <p class="mt-4 max-w-md text-lg text-zinc-400">
      A página que você está procurando não existe ou foi movida para um novo endereço.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="rounded-full bg-brand-red px-8 py-4 font-bold text-white transition-transform hover:scale-105 hover:bg-brand-red-dark active:scale-95"
      >
        Voltar para o Início
      </a>
      <a
        href="/#cursos"
        class="rounded-full border border-white/15 bg-white/5 px-8 py-4 font-bold text-white transition-colors hover:bg-white/10"
      >
        Ver Treinamentos
      </a>
    </div>

    {/* Background Glow */}
    <div class="pointer-events-none fixed top-1/2 left-1/2 -z-10 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-red/10 blur-[120px]"></div>
  </section>
</BaseLayout>
