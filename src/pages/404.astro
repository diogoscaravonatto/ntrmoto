---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página não encontrada | 404">
    <div
        class="min-h-screen bg-primary flex flex-col items-center justify-center py-12 px-4 relative overflow-hidden"
    >
        <!-- Textura de fundo suave -->
        <div
            class="absolute inset-0 bg-brand-pattern opacity-10 pointer-events-none"
        >
        </div>
        <div
            class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-lg h-full bg-linear-to-b from-white/5 to-transparent pointer-events-none"
        >
        </div>

        <main
            class="relative z-10 flex flex-col items-center text-center max-w-2xl"
        >
            <a
                href="/"
                class="mb-12 animate-reveal hover:scale-105 transition-transform"
            >
                <img
                    src="/logovetpragas1.3.svg"
                    alt="VetPragas Logo"
                    class="h-10 md:h-14 w-auto opacity-80 hover:opacity-100 transition-opacity"
                />
            </a>

            <div
                class="relative group animate-reveal"
                style="animation-delay: 100ms;"
            >
                <h1
                    class="text-[8rem] md:text-[12rem] font-black leading-none tracking-tighter text-transparent bg-clip-text bg-linear-to-b from-accent to-transparent opacity-30"
                >
                    404
                </h1>
                <div class="absolute inset-0 flex items-center justify-center">
                    <span
                        class="text-3xl md:text-5xl font-black text-white tracking-tight uppercase"
                        >Oops! Caminho Errado.</span
                    >
                </div>
            </div>

            <p
                class="max-w-md mt-6 text-lg text-white/70 font-medium animate-reveal"
                style="animation-delay: 200ms;"
            >
                A página que você está procurando não existe ou foi movida.
                Nossos especialistas já realizaram o controle por aqui.
            </p>

            <div
                class="mt-12 flex flex-col sm:flex-row gap-4 animate-reveal"
                style="animation-delay: 300ms;"
            >
                <a href="/" class="btn-primary"> Voltar para o Início </a>
                <a
                    href="/#contato"
                    class="px-8 py-4 bg-transparent border border-white/20 text-white font-bold text-sm uppercase tracking-widest rounded-xl hover:bg-white/10 transition-all shadow-lg text-center inline-block"
                >
                    Falar com Especialista
                </a>
            </div>

            <!-- Background Glow -->
            <div
                class="absolute -z-10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/20 blur-[150px] rounded-full pointer-events-none"
            >
            </div>
        </main>
    </div>
</BaseLayout>
