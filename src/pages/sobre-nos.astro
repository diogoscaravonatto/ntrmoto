---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import FloatingWhatsapp from "@components/FloatingWhatsapp.astro";
import { Image } from "astro:assets";
import aboutImage from "@assets/images/about-v2.jpg";

const pageTitle = "Sobre Nós | VetPragas Health & Safety";
const pageDescription =
    "Conheça a história e a metodologia exclusiva da VetPragas, a única empresa de controle de pragas com supervisão veterinária na região.";

const missionVisionValues = [
    {
        title: "Missão",
        description:
            "Proporcionar saúde e bem-estar através do controle inteligente de pragas, priorizando a segurança de pessoas e animais de estimação.",
        icon: "target",
    },
    {
        title: "Visão",
        description:
            "Ser a referência máxima em saúde ambiental e proteção biológica no Sul do Brasil, reconhecida pela precisão técnica e ética veterinária.",
        icon: "eye",
    },
    {
        title: "Valores",
        description:
            "Ciência aplicada, responsabilidade ambiental, transparência total e respeito à vida em todas as suas formas.",
        icon: "shield-check",
    },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
    <div
        class="min-h-screen selection:bg-accent/10 selection:text-accent overflow-x-hidden bg-white"
    >
        <Navbar />

        <main class="pt-20">
            <!-- Hero Interno -->
            <section class="relative py-20 bg-slate-900 overflow-hidden">
                <div class="absolute inset-0 opacity-20">
                    <div
                        class="absolute inset-0 bg-linear-to-b from-accent/10 to-transparent"
                    >
                    </div>
                </div>
                <!-- Background Decorative Rings -->
                <div
                    class="absolute -top-24 -right-24 w-96 h-96 border border-accent/10 rounded-full"
                >
                </div>
                <div
                    class="absolute -bottom-24 -left-24 w-96 h-96 border border-accent/10 rounded-full"
                >
                </div>

                <div class="container mx-auto px-6 relative z-10 text-center">
                    <div
                        class="inline-block p-2 bg-accent/10 border border-accent/20 rounded-lg mb-6 tracking-[0.3em] font-mono text-[10px] uppercase text-accent font-bold"
                    >
                        Nossa Identidade
                    </div>
                    <h1
                        class="text-4xl lg:text-6xl font-black text-white mb-6 uppercase tracking-tighter leading-tight"
                    >
                        Ciência a Serviço da <span class="text-accent"
                            >Vida</span
                        >
                    </h1>
                    <p
                        class="text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed font-medium"
                    >
                        A VetPragas nasceu da necessidade de um controle de
                        pragas que não fosse apenas eficiente, mas
                        biológicamente responsável.
                    </p>
                </div>
            </section>

            <!-- Nossa História -->
            <section class="py-24 bg-white relative">
                <div class="container mx-auto px-6">
                    <div class="grid lg:grid-cols-2 gap-16 items-center">
                        <div class="relative">
                            <div
                                class="relative rounded-3xl overflow-hidden shadow-2xl"
                            >
                                <Image
                                    src={aboutImage}
                                    alt="Equipe VetPragas em operação"
                                    class="w-full h-auto object-cover aspect-4/5 lg:aspect-auto"
                                />
                                <div
                                    class="absolute inset-0 bg-linear-to-t from-slate-900/60 to-transparent"
                                >
                                </div>
                                <div
                                    class="absolute bottom-8 left-8 right-8 text-white"
                                >
                                    <div class="text-3xl font-black mb-1">
                                        10+ Anos
                                    </div>
                                    <div
                                        class="text-sm font-bold uppercase tracking-widest opacity-80"
                                    >
                                        De história e inovação
                                    </div>
                                </div>
                            </div>
                            <!-- Decorativo -->
                            <div
                                class="absolute -bottom-10 -right-10 w-40 h-40 bg-accent/5 rounded-full -z-10 blur-3xl"
                            >
                            </div>
                        </div>

                        <div>
                            <div
                                class="inline-block p-2 bg-slate-50 border border-slate-100 rounded-lg mb-6 tracking-[0.3em] font-mono text-[10px] uppercase text-accent font-bold"
                            >
                                Como Começamos
                            </div>
                            <h2
                                class="text-3xl lg:text-4xl font-black text-slate-900 mb-8 uppercase tracking-tighter leading-tight"
                            >
                                Mais que uma dedetizadora, um conceito em <span
                                    class="text-accent">Saúde Ambiental</span
                                >
                            </h2>
                            <div
                                class="space-y-6 text-slate-600 text-lg leading-relaxed"
                            >
                                <p>
                                    Fundada em Cascavel, a <strong
                                        >VetPragas Health & Safety</strong
                                    > surgiu com uma proposta clara: unir a eficácia
                                    do controle químico com a segurança da medicina
                                    veterinária.
                                </p>
                                <p>
                                    Percebemos que o mercado oferecia soluções
                                    genéricas, muitas vezes perigosas para pets
                                    e crianças. Decidimos mudar isso trazendo a
                                    supervisão técnica de médicos veterinários
                                    para o centro da operação.
                                </p>
                                <p>
                                    Hoje, somos referência técnica em toda a
                                    região Oeste do Paraná, atendendo desde
                                    residências que buscam segurança total até
                                    indústrias que exigem os mais rigorosos
                                    padrões sanitários.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Diferencial Veterinário (The "Why") -->
            <section class="py-24 bg-slate-50 border-y border-slate-100">
                <div class="container mx-auto px-6">
                    <div class="text-center mb-16">
                        <h2
                            class="text-3xl lg:text-4xl font-black text-slate-900 mb-4 uppercase tracking-tighter"
                        >
                            O Diferencial <span class="text-accent"
                                >Veterinário</span
                            >
                        </h2>
                        <p
                            class="text-slate-500 max-w-2xl mx-auto font-medium text-lg italic"
                        >
                            "Dosagem exata, alvo específico, risco zero para
                            mamíferos."
                        </p>
                    </div>

                    <div class="grid md:grid-cols-3 gap-8">
                        {
                            missionVisionValues.map((item) => (
                                <div class="bg-white p-10 rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 group">
                                    <div class="w-14 h-14 bg-accent/5 rounded-2xl flex items-center justify-center text-accent mb-8 group-hover:bg-accent group-hover:text-white transition-colors">
                                        {item.icon === "target" && (
                                            <svg
                                                class="w-8 h-8"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                                />
                                            </svg>
                                        )}
                                        {item.icon === "eye" && (
                                            <svg
                                                class="w-8 h-8"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                                />
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                                                />
                                            </svg>
                                        )}
                                        {item.icon === "shield-check" && (
                                            <svg
                                                class="w-8 h-8"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                                />
                                            </svg>
                                        )}
                                    </div>
                                    <h3 class="text-xl font-black text-slate-900 mb-4 uppercase tracking-tight">
                                        {item.title}
                                    </h3>
                                    <p class="text-slate-600 leading-relaxed font-medium">
                                        {item.description}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <!-- Liderança Técnica -->
            <section class="py-24 bg-white overflow-hidden">
                <div class="container mx-auto px-6">
                    <div
                        class="bg-slate-900 rounded-[3rem] p-8 lg:p-20 relative overflow-hidden"
                    >
                        <!-- Decorative element -->
                        <div
                            class="absolute top-0 right-0 w-1/2 h-full bg-accent/10 skew-x-12 translate-x-1/2"
                        >
                        </div>

                        <div
                            class="grid lg:grid-cols-2 gap-12 items-center relative z-10"
                        >
                            <div>
                                <div
                                    class="inline-block p-2 bg-accent/10 border border-accent/20 rounded-lg mb-6 tracking-[0.3em] font-mono text-[10px] uppercase text-accent font-bold"
                                >
                                    Liderança Técnica
                                </div>
                                <h2
                                    class="text-3xl lg:text-4xl font-black text-white mb-8 uppercase tracking-tighter leading-tight"
                                >
                                    A Segurança de um <span class="text-accent"
                                        >Especialista</span
                                    > em Comando
                                </h2>
                                <p
                                    class="text-slate-300 text-lg mb-8 leading-relaxed font-medium"
                                >
                                    Diferente de empresas comuns, a VetPragas
                                    opera sob protocolos médicos. Cada aplicação
                                    é calculada com base na biologia do alvo e
                                    na segurança do ambiente.
                                </p>
                                <div
                                    class="flex items-center gap-6 p-6 bg-white/5 border border-white/10 rounded-2xl"
                                >
                                    <div>
                                        <div
                                            class="text-accent text-[10px] font-bold uppercase tracking-widest mb-1"
                                        >
                                            Responsável Técnico
                                        </div>
                                        <div
                                            class="text-white text-xl font-black tracking-tight"
                                        >
                                            Dr. Responsável Veterinário
                                        </div>
                                        <div
                                            class="text-slate-400 text-xs font-bold uppercase tracking-widest"
                                        >
                                            CRMV-PR Ativo • Especialista em
                                            Saúde Ambiental
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div
                                    class="bg-white/5 border border-white/10 p-8 rounded-3xl text-center"
                                >
                                    <div
                                        class="text-3xl font-black text-accent mb-1"
                                    >
                                        100%
                                    </div>
                                    <div
                                        class="text-[10px] text-slate-400 font-bold uppercase tracking-widest"
                                    >
                                        Produtos ANVISA
                                    </div>
                                </div>
                                <div
                                    class="bg-white/5 border border-white/10 p-8 rounded-3xl text-center"
                                >
                                    <div
                                        class="text-3xl font-black text-accent mb-1"
                                    >
                                        Zero
                                    </div>
                                    <div
                                        class="text-[10px] text-slate-400 font-bold uppercase tracking-widest"
                                    >
                                        Acidentes com Pets
                                    </div>
                                </div>
                                <div
                                    class="bg-white/5 border border-white/10 p-8 rounded-3xl text-center"
                                >
                                    <div
                                        class="text-3xl font-black text-accent mb-1"
                                    >
                                        +5k
                                    </div>
                                    <div
                                        class="text-[10px] text-slate-400 font-bold uppercase tracking-widest"
                                    >
                                        Clientes Atendidos
                                    </div>
                                </div>
                                <div
                                    class="bg-white/5 border border-white/10 p-8 rounded-3xl text-center"
                                >
                                    <div
                                        class="text-3xl font-black text-accent mb-1"
                                    >
                                        24h
                                    </div>
                                    <div
                                        class="text-[10px] text-slate-400 font-bold uppercase tracking-widest"
                                    >
                                        Suporte Técnico
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- CTA Final -->
            <section class="py-24 bg-white text-center">
                <div class="container mx-auto px-6">
                    <h2
                        class="text-3xl lg:text-5xl font-black text-slate-900 mb-8 uppercase tracking-tighter leading-tight max-w-4xl mx-auto"
                    >
                        Pronto para experimentar o <span class="text-accent"
                            >Padrão VetPragas</span
                        > de Proteção?
                    </h2>
                    <div
                        class="flex flex-col sm:flex-row items-center justify-center gap-4"
                    >
                        <a
                            href="https://wa.me/5545991586405"
                            class="px-10 py-5 bg-accent text-white font-black text-sm uppercase tracking-[0.2em] rounded-2xl hover:bg-accent-dark transition-all shadow-accent/20 hover:-translate-y-1"
                        >
                            Solicitar Orçamento Agora
                        </a>
                        <a
                            href="/"
                            class="px-10 py-5 bg-slate-100 text-slate-900 font-black text-sm uppercase tracking-[0.2em] rounded-2xl hover:bg-slate-200 transition-all"
                        >
                            Voltar para Início
                        </a>
                    </div>
                </div>
            </section>
        </main>

        <Footer />
        <FloatingWhatsapp />
    </div>
</BaseLayout>

<style is:global>
    @import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Plus+Jakarta+Sans:wght@300;400;600;700;800;900&display=swap");

    html {
        scroll-behavior: smooth;
        background-color: #fff;
    }

    body {
        font-family: "Plus Jakarta Sans", sans-serif;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    .font-mono {
        font-family: "JetBrains Mono", monospace;
    }
</style>
