    img: imgDesenvolvimentoCabecotes,
  },
  {
    title: "Comandos Nível 1",
    desc: "Diagrama, graduação, levante, overlap e lobe center",
    badge: "09 / 18",
    img: imgComandosN1Vermelho,
  },
  {
    title: "Comandos Nível 2",
    desc: "Cálculo avançado de cruzamento, molas e enquadramento",
    badge: "10 / 18",
    img: imgComandosN2Vermelho,
  },
  {
    title: "Comandos Nível 3",
    desc: "Desenvolvimento de perfis de competição e arrancada",
    badge: "11 / 18",
    img: imgComandosN3Vermelho,
  },
  {
    title: "Usinagem de Comandos",
    desc: "Retífica, desbaste, cópia e acabamento na prática",
    badge: "12 / 18",
    img: imgUsinagemComandosVermelho,
  },
  {
    title: "Acertos Finos",
    desc: "Giclagem, agulha, ponto de ignição e resposta de acelerador",
    badge: "13 / 18",
    img: imgAcertosFinosAmarelo,
  },
  {
    title: "Acerto de Injeção",
    desc: "Mapas de combustível, mapa de ponto e correção via software",
    badge: "14 / 18",
    img: imgAcertoPiggybackAmarelo,
