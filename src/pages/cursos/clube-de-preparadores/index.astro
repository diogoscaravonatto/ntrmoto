const whatsappSuporte =
  "https://wa.me/5545999003816?text=Ol%C3%A1%2C%20vim%20do%20site%20e%20estou%20com%20d%C3%BAvidas%20sobre%20a%20Black%20do%20Clube%20NTR";

// Os 18 Treinamentos Oficiais do Clube NTR Organizados por Categorias Técnicas
const gruposCursos = [
  {
    nome: "Tudo sobre Desenvolvimento de motores 100% prático",
    tag: "DESENVOLVIMENTO",
    cor: "#ff2a2a",
    cursos: [
      { id: "01", title: "O COMEÇO DO PROJETO", tag: "BASE", img: imgCurso01 },
      { id: "02", title: "PROJETO DE RUA 28CV", tag: "PROJETO REAL", img: imgCurso13 },
      { id: "03", title: "REI DO 4TRINHO", tag: "COMPETIÇÃO", img: imgCurso16 },
