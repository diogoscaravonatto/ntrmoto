    img: imgEventoRemapAmarelo,
  },
  {
    title: "Raio-X de Motores",
    desc: "Desmontagem, análise técnica de desgastes e folgas ocultas",
    badge: "17 / 18",
    img: imgCurso09,
  },
  {
    title: "Motores de Ponta",
    desc: "Segredos dos motores campeões de arrancada e circuito",
    badge: "18 / 18",
    img: imgCurso12,
  },
];

const carrosselCursosData = await Promise.all(
  carrosselCursosRaw.map(async (item) => {
    const opt = await getImage({ src: item.img, width: 360, format: "webp", quality: 74 });
    return { title: item.title, desc: item.desc, badge: item.badge, src: opt.src };
  }),
);

const printsReais = [imgDepo01, imgDepo02, imgDepo03, imgDepo04, imgDepo05, imgDepo06];
const printsCarouselData = await Promise.all(
  printsReais.map(async (img, idx) => {
    const opt = await getImage({ src: img, width: 460, format: "webp", quality: 76 });
    return {
      src: opt.src,
      alt: `Comentário Aluno NTR ${idx + 1}`,
    };
  }),
);
const fotosTrofeus = [
  imgTrofeu01,
  imgTrofeu02,
  imgTrofeu03,
  imgTrofeu04,
  imgTrofeu05,
  imgTrofeu06,
  imgTrofeu07,
  imgTrofeu08,
  imgTrofeu09,
];

const faqs = [
  {
    q: "Qual a diferença entre o Acesso por 1 Ano (R$ 299) e o Acesso Vitalício (R$ 899)?",
    a: "No Acesso de 1 Ano você tem 12 meses de acesso aos 18 cursos do Clube NTR sem cobrança recorrente (não renova sozinho). Já no Acesso Vitalício você paga uma única vez na vida e tem acesso PARA SEMPRE aos 18 cursos, todas as futuras atualizações, além dos bônus exclusivos da Black Friday (Biblioteca Completa NTR + Manuais de Serviço + 1 Ano da Calculadora de Motores).",
  },
  {
    q: "Estou começando do zero. O Clube NTR serve para mim?",
    a: "Sim! A metodologia começa nos cursos de base (ensinado medidas, ferramentas e cálculos passo a passo) e avança até os níveis PRO de cabeçotes, comandos, injeção e projetos de pista.",
  },
  {
    q: "Preciso ter oficina montada ou ferramentas caras?",
    a: "Não. Você pode começar em casa com as ferramentas que já possui. O método ensina exatamente como projetar com segurança antes de gastar com peças.",
  },
  {
    q: "Como funciona o suporte para tirar dúvidas?",
    a: "Você tem suporte individual direto na plataforma de aulas para tirar dúvidas técnicas do seu projeto, além da comunidade exclusiva de preparadores no WhatsApp.",
  },
  {
    q: "Como funciona a Garantia de 30 dias?",
    a: "Você entra, assiste às aulas e testa o Clube por 30 dias. Se por qualquer motivo quiser desistir dentro desse prazo, devolvemos 100% do seu dinheiro sem burocracia.",
  },
  {
    q: "Como funciona o sorteio do cabeçote Torkmax?",
    a: "Apenas quem adquirir a Super Black NTR durante a Black Friday 2026, até 31/12/2026 às 23h59, participa automaticamente do Cabeçote Torkmax preparado com válvulas 34x29mm.\n\nSe houver solicitação de reembolso da compra, o participante perde automaticamente o direito de concorrer.",
  },
];
const canonicalPath = "/cursos/clube-de-preparadores/";
const pageTitle = "Clube de Preparadores NTR (18 Cursos) | NTR Escola de Motores";
const pageDescription =
  "Domine a preparação de motores com os 18 cursos completos do Clube NTR. Oferta Especial de Black Friday: Plano Anual (R$ 299) ou Acesso Vitalício (R$ 899) com garantia de 30 dias.";
const breadcrumbs = [
  { name: "Início", path: "/" },
  { name: "Cursos", path: "/cursos/" },
  { name: "Clube de Preparadores NTR", path: canonicalPath },
];
const schema = [
  buildOrganizationSchema(),
  buildBreadcrumbSchema(breadcrumbs),
  buildCourseSchema({
    name: "Clube de Preparadores NTR (18 Cursos)",
    description: pageDescription,
    path: canonicalPath,
    price: "299.00",
    priceValidUntil: "2026-12-31",
    image: "/images/mockup_combo.webp",
  }),
  buildFaqSchema(faqs),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage="/images/mockup_combo.webp"
  canonicalPath={canonicalPath}
  schema={schema}
  contentType="course"
  contentSlug="clube-de-preparadores"
>
  <Breadcrumbs items={breadcrumbs} />
  <div class="overflow-x-hidden bg-black text-white selection:bg-[#e50914] selection:text-white">
    {/* ==========================================================================
        SEÇÃO 1: HERO
        - Desktop: Copy + CTA na esquerda | Imagem na direita (alinhada à base, sem margem inferior)
        - Mobile: Imagem no topo | Copy + CTA abaixo
        - Fundo escuro absoluto (#000000) perfeitamente integrado à imagem
        - Badge PNG sobreposto na parte inferior centralizada com efeito glow infinito
       ========================================================================== */}
    <section class="relative overflow-visible bg-black px-4 pt-6 pb-12 sm:pt-10 sm:pb-16 md:pt-14 lg:pb-16">
      <div class="mx-auto max-w-6xl">
        <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-10">
          {/* COLUNA ESQUERDA (DESKTOP) / ABAIXO DA IMAGEM (MOBILE): COPY + CTA */}
          <div class="order-2 flex flex-col justify-center text-center lg:order-1 lg:col-span-6 lg:text-left">
            {/* HEADLINE */}
            <h1 class="mb-6 text-3xl leading-[1.18] font-black tracking-tight text-white uppercase italic sm:text-4xl md:text-5xl lg:text-[44px] xl:text-[48px]">
              CHEGOU A MAIOR BLACK FRIDAY DA{" "}
              <span class="grad-text-red">PREPARAÇÃO DE MOTORES</span>
            </h1>

            {/* 3 BULLETS SOLICITADOS */}
            <ul class="mx-auto mb-8 flex max-w-md flex-col gap-3.5 text-left lg:mx-0">
              <li class="flex items-center gap-3 text-base font-bold text-gray-200 sm:text-lg">
                <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-[#e50914]/40 bg-[#e50914]/20 text-sm text-[#ff3333]">
                  ✓
                </span>
                <span>18 Cursos de Preparação</span>
              </li>
              <li class="flex items-center gap-3 text-base font-bold text-gray-200 sm:text-lg">
                <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-[#e50914]/40 bg-[#e50914]/20 text-sm text-[#ff3333]">
                  ✓
                </span>
                <span>Técnicas Avançadas</span>
              </li>
              <li class="flex items-start gap-3 text-base font-bold text-gray-200 sm:text-lg">
                <span class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-[#e50914]/40 bg-[#e50914]/20 text-sm text-[#ff3333]">
                  ✓
                </span>
                <div>
                  <span class="block text-white">
                    Sorteio 01 <span class="text-[#fbbf24]">Cabeçote Torkmax PREPARADO</span>
                  </span>
                  <span class="mt-0.5 block text-xs font-semibold text-emerald-400 italic sm:text-sm">
                    (valor estimado do cabeçote R$ 2.500)
                  </span>
                </div>
              </li>
            </ul>

            {/* BOTÃO CTA EM VERDE VIBRANTE DE ALTO DESTAQUE */}
            <div class="mx-auto w-full max-w-md lg:mx-0">
              <a
                href="#oferta"
                class="group flex w-full transform items-center justify-center gap-3 rounded-full bg-gradient-to-r from-[#00b341] via-[#00d254] to-[#009b36] px-8 py-4.5 text-lg font-black tracking-tight text-white uppercase italic shadow-[0_0_40px_rgba(0,210,84,0.55)] transition-all duration-300 hover:-translate-y-1 hover:from-[#00d254] hover:to-[#00b341] hover:shadow-[0_0_60px_rgba(0,210,84,0.85)] sm:text-xl"
              >
                <span>GARANTIR MINHA VAGA NA BLACK</span>
                <span class="text-2xl leading-none transition-transform duration-300 group-hover:translate-x-1.5">
                  →
                </span>
              </a>

              {/* SOCIAL PROOF (APENAS ALUNOS FORMADOS) */}
              <div class="mt-4 flex items-center justify-center gap-2 text-sm font-bold text-gray-300 lg:justify-start">
                <span class="tracking-wide text-[#fbbf24]">★★★★★</span>
                <span>+12.000 Alunos Formados</span>
              </div>
            </div>
          </div>

          {/* COLUNA DIREITA (DESKTOP) / TOPO (MOBILE): IMAGEM INTEGRADA + BADGE */}
          <div class="relative order-1 mb-6 flex w-full items-center justify-center lg:order-2 lg:col-span-6 lg:mb-0">
            <div class="relative mx-auto w-full max-w-[560px] pb-10 sm:pb-12 lg:max-w-none lg:pb-14">
              <Image
                src={imgHeroCompleta}
                alt="Clube de Preparadores NTR - Fábio Scaravonatto e Todos os Cursos"
                widths={[480, 720, 960]}
                sizes="(max-width: 640px) 92vw, (max-width: 1024px) 560px, 540px"
                format="webp"
                quality={80}
                class="pointer-events-none mx-auto block h-auto w-full object-contain select-none"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />

              {/* SOBREPOSIÇÃO DO PNG BLACK FRIDAY 2026 CENTRALIZADO NA BASE COM FOLGA COMPLETA */}
              <div class="pointer-events-none absolute bottom-0 left-1/2 z-20 w-48 max-w-[85%] -translate-x-1/2 sm:w-64 md:w-72">
                <div class="relative flex items-center justify-center">
                  {/* Glow volumétrico pulsante de horizonte infinito */}
                  <div class="absolute inset-0 scale-125 animate-pulse rounded-full bg-[#e50914]/65 blur-2xl"></div>
                  <Image
                    src={imgBadgeBF2026}
                    alt="Black Friday 2026 NTR"
                    width={360}
                    format="webp"
                    quality={80}
                    class="relative z-10 h-auto w-full object-contain drop-shadow-[0_10px_35px_rgba(229,9,20,0.85)]"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ==========================================================================
        FAIXA FITAS CRUZADAS 3D (ESTILO EXATO DA REFERÊNCIA)
