    badge: "01 / 18",
    img: imgCurso01,
  },
  {
    title: "Projeto de Rua 28cv",
    desc: "Passo a passo completo da Titan / Fan 28cv confiável",
    badge: "02 / 18",
    img: imgCurso13,
  },
  {
    title: "Rei do 4Trinho",
    desc: "Construção do motor mais forte da categoria",
    badge: "03 / 18",
    img: imgCurso16,
  },
  {
    title: "Balanceamento de Motores",
    desc: "Alívio de peso e balanceamento dinâmico de biela e virabrequim",
    badge: "04 / 18",
    img: imgCurso10,
  },
  {
    title: "Cabeçotes Nível 1",
    desc: "Dutos, sedes, válvulas e técnicas fundamentais de fluxo",
    badge: "05 / 18",
    img: imgCabecoteN1Azul,
  },
  {
    title: "Cabeçotes PRO",
    desc: "Câmaras de combustão, fluxo avançado e medições extremas",
    badge: "06 / 18",
    img: imgCabecoteProN2Azul,
  },
  {
    title: "Molas Especiais",
    desc: "Carga de molas, retorno, flutuação de válvula e segurança",
    badge: "07 / 18",
    img: imgMolasEspeciaisAzul,
  },
  {
    title: "Desenvolvimento de Cabeçotes",
    desc: "Otimização profunda de dutos e geometria em bancada",
