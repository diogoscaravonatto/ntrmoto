    tag: "ACERTOS",
    cor: "#eab308",
    cursos: [
      { id: "13", title: "ACERTOS FINOS", tag: "CARBURADOR", img: imgAcertosFinosAmarelo },
      { id: "14", title: "ACERTO INJEÇÃO", tag: "ELETRÔNICA", img: imgAcertoPiggybackAmarelo },
      {
        id: "15",
        title: "COMBUSTÍVEIS COMPETIÇÃO",
        tag: "COMBUSTÍVEIS",
