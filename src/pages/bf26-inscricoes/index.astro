  <style>
    /* Carrossel Automático e Infinito no Mobile */
    .marquee-track {
      display: flex;
      width: max-content;
      animation: marquee-scroll 18s linear infinite;
    }

    .marquee-reverse {
      animation: marquee-scroll-reverse 18s linear infinite;
    }

    .marquee-track:hover,
    .marquee-track:active {
      animation-play-state: paused;
    }

    @keyframes marquee-scroll {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-50%);
      }
    }

    @keyframes marquee-scroll-reverse {
      0% {
        transform: translateX(-50%);
      }
      100% {
        transform: translateX(0);
      }
    }
  </style>

  <script>
    // Evita que a página inicie lá embaixo caso exista #oferta na URL ou restauração de scroll
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    if (window.location.hash) {
      history.replaceState(null, '', window.location.pathname + window.location.search);
      window.scrollTo(0, 0);
    }

    // Rolagem suave para #oferta apenas quando clicar no botão, sem sujar a URL com #oferta
    document.querySelectorAll('a[href="#oferta"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById('oferta');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  </script>
