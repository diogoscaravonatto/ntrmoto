---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import imgHero from '../../assets/images/black_vitalicia_ntr_2026_vendas.jpg';
import imgCabecoteN1Azul from '../../assets/images/card_cabecote_nivel1_azul.jpg';
import imgCabecoteProN2Azul from '../../assets/images/card_cabecote_pro_nivel2_azul.jpg';
import imgMolasEspeciaisAzul from '../../assets/images/card_molas_especiais_azul.jpg';
import imgSuporteCabecotesAzul from '../../assets/images/card_suporte_cabecotes_azul.jpg';
import imgComandosN1Vermelho from '../../assets/images/card_comandos_nivel1_vermelho.jpg';
import imgComandosN2Vermelho from '../../assets/images/card_comandos_nivel2_vermelho.jpg';
import imgComandosN3Vermelho from '../../assets/images/card_comandos_nivel3_vermelho.jpg';
import imgUsinagemComandosVermelho from '../../assets/images/card_usinagem_comandos_vermelho.jpg';
import imgAcertosFinosAmarelo from '../../assets/images/card_acertos_finos_amarelo.jpg';
import imgAcertoPiggybackAmarelo from '../../assets/images/card_acerto_piggyback_amarelo.jpg';
import imgEventoRemapAmarelo from '../../assets/images/card_evento_remap_amarelo.jpg';
import imgCombustiveisCompeticaoAmarelo from '../../assets/images/card_combustiveis_competicao_amarelo.jpg';

import imgGarantia from '../../assets/images/selo_garantia_7d.png';
import imgPgto from '../../assets/images/pag_seguro.png';
import imgFabio from '../../assets/images/fabio_ntr_bio.webp';

import print2 from '../../assets/images/Prints/depoimento_ntr_2.png';
import print3 from '../../assets/images/Prints/depoimento_ntr_3.png';
import print4 from '../../assets/images/Prints/print_depoimento_4.webp';
import print5 from '../../assets/images/Prints/print_depoimento_5.webp';
import print6 from '../../assets/images/Prints/print_depoimento_6.webp';
import print7 from '../../assets/images/Prints/print_depoimento_7.webp';

const checkoutLink = "https://chk.eduzz.com/8017JO4Q07";

const formacaoCabecotes = [
  { title: "Preparação de Cabeçotes - Nível 1", img: imgCabecoteN1Azul },
  { title: "Preparação de Cabeçotes PRO - Nível 2", img: imgCabecoteProN2Azul },
  { title: "Molas Especiais - Cabeçotes Preparados", img: imgMolasEspeciaisAzul },
  { title: "Suporte em Preparação de Cabeçotes", img: imgSuporteCabecotesAzul }
];

const formacaoComandos = [
  { title: "Comandos em Ação - Nível 1", img: imgComandosN1Vermelho },
  { title: "Mestre em Comandos - Nível 2", img: imgComandosN2Vermelho },
  { title: "Comandos Agressivos - Nível 3", img: imgComandosN3Vermelho },
  { title: "Usinagem de Comandos", img: imgUsinagemComandosVermelho }
];

const formacaoAcerto = [
  { title: "Acertos Finos - Nível 1", img: imgAcertosFinosAmarelo },
  { title: "Acerto Injeção Piggy Back", img: imgAcertoPiggybackAmarelo },
  { title: "Evento Remap - Central na Prática", img: imgEventoRemapAmarelo },
  { title: "Combustíveis de Competição", img: imgCombustiveisCompeticaoAmarelo }
];

const pilaresPublico = [
  {
    tag: "PILAR 01 • FLUXO E EFICIÊNCIA",
    title: "Cabeçotes que geram POTÊNCIA",
    desc: "Pare de abrir duto no 'achismo' e matar a velocidade de fluxo em baixa. Você vai dominar ângulos, sedes, válvulas e preparação de molas especiais para motores que giram alto sem flutuar."
  },
  {
    tag: "PILAR 02 • GEOMETRIA PERFEITA",
    title: "Domínio absoluto de Comandos",
    desc: "Chega de comprar comando caro que não casa com o projeto. Aprenda a escolher, enquadrar no relógio comparador, cruzar diagramas agressivos e até usinar comandos para faturar $$$."
  },
  {
    tag: "PILAR 03 • ACERTO FINO E REMAP",
    title: "Acerto perfeito sem risco de quebra",
    desc: "De nada adianta um motor bem montado se o acerto estiver pobre ou gordo. Domine sonda, telemetria, Piggyback, Remap de central original na prática e combustíveis de competição."
  }
];

const stackIncluso = [
  { name: "ACESSO VITALÍCIO (Para Sempre) a todas as aulas", price: "Incluso", highlight: true },
  { name: "Preparação de Cabeçotes - Nível 1", price: "R$ 297" },
  { name: "Preparação de Cabeçotes PRO - Nível 2", price: "R$ 397" },
  { name: "Molas Especiais - Cabeçotes Preparados", price: "R$ 197" },
  { name: "Suporte em Preparação de Cabeçotes (30 dias)", price: "R$ 197" },
  { name: "Comandos em Ação - Nível 1", price: "R$ 297" },
  { name: "Mestre em Comandos - Nível 2", price: "R$ 397" },
  { name: "Comandos Agressivos - Nível 3", price: "R$ 397" },
  { name: "Usinagem de Comandos", price: "R$ 297" },
  { name: "Acertos Finos - Nível 1", price: "R$ 197" },
  { name: "Acerto de Injeção Piggy Back", price: "R$ 297" },
  { name: "Evento Remap - Central na Prática", price: "R$ 297" },
  { name: "Combustíveis de Competição", price: "R$ 197" }
];

const prints = [print2, print7, print3, print4, print5, print6];

const faqs = [
  {
    q: "O acesso aos cursos é realmente vitalício?",
    a: "Sim! Garantindo sua inscrição nesta condição especial da Black Vitalícia NTR, você não tem prazo de expiração para assistir aos cursos. O acesso é seu para sempre, podendo rever as aulas na oficina sempre que estiver montando um motor."
  },
  {
    q: "Serve para quem está começando do zero na preparação?",
    a: "Com certeza. As 3 Formações (Cabeçotes, Comandos e Acerto) começam no Nível 1 — explicando a base, ferramentas e cálculos passo a passo — e avançam até os níveis PRO, Nível 3, Usinagem e Remap na prática."
  },
  {
    q: "Já sou mecânico/preparador, esse pacote vai agregar para mim?",
    a: "Sim! É justamente onde os preparadores mais destravam resultado: quando saem das receitas prontas e passam a dominar cruzamento de comandos agressivos, preparação de molas, geometria de cabeçote PRO, acerto com Piggyback/Remap e combustíveis de competição."
  },
  {
    q: "Como recebo meu acesso após a inscrição?",
    a: "Imediatamente após a confirmação do pagamento (no PIX ou Cartão de Crédito é na mesma hora), você recebe no seu e-mail e WhatsApp o link de acesso imediato à plataforma de alunos da NTR."
  },
  {
    q: "Tenho garantia se eu quiser testar os cursos?",
    a: "Sim! Você tem 7 dias de Garantia Incondicional. Pode entrar, assistir às aulas e se achar que não é para você, basta solicitar o reembolso dentro de 7 dias que devolvemos 100% do seu dinheiro."
  }
];
---

<BaseLayout 
  title="Inscrições Abertas | Black Vitalícia NTR - O Arsenal Completo de Preparação" 
  description="Garanta seu Acesso Vitalício às 3 Formações Avançadas da NTR: Cabeçotes, Comandos e Acerto. Prepare motores fortes que andam na frente sem risco de quebras."
>
  <div class="bg-[#050505] text-white selection:bg-brand-red selection:text-white">

    {/* BARRA DE URGÊNCIA TOPO */}
    <div class="bg-gradient-to-r from-[#990000] via-[#CC0000] to-[#990000] text-white py-2.5 px-4 text-center border-b border-white/20 sticky top-0 z-50 backdrop-blur-md">
      <div class="max-w-5xl mx-auto flex items-center justify-center gap-2 text-xs sm:text-sm font-black uppercase tracking-wider">
        <span class="w-2.5 h-2.5 rounded-full bg-[#22C55E] animate-ping shrink-0"></span>
        <span>🔥 INSCRIÇÕES ABERTAS: CONDIÇÃO DE BLACK VITALÍCIA LIBERADA POR TEMPO LIMITADO</span>
      </div>
    </div>

    {/* HERO SECTION - PÁGINA DE VENDAS */}
    <section class="relative pt-8 pb-16 md:pt-14 md:pb-24 px-4 overflow-hidden border-b border-white/10">
      {/* Glow de Fundo */}
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-brand-red/15 blur-[130px] rounded-full pointer-events-none"></div>

      <div class="max-w-6xl mx-auto relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
          
          {/* Coluna de Imagem (Alinhada ao topo e maior) */}
          <div class="lg:col-span-5 order-1 lg:order-2 flex justify-center lg:justify-end">
            <div class="relative w-full max-w-[380px] sm:max-w-[440px] lg:max-w-[480px] rounded-3xl overflow-hidden border-2 border-brand-red/40 shadow-[0_0_60px_rgba(255,51,51,0.25)] group">
              <Image 
                src={imgHero} 
                alt="Black Vitalícia NTR - Inscrições Abertas" 
                class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>

          {/* Coluna de Texto e CTA */}
          <div class="lg:col-span-7 order-2 lg:order-1 text-center lg:text-left">
            <h1 class="text-2xl sm:text-4xl md:text-[42px] lg:text-[44px] xl:text-[48px] font-black text-white uppercase tracking-tighter italic leading-[1.02] mb-5">
              <span class="block sm:whitespace-nowrap">OS MELHORES CURSOS DE</span>
              <span class="block sm:whitespace-nowrap">PREPARAÇÃO DO BRASIL</span>
              <span class="block sm:whitespace-nowrap text-brand-red">SERÃO SEUS PRA SEMPRE</span>
            </h1>

            <p class="text-gray-200 text-base md:text-lg font-medium leading-relaxed mb-7 max-w-2xl mx-auto lg:mx-0">
              Aqui você entra num sistema de desenvolvimento de motores com técnicas avançadas em preparação de cabeçotes, comando e acerto para atingir um resultado brutal.
            </p>

            {/* Botão Principal de Inscrição */}
            <div class="max-w-xl mx-auto lg:mx-0 mb-7">
              <a 
                href="#oferta"
                class="group relative flex items-center justify-center gap-3 w-full py-5 px-6 bg-[#22C55E] hover:bg-[#16a34a] text-white text-lg sm:text-xl font-black rounded-2xl shadow-[0_15px_40px_rgba(34,197,94,0.35)] hover:shadow-[0_15px_50px_rgba(34,197,94,0.55)] transition-all transform hover:-translate-y-1 uppercase tracking-tight italic"
              >
                <span>QUERO MEU ACESSO VITALÍCIO AGORA</span>
                <svg class="w-6 h-6 stroke-current stroke-[3] transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
              <p class="mt-3 text-gray-400 text-xs font-semibold text-center lg:text-left">
                ⚡ Liberação imediata no seu e-mail e WhatsApp + 7 dias de garantia incondicional.
              </p>
            </div>

            {/* Box de Destaques da Oferta */}
            <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-4 text-left max-w-xl mx-auto lg:mx-0 space-y-2.5">
              <div class="flex items-center gap-3 text-sm text-gray-200 font-semibold">
                <span class="text-[#22C55E] font-black text-lg lg:text-base">✔</span>
                <span><strong>Acesso Vitalício</strong> (assista quantas vezes quiser, para sempre)</span>
              </div>
              <div class="flex items-center gap-3 text-sm text-gray-200 font-semibold">
                <span class="text-[#22C55E] font-black text-lg lg:text-base">✔</span>
                <span><strong>As 3 Formações Completas:</strong> Cabeçotes + Comandos + Acerto</span>
              </div>
              <div class="flex items-center gap-3 text-sm text-gray-200 font-semibold">
                <span class="text-[#22C55E] font-black text-lg lg:text-base">✔</span>
                <span><strong>1 Ano de Suporte Técnico + 11 Certificados Profissionais</strong> inclusos</span>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    {/* SEÇÃO: O QUE VOCÊ VAI LEVAR (MANTIDA INTEGRALMENTE COM OS CARDS E CARROSSEL) */}
    <section class="py-16 md:py-24 px-4 bg-[#050505]">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-brand-red font-black text-xs uppercase tracking-widest">Arsenal Completo NTR</span>
          <h2 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tighter italic mt-2 mb-4">
            O que você <span class="text-brand-red">vai levar</span> na Black Vitalícia
          </h2>
          <p class="text-gray-400 text-base md:text-lg max-w-2xl mx-auto">
            Do básico ao avançado: todos os treinamentos para você preparar motores fortes que andam na frente, sem risco de quebras e com acesso para sempre.
          </p>
        </div>

        {/* Sub-bloco: FORMAÇÃO AVANÇADA EM CABEÇOTES */}
        <div class="mb-14">
          <div class="flex items-center justify-center gap-3 mb-5">
            <div class="h-px bg-blue-500/30 flex-1 max-w-[100px]"></div>
            <h3 class="text-xl sm:text-2xl md:text-3xl font-black text-white uppercase tracking-tighter italic text-center">
              FORMAÇÃO AVANÇADA EM <span class="text-[#00A3FF]">CABEÇOTES</span>
            </h3>
            <div class="h-px bg-blue-500/30 flex-1 max-w-[100px]"></div>
          </div>

          {/* Mobile: Carrossel Automático Infinito */}
          <div class="sm:hidden overflow-hidden -mx-4 relative">
            <div class="marquee-track">
              {[...formacaoCabecotes, ...formacaoCabecotes].map((item) => (
                <div class="w-[230px] shrink-0 mx-2 relative bg-[#0a0a0a] border border-blue-500/30 rounded-2xl overflow-hidden aspect-[3/4]">
                  <Image 
                    src={item.img} 
                    alt={item.title} 
                    class="absolute inset-0 w-full h-full object-cover"
                  />
                </div>
              ))}
            </div>
          </div>

          {/* Desktop/Tablet: Grid 4 Colunas */}
          <div class="hidden sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
            {formacaoCabecotes.map((item) => (
              <div class="group relative bg-[#0a0a0a] border border-blue-500/30 rounded-2xl overflow-hidden aspect-[3/4] flex flex-col items-center justify-end transition-all duration-500 hover:border-[#00A3FF] hover:shadow-[0_0_35px_rgba(0,163,255,0.25)]">
                <Image 
                  src={item.img} 
                  alt={item.title} 
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              </div>
            ))}
          </div>
        </div>

        {/* Sub-bloco: FORMAÇÃO AVANÇADA EM COMANDOS */}
        <div class="mb-14">
          <div class="flex items-center justify-center gap-3 mb-5">
            <div class="h-px bg-brand-red/30 flex-1 max-w-[100px]"></div>
            <h3 class="text-xl sm:text-2xl md:text-3xl font-black text-white uppercase tracking-tighter italic text-center">
              FORMAÇÃO AVANÇADA EM <span class="text-brand-red">COMANDOS</span>
            </h3>
            <div class="h-px bg-brand-red/30 flex-1 max-w-[100px]"></div>
          </div>

          {/* Mobile: Carrossel Automático Infinito */}
          <div class="sm:hidden overflow-hidden -mx-4 relative">
            <div class="marquee-track marquee-reverse">
              {[...formacaoComandos, ...formacaoComandos].map((item) => (
                <div class="w-[230px] shrink-0 mx-2 relative bg-[#0a0a0a] border border-brand-red/30 rounded-2xl overflow-hidden aspect-[3/4]">
                  <Image 
                    src={item.img} 
                    alt={item.title} 
                    class="absolute inset-0 w-full h-full object-cover"
                  />
                </div>
              ))}
            </div>
          </div>

          {/* Desktop/Tablet: Grid 4 Colunas */}
          <div class="hidden sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
            {formacaoComandos.map((item) => (
              <div class="group relative bg-[#0a0a0a] border border-brand-red/30 rounded-2xl overflow-hidden aspect-[3/4] flex flex-col items-center justify-end transition-all duration-500 hover:border-brand-red hover:shadow-[0_0_35px_rgba(255,51,51,0.25)]">
                <Image 
                  src={item.img} 
                  alt={item.title} 
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              </div>
            ))}
          </div>
        </div>

        {/* Sub-bloco: FORMAÇÃO AVANÇADA EM ACERTO */}
        <div class="mb-14">
          <div class="flex items-center justify-center gap-3 mb-5">
            <div class="h-px bg-[#F0B102]/30 flex-1 max-w-[100px]"></div>
            <h3 class="text-xl sm:text-2xl md:text-3xl font-black text-white uppercase tracking-tighter italic text-center">
              FORMAÇÃO AVANÇADA EM <span class="text-[#F0B102]">ACERTO</span>
            </h3>
            <div class="h-px bg-[#F0B102]/30 flex-1 max-w-[100px]"></div>
          </div>

          {/* Mobile: Carrossel Automático Infinito */}
          <div class="sm:hidden overflow-hidden -mx-4 relative">
            <div class="marquee-track">
              {[...formacaoAcerto, ...formacaoAcerto].map((item) => (
                <div class="w-[230px] shrink-0 mx-2 relative bg-[#0a0a0a] border border-[#F0B102]/30 rounded-2xl overflow-hidden aspect-[3/4]">
                  <Image 
                    src={item.img} 
                    alt={item.title} 
                    class="absolute inset-0 w-full h-full object-cover"
                  />
                </div>
              ))}
            </div>
          </div>

          {/* Desktop/Tablet: Grid 4 Colunas */}
          <div class="hidden sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
            {formacaoAcerto.map((item) => (
              <div class="group relative bg-[#0a0a0a] border border-[#F0B102]/30 rounded-2xl overflow-hidden aspect-[3/4] flex flex-col items-center justify-end transition-all duration-500 hover:border-[#F0B102] hover:shadow-[0_0_35px_rgba(240,177,2,0.25)]">
                <Image 
                  src={item.img} 
                  alt={item.title} 
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              </div>
            ))}
          </div>
        </div>

        {/* CTA Intermediário */}
        <div class="text-center max-w-xl mx-auto">
          <a 
            href="#oferta"
            class="group flex items-center justify-center gap-3 w-full py-5 px-6 bg-[#22C55E] hover:bg-[#16a34a] text-white text-lg sm:text-xl font-black rounded-2xl shadow-[0_15px_40px_rgba(34,197,94,0.35)] hover:shadow-[0_15px_50px_rgba(34,197,94,0.55)] transition-all transform hover:-translate-y-1 uppercase tracking-tight italic"
          >
            <span>QUERO DESTRAVAR MEU ACESSO VITALÍCIO</span>
          </a>
        </div>
      </div>
    </section>

    {/* SEÇÃO: POR QUE ESSA FORMAÇÃO É DIFERENTE DE TUDO (FOCO NA DOR DO PREPARADOR) */}
    <section class="py-16 md:py-24 px-4 bg-[#0a0a0a] border-y border-white/10">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-brand-red font-black text-xs uppercase tracking-widest">TÉCNICAS COMPROVADAS EM DINAMÔMETRO E PISTA</span>
          <h2 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tighter italic mt-2 mb-4">
            Pare de depender de <span class="text-brand-red">"receita pronta"</span> que quebra motor
          </h2>
          <p class="text-gray-400 text-base md:text-lg max-w-3xl mx-auto">
            Quem copia receita de internet vive refém da sorte: às vezes a moto anda, às vezes trava pistão, flutua válvula ou derrete tudo. Na NTR você domina a engenharia prática por trás dos 3 pilares que realmente fazem um motor andar na frente:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {pilaresPublico.map((pilar) => (
            <div class="bg-[#050505] border border-white/10 rounded-3xl p-7 relative overflow-hidden hover:border-brand-red/50 transition-all">
              <span class="inline-block text-[11px] font-black uppercase tracking-widest text-brand-red bg-brand-red/10 border border-brand-red/20 px-3 py-1 rounded-full mb-4">
                {pilar.tag}
              </span>
              <h3 class="text-xl sm:text-2xl font-black text-white uppercase italic tracking-tight mb-3">
                {pilar.title}
              </h3>
              <p class="text-gray-400 text-sm sm:text-base leading-relaxed">
                {pilar.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SEÇÃO: PROVA SOCIAL (ALUNOS NTR) */}
    <section class="py-16 md:py-24 px-4 bg-[#050505]">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-14">
          <span class="text-brand-red font-black text-xs uppercase tracking-widest">Resultados Reais na Prática</span>
          <h2 class="text-3xl md:text-5xl font-black text-white mt-2 mb-3 uppercase tracking-tighter italic">
            Veja o que os <span class="text-brand-red">preparadores formados pela NTR</span> dizem:
          </h2>
          <p class="text-gray-400 font-bold uppercase tracking-widest text-xs max-w-2xl mx-auto">
            Mais de 12.000 alunos já transformaram seus motores e suas oficinas com o método NTR
          </p>
        </div>

        <div class="columns-1 sm:columns-2 md:columns-3 gap-5 space-y-5">
          {prints.map((print, i) => (
            <div class="break-inside-avoid bg-[#0a0a0a] border border-white/10 rounded-2xl p-2 overflow-hidden shadow-xl transition-all hover:border-brand-red/40">
              <Image src={print} alt={`Depoimento Aluno NTR ${i + 1}`} class="w-full h-auto rounded-xl" />
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SEÇÃO DE OFERTA PRINCIPAL (#oferta) */}
    <section id="oferta" class="py-20 md:py-28 px-4 bg-gradient-to-b from-[#0a0a0a] to-black border-t border-white/10 relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[600px] bg-brand-red/10 blur-[150px] rounded-full pointer-events-none"></div>

      <div class="max-w-6xl mx-auto relative z-10">
        <div class="text-center mb-14">
          <div class="inline-flex items-center gap-2 bg-brand-red/15 border border-brand-red/40 px-4 py-1.5 rounded-full mb-4">
            <span class="text-brand-red font-black text-xs uppercase tracking-widest">⚡ Condição Especial de Black Friday</span>
          </div>
