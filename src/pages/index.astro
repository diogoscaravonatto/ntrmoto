---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import StatsBar from "../components/home/StatsBar.astro";
import ProblemStatement from "../components/home/ProblemStatement.astro";
import Framework from "../components/home/Framework.astro";
import Courses from "../components/home/Courses.astro";
import SocialProofGrid from "../components/home/SocialProofGrid.astro";
import FinalCTA from "../components/home/FinalCTA.astro";
import Footer from "../components/home/Footer.astro";
import { buildOrganizationSchema, buildWebSiteSchema } from "../utils/seo";

const title = "NTR Escola de Motores | Preparação de Motores";
const description =
  "A maior escola de preparação de motores da América Latina. O sistema simples que a NTR usa para formar campeões.";
const schema = [buildOrganizationSchema(), buildWebSiteSchema()];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  schema={schema}
  contentType="home"
  contentSlug="home"
  hideFooter={true}
>
  <div class="min-h-screen bg-[#0a0a0a] font-sans text-white selection:bg-brand-red selection:text-white">
    <Hero />
    <StatsBar />
    <ProblemStatement />
    <Framework />
    <Courses />
    <SocialProofGrid />
    <FinalCTA />
  </div>
  <Footer slot="footer" />
</BaseLayout>
