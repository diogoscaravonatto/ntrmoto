  <style>
    /* Carrossel Automático e Infinito no Mobile */
    .marquee-track {
      display: flex;
      width: max-content;
      animation: marquee-scroll 18s linear infinite;
    }

    .marquee-reverse {
      animation: marquee-scroll-reverse 18s linear infinite;
    }

    .marquee-track:hover,
    .marquee-track:active {
      animation-play-state: paused;
    }

    @keyframes marquee-scroll {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-50%);
      }
    }

    @keyframes marquee-scroll-reverse {
      0% {
        transform: translateX(-50%);
      }
      100% {
        transform: translateX(0);
      }
    }
  </style>

  <script>
    // Contagem regressiva até 10/11 às 20:00 (horário de Brasília)
    function updateCountdown() {
      const now = new Date();
      const currentYear = now.getFullYear();
      let target = new Date(`${currentYear}-11-10T20:00:00-03:00`);
      
      // Caso já tenha passado de 10/11 às 20h no ano atual, mantém zerado
      const diff = target.getTime() - now.getTime();

      const daysEl = document.getElementById('cd-days');
      const hoursEl = document.getElementById('cd-hours');
      const minsEl = document.getElementById('cd-mins');
      const secsEl = document.getElementById('cd-secs');

      if (!daysEl || !hoursEl || !minsEl || !secsEl) return;

      if (diff <= 0) {
        daysEl.textContent = '00';
        hoursEl.textContent = '00';
        minsEl.textContent = '00';
        secsEl.textContent = '00';
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const mins = Math.floor((diff / 1000 / 60) % 60);
      const secs = Math.floor((diff / 1000) % 60);

      daysEl.textContent = String(days).padStart(2, '0');
      hoursEl.textContent = String(hours).padStart(2, '0');
      minsEl.textContent = String(mins).padStart(2, '0');
      secsEl.textContent = String(secs).padStart(2, '0');
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);

    // Disparo do evento padrão Lead do Meta Pixel nos botões "ENTRAR NO GRUPO VIP"
    document.querySelectorAll('.btn-grupo-vip').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (typeof fbq === 'function') {
          fbq('track', 'Lead');
        }
      });
    });
  </script>
