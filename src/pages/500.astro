---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
    error: unknown;
}

const { error } = Astro.props;
---

<BaseLayout title="Erro de Servidor | 500">
    <main
        class="flex flex-col items-center justify-center min-h-screen p-6 text-center"
    >
        <div class="relative group">
            <h1
                class="text-[12rem] font-black leading-none tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-red-500 to-red-900 opacity-20"
            >
                500
            </h1>
            <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-4xl font-bold tracking-tight"
                    >Algo deu errado</span
                >
            </div>
        </div>

        <p class="max-w-md mt-4 text-lg text-zinc-400">
            Ocorreu um erro inesperado no nosso servidor. Estamos trabalhando
            para resolver.
        </p>

        {
            import.meta.env.DEV && (
                <div class="mt-8 p-4 bg-red-950/30 border border-red-900/50 rounded-lg text-left max-w-2xl overflow-auto">
                    <p class="text-red-400 font-mono text-sm">
                        {error instanceof Error
                            ? error.message
                            : "Desconhecido"}
                    </p>
                    {error instanceof Error && error.stack && (
                        <pre class="mt-2 text-red-500/70 text-xs font-mono">
                            {error.stack}
                        </pre>
                    )}
                </div>
            )
        }

        <a
            href="/"
            class="mt-12 px-8 py-4 bg-white text-black font-bold rounded-full hover:scale-105 transition-transform active:scale-95"
        >
            Tentar novamente
        </a>

        <!-- Background Glow -->
        <div
            class="fixed -z-10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-red-500/10 blur-[120px] rounded-full pointer-events-none"
        >
        </div>
    </main>
</BaseLayout>
