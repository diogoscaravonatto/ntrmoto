---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
    error: unknown;
}

const { error } = Astro.props;
---

<BaseLayout title="Erro de Servidor | 500">
    <div
        class="min-h-screen bg-primary flex flex-col items-center justify-center py-12 px-4 relative overflow-hidden"
    >
        <!-- Textura de fundo suave -->
        <div
            class="absolute inset-0 bg-brand-pattern opacity-10 pointer-events-none"
        >
        </div>
        <div
            class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-lg h-full bg-linear-to-b from-white/5 to-transparent pointer-events-none"
        >
        </div>

        <main
            class="relative z-10 flex flex-col items-center text-center w-full max-w-3xl"
        >
            <a
                href="/"
                class="mb-12 animate-reveal hover:scale-105 transition-transform"
            >
                <img
                    src="/logovetpragas1.3.svg"
                    alt="VetPragas Logo"
                    class="h-10 md:h-14 w-auto opacity-80 hover:opacity-100 transition-opacity"
                />
            </a>

            <div
                class="relative group animate-reveal"
                style="animation-delay: 100ms;"
            >
                <h1
                    class="text-[8rem] md:text-[12rem] font-black leading-none tracking-tighter text-transparent bg-clip-text bg-linear-to-b from-orange-500 to-transparent opacity-30"
                >
                    500
                </h1>
                <div class="absolute inset-0 flex items-center justify-center">
                    <span
                        class="text-3xl md:text-5xl font-black text-white tracking-tight uppercase"
                        >Erro no Sistema</span
                    >
                </div>
            </div>

            <p
                class="max-w-md mt-6 text-lg text-white/70 font-medium animate-reveal"
                style="animation-delay: 200ms;"
            >
                Ocorreu uma falha inesperada em nossos servidores técnicos. A
                equipe responsável já foi notificada.
            </p>

            {
                import.meta.env.DEV && (
                    <div
                        class="mt-8 p-6 bg-black/40 border border-white/10 rounded-xl text-left w-full overflow-auto shadow-2xl backdrop-blur-md animate-reveal"
                        style="animation-delay: 250ms;"
                    >
                        <div class="flex items-center gap-2 mb-4">
                            <div class="w-3 h-3 rounded-full bg-red-500 shadow-[0_0_10px_rgba(239,68,68,0.6)]" />
                            <span class="text-white/50 text-xs font-bold uppercase tracking-widest">
                                Stack Trace (Somente DEV)
                            </span>
                        </div>
                        <p class="text-red-400 font-mono text-sm break-all font-bold">
                            {error instanceof Error
                                ? error.message
                                : "Erro Desconhecido"}
                        </p>
                        {error instanceof Error && error.stack && (
                            <pre class="mt-4 p-4 bg-black/50 rounded-lg text-white/60 text-xs font-mono overflow-x-auto border border-white/5">
                                {error.stack}
                            </pre>
                        )}
                    </div>
                )
            }

            <div
                class="mt-12 flex flex-col sm:flex-row gap-4 animate-reveal"
                style="animation-delay: 300ms;"
            >
                <a
                    href="javascript:window.location.reload()"
                    class="btn-primary"
                >
                    Tentar Novamente
                </a>
                <a
                    href="/"
                    class="px-8 py-4 bg-transparent border border-white/20 text-white font-bold text-sm uppercase tracking-widest rounded-xl hover:bg-white/10 transition-all shadow-lg text-center inline-block"
                >
                    Voltar ao Início
                </a>
            </div>

            <!-- Background Glow -->
            <div
                class="absolute -z-10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-orange-500/20 blur-[150px] rounded-full pointer-events-none"
            >
            </div>
        </main>
    </div>
</BaseLayout>
