---
export const prerender = true;
import FunnelLayout from "@templates/funnels/marketing-digital-vsl/layouts/FunnelLayout.astro";
import Headline from "@templates/funnels/marketing-digital-vsl/sections/downsell/Headline.astro";
import Oferta from "@templates/funnels/marketing-digital-vsl/sections/downsell/Oferta.astro";

const offer = {
    price: "R$ 47,00",
};
---

<FunnelLayout
    title="Última Chance - Oferta Especial"
    step={4}
    totalSteps={5}
    showProgressBar={true}
>
    <div class="w-full max-w-3xl mx-auto space-y-6 animate-fade-in-up">
        <Headline />
        <Oferta offer={offer} />
    </div>
</FunnelLayout>

<style>
    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
    }
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
