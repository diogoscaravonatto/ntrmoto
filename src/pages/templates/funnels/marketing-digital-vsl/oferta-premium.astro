---
export const prerender = true;
import FunnelLayout from "@templates/funnels/marketing-digital-vsl/layouts/FunnelLayout.astro";
import VideoPlayer from "@templates/funnels/marketing-digital-vsl/components/VideoPlayer.astro";
import Headline from "@templates/funnels/marketing-digital-vsl/sections/upsell/Headline.astro";
import Oferta from "@templates/funnels/marketing-digital-vsl/sections/upsell/Oferta.astro";

const offer = {
    originalPrice: "R$ 997,00",
    offerPrice: "R$ 297,00",
    savings: "R$ 700,00",
};
---

<FunnelLayout
    title="Oferta Especial - Não feche essa página"
    step={3}
    totalSteps={5}
    showProgressBar={true}
>
    <div class="w-full max-w-4xl mx-auto space-y-8 animate-fade-in-up">
        <Headline />

        <div class="relative z-20">
            <VideoPlayer
                thumbnail="https://images.unsplash.com/photo-1553729459-efe14ef6055d?q=80&w=1600&auto=format&fit=crop"
            />
        </div>

        <Oferta offer={offer} />
    </div>
</FunnelLayout>

<style>
    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
    }
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
