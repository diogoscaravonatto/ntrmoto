---
export const prerender = true;
import FunnelLayout from "@templates/funnels/marketing-digital-vsl/layouts/FunnelLayout.astro";
import Formulario from "@templates/funnels/marketing-digital-vsl/sections/checkout/Formulario.astro";
import Resumo from "@templates/funnels/marketing-digital-vsl/sections/checkout/Resumo.astro";

const product = {
    name: "Método VSL - Masterclass 4 Dias",
    price: "R$ 197,00",
    features: [
        "Acesso Vitalício",
        "4 Módulos Práticos",
        "Suporte VIP",
        "Bônus: Template Pack",
    ],
};
---

<FunnelLayout
    title="Finalizar Compra - Método VSL"
    step={2}
    totalSteps={5}
    showProgressBar={true}
>
    <div
        class="w-full max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-start"
    >
        <div class="lg:col-span-7">
            <Formulario />
        </div>
        <div class="lg:col-span-5">
            <Resumo product={product} />
        </div>
    </div>
</FunnelLayout>
