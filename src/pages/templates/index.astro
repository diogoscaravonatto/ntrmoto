        icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="6" x="3" y="15" rx="2"/><path d="M12 9V3m0 0 3 3m-3-3-3 3"/></svg>',
    },
    StepProcess: {
        description:
            "Exposição visual das etapas do serviço. Ideal para reduzir a ansiedade do Lead.",
        icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>',
    },
    ComparisonTable: {
        description:
            "Tabela comparativa 'Nós vs Concorrência'. Mata objeções de qualidade e preço.",
        icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 3h5v5"/><path d="M8 3H3v5"/><path d="M21 16v5h-5"/><path d="M3 16v5h5"/><path d="M12 3v18"/><path d="M3 12h18"/></svg>',
    },
    TrustBadges: {
        description:
            "Selos de segurança e garantia. Aumentam a confiança na hora da compra.",
        icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>',
    },
    ExitIntentPopup: {
        description:
            "Modal acionado na saída do usuário. Última chance de capturar o lead.",
        icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>',
    },
    BentoGridPremium: {
        description:
            "Grid moderno estilo Apple para recursos. Display premium de alta densidade.",
        icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>',
    },
    VSLSection: {
        description:
            "Seção otimizada para Vídeo de Vendas. Foco total em retenção e CTA.",
        icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="15" x="2" y="3" rx="2"/><path d="m10 8 5 3-5 3V8z"/></svg>',
    },
};

const components = Object.keys(componentFiles).map((path) => {
    const fileName = path.split("/").pop()?.replace(".astro", "") || "";

    // Detectar categoria baseada no nome do arquivo
    let categoryInfo = {
        category: "Marketing",
        color: "text-violet-500",
        bg: "bg-violet-500/10",
    };
    for (const [key, value] of Object.entries(componentCategories)) {
        if (fileName.includes(key)) {
            categoryInfo = value;
            break;
        }
    }

    // Gerar descrição baseada no nome
    const nameFormatted = fileName.replace(/([A-Z])/g, " $1").trim();
    const customInfo = customComponentInfo[fileName] || {
        description: `Componente ${nameFormatted} pronto para uso.`,
        icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>',
    };

    return {
        id: fileName
            .toLowerCase()
            .replace(/([A-Z])/g, "-$1")
            .toLowerCase(),
        slug: fileName,
        name: nameFormatted,
        path: `/templates/preview/${fileName}`,
        ...categoryInfo,
        ...customInfo,
    };
});
// 4. Coletar Funis
const funnelFiles = import.meta.glob("./funnels/*/index.astro");
const funnels = Object.keys(funnelFiles).map((path) => {
    const slug = path.split("/").slice(-2, -1)[0];
    const stepsGlob = import.meta.glob("./funnels/**/*.astro");
    const stepsCount = Object.keys(stepsGlob).filter(
        (p) => p.includes(`/funnels/${slug}/`) && !p.endsWith("index.astro"),
    ).length;

    // Metadados específicos para funis (podemos expandir depois)
    const funnelMetadata: Record<
        string,
        TemplateMetadata & { steps: { name: string; path: string }[] }
    > = {
        "marketing-digital-vsl": {
            name: "Marketing Digital VSL",
            description: "Funil completo de alta conversão para infoprodutos.",
            category: "Vendas",
            icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>',
            color: "text-violet-500",
            bg: "bg-violet-500/10",
            steps: [
                {
                    name: "Página de Vendas",
                    path: `/templates/funnels/${slug}/pagina-vendas`,
                },
                {
                    name: "Checkout",
                    path: `/templates/funnels/${slug}/checkout`,
                },
                {
                    name: "Oferta Premium",
                    path: `/templates/funnels/${slug}/oferta-premium`,
                },
                {
                    name: "Oferta Básica",
                    path: `/templates/funnels/${slug}/oferta-basica`,
                },
                {
                    name: "Obrigado",
                    path: `/templates/funnels/${slug}/obrigado`,
                },
            ],
        },
    };

    const info = funnelMetadata[slug] || {
        name: slug.charAt(0).toUpperCase() + slug.slice(1).replace("-", " "),
        description: "Estrutura de funil multi-etapas completa.",
        category: "Marketing",
        icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
        color: "text-zinc-400",
        bg: "bg-zinc-900/50",
        steps: [],
    };

    return {
        id: `funnel-${slug}`,
        slug,
        path: `/templates/funnels/${slug}`,
        stepsCount: info.steps.length || stepsCount,
        ...info,
    };
});
---

<TemplateGalleryLayout
    title="Hub de Templates"
    description="Explore nossa biblioteca de templates premium e componentes modulares otimizados para performance."
>
    <main
        class="py-24 px-6 md:px-12 max-w-7xl mx-auto min-h-screen transition-colors duration-500"
    >
        <header class="mb-20 text-center">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full border text-[10px] font-mono uppercase tracking-widest mb-6 transition-all cursor-default
                       dark:bg-white/5 dark:border-white/10 dark:text-zinc-500 dark:hover:border-amber-500/30 dark:hover:text-amber-500
                       bg-gray-100 border-gray-200 text-gray-600 hover:border-violet-400 hover:text-violet-600"
            >
                <span
                    class="size-1 rounded-full animate-pulse dark:bg-amber-500 bg-violet-500"
                ></span>
                ARSENAL SNIPER | Preview Center
            </div>
            <h1
                class="text-7xl md:text-9xl font-black uppercase tracking-tighter mb-8 transition-colors
                       dark:text-white text-gray-900"
            >
                ARSENAL<span class="dark:text-zinc-800 text-gray-400"
                    >.SNIPER</span
                >
            </h1>
            <p
                class="text-xl max-w-2xl mx-auto leading-relaxed font-medium transition-colors
                       dark:text-zinc-500 text-gray-600"
            >
                Sua central de exploração dinâmica. Escolha entre templates
                completos ou componentes modulares e filtre por necessidade.
            </p>
        </header>

        <!-- Dynamic Vue Explorer - Renderizado APENAS no cliente (sem SSR) -->
        <TemplateExplorer
            client:only="vue"
            pages={pages}
            components={components}
            funnels={funnels}
        />
    </main>
</TemplateGalleryLayout>
