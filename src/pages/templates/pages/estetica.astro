---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Navbar from "@templates-pages/estetica/components/Navbar.astro";
import Hero from "@templates-pages/estetica/components/Hero.astro";
import Metodologia from "@templates-pages/estetica/components/Metodologia.astro";
import Procedimentos from "@templates-pages/estetica/components/Procedimentos.astro";
import Tecnologia from "@templates-pages/estetica/components/Tecnologia.astro";
import Equipe from "@templates-pages/estetica/components/Equipe.astro";
import FAQ from "@templates-pages/estetica/components/FAQ.astro";
import CTA from "@templates-pages/estetica/components/CTA.astro";
import Footer from "@templates-pages/estetica/components/Footer.astro";
---

<BaseLayout
    title="Clínica de Estética | Ciência & Beleza"
    description="Referência em rejuvenescimento facial e tratamentos estéticos avançados. Tecnologia de ponta aliada à arte da beleza natural."
    image="/images/templates/estetica.png"
    theme="light"
>
    <main
        class="bg-[#fcf8f6] text-[#6d5a57] font-sans selection:bg-[#f8b4b4] selection:text-white overflow-hidden"
    >
        <!-- DECORATIVE ELEMENTS -->
        <div class="fixed inset-0 pointer-events-none z-0">
            <div
                class="absolute top-[5%] left-[-5%] size-[500px] bg-[#f8e8e3] rounded-full blur-[100px] opacity-60"
            >
            </div>
            <div
                class="absolute bottom-[10%] right-[-5%] size-[600px] bg-[#fcf2ef] rounded-full blur-[120px] opacity-40"
            >
            </div>
        </div>

        <Navbar />
        <Hero />
        <Metodologia />
        <Procedimentos />
        <Tecnologia />
        <Equipe />
        <FAQ />
        <CTA />
        <Footer />
    </main>
</BaseLayout>

<style is:global>
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in-up {
        animation: fadeInUp 1s ease-out forwards;
    }
</style>
