---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Navbar from "@templates-pages/joalheria/components/Navbar.astro";
import Hero from "@templates-pages/joalheria/components/Hero.astro";
import Atelier from "@templates-pages/joalheria/components/Atelier.astro";
import Bespoke from "@templates-pages/joalheria/components/Bespoke.astro";
import Padrao from "@templates-pages/joalheria/components/Padrao.astro";
import Colecoes from "@templates-pages/joalheria/components/Colecoes.astro";
import FAQ from "@templates-pages/joalheria/components/FAQ.astro";
import CTA from "@templates-pages/joalheria/components/CTA.astro";
import Footer from "@templates-pages/joalheria/components/Footer.astro";
---

<BaseLayout
    title="Joalheria d'Élite | Herança & Brilho Eterno"
    description="Coleção exclusiva de alta joalheria. Diamantes certificados e design autoral para momentos inesquecíveis."
    image="/images/templates/joalheria.png"
    theme="light"
>
    <main
        class="bg-white text-zinc-900 font-serif selection:bg-[#d4af37] selection:text-white overflow-hidden"
    >
        <Navbar />
        <Hero />
        <Atelier />
        <Bespoke />
        <Padrao />
        <Colecoes />
        <FAQ />
        <CTA />
        <Footer />
    </main>
</BaseLayout>

<style is:global>
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(80px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in {
        animation: fadeIn 1.5s ease-out forwards;
        opacity: 0;
    }
    .animate-slide-up {
        animation: slideUp 2s cubic-bezier(0.19, 1, 0.22, 1) forwards;
        opacity: 0;
    }
    .delay-500 {
        animation-delay: 0.5s;
    }
    .delay-700 {
        animation-delay: 0.7s;
    }
</style>
