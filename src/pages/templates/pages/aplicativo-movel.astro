---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Navigation from "@templates-pages/aplicativo-movel/components/Navigation.astro";
import Hero from "@templates-pages/aplicativo-movel/components/Hero.astro";
import Features from "@templates-pages/aplicativo-movel/components/Features.astro";
import Testimonials from "@templates-pages/aplicativo-movel/components/Testimonials.astro";
import CTA from "@templates-pages/aplicativo-movel/components/CTA.astro";

const data: {
    name: string;
    description: string;
    theme: "light" | "dark";
    colors: {
        primary: string;
        secondary: string;
        background: string;
    };
} = {
    name: "Native App",
    description: "Showcase moderno para aplicativos móveis e SaaS.",
    theme: "dark",
    colors: {
        primary: "#3b82f6",
        secondary: "#60a5fa",
        background: "#050505",
    },
};
---

<BaseLayout
    title={data.name}
    description={data.description}
    theme={data.theme}
    colors={data.colors}
>
    <div
        class="min-h-screen bg-[#050505] font-sans text-white selection:bg-indigo-500/30 overflow-x-hidden relative"
    >
        <!-- Background Gradients -->
        <div class="fixed inset-0 z-0 pointer-events-none">
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-indigo-600/20 blur-[130px] rounded-full mix-blend-screen opacity-50"
            >
            </div>
            <div
                class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-purple-600/10 blur-[150px] rounded-full mix-blend-screen opacity-30"
            >
            </div>
            <!-- Mesh Grid Pattern -->
            <div
                class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-size-[40px_40px] mask-[radial-gradient(ellipse_at_center,black,transparent_80%)]"
            >
            </div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-6">
            <Navigation />
            <Hero />
            <Features />
            <Testimonials />
            <CTA />
        </div>
    </div>
</BaseLayout>

<style is:global>
    html {
        scroll-behavior: smooth;
    }

    body {
        background-color: #050505;
    }

    /* Gradients & Animations are handled within components */
</style>
