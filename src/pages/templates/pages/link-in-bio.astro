---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
const metadata = {
    name: "Aura Links | Sua Identidade Digital",
    description:
        "Conecte sua audiência aos seus links mais importantes com um design premium e minimalista.",
};
import Navigation from "@templates-pages/link-in-bio/components/Navigation.astro";
import Hero from "@templates-pages/link-in-bio/components/Hero.astro";
import Links from "@templates-pages/link-in-bio/components/Links.astro";
import ContentShowcase from "@templates-pages/link-in-bio/components/ContentShowcase.astro";
import Testimonials from "@templates-pages/link-in-bio/components/Testimonials.astro";
import Newsletter from "@templates-pages/link-in-bio/components/Newsletter.astro";
import FAQ from "@templates-pages/link-in-bio/components/FAQ.astro";
import Footer from "@templates-pages/link-in-bio/components/Footer.astro";
const layoutColors = {
    primary: "#a855f7",
    secondary: "#c084fc",
    background: "#000000",
};
---

<BaseLayout
    title={metadata.name}
    description={metadata.description}
    theme="dark"
    colors={layoutColors}
>
    <div class="bg-black text-white min-h-screen font-['Outfit',,sans-serif]">
        <Navigation />
        <main>
            <Hero />
            <Links />
            <ContentShowcase />
            <Testimonials />
            <Newsletter />
            <FAQ />
        </main>
        <Footer />
    </div>
</BaseLayout>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Outfit:wght@100;400;700;900&display=swap");
</style>
