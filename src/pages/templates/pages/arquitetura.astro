---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Navigation from "@templates-pages/arquitetura/components/Navigation.astro";
import Hero from "@templates-pages/arquitetura/components/Hero.astro";
import Manifesto from "@templates-pages/arquitetura/components/Manifesto.astro";
import Projects from "@templates-pages/arquitetura/components/Projects.astro";
import Services from "@templates-pages/arquitetura/components/Services.astro";
import Contact from "@templates-pages/arquitetura/components/Contact.astro";

const data: {
    name: string;
    description: string;
    theme: "light" | "dark";
    colors: {
        primary: string;
        secondary: string;
        background: string;
    };
} = {
    name: "Architectural Studio",
    description:
        "Design editorial e de alto padrão para arquitetura contemporânea.",
    theme: "light",
    colors: {
        primary: "#1c1c1c",
        secondary: "#8d8d8d",
        background: "#fdfdfb",
    },
};
---

<BaseLayout
    title={data.name}
    description={data.description}
    theme={data.theme}
    colors={data.colors}
>
    <!-- LUXURY EDITORIAL STYLE -->
    <div
        class="font-['Inter',,sans-serif] antialiased bg-[#fdfdfb] text-[#1c1c1c] selection:bg-[#1c1c1c] selection:text-white"
    >
        <Navigation />

        <main>
            <div class="scroll-smooth">
                <Hero />
                <Manifesto />
                <Projects />
                <Services />
                <Contact />
            </div>
        </main>

        <footer class="py-24 px-8 md:px-16 bg-white border-t border-zinc-100">
            <div class="max-w-[1600px] mx-auto">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-16 mb-24">
                    <div class="md:col-span-4">
                        <div class="text-2xl font-serif tracking-tighter mb-8">
                            Architectural Studio
                        </div>
                        <p
                            class="text-zinc-400 font-light leading-relaxed max-w-xs"
                        >
                            Moldando o silêncio e a luz em formas eternas.
                            Arquitetura de alto padrão para visões
                            extraordinárias.
                        </p>
                    </div>
                    <div class="md:col-span-2">
                        <h4
                            class="text-[10px] tracking-[0.3em] font-bold uppercase mb-8"
                        >
                            Explorar
                        </h4>
                        <ul class="space-y-4 text-sm font-medium">
                            <li>
                                <a
                                    href="#"
                                    class="hover:text-zinc-400 transition-colors"
                                    >Projetos</a
                                >
                            </li>
                            <li>
                                <a
                                    href="#"
                                    class="hover:text-zinc-400 transition-colors"
                                    >Manifesto</a
                                >
                            </li>
                            <li>
                                <a
                                    href="#"
                                    class="hover:text-zinc-400 transition-colors"
                                    >Escritório</a
                                >
                            </li>
                        </ul>
                    </div>
                    <div class="md:col-span-2">
                        <h4
                            class="text-[10px] tracking-[0.3em] font-bold uppercase mb-8"
                        >
                            Social
                        </h4>
                        <ul class="space-y-4 text-sm font-medium">
                            <li>
                                <a
                                    href="#"
                                    class="hover:text-zinc-400 transition-colors"
                                    >Instagram</a
                                >
                            </li>
                            <li>
                                <a
                                    href="#"
                                    class="hover:text-zinc-400 transition-colors"
                                    >LinkedIn</a
                                >
                            </li>
                            <li>
                                <a
                                    href="#"
                                    class="hover:text-zinc-400 transition-colors"
                                    >Pinterest</a
                                >
                            </li>
                        </ul>
                    </div>
                    <div class="md:col-span-4 lg:text-right">
                        <h4
                            class="text-[10px] tracking-[0.3em] font-bold uppercase mb-8"
                        >
                            Contato
                        </h4>
                        <p
                            class="text-xl font-light mb-4 group cursor-pointer inline-block"
                        >
                            ola@estudioarquitetura.com
                            <span
                                class="block h-px bg-current w-0 group-hover:w-full transition-all duration-500"
                            ></span>
                        </p>
                        <p class="text-zinc-400">+55 11 98765-4321</p>
                    </div>
                </div>
                <div
                    class="flex flex-col md:flex-row justify-between items-center gap-8 pt-12 border-t border-zinc-100"
                >
                    <div
                        class="text-[10px] tracking-widest text-zinc-400 uppercase font-medium"
                    >
                        © 2026 Architectural Studio — Todos os direitos
                        reservados
                    </div>
                    <div
                        class="text-[10px] tracking-widest text-zinc-400 uppercase font-medium group cursor-pointer"
                    >
                        Sniper Pages
                    </div>
                </div>
            </div>
        </footer>
    </div>
</BaseLayout>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap");

    :global(h1, h2, h3, h4, .font-serif) {
        font-family: "Playfair Display", serif;
    }

    :global(body) {
        font-family: "Inter", sans-serif;
    }

    :global(.luxury-mask) {
        mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
    }
</style>
