---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Navbar from "@templates-pages/vetpragas/components/Navbar.astro";
import Hero from "@templates-pages/vetpragas/components/Hero.astro";
import Services from "@templates-pages/vetpragas/components/Services.astro";
import Process from "@templates-pages/vetpragas/components/Process.astro";
import About from "@templates-pages/vetpragas/components/About.astro";
import Comparison from "@templates-pages/vetpragas/components/Comparison.astro";
import Pricing from "@templates-pages/vetpragas/components/Pricing.astro";
import Guarantees from "@templates-pages/vetpragas/components/Guarantees.astro";
import Results from "@templates-pages/vetpragas/components/Results.astro";
import VideoTestimonial from "@templates-pages/vetpragas/components/VideoTestimonial.astro";
import Testimonials from "@templates-pages/vetpragas/components/Testimonials.astro";
import Coverage from "@templates-pages/vetpragas/components/Coverage.astro";
import Faq from "@templates-pages/vetpragas/components/Faq.astro";
import FinalCta from "@templates-pages/vetpragas/components/FinalCta.astro";
import Footer from "@templates-pages/vetpragas/components/Footer.astro";
import FloatingWhatsapp from "@templates-pages/vetpragas/components/FloatingWhatsapp.astro";

const data = {
    name: "VetPragas Bio-Defense",
    description:
        "Controle profissional de pragas com supervisão veterinária em Cascavel e região",
};
---

<BaseLayout title={data.name} description={data.description}>
    <div
        class="min-h-screen selection:bg-emerald-100 selection:text-emerald-900 overflow-x-hidden bg-black"
    >
        <Navbar />

        <main>
            <Hero />
            <Services />
            <Process />
            <About />
            <Comparison />
            <Pricing />
            <Guarantees />
            <Results />
            <VideoTestimonial />
            <Testimonials />
            <Coverage />
            <Faq />
            <FinalCta />
        </main>

        <Footer />
        <FloatingWhatsapp />
    </div>
</BaseLayout>

<style is:global>
    @import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Plus+Jakarta+Sans:wght@300;400;600;700;800;900&display=swap");

    html {
        scroll-behavior: smooth;
        background-color: #000;
    }

    body {
        font-family: "Plus Jakarta Sans", sans-serif;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    .font-mono {
        font-family: "JetBrains Mono", monospace;
    }
</style>
