---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Navigation from "@templates-pages/inteligencia/components/Navigation.astro";
import Hero from "@templates-pages/inteligencia/components/Hero.astro";
import Ticker from "@templates-pages/inteligencia/components/Ticker.astro";
import Paradigm from "@templates-pages/inteligencia/components/Paradigm.astro";
import Methodology from "@templates-pages/inteligencia/components/Methodology.astro";
import Ecosystem from "@templates-pages/inteligencia/components/Ecosystem.astro";
import Process from "@templates-pages/inteligencia/components/Process.astro";
import Results from "@templates-pages/inteligencia/components/Results.astro";
import ContactCTA from "@templates-pages/inteligencia/components/ContactCTA.astro";
import Footer from "@templates-pages/inteligencia/components/Footer.astro";

const data: {
    name: string;
    description: string;
    theme: "light" | "dark";
    colors: {
        primary: string;
        secondary: string;
        background: string;
    };
} = {
    name: "DataIA Hub",
    description: "Painel de inteligência de dados com foco em IA.",
    theme: "dark",
    colors: {
        primary: "#a855f7",
        secondary: "#c084fc",
        background: "#000000",
    },
};
---

<BaseLayout
    title={data.name}
    description={data.description}
    theme={data.theme}
    colors={data.colors}
>
    <div
        class="bg-black min-h-screen text-slate-100 selection:bg-[#FF5500] selection:text-black font-sans antialiased"
    >
        <Navigation />

        <main>
            <Hero />
            <Ticker />
            <Paradigm />
            <Methodology />
            <Ecosystem />
            <Process />
            <Results />
            <ContactCTA />
        </main>

        <Footer />
    </div>
</BaseLayout>

<style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@700;800&family=JetBrains+Mono:wght@400;700&display=swap");

    :root {
        --color-primary: #ff5500;
    }

    html {
        scroll-behavior: smooth;
        background-color: #000;
    }

    body {
        font-family: "Inter", sans-serif;
    }

    h1,
    h2,
    h3,
    .font-display {
        font-family: "Plus Jakarta Sans", sans-serif;
    }

    .font-mono {
        font-family: "JetBrains Mono", monospace;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
        width: 10px;
    }
    ::-webkit-scrollbar-track {
        background: #000;
    }
    ::-webkit-scrollbar-thumb {
        background: #1a1a1a;
        border: 2px solid #000;
        border-radius: 10px;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: #ff5500;
    }

    /* Utilities */
    .orange-glow {
        box-shadow: 0 0 50px rgba(255, 85, 0, 0.1);
    }

    .text-stroke {
        -webkit-text-stroke: 1px rgba(255, 255, 255, 0.1);
        color: transparent;
    }
</style>
