---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Navbar from "@templates-pages/imoveis-luxo/components/Navbar.astro";
import Hero from "@templates-pages/imoveis-luxo/components/Hero.astro";
import Portfolio from "@templates-pages/imoveis-luxo/components/Portfolio.astro";
import Concierge from "@templates-pages/imoveis-luxo/components/Concierge.astro";
import FAQ from "@templates-pages/imoveis-luxo/components/FAQ.astro";
import CTA from "@templates-pages/imoveis-luxo/components/CTA.astro";
import Footer from "@templates-pages/imoveis-luxo/components/Footer.astro";
---

<BaseLayout
    title="Luxury Real Estate | Curadoria de Imóveis de Elite"
    description="As propriedades mais exclusivas do mundo em um único portfólio. Mansões, coberturas e refúgios particulares para investidores exigentes."
    image="/images/templates/imoveis-luxo.png"
>
    <main
        class="bg-[#050505] text-zinc-300 font-sans selection:bg-[#f1e7d0] selection:text-black"
    >
        <Navbar />
        <Hero />
        <Portfolio />
        <Concierge />
        <FAQ />
        <CTA />
        <Footer />
    </main>
</BaseLayout>

<style is:global>
    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
    .animate-fade-in {
        animation: fadeIn 2s ease-out forwards;
    }
</style>
