---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Navigation from "@templates-pages/barbearia/components/Navigation.astro";
import Hero from "@templates-pages/barbearia/components/Hero.astro";
import Services from "@templates-pages/barbearia/components/Services.astro";
import Gallery from "@templates-pages/barbearia/components/Gallery.astro";
import Team from "@templates-pages/barbearia/components/Team.astro";
import Booking from "@templates-pages/barbearia/components/Booking.astro";
import Footer from "@templates-pages/barbearia/components/Footer.astro";
const data: {
    name: string;
    description: string;
    theme: "dark" | "light";
    colors: {
        primary: string;
        secondary: string;
        background: string;
    };
} = {
    name: "Gentleman Barber",
    description: "Estilo clássico e sofisticado para negócios premium.",
    theme: "dark",
    colors: {
        primary: "#d97706",
        secondary: "#fbbf24",
        background: "#0a0a0a",
    },
};
---

<BaseLayout
    title={data.name}
    description={data.description}
    theme={data.theme}
    colors={data.colors}
>
    <div
        class="font-sans antialiased text-zinc-100 bg-[#0a0a0a] selection:bg-amber-600 selection:text-white overflow-x-hidden"
    >
        <Navigation />

        <main>
            <Hero />
            <Services />
            <Gallery />
            <Team />
            <Booking />
        </main>

        <Footer />
    </div>

    <style is:global>
        /* Fontes Específicas para Barbearia */
        @import url("https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@400;700&display=swap");

        :root {
            --font-serif: "Playfair Display", serif;
            --font-mono: "JetBrains Mono", monospace;
        }

        .font-serif {
            font-family: var(--font-serif);
        }
        .font-mono {
            font-family: var(--font-mono);
        }
    </style>
</BaseLayout>
