---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Navbar from "@templates-pages/gastronomia/components/Navbar.astro";
import Hero from "@templates-pages/gastronomia/components/Hero.astro";
import Filosofia from "@templates-pages/gastronomia/components/Filosofia.astro";
import Ritual from "@templates-pages/gastronomia/components/Ritual.astro";
import Menu from "@templates-pages/gastronomia/components/Menu.astro";
import Adega from "@templates-pages/gastronomia/components/Adega.astro";
import FAQ from "@templates-pages/gastronomia/components/FAQ.astro";
import CTA from "@templates-pages/gastronomia/components/CTA.astro";
import Footer from "@templates-pages/gastronomia/components/Footer.astro";
---

<BaseLayout
    title="Fine Dining | L'Art de la Gastronomie"
    description="Sinfonia de sabores, texturas e exclusividade. Uma experiência gastronômica autoral que redefine o luxo contemporâneo."
    image="/images/templates/gastronomia.png"
>
    <main
        class="bg-black text-zinc-200 font-serif selection:bg-[#d4af37] selection:text-black"
    >
        <Navbar />
        <Hero />
        <Filosofia />
        <Ritual />
        <Menu />
        <Adega />
        <FAQ />
        <CTA />
        <Footer />
    </main>
</BaseLayout>

<style is:global>
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(100px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in {
        animation: fadeInUp 1.2s ease-out forwards;
        opacity: 0;
    }
    .animate-slide-up {
        animation: slideUp 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }
    .delay-500 {
        animation-delay: 0.5s;
    }
</style>
