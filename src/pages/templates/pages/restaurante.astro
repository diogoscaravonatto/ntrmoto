---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
const metadata = {
    name: "Aura Gastronomia | Alta Cozinha",
    description:
        "Uma experiência sensorial única que combina tradição e vanguarda na culinária contemporânea.",
};
import Navigation from "@templates-pages/restaurante/components/Navigation.astro";
import Hero from "@templates-pages/restaurante/components/Hero.astro";
import BentoMenu from "@templates-pages/restaurante/components/BentoMenu.astro";
import Reservas from "@templates-pages/restaurante/components/Reservas.astro";
const layoutColors = {
    primary: "#ea580c",
    secondary: "#f97316",
    background: "#000000",
};
---

<BaseLayout
    title={metadata.name}
    description={metadata.description}
    theme="dark"
    colors={layoutColors}
>
    <div
        class="bg-black text-white selection:bg-orange-600 font-['Outfit',,sans-serif]"
    >
        <Navigation />
        <main>
            <Hero />
            <BentoMenu />
            <Reservas />
        </main>
        <footer class="py-20 text-center border-t border-white/5 bg-zinc-950">
            <div
                class="text-4xl font-black italic mb-10 text-orange-600 uppercase"
            >
                AURA
            </div>
            <p
                class="text-[10px] text-zinc-700 font-black uppercase tracking-[0.6em] mb-10"
            >
                THE FUTURE OF TASTE
            </p>
            <div
                class="flex justify-center gap-10 text-zinc-500 font-bold uppercase text-[10px] tracking-widest leading-loose"
            >
                <span>RUA DOS GOURMETS, 1024<br />SÃO PAULO - SP</span>
                <span>TER - DOM<br />19:00 - 00:00</span>
            </div>
        </footer>
    </div>
</BaseLayout>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Outfit:wght@100;400;700;900&display=swap");
</style>
