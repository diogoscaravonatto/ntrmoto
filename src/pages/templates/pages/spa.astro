---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Navbar from "@templates-pages/spa/components/Navbar.astro";
import Hero from "@templates-pages/spa/components/Hero.astro";
import Dores from "@templates-pages/spa/components/Dores.astro";
import Galeria from "@templates-pages/spa/components/Galeria.astro";
import Metodologia from "@templates-pages/spa/components/Metodologia.astro";
import Equipe from "@templates-pages/spa/components/Equipe.astro";
import FAQ from "@templates-pages/spa/components/FAQ.astro";
import CTA from "@templates-pages/spa/components/CTA.astro";
import Footer from "@templates-pages/spa/components/Footer.astro";
---

<BaseLayout
    title="Aura Wellness | Santuário de Reequilíbrio"
    description="Uma jornada sensorial de autocuidado e serenidade. Terapias holísticas e tratamentos premium para sua mente e corpo."
    image="/images/templates/spa.png"
    theme="light"
>
    <main
        class="bg-[#faf7f5] text-[#4a3f35] font-sans selection:bg-[#e2a5a5] selection:text-white overflow-hidden"
    >
        <!-- DECORATIVE BLOBS -->
        <div class="fixed inset-0 pointer-events-none z-0">
            <div
                class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:40px_40px]"
            >
            </div>
            <div
                class="absolute bottom-[-10%] left-[-10%] w-[40%] h-[50%] bg-[#e2d5c3] rounded-[100%] blur-[100px] opacity-40"
            >
            </div>
        </div>

        <Navbar />
        <Hero />
        <Dores />
        <Galeria />
        <Metodologia />
        <Equipe />
        <FAQ />
        <CTA />
        <Footer />
    </main>
</BaseLayout>

<style is:global>
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(100px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in {
        animation: fadeInUp 1.2s ease-out forwards;
        opacity: 0;
    }
    .animate-slide-up {
        animation: slideUp 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
    }
    .delay-300 {
        animation-delay: 0.3s;
    }
    .delay-500 {
        animation-delay: 0.5s;
    }
</style>
