---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
const metadata = {
    name: "AI Mastery | O Guia Definitivo",
    description:
        "Domine as ferramentas de inteligência artificial que estão mudando o mercado de trabalho.",
};
import Hero from "@templates-pages/ebook/components/Hero.astro";
import Problem from "@templates-pages/ebook/components/Problem.astro";
import Modules from "@templates-pages/ebook/components/Modules.astro";
import Author from "@templates-pages/ebook/components/Author.astro";
import GuaranteeFAQ from "@templates-pages/ebook/components/GuaranteeFAQ.astro";
const layoutColors = {
    primary: "#10b981", // Emerald 500
    secondary: "#047857", // Emerald 700
    background: "#020403", // Deep Dark Green/Black
};
---

<BaseLayout
    title={metadata.name}
    description={metadata.description}
    theme="dark"
    colors={layoutColors}
>
    <div
        class="bg-[#0a0a0a] text-white font-['Outfit',,sans-serif] selection:bg-green-500 selection:text-black"
    >
        <!-- Minimal Navigation for CRO (Conversion Rate Optimization) -->
        <nav
            class="fixed top-0 left-0 w-full z-50 p-6 flex justify-between items-center backdrop-blur-md border-b border-white/5 bg-black/50"
        >
            <div class="text-xl font-black uppercase tracking-tighter">
                AI MASTERY
            </div>
            <button
                class="bg-green-500 text-black px-6 py-2 font-black uppercase text-xs rounded shadow-[0_0_15px_rgba(34,197,94,0.4)] hover:bg-green-400 transition-colors"
            >
                COMPRAR AGORA
            </button>
        </nav>

        <main>
            <Hero />
            <Problem />
            <Modules />
            <Author />
            <GuaranteeFAQ />
        </main>

        <footer
            class="py-12 text-center text-zinc-600 text-sm border-t border-white/5 bg-black"
        >
            <p>&copy; 2026 AI Mastery. Todos os direitos reservados.</p>
            <p class="mt-2 text-xs">
                Este produto não garante a obtenção de resultados. Qualquer
                referência ao desempenho de uma estratégia não deve ser
                interpretada como uma garantia de resultados.
            </p>
        </footer>
    </div>
</BaseLayout>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&display=swap");
</style>
