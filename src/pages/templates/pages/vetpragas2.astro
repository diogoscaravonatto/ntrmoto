---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Navbar from "@templates-pages/vetpragas2/components/Navbar.astro";
import Hero from "@templates-pages/vetpragas2/components/Hero.astro";
import Services from "@templates-pages/vetpragas2/components/Services.astro";
import Process from "@templates-pages/vetpragas2/components/Process.astro";
import About from "@templates-pages/vetpragas2/components/About.astro";
import Comparison from "@templates-pages/vetpragas2/components/Comparison.astro";
import Pricing from "@templates-pages/vetpragas2/components/Pricing.astro";
import Guarantees from "@templates-pages/vetpragas2/components/Guarantees.astro";

import VideoTestimonial from "@templates-pages/vetpragas2/components/VideoTestimonial.astro";
import Testimonials from "@templates-pages/vetpragas2/components/Testimonials.astro";

import Faq from "@templates-pages/vetpragas2/components/Faq.astro";
import FinalCta from "@templates-pages/vetpragas2/components/FinalCta.astro";
import Footer from "@templates-pages/vetpragas2/components/Footer.astro";
import FloatingWhatsapp from "@templates-pages/vetpragas2/components/FloatingWhatsapp.astro";

import Ticker from "@templates-pages/vetpragas2/components/Ticker.astro";

const data = {
    name: "VetPragas | Especialista em Controle de Pragas em Cascavel",
    description:
        "Referência em dedetização, sanitização e controle de pragas. Empresa dedetizadora especializada em indústrias, condomínios e restaurantes com supervisão veterinária e certificação ISO 9001.",
};
---

<BaseLayout title={data.name} description={data.description}>
    <div
        class="min-h-screen selection:bg-emerald-100 selection:text-emerald-900 overflow-x-hidden bg-white"
    >
        <Navbar />

        <main>
            <Hero />
            <Ticker />
            <Services />
            <Process />
            <About />
            <Comparison />
            <Pricing />
            <Guarantees />

            <VideoTestimonial />
            <Testimonials />

            <Faq />
            <FinalCta />
        </main>

        <Footer />
        <FloatingWhatsapp />
    </div>
</BaseLayout>

<style is:global>
    @import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Plus+Jakarta+Sans:wght@300;400;600;700;800;900&display=swap");

    html {
        scroll-behavior: smooth;
        background-color: #fff;
    }

    body {
        font-family: "Plus Jakarta Sans", sans-serif;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    .font-mono {
        font-family: "JetBrains Mono", monospace;
    }
</style>
