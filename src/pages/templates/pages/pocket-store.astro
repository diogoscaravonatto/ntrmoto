---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
const metadata = {
    name: "Pocket Store | Minimalist Fashion",
    description:
        "Essenciais para o seu guarda-roupa com design atemporal e qualidade premium.",
};
import Navigation from "@templates-pages/pocket-store/components/Navigation.astro";
import Hero from "@templates-pages/pocket-store/components/Hero.astro";
import Products from "@templates-pages/pocket-store/components/Products.astro";
import Features from "@templates-pages/pocket-store/components/Features.astro";
import Footer from "@templates-pages/pocket-store/components/Footer.astro";
const layoutColors = {
    primary: "#000000",
    secondary: "#333333",
    background: "#ffffff",
};
---

<BaseLayout
    title={metadata.name}
    description={metadata.description}
    theme="light"
    colors={layoutColors}
>
    <!-- GLOBAL STYLE MINIMALIST -->
    <div
        class="font-sans antialiased text-gray-900 bg-white selection:bg-black selection:text-white"
    >
        <Navigation />
        <main>
            <Hero />
            <Products />
            <Features />
        </main>
        <Footer />
    </div>
</BaseLayout>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap");

    :global(body) {
        font-family: "Inter", sans-serif;
    }
</style>
