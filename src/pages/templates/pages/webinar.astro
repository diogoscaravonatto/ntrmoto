---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@templates-pages/webinar/components/Header.astro";
import Hero from "@templates-pages/webinar/components/Hero.astro";
import Agenda from "@templates-pages/webinar/components/Agenda.astro";

const data: {
    name: string;
    description: string;
    theme: "light" | "dark";
    colors: {
        primary: string;
        secondary: string;
        background: string;
    };
} = {
    name: "Webinar Flow",
    description: "Landing page de alta conversão para eventos online.",
    theme: "dark",
    colors: {
        primary: "#ef4444",
        secondary: "#f87171",
        background: "#020202",
    },
};
---

<BaseLayout
    title={data.name}
    description={data.description}
    theme={data.theme}
    colors={data.colors}
>
    <main
        class="min-h-screen bg-[#020202] text-white font-sans selection:bg-red-600/30 overflow-x-hidden relative"
    >
        <!-- Red Noise & Glow (Template Specific) -->
        <div class="fixed inset-0 pointer-events-none">
            <!-- Noise -->
            <div
                class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-10 mix-blend-overlay"
            >
            </div>
            <!-- Glow -->
            <div
                class="absolute top-0 right-0 w-[800px] h-[800px] bg-red-600/10 blur-[150px] rounded-full mix-blend-screen animate-pulse-slow"
            >
            </div>
        </div>

        <Header />

        <div class="relative z-10 max-w-7xl mx-auto px-6 pt-32 pb-20">
            <Hero />
            <Agenda />
        </div>
    </main>
</BaseLayout>

<style is:global>
    .animate-pulse-slow {
        animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.7;
        }
    }
</style>
