---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@templates-pages/contabilidade/components/Header.astro";
import Hero from "@templates-pages/contabilidade/components/Hero.astro";
import Stats from "@templates-pages/contabilidade/components/Stats.astro";
import VideoSection from "@templates-pages/contabilidade/components/VideoSection.astro";
import ProfitFlow from "@templates-pages/contabilidade/components/ProfitFlow.astro";
import Comparison from "@templates-pages/contabilidade/components/Comparison.astro";
import BentoGrid from "@templates-pages/contabilidade/components/BentoGrid.astro";
import Testimonials from "@templates-pages/contabilidade/components/Testimonials.astro";
import Contact from "@templates-pages/contabilidade/components/Contact.astro";
import CTA from "@templates-pages/contabilidade/components/CTA.astro";
import Footer from "@templates-pages/contabilidade/components/Footer.astro";

const data: {
    name: string;
    description: string;
    theme: "light" | "dark";
    colors: {
        primary: string;
        secondary: string;
        background: string;
    };
} = {
    name: "LuxFinance",
    description: "Gestão estratégica e contabilidade corporativa.",
    theme: "light",
    colors: {
        primary: "#10b981",
        secondary: "#34d399",
        background: "#ffffff",
    },
};
---

<BaseLayout
    title={data.name}
    description={data.description}
    theme={data.theme}
    colors={data.colors}
>
    <div class="bg-white min-h-screen font-sans selection:bg-[#005a5c]/30">
        <Header />
        <main>
            <Hero />
            <Stats />
            <VideoSection />
            <ProfitFlow />
            <Comparison />
            <BentoGrid />
            <Testimonials />
            <Contact />
            <CTA />
        </main>
        <Footer />
    </div>
</BaseLayout>

<style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600;700;800&display=swap");

    body {
        font-family: "Manrope", sans-serif;
    }

    html {
        scroll-behavior: smooth;
    }

    /* Additional polish for the theme */
    .selection\:bg-\[\#005a5c\]\/30 ::selection {
        background-color: rgba(0, 90, 92, 0.3);
    }
</style>
