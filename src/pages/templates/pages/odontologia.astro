---
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@templates-pages/odontologia/components/Header.astro";
import Hero from "@templates-pages/odontologia/components/Hero.astro";
import Services from "@templates-pages/odontologia/components/Services.astro";
import ModernTech from "@templates-pages/odontologia/components/ModernTech.astro";
import BeforeAfter from "@templates-pages/odontologia/components/BeforeAfter.astro";
import Testimonials from "@templates-pages/odontologia/components/Testimonials.astro";
import Faq from "@templates-pages/odontologia/components/Faq.astro";
import Contact from "@templates-pages/odontologia/components/Contact.astro";
import CTA from "@templates-pages/odontologia/components/CTA.astro";
import FloatingWhatsapp from "@templates-pages/odontologia/components/FloatingWhatsapp.astro";
import Footer from "@templates-pages/odontologia/components/Footer.astro";
const data = {
    name: "Aura Dental",
    description: "Design premium focado em saúde e estética dental.",
    category: "Health",
    theme: "light",
    colors: {
        primary: "#4f46e5",
        secondary: "#818cf8",
    },
};
---

<BaseLayout title={data.name} description={data.description}>
    <div
        class="min-h-screen selection:bg-indigo-100 selection:text-indigo-900 overflow-x-hidden"
    >
        <Header />

        <main>
            <Hero />
            <Services />
            <ModernTech />
            <BeforeAfter />
            <Testimonials />
            <Faq />
            <Contact />
            <CTA />
            <FloatingWhatsapp />
        </main>

        <Footer />
    </div>
</BaseLayout>

<style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800;900&display=swap");

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: "Plus Jakarta Sans", sans-serif;
    }

    /* Custom Selection */
    ::selection {
        background-color: #4f46e5;
        color: white;
    }

    /* Scrollbar Styling */
    ::-webkit-scrollbar {
        width: 10px;
    }
    ::-webkit-scrollbar-track {
        background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 5px;
        border: 2px solid #f1f5f9;
    }
    ::-webkit-scrollbar-thumb:hover {
        background: #4f46e5;
    }
</style>
