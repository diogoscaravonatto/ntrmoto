---
import { SEO } from "astro-seo";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Explore nossa biblioteca de templates premium e componentes modulares.",
} = Astro.props;

const siteUrl = Astro.site
    ? Astro.site.href
    : "https://pages.sniper.escoladeaplicativos.com.br";
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <SEO
            title={title}
            titleTemplate="%s | Sniper Pages Gallery"
            description={description}
            canonical={Astro.url.href}
            openGraph={{
                basic: {
                    title: title,
                    type: "website",
                    image: `${siteUrl}/images/og-gallery.png`,
                    url: Astro.url.href,
                },
                optional: {
                    description: description,
                    siteName: "Sniper Pages - Template Gallery",
                },
            }}
            twitter={{
                card: "summary_large_image",
            }}
        />

        <!-- Fonts (Google Fonts - Async para evitar render-blocking) -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Montserrat:wght@400;500;600;700;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap"
            rel="stylesheet"
            media="print"
            onload="this.media='all'"
        />
        <noscript>
            <link
                href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=Montserrat:wght@400;500;600;700;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap"
                rel="stylesheet"
            />
        </noscript>

        <!-- Prevenir FOUC - Inicializar tema ANTES do render (APENAS para galeria) -->
        <script is:inline>
            (function () {
                // Ler do localStorage (sincronizado com nanostores)
                try {
                    const savedTheme = localStorage.getItem("theme");
                    const isDark = savedTheme ? savedTheme === "dark" : true;

                    // Aplicar classe imediatamente no HTML
                    const html = document.documentElement;
                    if (isDark) {
                        html.classList.add("dark");
                    } else {
                        html.classList.remove("dark");
                    }
                } catch {
                    // Fallback para dark mode se localStorage não estiver disponível
                    document.documentElement.classList.add("dark");
                }
            })();
        </script>
    </head>
    <body
        class="font-sans antialiased min-h-screen overflow-x-hidden transition-colors duration-500
               dark:bg-black dark:text-white dark:selection:bg-white dark:selection:text-black
               bg-gray-50 text-gray-900 selection:bg-black selection:text-white"
    >
        <!-- Overhead Grain Noise Overlay (dark mode + desktop only para performance) -->
        <div
            class="hidden md:dark:block fixed inset-0 pointer-events-none z-100 opacity-[0.015] contrast-125 brightness-100 mix-blend-overlay"
        >
            <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                <filter id="noise">
                    <feTurbulence
                        type="fractalNoise"
                        baseFrequency="0.65"
                        numOctaves="3"
                        stitchTiles="stitch"></feTurbulence>
                </filter>
                <rect width="100%" height="100%" filter="url(#noise)"></rect>
            </svg>
        </div>

        <slot />

        <style is:global>
            /* Custom Scrollbar - Premium Feel (apenas para galeria) */
            ::-webkit-scrollbar {
                width: 6px;
            }
            ::-webkit-scrollbar-track {
                background: transparent;
            }
            .dark ::-webkit-scrollbar-track {
                background: #000;
            }
            ::-webkit-scrollbar-thumb {
                background: #999;
            }
            .dark ::-webkit-scrollbar-thumb {
                background: #333;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #666;
            }
            .dark ::-webkit-scrollbar-thumb:hover {
                background: #555;
            }
        </style>
    </body>
</html>
