---
import { Image } from "astro:assets";
import testimonialThumb from "@assets/images/hero-v2.jpg";
import { vetPragasData } from "./content";
---

<section class="py-24 bg-white relative">
    <div class="container mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-center max-w-6xl mx-auto">
            <!-- Video Frame Column -->
            <div class="relative group">
                <div
                    class="relative aspect-video bg-slate-100 rounded-[2.5rem] overflow-hidden border-8 border-white shadow-[0_40px_100px_rgba(0,0,0,0.1)] transition-transform duration-500 group-hover:scale-[1.02]"
                >
                    {/* Placeholder for Video */}
                    <div
                        class="absolute inset-0 flex items-center justify-center bg-slate-50"
                    >
                        <div class="relative">
                            <div
                                class="w-24 h-24 bg-emerald-600 rounded-full flex items-center justify-center text-white shadow-2xl hover:scale-110 transition-transform cursor-pointer"
                            >
                                <svg
                                    class="w-10 h-10 ml-1"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path d="M8 5v14l11-7z"></path></svg
                                >
                            </div>
                        </div>
                    </div>

                    <Image
                        src={testimonialThumb}
                        alt="Depoimento em vídeo de cliente satisfeito"
                        class="absolute inset-0 w-full h-full object-cover opacity-20 pointer-events-none"
                        loading="lazy"
                    />
                </div>

                <!-- Floating Badge -->
                <div
                    class="absolute -bottom-6 -right-6 bg-white p-6 rounded-3xl shadow-2xl flex items-center gap-4"
                >
                    <div class="flex -space-x-4">
                        {
                            [1, 2, 3].map((i) => (
                                <div class="w-10 h-10 rounded-full border-2 border-white bg-slate-100 flex items-center justify-center text-[10px] font-bold text-slate-400">
                                    U{i}
                                </div>
                            ))
                        }
                    </div>
                    <div
                        class="text-xs font-black text-slate-900 uppercase tracking-widest"
                    >
                        +5.000 Reviews
                    </div>
                </div>
            </div>

            <!-- Content Column -->
            <div>
                <div
                    class="inline-block p-2 bg-emerald-50 rounded-lg mb-6 tracking-[0.3em] font-mono text-[10px] uppercase text-emerald-600 font-bold"
                >
                    Depoimento em Vídeo
                </div>
                <h2
                    class="text-4xl lg:text-5xl font-black text-slate-900 mb-8 uppercase tracking-tighter"
                >
                    {vetPragasData.videoTestimonial.title}
                </h2>

                <blockquote
                    class="text-2xl text-slate-600 italic leading-relaxed mb-10 font-medium"
                >
                    "{vetPragasData.videoTestimonial.video.quote}"
                </blockquote>

                <div class="flex items-center gap-6 mb-12">
                    <div
                        class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center text-emerald-600 font-black text-3xl"
                    >
                        {vetPragasData.videoTestimonial.video.client.charAt(0)}
                    </div>
                    <div>
                        <div
                            class="text-xl font-black text-slate-900 uppercase tracking-tight"
                        >
                            {vetPragasData.videoTestimonial.video.client}
                        </div>
                        <div
                            class="text-emerald-600 text-xs font-bold uppercase tracking-widest"
                        >
                            {vetPragasData.videoTestimonial.video.location}
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-6">
                    {
                        vetPragasData.videoTestimonial.stats.map((stat) => (
                            <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 group hover:border-emerald-500/30 transition-all">
                                <div class="text-2xl font-black text-slate-900 group-hover:text-emerald-600 transition-colors">
                                    {stat.value}
                                </div>
                                <div class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">
                                    {stat.label}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>
