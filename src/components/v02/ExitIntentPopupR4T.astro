---
---

<div
  id="exit-intent-popup-r4t"
  class="fixed inset-0 z-[9999] hidden items-center justify-center p-4"
>
  {/* Backdrop */}
  <div class="absolute inset-0 bg-black/90 backdrop-blur-sm" id="popup-backdrop-r4t"></div>

  {/* Content Card */}
  <div
    class="relative w-full max-w-lg scale-90 transform rounded-[40px] border-2 border-brand-red bg-[#0a0a0a] p-8 text-center opacity-0 shadow-[0_0_100px_rgba(255,51,51,0.2)] transition-all duration-300 md:p-12"
    id="popup-card-r4t"
  >
    <div class="mb-8">
      <div class="mb-6 inline-block animate-pulse rounded-full bg-brand-red px-4 py-1 text-[10px] font-black tracking-widest text-white uppercase md:text-xs">
        Aviso de Desconto
      </div>

      <h2 class="mb-6 text-3xl leading-tight font-black tracking-tighter uppercase italic md:text-5xl">
        <span class="text-brand-red">ÚLTIMOS CUPONS</span>&nbsp;
        <span class="text-[#FFD700]">DE DESCONTO DISPONÍVEIS</span>
      </h2>

      <p class="text-lg leading-tight font-medium text-gray-300 md:text-xl">
        Se você sair agora, perderá o cupom de{" "}
        <span class="font-bold text-white">50% de Desconto</span>. Na próxima vez que você abrir
        essa página, o valor pode ser maior.
      </p>
    </div>

    <div class="space-y-6">
      <a
        href="#oferta"
        id="popup-cta-r4t"
        class="animate-shake inline-block w-full transform rounded-2xl bg-[#65A30D] px-8 py-6 text-xl font-black tracking-tighter text-white uppercase italic shadow-[0_10px_30px_rgba(101,163,13,0.3)] transition-all hover:-translate-y-1 hover:bg-[#4d7c0f] md:text-2xl"
      >
        QUERO MEU DESCONTO
      </a>

      <p class="text-sm font-bold text-gray-500 italic">
        Clique para garantir o desconto de 50% antes que acabe
      </p>
    </div>
  </div>
</div>

<style>
  @keyframes shake {
    0%,
    100% {
      transform: translateX(0) rotate(-1deg);
    }
    25% {
      transform: translateX(-1px) rotate(1deg);
    }
    75% {
      transform: translateX(1px) rotate(-1deg);
    }
  }
  .animate-shake {
    animation: shake 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) infinite;
  }
</style>

<script is:inline>
  function initExitIntentR4T() {
    const popup = document.getElementById("exit-intent-popup-r4t");
    const card = document.getElementById("popup-card-r4t");
    const backdrop = document.getElementById("popup-backdrop-r4t");
    const ctaBtn = document.getElementById("popup-cta-r4t");

    let popupShown = false;

    if (sessionStorage.getItem("r4t_exit_popup_shown")) {
      return;
    }

    function showPopup() {
      if (popupShown) return;
      popupShown = true;
      sessionStorage.setItem("r4t_exit_popup_shown", "true");

      popup.classList.remove("hidden");
      popup.classList.add("flex");

      setTimeout(() => {
        card.classList.remove("scale-90", "opacity-0");
        card.classList.add("scale-100", "opacity-100");
      }, 10);
    }

    function hidePopup() {
      card.classList.add("scale-90", "opacity-0");
      card.classList.remove("scale-100", "opacity-100");
      setTimeout(() => {
        popup.classList.add("hidden");
        popup.classList.remove("flex");
      }, 300);
    }

    // Gatilhos ativados apenas após 5 segundos para evitar disparos falsos no load
    setTimeout(() => {
      // Desktop
      document.addEventListener("mouseleave", (e) => {
        if (e.clientY <= 0) {
          showPopup();
        }
      });

      // Mobile
      history.pushState(null, null, window.location.href);
      window.addEventListener("popstate", () => {
        // Ignora se o usuário está apenas navegando para uma seção na página (ex: clicou em um botão #oferta)
        if (window.location.hash) return;

        if (!popupShown) {
          showPopup();
          history.pushState(null, null, window.location.href);
        }
      });

      // Timer 60s (ajustado para 55s extras pois já passaram 5s)
      setTimeout(() => {
        showPopup();
      }, 55000);
    }, 5000);

    // Fechar
    backdrop.addEventListener("click", hidePopup);
    ctaBtn.addEventListener("click", hidePopup);
  }

  document.addEventListener("DOMContentLoaded", initExitIntentR4T);
</script>
