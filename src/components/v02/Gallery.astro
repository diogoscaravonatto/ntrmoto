---
import { Image } from 'astro:assets';
import imgTreino1 from '../../assets/images/imagem_r4t_01.webp';
import imgTreino2 from '../../assets/images/imagem_r4t_02.webp';
import imgTreino3 from '../../assets/images/imagem_r4t_03.webp';
import imgTreino4 from '../../assets/images/imagem_r4t_04.webp';
import imgTreino5 from '../../assets/images/imagem_r4t_05.webp';
import imgTreino6 from '../../assets/images/imagem_r4t_06.webp';
import imgTreino7 from '../../assets/images/imagem_r4t_07.webp';
import imgTreino8 from '../../assets/images/imagem_r4t_08.webp';
import imgDino1 from '../../assets/images/teste_dinamometro_r4t_opt.webp';
import imgDino2 from '../../assets/images/grafico_dinamometro_32cv_opt.webp';

const row1 = [imgTreino1, imgTreino2, imgTreino3, imgTreino4, imgTreino5];
const row2 = [imgTreino6, imgTreino7, imgTreino8, imgDino1, imgDino2];
---

<section class="py-24 bg-[#F9F9F9]">
  <div class="w-full text-center mb-10 relative z-10 px-4 flex flex-col items-center">
    <h3 class="text-xl md:text-2xl font-black text-black tracking-wider mb-4">
      Confira imagens reais do treinamento:
    </h3>
    <div class="flex flex-col items-center gap-2">
      <p class="text-5xl md:text-7xl font-black text-[#FF3333] uppercase tracking-tighter text-center">
        100% PRÁTICA
      </p>
      <span class="text-2xl md:text-4xl font-black text-black uppercase tracking-wider text-center">
        ZERO% TEORIA FURADA
      </span>
    </div>
  </div>

  <div class="w-full space-y-4 relative bg-[#1A1A1A] py-8 border-y border-gray-200 overflow-hidden">
    {/* Sombras laterais adaptadas para fundo claro */}
    <div class="absolute top-0 left-0 w-16 md:w-40 h-full bg-gradient-to-r from-[#F9F9F9] via-[#F9F9F9]/20 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute top-0 right-0 w-16 md:w-40 h-full bg-gradient-to-l from-[#F9F9F9] via-[#F9F9F9]/20 to-transparent z-10 pointer-events-none"></div>

    {/* Linha 1: Normal */}
    <div class="flex group overflow-hidden">
      <div class="flex shrink-0 animate-marquee group-hover:[animation-play-state:paused]">
        {[...row1, ...row1].map((img) => (
          <div class="w-64 md:w-80 bg-[#1A1A1A] shrink-0 flex flex-col border-l border-r border-gray-800 px-2 py-2 hover:bg-[#222] transition-colors">
            <div class="flex justify-between px-2 mb-3">
              {Array.from({ length: 6 }).map(() => <div class="w-3 h-4 bg-black rounded-[2px]"></div>)}
            </div>
            <div class="w-full h-44 md:h-56 overflow-hidden rounded-sm bg-black flex items-center justify-center">
              <Image src={img} alt="Cena do Treinamento Rei do 4Trinho" class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity" />
            </div>
            <div class="flex justify-between px-2 mt-3">
              {Array.from({ length: 6 }).map(() => <div class="w-3 h-4 bg-black rounded-[2px]"></div>)}
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Linha 2: Reverso */}
    <div class="flex group overflow-hidden">
      <div class="flex shrink-0 animate-marquee-reverse group-hover:[animation-play-state:paused]">
        {[...row2, ...row2].map((img) => (
          <div class="w-64 md:w-80 bg-[#1A1A1A] shrink-0 flex flex-col border-l border-r border-gray-800 px-2 py-2 hover:bg-[#222] transition-colors">
            <div class="flex justify-between px-2 mb-3">
              {Array.from({ length: 6 }).map(() => <div class="w-3 h-4 bg-black rounded-[2px]"></div>)}
            </div>
            
            <div class="w-full h-44 md:h-56 overflow-hidden rounded-sm bg-black flex flex-col items-center justify-center relative">
              {img === imgDino2 ? (
                <>
                  <span class="absolute top-2 text-[10px] md:text-xs font-bold text-white tracking-wider z-10 bg-black/60 px-2 rounded">Potência real (na roda)</span>
                  <Image src={img} alt="Gráfico de Potência" class="w-full h-full object-contain opacity-90 hover:opacity-100 transition-opacity" />
                  <span class="absolute bottom-2 text-[10px] md:text-xs font-bold text-brand-red tracking-wider z-10 bg-black/60 px-2 rounded">Muita força de alta até o corte</span>
                </>
              ) : (
                <Image src={img} alt="Cena do Treinamento Rei do 4Trinho" class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity" />
              )}
            </div>

            <div class="flex justify-between px-2 mt-3">
              {Array.from({ length: 6 }).map(() => <div class="w-3 h-4 bg-black rounded-[2px]"></div>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  {/* CTA Button - Padrão Hero */}
  <div class="mt-16 w-full max-w-xl mx-auto px-4 text-center">
    <a 
      href="#oferta" 
      class="relative overflow-hidden block w-full py-5 px-6 bg-brand-red hover:bg-brand-red-dark text-white text-xl md:text-2xl font-black rounded-lg shadow-[0_0_30px_rgba(255,51,51,0.4)] hover:shadow-[0_0_50px_rgba(255,51,51,0.6)] transition-all transform hover:-translate-y-1 uppercase tracking-wider group"
    >
      <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/30 to-transparent -translate-x-full animate-shine"></div>
      <span class="relative z-10">QUERO TER ACESSO AGORA</span>
    </a>
    <p class="mt-4 text-sm text-gray-500 flex items-center justify-center gap-2">
      <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
      Acesso imediato e seguro
    </p>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @keyframes marquee-reverse {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }
  .animate-marquee {
    animation: marquee 40s linear infinite;
  }
  .animate-marquee-reverse {
    animation: marquee-reverse 40s linear infinite;
  }
  @keyframes shine {
    0% { transform: translateX(-100%); }
    20% { transform: translateX(100%); }
    100% { transform: translateX(100%); }
  }
  .animate-shine {
    animation: shine 3s infinite;
  }
</style>
