---
import { Image } from 'astro:assets';
import imgDinamometro from '../../assets/images/teste_dinamometro_r4t.png';
import imgVelocidade from '../../assets/images/grafico_dinamometro_32cv.png';
import print1 from '../../assets/images/Prints/depoimento_ntr_1.png';
import print2 from '../../assets/images/Prints/depoimento_ntr_2.png';
import print3 from '../../assets/images/Prints/depoimento_ntr_3.png';
---

<section id="prova" class="py-24 px-4 bg-brand-black">
  <div class="max-w-4xl mx-auto reveal-up">
    {/* Prints dos Alunos */}
    <div class="mt-24">
      <div class="text-center mb-10">
        <span class="text-brand-red font-bold uppercase tracking-widest text-sm block mb-4">Contra fatos não há argumentos</span>
        <h3 class="text-2xl md:text-4xl font-black text-white">Veja o resultado de alunos:</h3>
        <p class="text-gray-400 mt-3 text-lg">A prova real de quem já copiou o projeto e aplicou na moto.</p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {/* Print 1 */}
        <div class="bg-[#0d0d0d] rounded-[2rem] overflow-hidden border-4 border-gray-800 shadow-2xl aspect-[9/16] flex items-center justify-center relative">
           <Image src={print1} alt="Depoimento de aluno 1" class="w-full h-full object-cover" />
        </div>
        
        {/* Print 2 */}
        <div class="bg-[#0d0d0d] rounded-[2rem] overflow-hidden border-4 border-gray-800 shadow-2xl aspect-[9/16] flex items-center justify-center relative">
           <Image src={print2} alt="Depoimento de aluno 2" class="w-full h-full object-cover" />
        </div>

        {/* Print 3 */}
        <div class="bg-[#0d0d0d] rounded-[2rem] overflow-hidden border-4 border-gray-800 shadow-2xl aspect-[9/16] flex items-center justify-center relative">
           <Image src={print3} alt="Depoimento de aluno 3" class="w-full h-full object-cover" />
        </div>
      </div>

      {/* CTA Button após depoimentos */}
      <div class="mt-16 w-full max-w-md mx-auto text-center">
        <a href="#oferta" class="relative overflow-hidden block w-full py-5 px-6 bg-brand-red hover:bg-brand-red-dark text-white text-xl md:text-2xl font-black rounded-lg shadow-[0_0_30px_rgba(255,51,51,0.4)] hover:shadow-[0_0_50px_rgba(255,51,51,0.6)] transition-all transform hover:-translate-y-1 uppercase tracking-wider group">
          {/* Efeito de Brilho Correndo */}
          <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/30 to-transparent -translate-x-full animate-shine"></div>
          
          <span class="relative z-10">QUERO TER ACESSO AGORA</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes shine {
    0% { transform: translateX(-100%); }
    20% { transform: translateX(100%); }
    100% { transform: translateX(100%); }
  }
  .animate-shine {
    animation: shine 3s infinite;
  }
</style>
