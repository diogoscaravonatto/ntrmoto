---
import { Image } from "astro:assets";
import imgDinamometro from "../assets/images/teste_dinamometro_r4t.png";
import imgVelocidade from "../assets/images/grafico_dinamometro_32cv.png";
import print1 from "../assets/images/Prints/depoimento_ntr_1.png";
import print2 from "../assets/images/Prints/depoimento_ntr_2.png";
import print3 from "../assets/images/Prints/depoimento_ntr_3.png";
---

<section id="prova" class="bg-brand-black px-4 py-24">
  <div class="reveal-up mx-auto max-w-4xl">
    <div class="mb-12 text-center">
      <span class="text-sm font-bold tracking-widest text-brand-red uppercase">
        Contra fatos não há argumentos
      </span>
      <h2 class="mt-3 mb-6 text-3xl font-black text-white md:text-5xl">
        Projeto Testado e Validado
      </h2>
      <p class="mx-auto max-w-2xl text-lg text-gray-400">
        Não vendemos ilusão. A configuração exata que você vai aprender na prática rendeu 32cv na
        roda e fez a moto passar dos 200km/h
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {/* Proof 1: Dinamômetro */}
      <div class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 shadow-2xl">
        <div class="absolute inset-0 bg-brand-red/5 transition-colors group-hover:bg-brand-red/10"></div>
        <h3 class="mb-4 flex items-center gap-2 text-xl font-bold text-gray-900">
          <svg class="h-6 w-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
            ></path>
          </svg>
          Teste no Dinamômetro
        </h3>
        <div class="relative flex aspect-video items-center justify-center overflow-hidden rounded-lg border border-gray-300 bg-white">
          <Image
            src={imgDinamometro}
            alt="Gráfico de Teste no Dinamômetro"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute right-4 bottom-4 z-10 rounded bg-brand-red px-3 py-1 text-lg font-black text-white shadow-lg">
            32.6 cv
          </div>
        </div>
        <p class="mt-4 text-center text-sm font-medium text-gray-600">
          Potência suficiente para passar dos 200km/h de reta.
        </p>
      </div>

      {/* Proof 2: GPS/Velocímetro */}
      <div class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 shadow-2xl">
        <div class="absolute inset-0 bg-brand-red/5 transition-colors group-hover:bg-brand-red/10"></div>
        <h3 class="mb-4 flex items-center gap-2 text-xl font-bold text-gray-900">
          <svg class="h-6 w-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
          Potência real (na roda)
        </h3>
        <div class="relative flex aspect-video items-center justify-center overflow-hidden rounded-lg border border-gray-300 bg-white">
          <Image
            src={imgVelocidade}
            alt="Comprovação de Potência"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute right-4 bottom-4 z-10 rounded bg-brand-red px-3 py-1 font-black text-white shadow-lg">
            Motor de alta gira muito
          </div>
        </div>
        <p class="mt-4 text-center text-sm font-medium text-gray-600">
          Curva de potência linear. Muita força de alta até o corte.
        </p>
      </div>
    </div>

    {/* Prints dos Alunos */}
    <div class="mt-24">
      <div class="mb-10 text-center">
        <h3 class="text-2xl font-black text-white md:text-4xl">Veja o resultado da galera:</h3>
        <p class="mt-3 text-lg text-gray-400">
          A prova real de quem já copiou o projeto e aplicou na moto.
        </p>
      </div>

      <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
        {/* Print 1 */}
        <div class="relative flex aspect-[9/16] items-center justify-center overflow-hidden rounded-[2rem] border-4 border-gray-800 bg-[#0d0d0d] shadow-2xl">
          <Image src={print1} alt="Depoimento de aluno 1" class="h-full w-full object-cover" />
        </div>

        {/* Print 2 */}
        <div class="relative flex aspect-[9/16] items-center justify-center overflow-hidden rounded-[2rem] border-4 border-gray-800 bg-[#0d0d0d] shadow-2xl">
          <Image src={print2} alt="Depoimento de aluno 2" class="h-full w-full object-cover" />
        </div>

        {/* Print 3 */}
        <div class="relative flex aspect-[9/16] items-center justify-center overflow-hidden rounded-[2rem] border-4 border-gray-800 bg-[#0d0d0d] shadow-2xl">
          <Image src={print3} alt="Depoimento de aluno 3" class="h-full w-full object-cover" />
        </div>
      </div>

      {/* CTA Button após depoimentos */}
      <div class="mx-auto mt-16 w-full max-w-md text-center">
        <a
          href="#oferta"
          class="block w-full transform rounded-lg bg-brand-red px-6 py-5 text-xl font-black tracking-wider text-white uppercase shadow-[0_0_20px_rgba(255,51,51,0.3)] transition-all hover:-translate-y-1 hover:bg-brand-red-dark hover:shadow-[0_0_30px_rgba(255,51,51,0.5)] md:text-xl"
        >
          SIM, QUERO ANDAR NA FRENTE
        </a>
      </div>
    </div>
  </div>
</section>
