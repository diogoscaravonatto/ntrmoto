---
import { Image } from "astro:assets";
import imgTreino1 from "../assets/images/imagem_r4t_01.webp";
import imgTreino2 from "../assets/images/imagem_r4t_02.webp";
import imgTreino3 from "../assets/images/imagem_r4t_03.webp";
import imgTreino4 from "../assets/images/imagem_r4t_04.webp";
import imgTreino5 from "../assets/images/imagem_r4t_05.webp";
import imgTreino6 from "../assets/images/imagem_r4t_06.webp";
import imgTreino7 from "../assets/images/imagem_r4t_07.webp";
import imgTreino8 from "../assets/images/imagem_r4t_08.webp";

const carouselImages = [
  imgTreino1,
  imgTreino2,
  imgTreino3,
  imgTreino4,
  imgTreino5,
  imgTreino6,
  imgTreino7,
  imgTreino8,
];
---

<section class="bg-[#F9F9F9] py-24">
  <div class="relative z-10 mb-10 flex w-full flex-col items-center px-4 text-center">
    <h3 class="mb-4 text-xl font-black tracking-wider text-black md:text-2xl">
      Confira imagens reais do treinamento:
    </h3>
    <div class="flex flex-col items-center gap-2">
      <p class="text-5xl font-black tracking-tighter text-[#FF3333] uppercase md:text-7xl">
        100% PRÁTICA
      </p>
      <span class="text-2xl font-black tracking-wider text-black uppercase md:text-4xl">
        ZERO% TEORIA FURADA
      </span>
    </div>
  </div>

  <div class="relative w-full overflow-hidden border-y border-gray-200 bg-[#1A1A1A] py-4">
    {/* Sombras laterais adaptadas para fundo claro */}
    <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-16 bg-gradient-to-r from-[#F9F9F9] to-transparent md:w-32"></div>
    <div class="pointer-events-none absolute top-0 right-0 z-10 h-full w-16 bg-gradient-to-l from-[#F9F9F9] to-transparent md:w-32"></div>

    <div class="group flex">
      {/* Grupo 1 */}
      <div class="flex shrink-0 animate-marquee group-hover:[animation-play-state:paused]">
        {carouselImages.map((img) => (
          <div class="flex w-64 shrink-0 flex-col border-r border-l border-gray-800 bg-[#1A1A1A] px-2 py-2 transition-colors hover:bg-[#222] md:w-80">
            {/* Furos Superiores da Película */}
            <div class="mb-3 flex justify-between px-2">
              {Array.from({ length: 6 }).map(() => (
                <div class="h-4 w-3 rounded-[2px] bg-black"></div>
              ))}
            </div>
            {/* Imagem */}
            <div class="h-44 w-full overflow-hidden rounded-sm opacity-90 transition-opacity hover:opacity-100 md:h-56">
              <Image
                src={img}
                alt="Cena do Treinamento Rei do 4Trinho"
                class="h-full w-full object-cover"
              />
            </div>
            {/* Furos Inferiores da Película */}
            <div class="mt-3 flex justify-between px-2">
              {Array.from({ length: 6 }).map(() => (
                <div class="h-4 w-3 rounded-[2px] bg-black"></div>
              ))}
            </div>
          </div>
        ))}
      </div>
      {/* Grupo 2 (Duplicado para efeito infinito) */}
      <div
        class="flex shrink-0 animate-marquee group-hover:[animation-play-state:paused]"
        aria-hidden="true"
      >
        {carouselImages.map((img) => (
          <div class="flex w-64 shrink-0 flex-col border-r border-l border-gray-800 bg-[#1A1A1A] px-2 py-2 transition-colors hover:bg-[#222] md:w-80">
            <div class="mb-3 flex justify-between px-2">
              {Array.from({ length: 6 }).map(() => (
                <div class="h-4 w-3 rounded-[2px] bg-black"></div>
              ))}
            </div>
            <div class="h-44 w-full overflow-hidden rounded-sm opacity-90 transition-opacity hover:opacity-100 md:h-56">
              <Image
                src={img}
                alt="Cena do Treinamento Rei do 4Trinho"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="mt-3 flex justify-between px-2">
              {Array.from({ length: 6 }).map(() => (
                <div class="h-4 w-3 rounded-[2px] bg-black"></div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  {/* CTA Button - Padrão Hero */}
  <div class="mx-auto mt-16 w-full max-w-xl px-4 text-center">
    <a
      href="#oferta"
      class="block w-full transform rounded-lg bg-brand-red px-6 py-5 text-xl font-black tracking-wider text-white uppercase shadow-[0_0_20px_rgba(255,51,51,0.3)] transition-all hover:-translate-y-1 hover:bg-brand-red-dark hover:shadow-[0_0_30px_rgba(255,51,51,0.5)] md:text-2xl"
    >
      QUERO COPIAR ESSE PROJETO
    </a>
    <p class="mt-4 flex items-center justify-center gap-2 text-sm text-gray-500">
      <svg class="h-4 w-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
        ></path>
      </svg>
      Acesso imediato e seguro
    </p>
  </div>
</section>
