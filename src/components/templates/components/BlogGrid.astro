---
export const prerender = true;
// Blog Card Grid - Estilo Editorial Moderno
---

<section class="py-24 px-6 bg-gray-50">
    <div class="max-w-7xl mx-auto">
        <h2 class="text-4xl font-bold text-gray-900 mb-12">Últimas Notícias</h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Card 1 -->
            <article
                class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow"
            >
                <div
                    class="aspect-video bg-linear-to-br from-blue-400 to-indigo-600"
                >
                </div>
                <div class="p-6">
                    <span
                        class="text-xs font-semibold text-blue-600 uppercase tracking-wide"
                        >Tecnologia</span
                    >
                    <h3 class="text-xl font-bold text-gray-900 mt-2 mb-3">
                        O Futuro da IA em 2026
                    </h3>
                    <p class="text-gray-600 mb-4">
                        Descubra as principais tendências que vão moldar o
                        próximo ano.
                    </p>
                    <a
                        href="/blog/ia-2026"
                        class="text-blue-600 font-semibold hover:text-blue-700"
                        >Ler mais →</a
                    >
                </div>
            </article>

            <!-- Card 2 -->
            <article
                class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow"
            >
                <div
                    class="aspect-video bg-linear-to-br from-purple-400 to-pink-600"
                >
                </div>
                <div class="p-6">
                    <span
                        class="text-xs font-semibold text-purple-600 uppercase tracking-wide"
                        >Design</span
                    >
                    <h3 class="text-xl font-bold text-gray-900 mt-2 mb-3">
                        Tendências de UI/UX
                    </h3>
                    <p class="text-gray-600 mb-4">
                        Conheça os padrões que estão dominando o mercado.
                    </p>
                    <a
                        href="/blog/tendencias-ui-ux"
                        class="text-purple-600 font-semibold hover:text-purple-700"
                        >Ler mais →</a
                    >
                </div>
            </article>

            <!-- Card 3 -->
            <article
                class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow"
            >
                <div
                    class="aspect-video bg-linear-to-br from-emerald-400 to-teal-600"
                >
                </div>
                <div class="p-6">
                    <span
                        class="text-xs font-semibold text-emerald-600 uppercase tracking-wide"
                        >Negócios</span
                    >
                    <h3 class="text-xl font-bold text-gray-900 mt-2 mb-3">
                        Estratégias de Growth
                    </h3>
                    <p class="text-gray-600 mb-4">
                        Como escalar sua startup de forma sustentável.
                    </p>
                    <a
                        href="/blog/estrategias-growth"
                        class="text-emerald-600 font-semibold hover:text-emerald-700"
                        >Ler mais →</a
                    >
                </div>
            </article>
        </div>
    </div>
</section>
