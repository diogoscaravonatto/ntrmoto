---
export const prerender = true;
/**
 * COMPONENTE: BentoGridPremium
 * O QUE É: Layout de grid assimétrico moderno para exibição de recursos ou benefícios.
 * ONDE USAR: Seção de funcionalidades principal de sites tech, apps ou serviços premium.
 * COMO USAR: Use para agrupar informações de diferentes pesos visuais em um único bloco.
 */
interface Props {
    title?: string;
    subtitle?: string;
}

const {
    title = "Tecnologia de Ponta em Cada Detalhe",
    subtitle = "Não apenas um site, uma máquina de vendas otimizada.",
} = Astro.props;
---

<section class="py-24 px-6 bg-zinc-950">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-16">
            <h2
                class="text-4xl md:text-6xl font-black uppercase tracking-tighter mb-4 text-white max-w-2xl"
            >
                {title}
            </h2>
            <p class="text-zinc-500 text-lg max-w-xl">
                {subtitle}
            </p>
        </div>

        <!-- Bento Grid -->
        <div
            class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-6 h-auto md:h-[600px]"
        >
            <!-- Large Card -->
            <div
                class="md:col-span-2 md:row-span-2 bg-zinc-900/50 border border-zinc-800 rounded-[32px] p-8 md:p-12 relative overflow-hidden group hover:border-violet-500/30 transition-all"
            >
                <div class="relative z-10 h-full flex flex-col justify-between">
                    <div>
                        <div
                            class="size-16 bg-violet-600/10 text-violet-500 rounded-2xl flex items-center justify-center mb-8"
                        >
                            <svg
                                class="size-8"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                            >
                        </div>
                        <h3
                            class="text-3xl font-black text-white mb-4 tracking-tight"
                        >
                            Performance<br />Ultra-Sônica
                        </h3>
                        <p class="text-zinc-500 leading-relaxed max-w-xs">
                            Sites que carregam em menos de 1 segundo. Mais
                            velocidade significa menos abandono e mais lucro.
                        </p>
                    </div>
                    <div class="mt-8">
                        <div class="text-5xl font-black text-white">99/100</div>
                        <div
                            class="text-zinc-600 text-xs font-bold uppercase tracking-widest mt-2"
                        >
                            PageSpeed Score
                        </div>
                    </div>
                </div>
                <!-- Decorative Element -->
                <div
                    class="absolute -bottom-20 -right-20 size-80 bg-violet-600/10 blur-[80px] rounded-full group-hover:bg-violet-600/20 transition-all"
                >
                </div>
            </div>

            <!-- Middle Top -->
            <div
                class="md:col-span-2 bg-zinc-900/50 border border-zinc-800 rounded-[32px] p-8 relative overflow-hidden group hover:border-pink-500/30 transition-all"
            >
                <div
                    class="relative z-10 flex flex-col md:flex-row items-center gap-8"
                >
                    <div class="flex-1">
                        <h3 class="text-xl font-bold text-white mb-2">
                            Design Editorial
                        </h3>
                        <p class="text-zinc-500 text-sm leading-relaxed">
                            Layouts que respiram exclusividade e capturam a
                            atenção de clientes de alto padrão.
                        </p>
                    </div>
                    <div class="flex gap-2">
                        <div
                            class="size-10 bg-zinc-800 rounded-lg flex items-center justify-center text-white font-bold"
                        >
                            Aa
                        </div>
                        <div
                            class="size-10 bg-linear-to-br from-pink-500 to-violet-500 rounded-lg"
                        >
                        </div>
                        <div
                            class="size-10 bg-zinc-700/50 rounded-lg border border-zinc-700"
                        >
                        </div>
                    </div>
                </div>
            </div>

            <!-- Middle Bottom Left -->
            <div
                class="bg-zinc-900/50 border border-zinc-800 rounded-[32px] p-8 group hover:border-cyan-500/30 transition-all flex flex-col justify-between"
            >
                <div
                    class="size-10 bg-cyan-500/10 text-cyan-500 rounded-lg flex items-center justify-center mb-6"
                >
                    <svg
                        class="size-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                        ></path></svg
                    >
                </div>
                <div>
                    <h3 class="text-lg font-bold text-white mb-1">
                        Mobile-First
                    </h3>
                    <p class="text-zinc-600 text-xs">
                        Ajustes precisos para cada pixel em qualquer tela.
                    </p>
                </div>
            </div>

            <!-- Middle Bottom Right -->
            <div
                class="bg-zinc-900/50 border border-zinc-800 rounded-[32px] p-8 group hover:border-emerald-500/30 transition-all flex flex-col justify-between overflow-hidden relative"
            >
                <div
                    class="size-10 bg-emerald-500/10 text-emerald-500 rounded-lg flex items-center justify-center mb-6"
                >
                    <svg
                        class="size-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"
                        ></path></svg
                    >
                </div>
                <div>
                    <h3 class="text-lg font-bold text-white mb-1">
                        WhatsApp Hub
                    </h3>
                    <p class="text-zinc-600 text-xs">
                        Atendimento direto integrado com métricas.
                    </p>
                </div>
                <!-- Small Decoration -->
                <div
                    class="absolute -right-4 -bottom-4 size-20 bg-emerald-500/5 blur-2xl"
                >
                </div>
            </div>
        </div>
    </div>
</section>
