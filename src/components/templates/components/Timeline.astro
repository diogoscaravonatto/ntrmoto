---
export const prerender = true;
// Timeline - Estilo Corporativo
---

<section class="py-24 px-6 bg-white">
    <div class="max-w-5xl mx-auto">
        <h2 class="text-4xl font-bold text-gray-900 text-center mb-16">
            Nossa Jornada
        </h2>

        <div class="relative">
            <!-- Vertical Line -->
            <div
                class="absolute left-1/2 transform -translate-x-1/2 w-0.5 h-full bg-gray-200"
            >
            </div>

            <!-- Timeline Items -->
            <div class="space-y-12">
                <!-- Item 1 -->
                <div class="relative flex items-center">
                    <div class="flex-1 text-right pr-8">
                        <h3 class="text-2xl font-bold text-gray-900 mb-2">
                            2020
                        </h3>
                        <p class="text-gray-600">
                            Fundação da empresa com uma visão clara de inovação.
                        </p>
                    </div>
                    <div
                        class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-blue-600 rounded-full border-4 border-white shadow"
                    >
                    </div>
                    <div class="flex-1 pl-8"></div>
                </div>

                <!-- Item 2 -->
                <div class="relative flex items-center">
                    <div class="flex-1 pr-8"></div>
                    <div
                        class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-purple-600 rounded-full border-4 border-white shadow"
                    >
                    </div>
                    <div class="flex-1 pl-8">
                        <h3 class="text-2xl font-bold text-gray-900 mb-2">
                            2021
                        </h3>
                        <p class="text-gray-600">
                            Lançamento do primeiro produto e 1000 clientes.
                        </p>
                    </div>
                </div>

                <!-- Item 3 -->
                <div class="relative flex items-center">
                    <div class="flex-1 text-right pr-8">
                        <h3 class="text-2xl font-bold text-gray-900 mb-2">
                            2023
                        </h3>
                        <p class="text-gray-600">
                            Expansão internacional e rodada de investimento
                            Série A.
                        </p>
                    </div>
                    <div
                        class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-pink-600 rounded-full border-4 border-white shadow"
                    >
                    </div>
                    <div class="flex-1 pl-8"></div>
                </div>

                <!-- Item 4 -->
                <div class="relative flex items-center">
                    <div class="flex-1 pr-8"></div>
                    <div
                        class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-emerald-600 rounded-full border-4 border-white shadow"
                    >
                    </div>
                    <div class="flex-1 pl-8">
                        <h3 class="text-2xl font-bold text-gray-900 mb-2">
                            2026
                        </h3>
                        <p class="text-gray-600">
                            Líder de mercado com 50K+ clientes em 150 países.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
