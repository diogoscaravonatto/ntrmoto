---
export const prerender = true;
// Elegant Product Showcase - Estilo Luxo/Premium
---

<section class="py-32 px-6 bg-slate-900">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <!-- Image Side -->
            <div class="relative">
                <div
                    class="aspect-square bg-gradient-to-br from-amber-200 via-amber-400 to-amber-600 rounded-3xl shadow-2xl"
                >
                </div>
                <div
                    class="absolute -bottom-6 -right-6 w-64 h-64 bg-gradient-to-br from-rose-400 to-pink-600 rounded-3xl opacity-50 blur-2xl"
                >
                </div>
            </div>

            <!-- Content Side -->
            <div>
                <div
                    class="inline-block px-4 py-1 bg-amber-500/10 border border-amber-500/30 rounded-full text-amber-400 text-sm font-medium mb-6"
                >
                    EDIÇÃO LIMITADA
                </div>

                <h2
                    class="text-5xl md:text-6xl font-serif text-white mb-6 leading-tight"
                >
                    Elegância
                    <span class="block text-amber-400">Atemporal</span>
                </h2>

                <p class="text-lg text-slate-400 mb-8 leading-relaxed">
                    Descubra a perfeição em cada detalhe. Criado para aqueles
                    que apreciam o requinte e a sofisticação em sua forma mais
                    pura.
                </p>

                <div class="flex items-center gap-8 mb-10">
                    <div>
                        <p class="text-slate-500 text-sm mb-1">A partir de</p>
                        <p class="text-4xl font-bold text-white">R$ 2.499</p>
                    </div>
                    <div class="h-12 w-px bg-slate-700"></div>
                    <div>
                        <p class="text-slate-500 text-sm mb-1">Avaliação</p>
                        <div class="flex gap-1">
                            {
                                [...Array(5)].map(() => (
                                    <svg
                                        class="w-5 h-5 text-amber-400"
                                        fill="currentColor"
                                        viewBox="0 0 20 20"
                                    >
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                    </svg>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <div class="flex gap-4">
                    <button
                        class="px-8 py-4 bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold rounded-xl transition-colors"
                    >
                        Comprar Agora
                    </button>
                    <button
                        class="px-8 py-4 border-2 border-slate-700 hover:border-amber-500 text-white font-bold rounded-xl transition-colors"
                    >
                        Ver Detalhes
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>
