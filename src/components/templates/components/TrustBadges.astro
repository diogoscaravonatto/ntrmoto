---
export const prerender = true;
/**
 * COMPONENTE: TrustBadges
 * O QUE É: Selos de confiança, segurança e garantia (SSL, Devolução, Suporte).
 * ONDE USAR: No rodapé ou logo abaixo de botões de compra para aumentar a credibilidade.
 * COMO USAR: Componente estático simples. Pode ser alterado diretamente no código se precisar de novos ícones.
 */
interface Props {
    title?: string;
}

const { title = "Sua segurança é nossa prioridade" } = Astro.props;
---

<div class="py-12 px-6 flex flex-col items-center">
    {
        title && (
            <p class="text-zinc-500 text-xs font-bold uppercase tracking-widest mb-8">
                {title}
            </p>
        )
    }

    <div
        class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500"
    >
        <!-- SSL -->
        <div class="flex items-center gap-3">
            <svg
                class="size-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                ></path>
            </svg>
            <div class="flex flex-col">
                <span
                    class="text-white text-[10px] font-black leading-none uppercase"
                    >SSL Secure</span
                >
                <span class="text-zinc-500 text-[8px] uppercase"
                    >Encriptado</span
                >
            </div>
        </div>

        <!-- Satisfaction -->
        <div class="flex items-center gap-3">
            <svg
                class="size-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div class="flex flex-col">
                <span
                    class="text-white text-[10px] font-black leading-none uppercase"
                    >Garantia 100%</span
                >
                <span class="text-zinc-500 text-[8px] uppercase"
                    >Satisfação</span
                >
            </div>
        </div>

        <!-- Support -->
        <div class="flex items-center gap-3">
            <svg
                class="size-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"
                ></path>
            </svg>
            <div class="flex flex-col">
                <span
                    class="text-white text-[10px] font-black leading-none uppercase"
                    >Suporte 24/7</span
                >
                <span class="text-zinc-500 text-[8px] uppercase"
                    >Especializado</span
                >
            </div>
        </div>

        <!-- Fast Delivery -->
        <div class="flex items-center gap-3">
            <svg
                class="size-8 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <div class="flex flex-col">
                <span
                    class="text-white text-[10px] font-black leading-none uppercase"
                    >Entrega Rápida</span
                >
                <span class="text-zinc-500 text-[8px] uppercase"
                    >Alta Performance</span
                >
            </div>
        </div>
    </div>
</div>
