---
export const prerender = true;
// Stats section com números impactantes
---

<section class="py-24 px-6 bg-zinc-900 border-y border-zinc-800">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
            <!-- Stat 1 -->
            <div class="text-center">
                <div
                    class="text-5xl md:text-6xl font-black bg-linear-to-b from-violet-400 to-violet-600 bg-clip-text text-transparent mb-2"
                >
                    50K+
                </div>
                <p class="text-zinc-500 font-medium">Usuários Ativos</p>
            </div>

            <!-- Stat 2 -->
            <div class="text-center">
                <div
                    class="text-5xl md:text-6xl font-black bg-linear-to-b from-pink-400 to-pink-600 bg-clip-text text-transparent mb-2"
                >
                    99.9%
                </div>
                <p class="text-zinc-500 font-medium">Uptime</p>
            </div>

            <!-- Stat 3 -->
            <div class="text-center">
                <div
                    class="text-5xl md:text-6xl font-black bg-linear-to-b from-cyan-400 to-cyan-600 bg-clip-text text-transparent mb-2"
                >
                    24/7
                </div>
                <p class="text-zinc-500 font-medium">Suporte</p>
            </div>

            <!-- Stat 4 -->
            <div class="text-center">
                <div
                    class="text-5xl md:text-6xl font-black bg-linear-to-b from-emerald-400 to-emerald-600 bg-clip-text text-transparent mb-2"
                >
                    150+
                </div>
                <p class="text-zinc-500 font-medium">Países</p>
            </div>
        </div>
    </div>
</section>
