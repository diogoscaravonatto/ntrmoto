---
export const prerender = true;
// Pricing cards com destaque para plano popular
---

<section class="py-24 px-6 bg-zinc-950">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-16">
            <h2
                class="text-5xl md:text-6xl font-black uppercase tracking-tighter mb-4 bg-linear-to-b from-white to-zinc-600 bg-clip-text text-transparent"
            >
                Planos Simples
            </h2>
            <p class="text-zinc-500 text-lg">
                Escolha o plano perfeito para você
            </p>
        </div>

        <!-- Pricing Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
            <!-- Starter -->
            <div
                class="relative p-8 bg-zinc-900/50 border border-zinc-800 rounded-2xl hover:border-zinc-700 transition-all"
            >
                <h3 class="text-2xl font-bold text-white mb-2">Starter</h3>
                <p class="text-zinc-500 mb-6">Para começar</p>
                <div class="mb-8">
                    <span class="text-5xl font-black text-white">$19</span>
                    <span class="text-zinc-500">/mês</span>
                </div>
                <ul class="space-y-4 mb-8">
                    <li class="flex items-center gap-3 text-zinc-300">
                        <svg
                            class="size-5 text-violet-500"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        5 Projetos
                    </li>
                    <li class="flex items-center gap-3 text-zinc-300">
                        <svg
                            class="size-5 text-violet-500"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        10GB Storage
                    </li>
                    <li class="flex items-center gap-3 text-zinc-300">
                        <svg
                            class="size-5 text-violet-500"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        Suporte Email
                    </li>
                </ul>
                <button
                    class="w-full py-3 bg-white/5 hover:bg-white/10 text-white font-bold rounded-xl border border-white/10 transition-all"
                >
                    Começar
                </button>
            </div>

            <!-- Pro (Popular) -->
            <div
                class="relative p-8 bg-linear-to-b from-violet-600/20 to-zinc-900/50 border-2 border-violet-500 rounded-2xl scale-105 shadow-[0_0_50px_rgba(139,92,246,0.3)]"
            >
                <div
                    class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 bg-violet-500 text-white text-sm font-bold rounded-full"
                >
                    POPULAR
                </div>
                <h3 class="text-2xl font-bold text-white mb-2">Pro</h3>
                <p class="text-zinc-400 mb-6">Para profissionais</p>
                <div class="mb-8">
                    <span class="text-5xl font-black text-white">$49</span>
                    <span class="text-zinc-400">/mês</span>
                </div>
                <ul class="space-y-4 mb-8">
                    <li class="flex items-center gap-3 text-white">
                        <svg
                            class="size-5 text-violet-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        Projetos Ilimitados
                    </li>
                    <li class="flex items-center gap-3 text-white">
                        <svg
                            class="size-5 text-violet-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        100GB Storage
                    </li>
                    <li class="flex items-center gap-3 text-white">
                        <svg
                            class="size-5 text-violet-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        Suporte Prioritário
                    </li>
                    <li class="flex items-center gap-3 text-white">
                        <svg
                            class="size-5 text-violet-400"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        Analytics Avançado
                    </li>
                </ul>
                <button
                    class="w-full py-3 bg-violet-600 hover:bg-violet-500 text-white font-bold rounded-xl transition-all hover:shadow-[0_0_30px_rgba(139,92,246,0.5)]"
                >
                    Começar Agora
                </button>
            </div>

            <!-- Enterprise -->
            <div
                class="relative p-8 bg-zinc-900/50 border border-zinc-800 rounded-2xl hover:border-zinc-700 transition-all"
            >
                <h3 class="text-2xl font-bold text-white mb-2">Enterprise</h3>
                <p class="text-zinc-500 mb-6">Para empresas</p>
                <div class="mb-8">
                    <span class="text-5xl font-black text-white">$99</span>
                    <span class="text-zinc-500">/mês</span>
                </div>
                <ul class="space-y-4 mb-8">
                    <li class="flex items-center gap-3 text-zinc-300">
                        <svg
                            class="size-5 text-violet-500"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        Tudo do Pro
                    </li>
                    <li class="flex items-center gap-3 text-zinc-300">
                        <svg
                            class="size-5 text-violet-500"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        Storage Ilimitado
                    </li>
                    <li class="flex items-center gap-3 text-zinc-300">
                        <svg
                            class="size-5 text-violet-500"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        Suporte 24/7
                    </li>
                    <li class="flex items-center gap-3 text-zinc-300">
                        <svg
                            class="size-5 text-violet-500"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        SLA Garantido
                    </li>
                </ul>
                <button
                    class="w-full py-3 bg-white/5 hover:bg-white/10 text-white font-bold rounded-xl border border-white/10 transition-all"
                >
                    Falar com Vendas
                </button>
            </div>
        </div>
    </div>
</section>
