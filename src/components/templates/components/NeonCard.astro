---
export const prerender = true;

---

<!-- Neon Card com efeito de brilho e reflexo -->
<div
    class="group relative w-full max-w-sm rounded-xl bg-zinc-900 p-0.5 transition-all hover:shadow-[0_0_40px_-10px_rgba(124,58,237,0.5)]"
>
    <!-- Border Gradient Animado -->
    <div
        class="absolute inset-0 rounded-xl bg-gradient-to-r from-violet-600 via-pink-600 to-violet-600 opacity-60 blur-sm transition-all duration-500 group-hover:opacity-100 animate-border-spin"
    >
    </div>
    <div
        class="absolute inset-0 rounded-xl bg-gradient-to-r from-violet-600 via-pink-600 to-violet-600 opacity-0 transition-opacity duration-500 group-hover:opacity-30"
    >
    </div>

    <!-- Conteúdo -->
    <div
        class="relative flex h-full flex-col justify-between rounded-[10px] bg-zinc-950 p-6"
    >
        <div>
            <div
                class="mb-4 inline-flex items-center justify-center rounded-lg bg-violet-500/10 p-3 text-violet-500"
            >
                <slot name="icon">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="lucide lucide-zap"
                        ><polygon
                            points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
                        ></polygon></svg
                    >
                </slot>
            </div>
            <h3 class="mb-2 text-xl font-bold text-white">
                <slot name="title">Neon Card</slot>
            </h3>
            <p class="text-zinc-400">
                <slot name="description"
                    >Hover me to see the magic glow effect tailored for dark
                    mode interfaces.</slot
                >
            </p>
        </div>
        <button
            class="mt-6 w-full rounded-lg bg-white/5 py-2 text-sm font-medium text-white transition-colors hover:bg-white/10"
        >
            Action
        </button>
    </div>
</div>

<style>
    @keyframes border-spin {
        0% {
            filter: hue-rotate(0deg);
        }
        100% {
            filter: hue-rotate(360deg);
        }
    }
    .animate-border-spin {
        animation: border-spin 4s linear infinite;
    }
</style>
