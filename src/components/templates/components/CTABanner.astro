---
export const prerender = true;
// CTA Banner com gradiente e animação
---

<section class="py-24 px-6 bg-zinc-950 relative overflow-hidden">
    <!-- Animated Background -->
    <div
        class="absolute inset-0 bg-linear-to-r from-violet-600/20 via-pink-600/20 to-cyan-600/20"
    >
    </div>
    <div
        class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-50"
    >
    </div>

    <div class="max-w-5xl mx-auto text-center relative z-10">
        <!-- Badge -->
        <div
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-sm mb-8"
        >
            <span class="text-white text-sm font-bold">🚀 Oferta Limitada</span>
        </div>

        <!-- Title -->
        <h2
            class="text-5xl md:text-7xl font-black uppercase tracking-tighter mb-6 text-white"
        >
            Pronto para Começar?
        </h2>

        <!-- Subtitle -->
        <p class="text-xl md:text-2xl text-zinc-300 mb-12 max-w-3xl mx-auto">
            Junte-se a milhares de empresas que já transformaram seus negócios.
            Comece grátis hoje.
        </p>

        <!-- CTA -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <button
                class="group relative px-10 py-5 bg-white text-zinc-950 font-black text-lg rounded-xl transition-all hover:scale-105 hover:shadow-[0_0_40px_rgba(255,255,255,0.3)]"
            >
                Começar Gratuitamente
                <span
                    class="absolute inset-0 rounded-xl bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity"
                ></span>
            </button>
            <button
                class="px-10 py-5 bg-white/10 hover:bg-white/20 text-white font-bold text-lg rounded-xl border border-white/20 backdrop-blur-sm transition-all"
            >
                Agendar Demo
            </button>
        </div>

        <!-- Trust Badges -->
        <div
            class="mt-12 flex flex-wrap items-center justify-center gap-8 text-zinc-500 text-sm"
        >
            <div class="flex items-center gap-2">
                <svg
                    class="size-5 text-green-500"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"></path>
                </svg>
                Sem cartão de crédito
            </div>
            <div class="flex items-center gap-2">
                <svg
                    class="size-5 text-green-500"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"></path>
                </svg>
                Cancele quando quiser
            </div>
            <div class="flex items-center gap-2">
                <svg
                    class="size-5 text-green-500"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"></path>
                </svg>
                Setup em 5 minutos
            </div>
        </div>
    </div>
</section>
