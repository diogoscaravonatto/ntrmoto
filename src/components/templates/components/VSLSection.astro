---
export const prerender = true;
/**
 * COMPONENTE: VSLSection
 * O QUE É: Seção dedicada para Vídeo de Vendas (Video Sales Letter).
 * ONDE USAR: Peça central de funis de infoprodutos ou serviços de alto valor.
 * COMO USAR: Insira o link do YouTube/Vimeo e o CTA principal logo abaixo do vídeo.
 */
interface Props {
    title?: string;
    subtitle?: string;
    videoUrl?: string; // YouTube/Vimeo embed URL or direct video
    thumbnail?: string;
    ctaText?: string;
    ctaLink?: string;
}

const {
    title = "Assista o Vídeo e Descubra Como Escalar seu Negócio",
    subtitle = "Em menos de 5 minutos, você verá por que 90% dos empresários estão perdendo dinheiro na internet.",
    videoUrl = "https://www.youtube.com/embed/dQw4w9WgXcQ", // Exemplo
    ctaText = "Quero Aplicar essa Estratégia",
    ctaLink = "#contact",
} = Astro.props;
---

<section
    class="py-24 px-6 bg-zinc-900 border-y border-zinc-800 relative overflow-hidden"
>
    <!-- Gradient Blobs -->
    <div
        class="absolute top-0 right-0 size-96 bg-violet-600/5 blur-[100px] rounded-full translate-x-1/2 -translate-y-1/2"
    >
    </div>
    <div
        class="absolute bottom-0 left-0 size-96 bg-pink-600/5 blur-[100px] rounded-full -translate-x-1/2 translate-y-1/2"
    >
    </div>

    <div class="max-w-5xl mx-auto relative">
        <!-- Header -->
        <div class="text-center mb-16 px-4">
            <h2
                class="text-3xl md:text-5xl font-black uppercase tracking-tighter mb-4 text-white"
            >
                {title}
            </h2>
            <p class="text-zinc-500 text-lg max-w-2xl mx-auto">
                {subtitle}
            </p>
        </div>

        <!-- Video Player Wrapper -->
        <div class="relative group">
            <!-- Overglow effect -->
            <div
                class="absolute -inset-1 bg-linear-to-r from-violet-600 to-pink-600 rounded-[32px] blur opacity-25 group-hover:opacity-40 transition-all duration-500 shadow-2xl"
            >
            </div>

            <div
                class="relative aspect-video bg-zinc-950 border border-zinc-800 rounded-[32px] overflow-hidden shadow-2xl"
            >
                {
                    videoUrl.includes("embed") ? (
                        <iframe
                            src={videoUrl}
                            class="w-full h-full"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                        />
                    ) : (
                        <video
                            src={videoUrl}
                            controls
                            class="w-full h-full object-cover"
                            poster={Astro.props.thumbnail}
                        />
                    )
                }
            </div>
        </div>

        <!-- Sales CTA -->
        <div class="mt-16 text-center">
            <a
                href={ctaLink}
                class="inline-flex flex-col items-center gap-4 group"
            >
                <button
                    class="px-12 py-5 bg-violet-600 hover:bg-violet-500 text-white font-black rounded-[24px] text-xl transition-all shadow-[0_20px_50px_rgba(139,92,246,0.3)] hover:shadow-[0_25px_60px_rgba(139,92,246,0.5)] hover:-translate-y-1"
                >
                    {ctaText}
                </button>
                <div
                    class="flex items-center gap-2 text-zinc-600 text-xs font-bold uppercase tracking-widest group-hover:text-zinc-400 transition-colors"
                >
                    <svg
                        class="size-4 animate-bounce"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="3"
                            d="M19 14l-7 7-7-7"></path></svg
                    >
                    Clique para começar agora
                </div>
            </a>
        </div>

        <!-- Trust Indicators under VSL -->
        <div
            class="mt-12 flex flex-wrap justify-center items-center gap-x-8 gap-y-4 pt-8 border-t border-zinc-800/50"
        >
            <div class="flex items-center gap-2">
                <div class="size-2 bg-emerald-500 rounded-full animate-pulse">
                </div>
                <span
                    class="text-zinc-500 text-[10px] font-bold uppercase tracking-widest"
                    >32 assistindo agora</span
                >
            </div>
            <div class="flex items-center gap-2">
                <svg
                    class="size-4 text-zinc-600"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    ><path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z"
                    ></path></svg
                >
                <span
                    class="text-zinc-500 text-[10px] font-bold uppercase tracking-widest"
                    >Conteúdo Exclusivo</span
                >
            </div>
        </div>
    </div>
</section>
