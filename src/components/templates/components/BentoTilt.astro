---
export const prerender = true;

---

<!-- Bento Grid Item - Tilt Effect -->
<script>
    import VanillaTilt from "vanilla-tilt";
    const elements = document.querySelectorAll(".tilt-card");
    VanillaTilt.init(Array.from(elements) as HTMLElement[], {
        max: 15,
        speed: 400,
        glare: true,
        "max-glare": 0.2,
    });
</script>

<div
    class="tilt-card relative h-64 w-full overflow-hidden rounded-3xl border border-white/10 bg-zinc-900/50 p-8 backdrop-blur-md group"
>
    <div
        class="pointer-events-none absolute -inset-px opacity-0 transition duration-300 group-hover:opacity-100"
        style="background: radial-gradient(600px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(255,255,255,0.06), transparent 40%);"
    >
    </div>

    <div class="relative z-10 flex h-full flex-col justify-between">
        <div
            class="rounded-full bg-zinc-800/50 w-12 h-12 flex items-center justify-center border border-white/5"
        >
            <slot name="icon">✦</slot>
        </div>

        <div>
            <h3
                class="bg-gradient-to-b from-white to-zinc-500 bg-clip-text text-3xl font-bold text-transparent"
            >
                <slot name="title">Bento Tilt</slot>
            </h3>
            <p class="mt-2 text-sm text-zinc-400">
                <slot name="description"
                    >Interactive 3D tilt effect on hover using Vanilla Tilt.</slot
                >
            </p>
        </div>
    </div>

    <!-- Grid Pattern Background -->
    <div
        class="absolute inset-0 z-0 opacity-20 pointer-events-none"
        style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 16px 16px;"
    >
    </div>
</div>
