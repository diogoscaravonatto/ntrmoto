---
export const prerender = true;
// Newsletter signup com design moderno
---

<section class="py-24 px-6 bg-zinc-950 relative overflow-hidden">
    <!-- Background Pattern -->
    <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(139,92,246,0.1),transparent_70%)]"
    >
    </div>

    <div class="max-w-3xl mx-auto relative z-10">
        <div
            class="p-12 bg-zinc-900/50 backdrop-blur-sm border border-zinc-800 rounded-3xl"
        >
            <!-- Icon -->
            <div
                class="size-16 rounded-2xl bg-violet-500/10 flex items-center justify-center mx-auto mb-6"
            >
                <svg
                    class="size-8 text-violet-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    ></path>
                </svg>
            </div>

            <!-- Title -->
            <h2
                class="text-4xl md:text-5xl font-black uppercase tracking-tighter text-center mb-4 text-white"
            >
                Fique por Dentro
            </h2>

            <!-- Subtitle -->
            <p class="text-zinc-400 text-center mb-8 text-lg">
                Receba dicas exclusivas, novidades e ofertas especiais direto no
                seu email.
            </p>

            <!-- Form -->
            <form class="flex flex-col sm:flex-row gap-3">
                <input
                    type="email"
                    placeholder="seu@email.com"
                    class="flex-1 px-6 py-4 bg-zinc-800/50 border border-zinc-700 rounded-xl text-white placeholder:text-zinc-500 focus:outline-none focus:border-violet-500 transition-colors"
                    required
                />
                <button
                    type="submit"
                    class="px-8 py-4 bg-violet-600 hover:bg-violet-500 text-white font-bold rounded-xl transition-all hover:shadow-[0_0_30px_rgba(139,92,246,0.5)] whitespace-nowrap"
                >
                    Inscrever-se
                </button>
            </form>

            <!-- Privacy Note -->
            <p class="text-zinc-600 text-sm text-center mt-6">
                Respeitamos sua privacidade. Cancele a qualquer momento.
            </p>
        </div>
    </div>
</section>
