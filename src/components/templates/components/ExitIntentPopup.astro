---
export const prerender = true;
/**
 * COMPONENTE: ExitIntentPopup
 * O QUE É: Modal de interrupção (Vue) que aparece quando o usuário tenta sair do site.
 * ONDE USAR: Em páginas de vendas para tentar uma última oferta ou captura de lead.
 * COMO USAR: Adicione no final do seu layout. Ele dispara automaticamente ao detectar saída do mouse.
 */
import ExitIntentPopupVue from "./_ExitIntentPopup.vue";

interface Props {
    title?: string;
    description?: string;
    ctaText?: string;
    ctaLink?: string;
    coupon?: string;
}

const {
    title = "Espere! Não vá embora ainda...",
    description = "Temos uma oferta exclusiva para você fechar hoje mesmo.",
    ctaText = "Quero meu Desconto",
    ctaLink = "#contact",
    coupon = "SNIPER10",
} = Astro.props;
---

<ExitIntentPopupVue
    client:only="vue"
    title={title}
    description={description}
    ctaText={ctaText}
    ctaLink={ctaLink}
    coupon={coupon}
/>
