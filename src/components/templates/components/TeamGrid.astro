---
export const prerender = true;
// Team section com cards de membros
---

<section class="py-24 px-6 bg-zinc-950">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-16">
            <h2
                class="text-5xl md:text-6xl font-black uppercase tracking-tighter mb-4 bg-linear-to-b from-white to-zinc-600 bg-clip-text text-transparent"
            >
                Nosso Time
            </h2>
            <p class="text-zinc-500 text-lg">
                Conheça as pessoas por trás da magia
            </p>
        </div>

        <!-- Team Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <!-- Member 1 -->
            <div class="group text-center">
                <div class="relative mb-6 overflow-hidden rounded-2xl">
                    <div
                        class="aspect-square bg-linear-to-br from-violet-500 to-purple-600 group-hover:scale-110 transition-transform duration-500"
                    >
                    </div>
                    <div
                        class="absolute inset-0 bg-zinc-950/0 group-hover:bg-zinc-950/20 transition-colors"
                    >
                    </div>
                </div>
                <h3 class="text-xl font-bold text-white mb-1">João Silva</h3>
                <p class="text-violet-500 text-sm font-medium mb-3">
                    CEO & Founder
                </p>
                <div class="flex justify-center gap-3">
                    <a
                        href="https://twitter.com"
                        target="_blank"
                        class="size-8 rounded-lg bg-white/5 hover:bg-white/10 flex items-center justify-center transition-colors"
                    >
                        <svg
                            class="size-4 text-zinc-400"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"
                            ></path>
                        </svg>
                    </a>
                    <a
                        href="https://twitter.com"
                        target="_blank"
                        class="size-8 rounded-lg bg-white/5 hover:bg-white/10 flex items-center justify-center transition-colors"
                    >
                        <svg
                            class="size-4 text-zinc-400"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"
                            ></path>
                            <circle cx="4" cy="4" r="2"></circle>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Member 2 -->
            <div class="group text-center">
                <div class="relative mb-6 overflow-hidden rounded-2xl">
                    <div
                        class="aspect-square bg-linear-to-br from-pink-500 to-rose-600 group-hover:scale-110 transition-transform duration-500"
