---
export const prerender = true;
// Grid de features com hover effects
---

<section class="py-24 px-6 bg-zinc-950">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-16">
            <h2
                class="text-5xl md:text-6xl font-black uppercase tracking-tighter mb-4 bg-linear-to-b from-white to-zinc-600 bg-clip-text text-transparent"
            >
                Recursos Poderosos
            </h2>
            <p class="text-zinc-500 text-lg max-w-2xl mx-auto">
                Tudo que você precisa para criar experiências incríveis
            </p>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Feature 1 -->
            <div
                class="group relative p-8 bg-zinc-900/50 border border-zinc-800 rounded-2xl hover:border-violet-500/50 transition-all hover:bg-zinc-900"
            >
                <div
                    class="size-12 rounded-xl bg-violet-500/10 flex items-center justify-center mb-6 group-hover:bg-violet-500/20 transition-colors"
                >
                    <svg
                        class="size-6 text-violet-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Ultra Rápido</h3>
                <p class="text-zinc-500">
                    Performance otimizada para carregamento instantâneo em
                    qualquer dispositivo.
                </p>
            </div>

            <!-- Feature 2 -->
            <div
                class="group relative p-8 bg-zinc-900/50 border border-zinc-800 rounded-2xl hover:border-pink-500/50 transition-all hover:bg-zinc-900"
            >
                <div
                    class="size-12 rounded-xl bg-pink-500/10 flex items-center justify-center mb-6 group-hover:bg-pink-500/20 transition-colors"
                >
                    <svg
                        class="size-6 text-pink-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">
                    Design Flexível
                </h3>
                <p class="text-zinc-500">
                    Componentes totalmente customizáveis para criar sua
                    identidade única.
                </p>
            </div>

            <!-- Feature 3 -->
            <div
                class="group relative p-8 bg-zinc-900/50 border border-zinc-800 rounded-2xl hover:border-cyan-500/50 transition-all hover:bg-zinc-900"
            >
                <div
                    class="size-12 rounded-xl bg-cyan-500/10 flex items-center justify-center mb-6 group-hover:bg-cyan-500/20 transition-colors"
                >
                    <svg
                        class="size-6 text-cyan-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Seguro</h3>
                <p class="text-zinc-500">
                    Proteção de dados de nível empresarial com criptografia
                    end-to-end.
                </p>
            </div>
        </div>
    </div>
</section>
