---
export const prerender = true;
// Logo cloud - empresas que confiam
---

<section class="py-16 px-6 bg-zinc-900 border-y border-zinc-800">
    <div class="max-w-7xl mx-auto">
        <p
            class="text-center text-zinc-500 text-sm font-medium uppercase tracking-widest mb-12"
        >
            Empresas que confiam em nós
        </p>

        <div
            class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-8 items-center"
        >
            <div class="flex items-center justify-center h-12 px-4">
                <div
                    class="w-full h-8 rounded bg-linear-to-r from-violet-500/20 to-purple-500/20 border border-violet-500/30"
                >
                </div>
            </div>
            <div class="flex items-center justify-center h-12 px-4">
                <div
                    class="w-full h-8 rounded bg-linear-to-r from-pink-500/20 to-rose-500/20 border border-pink-500/30"
                >
                </div>
            </div>
            <div class="flex items-center justify-center h-12 px-4">
                <div
                    class="w-full h-8 rounded bg-linear-to-r from-cyan-500/20 to-blue-500/20 border border-cyan-500/30"
                >
                </div>
            </div>
            <div class="flex items-center justify-center h-12 px-4">
                <div
                    class="w-full h-8 rounded bg-linear-to-r from-emerald-500/20 to-teal-500/20 border border-emerald-500/30"
                >
                </div>
            </div>
            <div class="flex items-center justify-center h-12 px-4">
                <div
                    class="w-full h-8 rounded bg-linear-to-r from-orange-500/20 to-amber-500/20 border border-orange-500/30"
                >
                </div>
            </div>
            <div class="flex items-center justify-center h-12 px-4">
                <div
                    class="w-full h-8 rounded bg-linear-to-r from-indigo-500/20 to-violet-500/20 border border-indigo-500/30"
                >
                </div>
            </div>
        </div>
    </div>
</section>
