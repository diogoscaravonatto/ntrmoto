---
import { Image } from "astro:assets";
import aboutImagev1 from "@assets/images/about-v1.jpg";
import mapaPrImg from "@assets/images/mapa-pr.png";
import { vetPragasData } from "./content";
---

<section id="sobre" class="py-24 bg-slate-50 relative overflow-hidden">
    <div class="container mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-20 items-center">
            <!-- Coluna da Esquerda (Conteúdo) -->
            <div class="animate-reveal">
                <!-- Badge Superior -->
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 bg-accent/5 border border-accent/20 text-accent text-[10px] font-black uppercase tracking-[0.3em] mb-6 rounded-sm"
                >
                    EMPRESA DE DEDETIZAÇÃO VETPRAGAS
                </div>

                <!-- Título Principal -->
                <h2
                    class="text-4xl lg:text-7xl font-black mb-8 uppercase tracking-tighter leading-[0.95]"
                >
                    <span class="text-accent">CIÊNCIA A SERVIÇO</span>
                    <br /><span class="text-primary">DA SUA EMPRESA</span>
                </h2>

                <!-- Texto de Apoio -->
                <p
                    class="text-xl text-slate-600 mb-10 leading-relaxed font-medium"
                >
                    <span
                        class="text-accent underline decoration-accent/30 underline-offset-4"
                        >Diferente de empresas comuns</span
                    >,
                    <strong
                        >a VetPragas atua sob a ótica da saúde ambiental</strong
                    >. Com coordenação de um Médico Veterinário, entregamos um
                    nível de precisão técnica residencial e industrial de
                    excelência.
                </p>

                <!-- Imagem Mobile (Entre Texto e Bullets) -->
                <div class="lg:hidden relative animate-reveal mb-12">
                    <div
                        class="relative rounded-[2rem] overflow-hidden shadow-xl bg-primary"
                    >
                        <Image
                            src={aboutImagev1}
                            alt="Especialista VetPragas"
                            class="w-full h-[400px] object-cover opacity-90"
                            loading="lazy"
                            decoding="async"
                        />
                        <div
                            class="absolute inset-0 bg-linear-to-t from-primary/80 via-transparent to-transparent"
                        >
                        </div>
                    </div>
                </div>

                <!-- Diferenciais (Bullets) -->
                <div class="grid sm:grid-cols-2 gap-x-8 gap-y-5 mb-14">
                    {
                        vetPragasData.about.features.map((feature) => (
                            <div class="flex items-center gap-3 group">
                                <div class="shrink-0 w-6 h-6 bg-white border border-slate-200 rounded flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-white transition-all shadow-sm">
                                    <svg
                                        class="w-3 h-3"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="3"
                                            d="M5 13l4 4L19 7"
                                        />
                                    </svg>
                                </div>
                                <span class="text-primary font-bold text-[11px] uppercase tracking-wide">
                                    {feature}
                                </span>
                            </div>
                        ))
                    }
                </div>

                <!-- Área de Atuação (Abaixo dos Bullets) -->
                <div class="mb-12 group/map">
                    <div class="grid sm:grid-cols-2 gap-x-8 items-center">
                        <!-- Texto Column -->
                        <div class="flex flex-col gap-2">
                            <span
                                class="block text-[14px] font-black text-accent uppercase tracking-[0.5em] leading-none"
                            >
                                Área de Atuação
                            </span>
                            <span
                                class="text-[14px] sm:text-[15px] font-bold text-slate-800 tracking-tight leading-tight max-w-[280px]"
                            >
                                Atendimento especializado em <br
                                    class="hidden sm:block"
                                />
                                todo o <span class="text-primary font-black"
                                    >Oeste, Sudoeste e Noroeste do Paraná</span
                                >
                            </span>
                        </div>

                        <!-- Mapa -->
                        <div
                            class="relative w-44 h-28 sm:w-60 sm:h-44 shrink-0 mt-6 sm:mt-0"
                        >
                            <div
                                class="relative w-full h-full transform transition-transform duration-700 group-hover/map:scale-110"
                            >
                                <Image
                                    src={mapaPrImg}
                                    alt="Mapa PR"
                                    width="400"
                                    height="300"
                                    loading="lazy"
                                    decoding="async"
                                    class="w-full h-full object-contain filter brightness-95 grayscale-[0.05] group-hover/map:grayscale-0 transition-all opacity-95"
                                />
                                <div
                                    class="absolute top-[58%] left-[17%] -translate-x-1/2 -translate-y-1/2"
                                >
                                    <div
                                        class="relative flex items-center justify-center"
                                    >
                                        <div
                                            class="absolute w-16 h-16 bg-accent/20 rounded-full animate-ping"
                                        >
                                        </div>
                                        <div
                                            class="absolute w-8 h-8 bg-accent/40 rounded-full animate-ping-slow"
                                        >
                                        </div>
                                        <div
                                            class="w-3.5 h-3.5 bg-accent rounded-full shadow-[0_0_20px_rgba(239,68,68,0.9)]"
                                        >
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Coluna da Direita (Visual - Somente Desktop) -->
            <div class="hidden lg:block relative animate-reveal">
                <div
                    class="relative rounded-[3rem] overflow-hidden shadow-[0_50px_100px_-20px_rgba(0,0,0,0.15)] bg-primary"
                >
                    <Image
                        src={aboutImagev1}
                        alt="Especialista VetPragas"
                        class="w-full h-[650px] object-cover opacity-90 transition-transform duration-1000"
                        loading="lazy"
                        decoding="async"
                    />
                </div>

                <!-- Elementos Abstratos de Fundo -->
                <div
                    class="absolute -top-10 -right-10 w-48 h-48 bg-accent/20 rounded-full blur-[80px] -z-10"
                >
                </div>
                <div
                    class="absolute -bottom-10 -left-10 w-48 h-48 bg-primary/20 rounded-full blur-[80px] -z-10"
                >
                </div>
            </div>
        </div>
    </div>

    <style>
        @keyframes ping-slow {
            75%,
            100% {
                transform: scale(3);
                opacity: 0;
            }
        }
        .animate-ping-slow {
            animation: ping-slow 2.5s cubic-bezier(0, 0, 0.2, 1) infinite;
        }
    </style>
</section>
