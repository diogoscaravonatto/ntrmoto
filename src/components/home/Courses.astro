---
const linkClube = "/cursos/clube-de-preparadores/";
const linkCalculadora = "/ferramentas/calculadora-de-motores/";
const linkTaxa = "/cursos/taxa-de-compressao/";

const catalogLinks = [
  { label: "Todos os Cursos", href: "/cursos/" },
  { label: "Formação PRO (15 Cursos)", href: "/cursos/formacao-pro/" },
  { label: "Expert em Cabeçotes", href: "/cursos/preparacao-de-cabecotes/" },
  { label: "Comandos 4 em 1 PRO", href: "/cursos/comandos-de-valvulas/" },
  { label: "Curso Rápido (CRP)", href: "/cursos/curso-rapido-preparacao/" },
  { label: "Projeto Rei do 4Trinho", href: "/projetos/rei-do-4trinho/" },
  { label: "Guia de Motores (12 Receitas)", href: "/projetos/guia-motores-preparados/" },
  { label: "Aula Gratuita de Câmbio", href: "/aulas/cambio-e-velocidade-final/" },
];
---

<section id="cursos" class="bg-[#0a0a0a] py-24">
  <div class="container mx-auto max-w-6xl px-4">
    <div class="reveal-up mb-16 text-center">
      <h2 class="mb-4 text-4xl font-black tracking-tight text-white uppercase md:text-5xl">
        ONDE VOCÊ ESTÁ <span class="text-brand-red">NO JOGO?</span>
      </h2>
      <p class="text-lg text-gray-400">
        Toque nas imagens abaixo para conhecer nossos cursos e ferramentas oficiais.
      </p>
    </div>

    <div class="reveal-up grid grid-cols-1 gap-8 md:grid-cols-3" style="transition-delay: 200ms;">
      {/* Card 1: Clube de Preparadores NTR */}
      <a
        href={linkClube}
        class="group relative flex h-full flex-col overflow-hidden rounded-2xl border-2 border-brand-red/40 bg-[#111] shadow-[0_0_20px_rgba(255,0,0,0.1)] transition-all hover:-translate-y-2 hover:border-brand-red hover:shadow-[0_0_40px_rgba(255,0,0,0.3)]"
      >
        <div class="absolute top-0 right-0 z-10 animate-pulse rounded-bl-lg bg-gradient-to-r from-red-600 to-brand-red px-3 py-1 text-xs font-bold text-white uppercase">
          Mais Completo
        </div>
        <div class="relative aspect-video w-full overflow-hidden bg-black/50 p-4 pt-6">
          <img
            src="/images/mockup_combo.webp"
            alt="Clube de Preparadores NTR — 18 Cursos"
            width="640"
            height="360"
            loading="lazy"
            class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
          />
        </div>
        <div class="flex flex-grow flex-col bg-gradient-to-b from-transparent to-brand-red/5 p-6">
          <h3 class="mb-2 text-xl font-black text-white uppercase">Clube de Preparadores NTR</h3>
          <p class="mb-6 flex-grow text-sm text-gray-400">
            18 cursos completos (inclui Molas Especiais e Remap), suporte 1 ano e comunidade. Anual
            R$ 299 ou Vitalício R$ 899.
          </p>
          <div class="w-full rounded bg-brand-red py-3 text-center font-bold tracking-wider text-white uppercase shadow-lg">
            Conhecer o Clube
          </div>
        </div>
      </a>

      {/* Card 2: Calculadora de Motores */}
      <a
        href={linkCalculadora}
        class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-gray-800 bg-[#111] shadow-lg transition-all hover:-translate-y-2 hover:border-brand-red/50 hover:shadow-[0_0_30px_rgba(255,0,0,0.2)]"
      >
        <div class="absolute top-0 right-0 z-10 rounded-bl-lg bg-brand-red px-3 py-1 text-xs font-bold text-white">
          FERRAMENTA
        </div>
        <div class="relative aspect-video w-full overflow-hidden bg-black/50 p-4 pt-6">
          <img
            src="/images/mockup_calculadora.webp"
            alt="Calculadora de Motores NTR"
            width="640"
            height="360"
            loading="lazy"
            class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
          />
        </div>
        <div class="flex flex-grow flex-col p-6">
          <h3 class="mb-2 text-xl font-black text-white uppercase">Calculadora de Motores</h3>
          <p class="mb-6 flex-grow text-sm text-gray-400">
            App exclusivo para MOTOS calcular e projetar motores direto no celular em segundos. R$
            67 à vista (1 ano de acesso).
          </p>
          <div class="w-full rounded bg-gray-900 py-3 text-center font-bold tracking-wider text-white uppercase transition-colors group-hover:bg-brand-red">
            Quero Acessar
          </div>
        </div>
      </a>

      {/* Card 3: Taxa de Compressão */}
      <a
        href={linkTaxa}
        class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-gray-800 bg-[#111] shadow-lg transition-all hover:-translate-y-2 hover:border-brand-red/50 hover:shadow-[0_0_30px_rgba(255,0,0,0.2)]"
      >
        <div class="relative aspect-video w-full overflow-hidden bg-black/50 p-4 pt-6">
          <img
            src="/images/mockup_taxa.webp"
            alt="Curso Rápido Taxa de Compressão"
            width="640"
            height="360"
            loading="lazy"
            class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
          />
        </div>
        <div class="flex flex-grow flex-col p-6">
          <h3 class="mb-2 text-xl font-black text-white uppercase">Taxa de Compressão</h3>
          <p class="mb-6 flex-grow text-sm text-gray-400">
            Como acertar a taxa para gasolina, etanol ou metanol e extrair potência sem quebrar o
            motor. A partir de R$ 37 à vista.
          </p>
          <div class="w-full rounded bg-gray-900 py-3 text-center font-bold tracking-wider text-white uppercase transition-colors group-hover:bg-brand-red">
            Começar Agora
          </div>
        </div>
      </a>
    </div>

    {/* Links diretos para toda a escada de cursos, projetos e ferramentas */}
    <div class="mt-12 rounded-2xl border border-white/10 bg-[#111] p-6">
      <p class="mb-4 text-center text-xs font-bold tracking-widest text-gray-400 uppercase">
        Explore todos os treinamentos, projetos e ferramentas NTR
      </p>
      <div class="flex flex-wrap justify-center gap-2.5">
        {catalogLinks.map((item) => (
          <a
            href={item.href}
            class="rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 text-xs font-semibold text-gray-200 transition-colors hover:border-brand-red/60 hover:bg-brand-red/15 hover:text-white"
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
