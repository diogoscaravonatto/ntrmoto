<section class="border-y border-gray-800 bg-[#0d0d0d] py-12 relative z-20 -mt-8">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-center items-center gap-10 md:gap-20 text-center reveal-up">
      
      {/* Stat 1 */}
      <div class="flex flex-col items-center">
        <span class="text-5xl md:text-6xl font-black text-brand-red mb-2">+12.000</span>
        <span class="text-gray-400 font-bold uppercase tracking-widest text-sm md:text-base">Alunos formados</span>
      </div>
      
      {/* Divider (hide on mobile) */}
      <div class="hidden md:block w-px h-16 bg-gray-800"></div>

      {/* Stat 2 */}
      <div class="flex flex-col items-center">
        <span class="text-5xl md:text-6xl font-black text-brand-red mb-2">20</span>
        <span class="text-gray-400 font-bold uppercase tracking-widest text-sm md:text-base">Países alcançados</span>
      </div>

      {/* Divider (hide on mobile) */}
      <div class="hidden md:block w-px h-16 bg-gray-800"></div>

      {/* Stat 3 */}
      <div class="flex flex-col items-center">
        <span class="text-5xl md:text-6xl font-black text-brand-red mb-2">+150</span>
        <span class="text-gray-400 font-bold uppercase tracking-widest text-sm md:text-base">Motos na pista</span>
      </div>

    </div>
  </div>
</section>
