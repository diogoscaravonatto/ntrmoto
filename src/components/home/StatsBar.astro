<section class="relative z-20 -mt-8 border-y border-gray-800 bg-[#0d0d0d] py-12">
  <div class="container mx-auto px-4">
    <div class="reveal-up flex flex-col items-center justify-center gap-10 text-center md:flex-row md:gap-20">
      {/* Stat 1 */}
      <div class="flex flex-col items-center">
        <span class="mb-2 text-5xl font-black text-brand-red md:text-6xl">+12.000</span>
        <span class="text-sm font-bold tracking-widest text-gray-400 uppercase md:text-base">
          Alunos formados
        </span>
      </div>

      {/* Divider (hide on mobile) */}
      <div class="hidden h-16 w-px bg-gray-800 md:block"></div>

      {/* Stat 2 */}
      <div class="flex flex-col items-center">
        <span class="mb-2 text-5xl font-black text-brand-red md:text-6xl">20</span>
        <span class="text-sm font-bold tracking-widest text-gray-400 uppercase md:text-base">
          Países alcançados
        </span>
      </div>

      {/* Divider (hide on mobile) */}
      <div class="hidden h-16 w-px bg-gray-800 md:block"></div>

      {/* Stat 3 */}
      <div class="flex flex-col items-center">
        <span class="mb-2 text-5xl font-black text-brand-red md:text-6xl">+150</span>
        <span class="text-sm font-bold tracking-widest text-gray-400 uppercase md:text-base">
          Motos na pista
        </span>
      </div>
    </div>
  </div>
</section>
