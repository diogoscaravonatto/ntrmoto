---
import { Image } from "astro:assets";
import imgFabio from "../../assets/images/fabio_ntr_bio.webp";
---

<section class="relative flex min-h-[90vh] items-center justify-center overflow-hidden bg-black pt-20 pb-16">
  {/* Background effects */}
  <div class="absolute inset-0 z-0">
    <div class="absolute top-0 right-0 h-full w-3/4 bg-gradient-to-l from-brand-red/20 to-transparent opacity-50 blur-3xl"></div>
    <div class="absolute -top-40 -left-40 h-96 w-96 rounded-full bg-brand-red/20 opacity-30 blur-3xl"></div>
    {/* Grid pattern */}
    <div class="absolute inset-0 bg-[url('/grid.svg')] [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))] bg-center opacity-10"></div>
  </div>

  <div class="relative z-10 container mx-auto px-4">
    <div class="flex flex-col items-center gap-12 lg:flex-row lg:gap-8">
      {/* Text Content */}
      <div class="reveal-up flex w-full flex-col items-center text-center lg:w-1/2 lg:items-start lg:text-left">
        {/* Logo */}
        <div class="mb-6">
          <img
            src="/images/logo_ntr.webp"
            alt="NTR Escola de Motores"
            class="mx-auto h-8 w-auto object-contain drop-shadow-[0_0_15px_rgba(255,0,0,0.3)] md:h-10 lg:mx-0"
          />
        </div>

        <div class="mb-6 inline-block rounded-full border border-brand-red/30 bg-brand-red/10 px-4 py-1.5 text-sm font-bold tracking-wider text-brand-red uppercase">
          A Maior Escola de Preparação do Brasil
        </div>

        <h1 class="mb-6 text-5xl leading-[1.1] font-black tracking-tight text-white uppercase md:text-6xl lg:text-7xl">
          Conhecimento <br />
          <span class="text-brand-red">é sua maior</span>
          <br />
          ferramenta
        </h1>

        <p class="mb-10 max-w-2xl text-xl font-medium text-gray-300 md:text-2xl">
          Aqui você entra num sistema de desenvolvimento de motores com técnicas avançadas e
          resultado brutal.
        </p>

        <a
          href="#cursos"
          class="group inline-flex w-full items-center justify-center rounded-lg bg-brand-red px-8 py-5 text-xl font-black tracking-wider text-white uppercase shadow-[0_0_30px_rgba(255,0,0,0.4)] transition-all hover:-translate-y-1 hover:bg-red-700 hover:shadow-[0_0_50px_rgba(255,0,0,0.6)] md:w-auto"
        >
          Conheça Nossos Treinamentos
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="ml-3 h-6 w-6 transform transition-transform group-hover:translate-x-2"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="3"
              d="M14 5l7 7m0 0l-7 7m7-7H3"
            />
          </svg>
        </a>

        <div class="mt-6 flex flex-col items-center space-y-1 text-sm font-medium text-gray-400 lg:items-start">
          <p>12.000+ alunos formados em 8 anos de história</p>
          <p>#1 em treinamento de preparação do Brasil</p>
        </div>
      </div>

      {/* Visual Content */}
      <div class="reveal-up relative w-full lg:w-1/2" style="transition-delay: 200ms;">
        <div class="relative mx-auto flex aspect-square w-full max-w-lg items-end justify-center lg:aspect-auto lg:h-[700px]">
          {/* Decorações do fundo da imagem */}
          <div class="absolute inset-0 bottom-0 z-10 h-1/3 bg-gradient-to-t from-black via-transparent to-transparent"></div>

          {/* Imagem do Fabio */}
          <Image
            src={imgFabio}
            alt="Fábio - NTR Escola de Motores"
            class="relative z-0 h-full w-full object-contain drop-shadow-[0_0_40px_rgba(255,0,0,0.3)]"
          />
        </div>
      </div>
    </div>
  </div>
</section>
