---
import { Image } from 'astro:assets';
import imgFabio from '../../assets/images/fabio_ntr_bio.webp';
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden bg-black pt-20 pb-16">
  {/* Background effects */}
  <div class="absolute inset-0 z-0">
    <div class="absolute top-0 right-0 w-3/4 h-full bg-gradient-to-l from-brand-red/20 to-transparent blur-3xl opacity-50"></div>
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-brand-red/20 rounded-full blur-3xl opacity-30"></div>
    {/* Grid pattern */}
    <div class="absolute inset-0 bg-[url('/grid.svg')] bg-center [mask-image:linear-gradient(180deg,white,rgba(255,255,255,0))] opacity-10"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-8">
      
      {/* Text Content */}
      <div class="w-full lg:w-1/2 flex flex-col items-center lg:items-start text-center lg:text-left reveal-up">
        {/* Logo */}
        <div class="mb-6">
          <img src="/images/logo_ntr.webp" alt="NTR Escola de Motores" class="h-8 md:h-10 w-auto object-contain mx-auto lg:mx-0 drop-shadow-[0_0_15px_rgba(255,0,0,0.3)]" onerror="this.src='/favicon.png'; this.classList.remove('h-8', 'md:h-10'); this.classList.add('h-12');" />
        </div>

        <div class="inline-block px-4 py-1.5 mb-6 rounded-full bg-brand-red/10 border border-brand-red/30 text-brand-red font-bold text-sm tracking-wider uppercase">
          A Maior Escola de Preparação do Brasil
        </div>
        
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-black text-white leading-[1.1] mb-6 tracking-tight uppercase">
          Conhecimento <br />
          <span class="text-brand-red">é sua maior</span><br />
          ferramenta
        </h1>
        
        <p class="text-xl md:text-2xl text-gray-300 mb-10 max-w-2xl font-medium">
          Aqui você entra num sistema de desenvolvimento de motores com técnicas avançadas e resultado brutal.
        </p>
        
        <a href="#cursos" class="inline-flex items-center justify-center px-8 py-5 text-xl font-black text-white uppercase tracking-wider bg-brand-red hover:bg-red-700 transition-all rounded-lg shadow-[0_0_30px_rgba(255,0,0,0.4)] hover:shadow-[0_0_50px_rgba(255,0,0,0.6)] hover:-translate-y-1 group w-full md:w-auto">
          Conheça Nossos Treinamentos
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 ml-3 transform group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <div class="mt-6 flex flex-col items-center lg:items-start text-sm text-gray-400 font-medium space-y-1">
          <p>12.000+ alunos formados em 8 anos de história</p>
          <p>#1 em treinamento de preparação do Brasil</p>
        </div>
      </div>

      {/* Visual Content */}
      <div class="w-full lg:w-1/2 relative reveal-up" style="transition-delay: 200ms;">
        <div class="relative w-full max-w-lg mx-auto aspect-square lg:aspect-auto lg:h-[700px] flex items-end justify-center">
          {/* Decorações do fundo da imagem */}
          <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent z-10 bottom-0 h-1/3"></div>
          
          {/* Imagem do Fabio */}
          <Image 
            src={imgFabio} 
            alt="Fábio - NTR Escola de Motores" 
            class="relative z-0 object-contain w-full h-full drop-shadow-[0_0_40px_rgba(255,0,0,0.3)]"
          />
        </div>
      </div>
      
    </div>
  </div>
</section>
