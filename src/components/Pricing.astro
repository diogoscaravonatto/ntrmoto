---
import { vetPragasData } from "./content";
---

---

<section id="precos" class="py-24 bg-slate-50">
    <div class="container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span
                class="text-accent font-bold text-[10px] uppercase tracking-[0.3em]"
                >{vetPragasData.pricing.subtitle}</span
            >
            <h2
                class="text-4xl lg:text-5xl font-black text-slate-900 mt-4 mb-6 uppercase tracking-tighter"
            >
                {vetPragasData.pricing.title}
            </h2>
            <p class="text-lg text-slate-500">
                {vetPragasData.pricing.description}
            </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto mb-20">
            {
                vetPragasData.pricing.packages.map((pkg) => (
                    <div
                        class:list={[
                            "bg-white rounded-3xl p-10 border shadow-sm transition-all duration-500 hover:shadow-xl hover:-translate-y-2 relative group",
                            pkg.highlight
                                ? "border-accent shadow-accent/5"
                                : "border-slate-100",
                        ]}
                    >
                        {pkg.highlight && (
                            <div class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 bg-accent/90 backdrop-blur-sm text-white font-bold text-[10px] uppercase tracking-widest rounded-full">
                                {pkg.badge}
                            </div>
                        )}

                        <div
                            class:list={[
                                "w-14 h-14 rounded-2xl flex items-center justify-center mb-8",
                                pkg.highlight
                                    ? "bg-accent text-white"
                                    : "bg-accent/5 text-accent",
                            ]}
                        >
                            {pkg.icon === "home" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                    <polyline points="9 22 9 12 15 12 15 22" />
                                </svg>
                            )}
                            {pkg.icon === "building" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        width="16"
                                        height="20"
                                        x="4"
                                        y="2"
                                        rx="2"
                                        ry="2"
                                    />
                                    <path d="M9 22v-4h6v4" />
                                    <path d="M8 6h.01" />
                                    <path d="M16 6h.01" />
                                    <path d="M12 6h.01" />
                                    <path d="M12 10h.01" />
                                    <path d="M12 14h.01" />
                                    <path d="M16 10h.01" />
                                    <path d="M16 14h.01" />
                                    <path d="M8 10h.01" />
                                    <path d="M8 14h.01" />
                                </svg>
                            )}
                            {pkg.icon === "briefcase" && (
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        width="20"
                                        height="14"
                                        x="2"
                                        y="7"
                                        rx="2"
                                        ry="2"
                                    />
                                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                                </svg>
                            )}
                        </div>

                        <h3 class="text-2xl font-black text-slate-900 mb-2 uppercase tracking-tight">
                            {pkg.type}
                        </h3>
                        <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mb-8">
                            {pkg.description}
                        </p>

                        <div class="space-y-4 mb-10">
                            {pkg.services.map((service) => (
                                <div class="flex items-center justify-between pb-4 border-b border-slate-50 last:border-0">
                                    <span class="text-slate-600 text-sm font-medium">
                                        {service.name}
                                    </span>
                                    <span class="text-slate-900 font-black text-sm">
                                        {service.price}
                                    </span>
                                </div>
                            ))}
                        </div>

                        <a
                            href="https://wa.me/5545991586405"
                            class:list={[
                                "block text-center px-8 py-4 rounded-xl font-bold text-xs uppercase tracking-widest transition-all",
                                pkg.highlight
                                    ? "bg-accent text-white hover:bg-accent-dark shadow-lg shadow-accent/20"
                                    : "bg-slate-900 text-white hover:bg-slate-800",
                            ]}
                        >
                            Solicitar Agora
                        </a>
                    </div>
                ))
            }
        </div>

        <!-- Payment Methods -->
        <div
            class="max-w-4xl mx-auto p-10 bg-white border border-slate-100 rounded-3xl shadow-sm"
        >
            <div class="text-center mb-10">
                <h4
                    class="text-sm font-black text-slate-900 uppercase tracking-[0.2em]"
                >
                    Condições de Pagamento Facilitadas
                </h4>
            </div>
            <div class="grid sm:grid-cols-3 gap-8">
                {
                    vetPragasData.pricing.paymentMethods.map((method) => (
                        <div class="flex items-center gap-4 group">
                            <div class="w-12 h-12 bg-accent/5 rounded-xl flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-white transition-all shadow-sm group-hover:shadow-accent/20">
                                {method.icon === "zap" && (
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                                    </svg>
                                )}
                                {method.icon === "credit-card" && (
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <rect
                                            width="20"
                                            height="14"
                                            x="2"
                                            y="5"
                                            rx="2"
                                        />
                                        <line x1="2" x2="22" y1="10" y2="10" />
                                    </svg>
                                )}
                                {method.icon === "file-text" && (
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                                        <polyline points="14 2 14 8 20 8" />
                                        <line x1="16" x2="8" y1="13" y2="13" />
                                        <line x1="16" x2="8" y1="17" y2="17" />
                                        <line x1="10" x2="8" y1="9" y2="9" />
                                    </svg>
                                )}
                            </div>
                            <div>
                                <div class="text-sm font-black text-slate-900 uppercase tracking-tight">
                                    {method.name}
                                </div>
                                <div class="text-[10px] text-accent font-bold uppercase tracking-widest">
                                    {method.discount ||
                                        method.installments ||
                                        method.info}
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
