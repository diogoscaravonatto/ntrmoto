---
import { vetPragasData } from "./content";
import { Image } from "astro:assets";
import bayerImg from "@assets/images/lg-bayer.jpeg";
import syngentaImg from "@assets/images/lg-syngenta.jpeg";
import basfImg from "@assets/images/lg-basf.jpeg";
import textureTdImg from "@assets/images/vetpragas-textura-td.png";

const brands = [
    { src: bayerImg, alt: "Bayer", h: "h-10 lg:h-12" },
    { src: syngentaImg, alt: "Syngenta", h: "h-10 lg:h-12" },
    { src: basfImg, alt: "Basf", h: "h-8 lg:h-10" },
    { src: bayerImg, alt: "Bayer", h: "h-10 lg:h-12" },
    { src: syngentaImg, alt: "Syngenta", h: "h-10 lg:h-12" },
    { src: basfImg, alt: "Basf", h: "h-8 lg:h-10" },
];
---

<section id="empresa" class="py-24 bg-white relative overflow-hidden">
    <div class="container mx-auto px-6">
        <div
            class="max-w-6xl mx-auto rounded-3xl lg:rounded-[3rem] bg-slate-900 p-8 sm:p-12 lg:p-20 relative overflow-hidden"
        >
            <!-- Background Texture -->
            <Image
                src={textureTdImg}
                alt=""
                width="600"
                height="600"
                loading="lazy"
                decoding="async"
                class="absolute top-0 right-0 w-[400px] lg:w-[600px] h-auto opacity-40 pointer-events-none select-none z-0 rotate-180"
            />

            <div class="relative z-10">
                <div class="text-center mb-16">
                    <h2
                        class="text-3xl lg:text-5xl font-black text-white mb-4 uppercase tracking-tighter"
                    >
                        {vetPragasData.guarantees.title}
                    </h2>
                    <p
                        class="text-accent font-bold text-xs uppercase tracking-[0.3em] font-mono"
                    >
                        Nosso compromisso inegociável com você
                    </p>
                </div>

                <div class="grid md:grid-cols-2 gap-4 sm:gap-8 lg:gap-12 mb-12">
                    {
                        vetPragasData.guarantees.items.map((item) => (
                            <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 p-6 sm:p-8 bg-white/5 border border-white/10 rounded-3xl hover:bg-white/10 hover:border-accent/30 transition-all duration-500 group items-start">
                                <div class="shrink-0 w-12 h-12 sm:w-14 sm:h-14 bg-accent rounded-2xl flex items-center justify-center text-white shadow-lg shadow-accent/20 group-hover:scale-110 transition-transform">
                                    {item.icon === "badge" && (
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" />
                                            <path d="m9 12 2 2 4-4" />
                                        </svg>
                                    )}
                                    {item.icon === "check-circle" && (
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <circle cx="12" cy="12" r="10" />
                                            <path d="m9 12 2 2 4-4" />
                                        </svg>
                                    )}
                                    {item.icon === "document" && (
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                                            <polyline points="14 2 14 8 20 8" />
                                            <line
                                                x1="16"
                                                x2="8"
                                                y1="13"
                                                y2="13"
                                            />
                                            <line
                                                x1="16"
                                                x2="8"
                                                y1="17"
                                                y2="17"
                                            />
                                            <line
                                                x1="10"
                                                x2="8"
                                                y1="9"
                                                y2="9"
                                            />
                                        </svg>
                                    )}
                                    {item.icon === "shield-check" && (
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                            <path d="m9 12 2 2 4-4" />
                                        </svg>
                                    )}
                                </div>
                                <div class="text-left">
                                    <h3 class="text-lg sm:text-xl font-black text-white mb-2 uppercase tracking-tight">
                                        {item.title}
                                    </h3>
                                    <p class="text-slate-400 text-sm leading-relaxed font-medium">
                                        {item.description}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>

                <!-- Trusted Products Section Interno -->
                <div class="relative pt-0">
                    <!-- Brand Carousel -->
                    <div class="brand-ticker-container">
                        <div class="brand-ticker-track">
                            {
                                [...brands, ...brands, ...brands].map(
                                    (brand) => (
                                        <div class="brand-node group">
                                            <div class="brand-card">
                                                <Image
                                                    src={brand.src}
                                                    alt={brand.alt}
                                                    width="150"
                                                    height="48"
                                                    loading="lazy"
                                                    decoding="async"
                                                    class:list={[
                                                        "object-contain max-w-full opacity-60 hover:opacity-100 transition-opacity duration-300 filter grayscale hover:grayscale-0",
                                                        brand.h,
                                                    ]}
                                                />
                                            </div>
                                        </div>
                                    ),
                                )
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .brand-ticker-container {
        width: 100%;
        overflow: hidden;
        position: relative;
    }

    .brand-ticker-track {
        display: flex;
        width: fit-content;
        animation: brand-slide 40s linear infinite;
        will-change: transform;
        gap: 1rem;
        padding: 5px 0;
    }

    @keyframes brand-slide {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-33.33%);
        }
    }

    .brand-card {
        background: white;
        padding: 0.25rem 1rem; /* Margem interna reduzida para logo maior */
        border-radius: 1.25rem;
        height: 6rem;
        width: 11rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        z-index: 10;
        border: 1px solid transparent;
    }

    .brand-node:hover .brand-card {
        border-color: #d81624;
        transform: translateY(-4px);
    }

    .brand-ticker-container:hover .brand-ticker-track {
        animation-play-state: paused;
    }

    @media (max-width: 768px) {
        .brand-card {
            width: 9rem;
            height: 4.5rem;
        }
    }
</style>
