 * FooterSimples - Footer minimalista da homepage
 */
---

<footer class="py-20 px-6 border-t border-white/5 bg-zinc-950">
    <div
        class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-10"
    >
        <div class="flex items-center gap-4">
            <div
                class="w-10 h-10 bg-white rounded-full flex items-center justify-center text-black font-black italic"
            >
                V
            </div>
            <span class="font-black text-xl tracking-tighter italic"
                >VIBE STARTER</span
            >
        </div>
        <div class="text-center text-zinc-600 text-sm font-medium">
            <p>
                © {new Date().getFullYear()} – Inteligência Artificial aplicada ao
                seu bolso.
            </p>
        </div>
    </div>
</footer>
