---
/**
 * TutorialPassos - Fluxo visual de 3 passos
 * Escolha → Converse → Publique
 */

const passos = [
    {
        numero: 1,
        emoji: "🎨",
        titulo: "Escolha o Template",
        descricao:
            "Navegue pela biblioteca e escolha o design que mais combina com sua vibe. Cada template já vem pronto para personalizar.",
        bgColor: "bg-purple-500/10",
        borderColor: "border-purple-500",
        textColor: "text-purple-400",
    },
    {
        numero: 2,
        emoji: "💬",
        titulo: "Converse com a I.A.",
        descricao:
            '"Mude a cor para azul marinho", "Adicione meu logo", "Quero um botão de WhatsApp". A I.A. entende e executa.',
        bgColor: "bg-blue-500/10",
        borderColor: "border-blue-500",
        textColor: "text-blue-400",
    },
    {
        numero: 3,
        emoji: "🚀",
        titulo: "Publique Grátis",
        descricao:
            "Um clique e seu site está no ar, com domínio próprio, segurança máxima e velocidade de foguete. Tudo sem pagar nada.",
        bgColor: "bg-pink-500/10",
        borderColor: "border-pink-500",
        textColor: "text-pink-400",
    },
];
---

<section class="py-40 px-6">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-24">
            <span
                class="inline-block px-4 py-1 bg-black text-white rounded-full text-xs font-black uppercase mb-6 tracking-widest"
                >Tão Fácil que Parece Mágica</span
            >
            <h2 class="text-5xl md:text-7xl font-black mb-6 uppercase italic">
                3 Passos.<br /><span class="text-purple-500">8 Minutos.</span>
            </h2>
            <p class="text-zinc-500 text-xl">
                Do template vazio ao site no ar. Sem código, sem dor de cabeça.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 relative">
            <!-- Linha conectora -->
            <div
                class="hidden md:block absolute top-24 left-0 right-0 h-px bg-linear-to-r from-transparent via-purple-500/30 to-transparent"
            >
            </div>

            {
                passos.map((p) => (
                    <div class="relative text-center">
                        <div
                            class:list={[
                                "w-20 h-20 mx-auto mb-8 rounded-full border-2 flex items-center justify-center text-3xl font-black relative z-10",
                                p.bgColor,
                                p.borderColor,
                                p.textColor,
                            ]}
                        >
                            {p.numero}
                        </div>
                        <div class="p-8 rounded-3xl bg-zinc-900/50 border border-white/5">
                            <div class="text-4xl mb-4">{p.emoji}</div>
                            <h3 class="text-2xl font-black mb-4 italic">
                                {p.titulo}
                            </h3>
                            <p class="text-zinc-500 leading-relaxed">
                                {p.descricao}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>

        <div class="mt-20 text-center">
            <div
                class="inline-flex items-center gap-4 px-8 py-4 bg-zinc-900 rounded-full border border-white/5"
            >
                <div class="flex items-center gap-2">
                    <div
                        class="w-3 h-3 rounded-full bg-green-500 animate-pulse"
                    >
                    </div>
                    <span class="text-zinc-400 text-sm font-medium"
                        >Tempo médio:</span
                    >
                </div>
                <span class="text-3xl font-black text-white">8 min</span>
            </div>
        </div>
    </div>
</section>
