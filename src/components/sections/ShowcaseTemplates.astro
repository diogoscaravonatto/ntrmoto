---
/**
 * ShowcaseTemplates - Galeria visual dos templates disponíveis
 */

interface TemplateCard {
    href: string;
    name: string;
    category: string;
    description: string;
    time: string;
    color: string;
    borderColor: string;
    gradientFrom: string;
    gradientTo: string;
}

const templates: TemplateCard[] = [
    {
        href: "/templates/pages/agencia",
        name: "Agência Visionária",
        category: "Creative",
        description: "Design minimalista e interativo para agências criativas.",
        time: "~8 min",
        color: "text-blue-400",
        borderColor: "hover:border-purple-500/50",
        gradientFrom: "from-blue-900/20",
        gradientTo: "to-purple-900/20",
    },
    {
        href: "/templates/pages/barbearia",
        name: "Gentleman Barber",
        category: "Service",
        description: "Estilo clássico e sofisticado para negócios premium.",
        time: "~6 min",
        color: "text-amber-400",
        borderColor: "hover:border-amber-500/50",
        gradientFrom: "from-amber-900/20",
        gradientTo: "to-orange-900/20",
    },
    {
        href: "/templates/pages/pet",
        name: "PetLove Care",
        category: "Health",
        description: "Interface amigável para serviços veterinários.",
        time: "~5 min",
        color: "text-teal-400",
        borderColor: "hover:border-teal-500/50",
        gradientFrom: "from-teal-900/20",
        gradientTo: "to-green-900/20",
    },
    {
        href: "/templates/pages/odontologia",
        name: "Aura Dental",
        category: "Health",
        description: "Design premium focado em saúde e estética dental.",
        time: "~7 min",
        color: "text-cyan-400",
        borderColor: "hover:border-cyan-500/50",
        gradientFrom: "from-cyan-900/20",
        gradientTo: "to-blue-900/20",
    },
    {
        href: "/templates/pages/webinar",
        name: "Webinar Flow",
        category: "Marketing",
        description: "Landing page de alta conversão para eventos online.",
        time: "~4 min",
        color: "text-red-400",
        borderColor: "hover:border-red-500/50",
        gradientFrom: "from-red-900/20",
        gradientTo: "to-pink-900/20",
    },
    {
        href: "/templates/pages/contabilidade",
        name: "LuxFinance",
        category: "Business",
        description: "Gestão estratégica e contabilidade corporativa.",
        time: "~9 min",
        color: "text-emerald-400",
        borderColor: "hover:border-emerald-500/50",
        gradientFrom: "from-emerald-900/20",
        gradientTo: "to-green-900/20",
    },
];
---

<section
    id="exemplos"
    class="py-40 px-6 bg-zinc-950/50 border-y border-white/5"
>
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-20">
            <span
                class="inline-block px-4 py-1 bg-purple-500/10 text-purple-400 rounded-full text-xs font-black uppercase mb-6 tracking-widest"
                >Do Zero ao Ar</span
            >
            <h2 class="text-5xl md:text-7xl font-black mb-6 uppercase italic">
                Sites Reais.<br />Criados em <span class="text-purple-500"
                    >Minutos.</span
                >
            </h2>
            <p class="text-zinc-500 text-xl max-w-2xl mx-auto">
                Escolha um template, converse com a I.A. e veja seu site ganhar
                vida.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                templates.map((t) => (
                    <a
                        href={t.href}
                        class:list={[
                            "group relative rounded-3xl overflow-hidden bg-zinc-900 border border-white/5 transition-all hover:scale-105",
                            t.borderColor,
                        ]}
                    >
                        <div
                            class:list={[
                                "aspect-4/3 bg-linear-to-br flex items-center justify-center text-zinc-700 font-black text-xl",
                                t.gradientFrom,
                                t.gradientTo,
                            ]}
                        >
                            {t.name.toUpperCase()}
                        </div>
                        <div class="p-6">
                            <div class="flex items-center justify-between mb-3">
                                <span
                                    class:list={[
                                        "text-xs font-black uppercase tracking-widest",
                                        t.color,
                                    ]}
                                >
                                    {t.category}
                                </span>
                                <span class="text-xs text-zinc-600">
                                    {t.time}
                                </span>
                            </div>
                            <h3 class="text-xl font-bold mb-2">{t.name}</h3>
                            <p class="text-zinc-500 text-sm">{t.description}</p>
                        </div>
                    </a>
                ))
            }
        </div>

        <div class="text-center mt-16">
            <a
                href="/templates"
                class="inline-flex items-center gap-3 px-8 py-4 bg-zinc-800 hover:bg-zinc-700 text-white font-bold rounded-full transition-all border border-white/10"
            >
                Ver Todos os Templates
                <span>→</span>
            </a>
        </div>
    </div>
</section>
