---
/**
 * PerformanceVisual - Métricas do Lighthouse e comparativo de velocidade
 */

const metricas = [
    { label: "Performance", score: "98/100", width: "98%" },
    { label: "SEO", score: "100/100", width: "100%" },
    { label: "Mobile", score: "96/100", width: "96%" },
];
---

<section class="py-40 px-6">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-20">
            <h2 class="text-5xl md:text-7xl font-black mb-6 uppercase italic">
                Velocidade que<br /><span class="text-purple-500"
                    >o Google ama.</span
                >
            </h2>
            <p class="text-zinc-500 text-xl max-w-2xl mx-auto">
                Sites lentos perdem vendas. Sites rápidos conquistam clientes. É
                simples assim.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
            <!-- Lado Esquerdo: Métricas -->
            <div class="space-y-8">
                {
                    metricas.map((m) => (
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-sm font-bold uppercase tracking-widest text-zinc-500">
                                    {m.label}
                                </span>
                                <span class="text-3xl font-black text-green-400">
                                    {m.score}
                                </span>
                            </div>
                            <div class="h-3 bg-zinc-900 rounded-full overflow-hidden">
                                <div
                                    class="h-full bg-linear-to-r from-green-500 to-emerald-400 rounded-full"
                                    style={`width: ${m.width}`}
                                ></div>
                            </div>
                        </div>
                    ))
                }

                <div class="pt-8 border-t border-white/5">
                    <p class="text-zinc-400 italic">
                        "Plataformas tradicionais ficam entre 40-60 pontos. Nós
                        entregamos excelência."
                    </p>
                </div>
            </div>

            <!-- Lado Direito: Comparativo -->
            <div class="space-y-6">
                <div
                    class="p-8 rounded-3xl bg-zinc-900/50 border border-white/5"
                >
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-zinc-600 font-bold"
                            >Sites Tradicionais</span
                        >
                        <span class="text-red-500 font-black text-2xl"
                            >3.5s</span
                        >
                    </div>
                    <p class="text-zinc-500 text-sm">
                        Tempo médio de carregamento
                    </p>
                </div>

                <div
                    class="p-8 rounded-3xl bg-linear-to-br from-purple-900/20 to-blue-900/20 border border-purple-500/30"
                >
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-white font-black">Vibe Coding</span>
                        <span class="text-green-400 font-black text-2xl"
                            >0.4s</span
                        >
                    </div>
                    <p class="text-zinc-400 text-sm">
                        Carregamento instantâneo
                    </p>
                </div>

                <div class="p-6 bg-zinc-950 rounded-2xl">
                    <p class="text-xs text-zinc-600 mb-2">
                        IMPACTO NO NEGÓCIO:
                    </p>
                    <p class="text-white font-bold">
                        Cada segundo de atraso = 7% menos conversões
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
