---
/**
 * TechExplicado - Tecnologias explicadas de forma didática para leigos
 */

const techs = [
    {
        emoji: "🚀",
        nome: "Astro 6",
        apelido: '"Motor de Foguete"',
        descricao:
            "A tecnologia mais rápida do mercado. Enquanto outros sites carregam em 3 segundos, o seu carrega em 0.4s.",
        bgColor: "bg-orange-500/10",
        borderColor: "hover:border-orange-500/30",
    },
    {
        emoji: "🛡️",
        nome: "Cloudflare",
        apelido: '"Guarda-Costas Global"',
        descricao:
            "Seu site fica protegido e distribuído em 300+ cidades ao redor do mundo. Impossível cair.",
        bgColor: "bg-blue-500/10",
        borderColor: "hover:border-blue-500/30",
    },
    {
        emoji: "🧠",
        nome: "I.A. Nativa",
        apelido: '"Programador 24/7"',
        descricao:
            "Você conversa, ela programa. Sem precisar entender uma linha de código.",
        bgColor: "bg-purple-500/10",
        borderColor: "hover:border-purple-500/30",
    },
];
---

<section class="py-40 px-6 bg-zinc-950/50 border-y border-white/5">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-20">
            <h2 class="text-5xl md:text-7xl font-black mb-6 uppercase italic">
                A tecnologia que você<br /><span class="text-purple-500"
                    >não precisa entender.</span
                >
            </h2>
            <p class="text-zinc-500 text-xl">
                Mas se quiser saber o que está por trás da mágica...
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                techs.map((t) => (
                    <div
                        class:list={[
                            "p-10 rounded-[3rem] bg-zinc-900 border border-white/5 transition-all group",
                            t.borderColor,
                        ]}
                    >
                        <div
                            class:list={[
                                "w-16 h-16 rounded-2xl flex items-center justify-center text-4xl mb-6 group-hover:scale-110 transition-transform",
                                t.bgColor,
                            ]}
                        >
                            {t.emoji}
                        </div>
                        <h3 class="text-2xl font-black mb-4 italic">
                            {t.nome}
                        </h3>
                        <p class="text-lg text-zinc-400 mb-4">{t.apelido}</p>
                        <p class="text-zinc-500 leading-relaxed">
                            {t.descricao}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
