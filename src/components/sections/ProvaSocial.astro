---
/**
 * ProvaSocial - Depoimentos de usuários
 */

const depoimentos = [
    {
        texto: "Lancei meu portfólio em 2 horas. Meus clientes acharam que eu paguei uma agência cara!",
        nome: "Maria Silva",
        cargo: "Designer Freelancer",
        inicial: "M",
        bgColor: "bg-purple-200",
        textColor: "text-purple-700",
    },
    {
        texto: "Economizei R$ 3.500 que ia gastar com desenvolvedor. O site ficou exatamente como eu queria.",
        nome: "João Costa",
        cargo: "Dono de Pet Shop",
        inicial: "J",
        bgColor: "bg-blue-200",
        textColor: "text-blue-700",
    },
    {
        texto: "Nunca imaginei que criar um site fosse tão simples. Parece conversar no WhatsApp!",
        nome: "Ana Rodrigues",
        cargo: "Fotógrafa",
        inicial: "A",
        bgColor: "bg-pink-200",
        textColor: "text-pink-700",
    },
];
---

<section
    class="py-40 px-6 bg-white text-black rounded-[4rem] md:rounded-[6rem] mx-2 md:mx-6 overflow-hidden"
>
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-20">
            <h2 class="text-5xl md:text-7xl font-black mb-6 uppercase italic">
                Quem já está<br />criando <span class="text-purple-600"
                    >sem código.</span
                >
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                depoimentos.map((d) => (
                    <div class="p-8 rounded-3xl bg-zinc-100 border border-zinc-200">
                        <div class="flex items-center gap-1 mb-4">
                            <span class="text-yellow-500">★★★★★</span>
                        </div>
                        <p class="text-lg font-medium mb-6 italic">
                            "{d.texto}"
                        </p>
                        <div class="flex items-center gap-4">
                            <div
                                class:list={[
                                    "w-12 h-12 rounded-full flex items-center justify-center font-black",
                                    d.bgColor,
                                    d.textColor,
                                ]}
                            >
                                {d.inicial}
                            </div>
                            <div>
                                <p class="font-bold">{d.nome}</p>
                                <p class="text-sm text-zinc-600">{d.cargo}</p>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
