---
/**
 * CasosDeUso - Seção com público-alvo e seus benefícios
 * Freelancers, Pequenos Negócios, Criativos, Educadores
 */

interface CasoDeUso {
    emoji: string;
    titulo: string;
    descricao: string;
    beneficios: string[];
    gradientFrom: string;
    gradientTo: string;
    borderColor: string;
}

const casos: CasoDeUso[] = [
    {
        emoji: "💼",
        titulo: "Freelancers",
        descricao:
            "Mostre seu portfólio com um site que carrega em 0.5 segundos. Impressione clientes antes mesmo da primeira reunião.",
        beneficios: [
            "Portfólio profissional sem custo",
            "Atualize projetos conversando com a I.A.",
        ],
        gradientFrom: "from-purple-900/10",
        gradientTo: "to-blue-900/10",
        borderColor: "hover:border-purple-500/30",
    },
    {
        emoji: "🏪",
        titulo: "Pequenos Negócios",
        descricao:
            "Sua loja, clínica ou escritório merece presença digital. Sem mensalidades, sem complicação.",
        beneficios: [
            "Landing page que converte visitantes em clientes",
            "Formulários de contato integrados",
        ],
        gradientFrom: "from-emerald-900/10",
        gradientTo: "to-teal-900/10",
        borderColor: "hover:border-emerald-500/30",
    },
    {
        emoji: "🎨",
        titulo: "Criativos",
        descricao:
            "Designers, fotógrafos, artistas: seu trabalho merece uma vitrine à altura.",
        beneficios: [
            "Galerias visuais de alto impacto",
            "Design customizável sem limites",
        ],
        gradientFrom: "from-pink-900/10",
        gradientTo: "to-red-900/10",
        borderColor: "hover:border-pink-500/30",
    },
    {
        emoji: "📚",
        titulo: "Educadores",
        descricao:
            "Professores, coaches e mentores: crie páginas de captura para seus cursos e workshops.",
        beneficios: [
            "Landing pages para inscrições",
            "Integração com plataformas de pagamento",
        ],
        gradientFrom: "from-blue-900/10",
        gradientTo: "to-cyan-900/10",
        borderColor: "hover:border-blue-500/30",
    },
];
---

<section class="py-40 px-6 bg-zinc-950/50 border-y border-white/5">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-20">
            <h2 class="text-5xl md:text-7xl font-black mb-6 uppercase italic">
                Feito para quem<br /><span class="text-purple-500"
                    >faz acontecer.</span
                >
            </h2>
            <p class="text-zinc-500 text-xl">
                Não importa seu nicho. Se você tem uma ideia, nós temos o
                caminho.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {
                casos.map((c) => (
                    <div
                        class:list={[
                            "p-10 rounded-[3rem] bg-linear-to-br border border-white/5 transition-all",
                            c.gradientFrom,
                            c.gradientTo,
                            c.borderColor,
                        ]}
                    >
                        <div class="text-5xl mb-6">{c.emoji}</div>
                        <h3 class="text-3xl font-black mb-4 italic">
                            {c.titulo}
                        </h3>
                        <p class="text-zinc-400 text-lg leading-relaxed mb-6">
                            {c.descricao}
                        </p>
                        <ul class="space-y-3 text-zinc-500">
                            {c.beneficios.map((b) => (
                                <li class="flex items-start gap-3">
                                    <span class="text-green-400">✓</span>
                                    <span>{b}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
</section>
