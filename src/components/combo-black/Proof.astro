---
import { Image } from 'astro:assets';
import print2 from '../../assets/images/Prints/depoimento_ntr_2.png';
import print3 from '../../assets/images/Prints/depoimento_ntr_3.png';
import print4 from '../../assets/images/Prints/print_depoimento_4.webp';
import print5 from '../../assets/images/Prints/print_depoimento_5.webp';
import print6 from '../../assets/images/Prints/print_depoimento_6.webp';
import print7 from '../../assets/images/Prints/print_depoimento_7.webp';

const prints = [print2, print7, print3, print4, print5, print6];
---

<section class="py-24 px-4 bg-black">
  <div class="max-w-6xl mx-auto">
    
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-black text-white mb-4 uppercase tracking-tighter italic">
        Veja o que nossos <span class="text-brand-red">alunos dizem:</span>
      </h2>
      <p class="text-gray-400 font-bold uppercase tracking-widest text-xs max-w-2xl mx-auto">
        Já são mais de 12 MIL alunos já transformaram seus resultados com as técnicas NTR
      </p>
    </div>

    {/* Grid de Depoimentos */}
    <div class="columns-1 md:columns-3 gap-6 space-y-6">
      {prints.map((print, i) => (
        <div class="break-inside-avoid bg-[#0a0a0a] border border-white/5 rounded-2xl p-2 overflow-hidden shadow-xl transition-all hover:scale-[1.02]">
           <Image src={print} alt={`Depoimento Aluno ${i + 1}`} class="w-full h-auto rounded-lg" />
        </div>
      ))}
    </div>

  </div>
</section>
