---
import { Image } from "astro:assets";
import print2 from "../../assets/images/Prints/depoimento_ntr_2.png";
import print3 from "../../assets/images/Prints/depoimento_ntr_3.png";
import print4 from "../../assets/images/Prints/print_depoimento_4.webp";
import print5 from "../../assets/images/Prints/print_depoimento_5.webp";
import print6 from "../../assets/images/Prints/print_depoimento_6.webp";
import print7 from "../../assets/images/Prints/print_depoimento_7.webp";

const prints = [print2, print7, print3, print4, print5, print6];
---

<section class="bg-black px-4 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-black tracking-tighter text-white uppercase italic md:text-5xl">
        Veja o que nossos <span class="text-brand-red">alunos dizem:</span>
      </h2>
      <p class="mx-auto max-w-2xl text-xs font-bold tracking-widest text-gray-400 uppercase">
        Já são mais de 12 MIL alunos já transformaram seus resultados com as técnicas NTR
      </p>
    </div>

    {/* Grid de Depoimentos */}
    <div class="columns-1 gap-6 space-y-6 md:columns-3">
      {prints.map((print, i) => (
        <div class="break-inside-avoid overflow-hidden rounded-2xl border border-white/5 bg-[#0a0a0a] p-2 shadow-xl transition-all hover:scale-[1.02]">
          <Image src={print} alt={`Depoimento Aluno ${i + 1}`} class="h-auto w-full rounded-lg" />
        </div>
      ))}
    </div>
  </div>
</section>
