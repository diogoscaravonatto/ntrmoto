---
import { Image } from "astro:assets";
import imgGuia from "../../assets/images/mockup_guia_motores.webp";
import imgFabrica from "../../assets/images/mockup_fabrica_motores.webp";
import imgGrupo from "../../assets/images/mockup_grupo_vip.webp";

const bonuses = [
  {
    tag: "Brinde #1",
    title: "Grupo no Whats",
    desc: "Grupo Vip com outros preparadores para trocar ideias e experiência.",
    bullet: "Aqui não deixamos você sozinho!",
    price: "R$ 97,00",
    img: imgGrupo,
  },
  {
    tag: "Brinde #2",
    title: "GUIA DE MOTORES",
    desc: "Como montar projetos simples de baixo custo que passam fácil dos 200km/h e se tornar referência.",
    bullet: "Aplicação, montagem e preparo 100% prático do início ao fim com testes em dinamômetro",
    price: "R$ 67,00",
    img: imgGuia,
  },
  {
    tag: "Brinde #3",
    title: "Fábrica de Motores",
    desc: "Como montar uma oficina lucrativa, atrair clientes e faturar mais de R$ 10mil/mês com preparação.",
    bullets: [
      "Planilha Financeira - Descubra se tá lucrando ou pagando pra trabalhar, sem precisar fazer conta.",
      "Lista completa de Ferramentas pra começar investindo pouco e sem gastar com besteira.",
    ],
    price: "R$ 97,00",
    img: imgFabrica,
  },
];
---

<section class="bg-black px-4 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mb-16 px-4 text-center">
      <h2 class="mx-auto mb-6 max-w-4xl text-center leading-tight font-black tracking-tighter text-white uppercase italic">
        <span class="text-3xl opacity-90 md:text-4xl lg:text-5xl">
          Além dos cursos, leve mais&nbsp;
        </span>
        <span class="text-3xl text-brand-red md:text-6xl lg:text-7xl">3 brindes exclusivos</span>
      </h2>
      <p class="mx-auto max-w-3xl text-lg font-medium text-gray-400 md:text-xl">
        Fazendo sua inscrição HOJE <span id="current-date" class="font-bold text-white"></span>,
        você ganha vantagens exclusivas para acelerar seus resultados.
      </p>
    </div>

    <div class="mb-16 grid grid-cols-1 gap-8 md:grid-cols-3">
      {bonuses.map((bonus) => (
        <div class="flex flex-col overflow-hidden rounded-3xl bg-white shadow-2xl transition-all hover:scale-[1.02]">
          {/* Header do Card */}
          <div class="bg-brand-red px-6 py-4 text-center">
            <span class="mb-1 block text-xs font-black tracking-widest text-white uppercase opacity-90">
              {bonus.tag}
            </span>
            <h3 class="text-xl font-black tracking-tighter text-white uppercase italic md:text-2xl">
              {bonus.title}
            </h3>
          </div>

          <div class="flex flex-1 flex-col p-8 text-center">
            <p class="mb-8 text-sm leading-tight font-bold text-gray-800 md:text-base">
              {bonus.desc}
            </p>

            <div class="mb-8 flex flex-1 items-center justify-center">
              <Image
                src={bonus.img}
                alt={bonus.title}
                class="h-auto max-h-[220px] w-full object-contain"
              />
            </div>

            <div class="mb-8 space-y-4 text-left">
              {bonus.bullet && (
                <div class="flex items-start gap-2 text-xs font-medium text-gray-700 md:text-sm">
                  <span class="shrink-0 text-brand-red">👉</span>
                  <span>{bonus.bullet}</span>
                </div>
              )}
              {bonus.bullets &&
                bonus.bullets.map((b) => (
                  <div class="flex items-start gap-2 text-xs font-medium text-gray-700 md:text-sm">
                    <span class="shrink-0 text-brand-red">👉</span>
                    <span>{b}</span>
                  </div>
                ))}
            </div>

            <div class="mt-auto border-t border-gray-100 pt-6">
              <p class="text-sm font-bold text-gray-400 uppercase">
                Valor Total: <span class="text-brand-red line-through">{bonus.price}</span>
              </p>
              <p class="mt-1 text-xl font-black tracking-tighter text-gray-900 uppercase italic md:text-2xl">
                HOJE É GRÁTIS!
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center">
      <a
        href="#oferta"
        class="inline-block w-full max-w-lg transform animate-pulse rounded-2xl bg-[#22C55E] px-8 py-6 text-xl font-black tracking-tighter text-white uppercase italic shadow-[0_20px_50px_rgba(34,197,94,0.3)] transition-all hover:-translate-y-2 hover:bg-[#16a34a] md:text-2xl"
      >
        SIM, QUERO GARANTIR OS BRINDES
      </a>
    </div>
  </div>
</section>

<script is:inline>
  function updateDate() {
    const dateElement = document.getElementById("current-date");
    if (!dateElement) return;

    const now = new Date();
    const day = now.getDate();
    const months = [
      "Janeiro",
      "Fevereiro",
      "Março",
      "Abril",
      "Maio",
      "Junho",
      "Julho",
      "Agosto",
      "Setembro",
      "Outubro",
      "Novembro",
      "Dezembro",
    ];
    const month = months[now.getMonth()];

    dateElement.textContent = `${day} de ${month}`;
  }
  updateDate();
</script>
