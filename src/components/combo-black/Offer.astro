---
import { Image } from "astro:assets";
import imgMockup from "../../assets/images/mockup_combo_black.webp";
import imgPgto from "../../assets/images/pag_seguro.png";

const features = [
  { name: "Acesso Vitalício (pra sempre) aos cursos", price: "" },
  { name: "Um ano de suporte para tirar dúvidas", price: "" },
  { name: "Curso Intensivo de Preparação", price: "R$147" },
  { name: "Curso Expert em Cabeçotes", price: "R$197" },
  { name: "Curso Comandos em Ação", price: "R$197" },
  { name: "Curso Acertos Finos", price: "R$97" },
  { name: "Curso de Balanceamento", price: "R$97" },
  { name: "Curso Acerto de Injeção", price: "R$ 197" },
  { name: "Guia Secreto de Motores", price: "R$67" },
  { name: "Fábrica de Motores Lucrativa", price: "R$97" },
  { name: "Planilha Financeira + Guia Ferramentas", price: "R$67" },
];
---

<section id="oferta" class="relative overflow-hidden bg-black px-4 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mb-16 px-4 text-center">
      <h2 class="mx-auto max-w-4xl text-3xl leading-tight font-black tracking-tighter text-white uppercase italic md:text-5xl lg:text-6xl">
        VEJA TUDO QUE ESTÁ INCLUSO NO COMBO NTR <span class="text-brand-red">VITALÍCIO</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
      {/* Coluna Esquerda: Lista de Valores */}
      <div class="space-y-8 text-left">
        <ul class="space-y-4" id="feature-list">
          {features.map((item) => (
            <li class="flex items-center gap-3 text-sm font-medium text-white/90 md:text-base">
              <span class="shrink-0 text-xl font-black text-[#22C55E]">✔</span>
              <span>{item.name}</span>
              {item.price && (
                <span class="relative ml-2 font-bold text-brand-red/80">
                  ({item.price})
                  <span class="absolute inset-x-0 top-1/2 h-[2px] w-full bg-brand-red"></span>
                </span>
              )}
            </li>
          ))}
        </ul>

        <div class="border-t border-white/10 pt-8" id="total-summary">
          <p class="mb-2 text-xl font-bold tracking-tighter text-white uppercase italic md:text-2xl">
            Preço total do Combo:
          </p>
          <div class="relative inline-block text-5xl font-black tracking-tighter text-brand-red italic decoration-8 md:text-7xl">
            R$ 1.299,00
            <span class="absolute inset-x-0 top-1/2 h-2 w-full bg-brand-red"></span>
          </div>
        </div>
      </div>

      {/* Coluna Direita: Card de Oferta Estático */}
      <div
        class="relative rounded-[40px] border-2 border-brand-red bg-white p-8 text-center shadow-[0_0_100px_rgba(255,255,255,0.1)] md:p-12"
        id="offer-card"
      >
        {/* Badge Superior Direito */}
        <div class="absolute top-0 right-0 z-10 rounded-bl-3xl bg-brand-red px-6 py-3 text-[10px] font-black tracking-widest text-white uppercase italic md:text-xs">
          ÚLTIMAS VAGAS COM ACESSO VITALÍCIO
        </div>

        <div class="mt-8 mb-4">
          <Image src={imgMockup} alt="Mockup Combo Black" class="mx-auto h-auto w-full max-w-sm" />
          <h4 class="mt-6 mb-2 text-xl font-black tracking-tighter text-black uppercase italic md:text-2xl">
            LEVE TUDO ISSO AGORA:
          </h4>
        </div>

        <div class="mb-8 space-y-2">
          <p class="text-lg font-bold text-gray-600">
            De <span class="text-gray-400 line-through">R$ 1.299,00</span> por apenas 12x
          </p>
          <div class="flex flex-col">
            <span class="text-7xl leading-none font-black tracking-tighter text-black md:text-8xl">
              R$ 29,90
            </span>
            <p class="mt-2 text-sm font-bold text-gray-500">
              parcelado no cartão ou R$299,00 à vista
            </p>
            <p class="mt-1 text-sm font-bold text-brand-red italic">
              Mais de 77% de desconto com acesso vitalício
            </p>
          </div>
        </div>

        <a
          href="https://sun.eduzz.com/R9JJ47G69X"
          target="_blank"
          class="animate-shake mb-8 inline-block w-full transform rounded-2xl bg-[#65A30D] px-8 py-6 text-xl font-black tracking-tighter text-white uppercase italic shadow-xl transition-all hover:-translate-y-1 hover:bg-[#4d7c0f] md:text-2xl"
        >
          CLIQUE PARA SE INSCREVER
        </a>

        <div class="border-t border-gray-100 pt-6">
          <Image
            src={imgPgto}
            alt="Pagamento Seguro"
            class="mx-auto h-16 w-auto object-contain md:h-20"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes shake {
    0%,
    100% {
      transform: translateX(0) rotate(-1deg);
    }
    25% {
      transform: translateX(-1px) rotate(1deg);
    }
    75% {
      transform: translateX(1px) rotate(-1deg);
    }
  }
  .animate-shake {
    animation: shake 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) infinite;
  }
</style>
