---
// Banner discreto de preferências de cookies (LGPD opt-out suave + Google Consent Mode v2)
// Integrado ao Cloudflare Zaraz CMP (hideModal: true) na zona ntrmoto.com.br.
---

<div id="ntr-cb" class="ntr-cb" role="region" aria-label="Preferências de cookies" hidden>
  <div id="ntr-cb-main" class="ntr-cb__row">
    <p class="ntr-cb__text">
      Usamos cookies para melhorar sua experiência e medir resultados.{" "}
      <a
        href="https://blog.ntrmoto.com.br/pages/privacidade"
        target="_blank"
        rel="noopener noreferrer"
        class="ntr-cb__link"
      >
        Privacidade
      </a>
    </p>
    <div class="ntr-cb__actions">
      <button type="button" id="ntr-cb-cfg" class="ntr-cb__link-btn">
        Configurar
      </button>
      <button type="button" id="ntr-cb-ok" class="ntr-cb__ok">
        OK
      </button>
    </div>
  </div>

  <div id="ntr-cb-prefs" class="ntr-cb__prefs" hidden>
    <div class="ntr-cb__prefs-head">
      <span>Preferências de cookies</span>
      <button type="button" id="ntr-cb-close" class="ntr-cb__link-btn">
        Fechar
      </button>
    </div>
    <label for="ntr-cb-chk-analytics" class="ntr-cb__opt">
      <input type="checkbox" id="ntr-cb-chk-analytics" checked />
      <span class="ntr-cb__opt-text">
        Análise e Desempenho <span class="ntr-cb__sub">— Google Analytics 4</span>
      </span>
    </label>
    <label for="ntr-cb-chk-marketing" class="ntr-cb__opt">
      <input type="checkbox" id="ntr-cb-chk-marketing" checked />
      <span class="ntr-cb__opt-text">
        Marketing e Conversões <span class="ntr-cb__sub">— Meta</span>
      </span>
    </label>
    <div class="ntr-cb__prefs-foot">
      <button type="button" id="ntr-cb-reject" class="ntr-cb__link-btn">
        Rejeitar opcionais
      </button>
      <button type="button" id="ntr-cb-save" class="ntr-cb__ok">
        Salvar
      </button>
    </div>
  </div>
</div>

<script>
  import { CF_CONSENT_COOKIE, NTR_BAR_COOKIE, buildCookieDomainSuffix } from "../utils/tracking";

  type ZarazConsentWindow = Window & {
    __ntrCookieBarInit?: boolean;
    __ntrOpenCookiePrefs?: () => void;
    zaraz?: {
      set?: (key: string, value: unknown, options?: { scope?: string }) => void;
      consent?: {
        APIReady?: boolean;
        getAll?: () => Record<string, boolean>;
        set?: (prefs: Record<string, boolean>) => void;
        setAll?: (status: boolean) => void;
        sendQueuedEvents?: () => void;
      };
    };
  };

  const win = window as ZarazConsentWindow;
  if (!win.__ntrCookieBarInit) {
    win.__ntrCookieBarInit = true;

    const root = document.getElementById("ntr-cb");
    const mainEl = document.getElementById("ntr-cb-main");
    const prefsEl = document.getElementById("ntr-cb-prefs");
    const chkAnalytics = document.getElementById("ntr-cb-chk-analytics") as HTMLInputElement | null;
    const chkMarketing = document.getElementById("ntr-cb-chk-marketing") as HTMLInputElement | null;
    const btnOk = document.getElementById("ntr-cb-ok");
    const btnCfg = document.getElementById("ntr-cb-cfg");
    const btnClose = document.getElementById("ntr-cb-close");
    const btnSave = document.getElementById("ntr-cb-save");
    const btnReject = document.getElementById("ntr-cb-reject");

    function hasCookie(name: string): boolean {
      const prefix = `${name}=`;
      return document.cookie.split(";").some((part) => part.trim().startsWith(prefix));
    }

    function setBarCookie() {
      try {
        const suffix = buildCookieDomainSuffix(window.location.hostname, window.location.protocol);
        document.cookie = `${NTR_BAR_COOKIE}=1${suffix}; Max-Age=31536000`;
      } catch {
        // Ignora erro caso cookies estejam bloqueados
      }
    }

    function updateGoogleConsent(analyticsGranted: boolean, marketingGranted: boolean) {
      try {
        win.zaraz?.set?.("google_consent_update", {
          analytics_storage: analyticsGranted ? "granted" : "denied",
          ad_storage: marketingGranted ? "granted" : "denied",
          ad_user_data: marketingGranted ? "granted" : "denied",
          ad_personalization: marketingGranted ? "granted" : "denied",
        });
      } catch {
        // Ignora erro caso zaraz ainda não esteja pronto
      }
    }

    function syncFromConsentCookie() {
      if (!hasCookie(CF_CONSENT_COOKIE)) return;
      const cur = win.zaraz?.consent?.getAll?.();
      if (!cur) return;
      updateGoogleConsent(cur.analytics === true, cur.marketing === true);
    }

    function ensureDefaultOptOutConsent() {
      const z = win.zaraz;
      if (!z?.consent?.APIReady) return;
      if (!hasCookie(CF_CONSENT_COOKIE)) {
        z.consent.set?.({ analytics: true, marketing: true });
        z.consent.sendQueuedEvents?.();
        updateGoogleConsent(true, true);
      } else {
        syncFromConsentCookie();
      }
    }

    function hideBar() {
      if (!root || !mainEl || !prefsEl) return;
      root.hidden = true;
      prefsEl.hidden = true;
      mainEl.hidden = false;
    }

    function openPrefs() {
      if (!root || !mainEl || !prefsEl) return;
      const cur = win.zaraz?.consent?.getAll?.() ?? {};
      if (chkAnalytics) chkAnalytics.checked = cur.analytics !== false;
      if (chkMarketing) chkMarketing.checked = cur.marketing !== false;
      mainEl.hidden = true;
      prefsEl.hidden = false;
      root.hidden = false;
    }

    win.__ntrOpenCookiePrefs = openPrefs;

    let isTopFrame = true;
    try {
      isTopFrame = window.self === window.top;
    } catch {
      isTopFrame = false;
    }

    if (root && mainEl && prefsEl && isTopFrame && !hasCookie(NTR_BAR_COOKIE)) {
      mainEl.hidden = false;
      prefsEl.hidden = true;
      root.hidden = false;
    }

    btnOk?.addEventListener("click", () => {
      win.zaraz?.consent?.setAll?.(true);
      win.zaraz?.consent?.sendQueuedEvents?.();
      updateGoogleConsent(true, true);
      setBarCookie();
      hideBar();
    });

    btnCfg?.addEventListener("click", openPrefs);

    btnClose?.addEventListener("click", () => {
      if (hasCookie(NTR_BAR_COOKIE)) {
        hideBar();
      } else if (mainEl && prefsEl) {
        prefsEl.hidden = true;
        mainEl.hidden = false;
      }
    });

    btnSave?.addEventListener("click", () => {
      const analytics = chkAnalytics ? chkAnalytics.checked : true;
      const marketing = chkMarketing ? chkMarketing.checked : true;
      win.zaraz?.consent?.set?.({ analytics, marketing });
      if (analytics || marketing) {
        win.zaraz?.consent?.sendQueuedEvents?.();
      }
      updateGoogleConsent(analytics, marketing);
      setBarCookie();
      hideBar();
    });

    btnReject?.addEventListener("click", () => {
      win.zaraz?.consent?.setAll?.(false);
      updateGoogleConsent(false, false);
      setBarCookie();
      hideBar();
    });

    if (win.zaraz?.consent?.APIReady) {
      ensureDefaultOptOutConsent();
    } else {
      document.addEventListener("zarazConsentAPIReady", ensureDefaultOptOutConsent, {
        once: true,
      });
    }
    document.addEventListener("zarazConsentChoicesUpdated", syncFromConsentCookie);
  }
</script>

<style>
  .ntr-cb[hidden],
  .ntr-cb :global([hidden]) {
    display: none !important;
  }

  .ntr-cb {
    position: fixed;
    right: 16px;
    bottom: 16px;
    max-width: 440px;
    z-index: 9999;
    background: #0f1117;
    color: #f4f6fa;
    border: 1px solid #222735;
    border-radius: 10px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    font-family: var(--font-inter, system-ui, -apple-system, sans-serif);
    font-size: 13px;
    line-height: 1.45;
    padding: 12px 14px;
    box-sizing: border-box;
    text-align: left;
  }

  .ntr-cb__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .ntr-cb__text {
    margin: 0;
    color: #f4f6fa;
    flex: 1;
  }

  .ntr-cb__link,
  .ntr-cb__link-btn {
    background: none;
    border: 0;
    padding: 0;
    font-family: inherit;
    font-size: 12px;
    color: #a6adbd;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .ntr-cb__link:hover,
  .ntr-cb__link-btn:hover {
    color: #f4f6fa;
  }

  .ntr-cb__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .ntr-cb__ok {
    background: #c81e1e;
    color: #ffffff;
    border: 0;
    border-radius: 6px;
    padding: 6px 14px;
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .ntr-cb__ok:hover {
    background: #991b1b;
  }

  .ntr-cb__prefs-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    font-weight: 600;
    color: #f4f6fa;
  }

  .ntr-cb__opt {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 6px;
    cursor: pointer;
    color: #f4f6fa;
    font-size: 12.5px;
  }

  .ntr-cb__opt input {
    margin-top: 2px;
    accent-color: #ef4444;
    cursor: pointer;
  }

  .ntr-cb__sub {
    color: #a6adbd;
    font-weight: 400;
  }

  .ntr-cb__opt-text {
    font-weight: 600;
  }

  .ntr-cb__prefs-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 10px;
  }

  @media (max-width: 640px) {
    .ntr-cb {
      left: 12px;
      right: 12px;
      bottom: 12px;
      max-width: none;
    }

    .ntr-cb__row {
      flex-direction: column;
      align-items: flex-start;
    }

    .ntr-cb__actions {
      width: 100%;
      justify-content: flex-end;
    }
  }
</style>
