---
/**
 * SocialProofBar - Barra de prova social compacta
 * Exibe logos, números e estatísticas em uma faixa horizontal
 *
 * @usage
 * <SocialProofBar
 *   stats={[
 *     { value: "500+", label: "Clientes Atendidos" },
 *     { value: "98%", label: "Satisfação" },
 *     { value: "4.9★", label: "Avaliação Google" },
 *   ]}
 * />
 */

interface Stat {
    value: string;
    label: string;
}

interface Props {
    stats: Stat[];
    theme?: "dark" | "light";
}

const { stats, theme = "dark" } = Astro.props;

const isDark = theme === "dark";
---

<div
    class:list={[
        "py-8 px-6 border-y",
        isDark ? "bg-zinc-950/50 border-white/5" : "bg-zinc-50 border-zinc-200",
    ]}
>
    <div class="max-w-6xl mx-auto">
        <div
            class="flex flex-wrap justify-center items-center gap-12 md:gap-20"
        >
            {
                stats.map((stat) => (
                    <div class="text-center">
                        <p
                            class:list={[
                                "text-3xl md:text-4xl font-black",
                                isDark ? "text-white" : "text-zinc-900",
                            ]}
                        >
                            {stat.value}
                        </p>
                        <p
                            class:list={[
                                "text-xs font-bold uppercase tracking-widest mt-1",
                                isDark ? "text-zinc-500" : "text-zinc-500",
                            ]}
                        >
                            {stat.label}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</div>
