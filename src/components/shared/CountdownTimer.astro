---
/**
 * CountdownTimer - Timer de urgência/escassez
 * Usa JavaScript client-side para contagem regressiva
 *
 * @usage
 * <CountdownTimer
 *   endDate="2026-03-15T23:59:59"
 *   title="Oferta expira em:"
 * />
 *
 * Ou com duração fixa:
 * <CountdownTimer
 *   hours={24}
 *   title="Esta promoção acaba em:"
 * />
 */

interface Props {
    /** Data/hora final no formato ISO (ex: 2026-03-15T23:59:59) */
    endDate?: string;
    /** Duração em horas a partir do primeiro acesso (usa localStorage) */
    hours?: number;
    /** Título acima do timer */
    title?: string;
    theme?: "dark" | "light";
}

const {
    endDate,
    hours,
    title = "Oferta por tempo limitado:",
    theme = "dark",
} = Astro.props;

const isDark = theme === "dark";
const endDateStr = endDate || "";
const hoursNum = hours || 0;
---

<div
    class:list={[
        "py-6 px-6 text-center",
        isDark
            ? "bg-zinc-900 border-y border-white/10"
            : "bg-zinc-100 border-y border-zinc-200",
    ]}
    data-countdown
    data-end-date={endDateStr}
    data-hours={hoursNum}
>
    <p
        class:list={[
            "text-sm font-bold uppercase tracking-widest mb-3",
            isDark ? "text-zinc-400" : "text-zinc-600",
        ]}
    >
        {title}
    </p>
    <div class="flex justify-center items-center gap-4">
        <div class="text-center">
            <span
                class:list={[
                    "block text-3xl md:text-4xl font-black tabular-nums",
                    isDark ? "text-white" : "text-zinc-900",
                ]}
                data-days
            >
                00
            </span>
            <span
                class:list={[
                    "text-[10px] font-bold uppercase tracking-widest",
                    isDark ? "text-zinc-600" : "text-zinc-400",
                ]}
            >
                Dias
            </span>
        </div>
        <span
            class:list={[
                "text-2xl font-black -mt-4",
                isDark ? "text-zinc-700" : "text-zinc-300",
            ]}
        >
            :
        </span>
        <div class="text-center">
            <span
                class:list={[
                    "block text-3xl md:text-4xl font-black tabular-nums",
                    isDark ? "text-white" : "text-zinc-900",
                ]}
                data-hours
            >
                00
            </span>
            <span
                class:list={[
                    "text-[10px] font-bold uppercase tracking-widest",
                    isDark ? "text-zinc-600" : "text-zinc-400",
                ]}
            >
                Horas
            </span>
        </div>
        <span
            class:list={[
                "text-2xl font-black -mt-4",
                isDark ? "text-zinc-700" : "text-zinc-300",
            ]}
        >
            :
        </span>
        <div class="text-center">
            <span
                class:list={[
                    "block text-3xl md:text-4xl font-black tabular-nums",
                    isDark ? "text-white" : "text-zinc-900",
                ]}
                data-minutes
            >
                00
            </span>
            <span
                class:list={[
                    "text-[10px] font-bold uppercase tracking-widest",
                    isDark ? "text-zinc-600" : "text-zinc-400",
                ]}
            >
                Min
            </span>
        </div>
        <span
            class:list={[
                "text-2xl font-black -mt-4",
                isDark ? "text-zinc-700" : "text-zinc-300",
            ]}
        >
            :
        </span>
        <div class="text-center">
            <span
                class:list={[
                    "block text-3xl md:text-4xl font-black tabular-nums text-red-500",
                ]}
                data-seconds
            >
                00
            </span>
            <span
                class:list={[
                    "text-[10px] font-bold uppercase tracking-widest",
                    isDark ? "text-zinc-600" : "text-zinc-400",
                ]}
            >
                Seg
            </span>
        </div>
    </div>
</div>

<script>
    function initCountdown() {
        const el = document.querySelector("[data-countdown]") as HTMLElement;
        if (!el) return;

        const endDateStr = el.dataset.endDate;
        const hoursStr = el.dataset.hours;
        let targetTime: number;

        if (endDateStr) {
            targetTime = new Date(endDateStr).getTime();
        } else if (hoursStr && Number(hoursStr) > 0) {
            const storageKey = "countdown_target";
            const stored = localStorage.getItem(storageKey);
            if (stored) {
                targetTime = Number(stored);
            } else {
                targetTime = Date.now() + Number(hoursStr) * 60 * 60 * 1000;
                localStorage.setItem(storageKey, String(targetTime));
            }
        } else {
            return;
        }

        const daysEl = el.querySelector("[data-days]");
        const hoursEl = el.querySelector("[data-hours]");
        const minutesEl = el.querySelector("[data-minutes]");
        const secondsEl = el.querySelector("[data-seconds]");

        function update() {
            const diff = Math.max(0, targetTime - Date.now());
            const d = Math.floor(diff / (1000 * 60 * 60 * 24));
            const h = Math.floor((diff / (1000 * 60 * 60)) % 24);
            const m = Math.floor((diff / (1000 * 60)) % 60);
            const s = Math.floor((diff / 1000) % 60);

            if (daysEl) daysEl.textContent = String(d).padStart(2, "0");
            if (hoursEl) hoursEl.textContent = String(h).padStart(2, "0");
            if (minutesEl) minutesEl.textContent = String(m).padStart(2, "0");
            if (secondsEl) secondsEl.textContent = String(s).padStart(2, "0");

            // Parar o timer quando chegar a zero
            if (diff <= 0 && intervalId) {
                clearInterval(intervalId);
            }
        }

        update();
        const intervalId = setInterval(update, 1000);
    }

    document.addEventListener("DOMContentLoaded", initCountdown);
</script>
