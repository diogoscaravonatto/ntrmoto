---
/**
 * Testimonials - Grid de depoimentos reutilizável
 * Suporta qualquer número de depoimentos com avatar
 *
 * @usage
 * <Testimonials
 *   items={[
 *     { texto: "Excelente!", nome: "Maria", cargo: "Designer", avatar: "M" },
 *   ]}
 *   title="O que nossos clientes dizem"
 * />
 */

interface Depoimento {
    texto: string;
    nome: string;
    cargo?: string;
    /** Inicial ou URL de imagem */
    avatar?: string;
    /** Avaliação de 1 a 5 */
    rating?: number;
}

interface Props {
    items: Depoimento[];
    title?: string;
    theme?: "dark" | "light";
    /** Número de colunas no desktop */
    columns?: 2 | 3;
}

const {
    items,
    title = "O que nossos clientes dizem",
    theme = "dark",
    columns = 3,
} = Astro.props;

const isDark = theme === "dark";
const gridCols = columns === 2 ? "md:grid-cols-2" : "md:grid-cols-3";
---

<section class="py-20 px-6">
    <div class="max-w-6xl mx-auto">
        {
            title && (
                <h2
                    class:list={[
                        "text-4xl md:text-5xl font-black mb-16 text-center",
                        isDark ? "text-white" : "text-zinc-900",
                    ]}
                >
                    {title}
                </h2>
            )
        }

        <div class:list={["grid grid-cols-1 gap-6", gridCols]}>
            {
                items.map((d) => (
                    <div
                        class:list={[
                            "p-8 rounded-3xl border",
                            isDark
                                ? "bg-zinc-900/50 border-white/10"
                                : "bg-zinc-50 border-zinc-200",
                        ]}
                    >
                        {d.rating && (
                            <div class="flex items-center gap-0.5 mb-4">
                                {Array.from({ length: d.rating }).map(() => (
                                    <span class="text-yellow-500">★</span>
                                ))}
                                {Array.from({ length: 5 - d.rating }).map(
                                    () => (
                                        <span class="text-zinc-600">★</span>
                                    ),
                                )}
                            </div>
                        )}

                        <p
                            class:list={[
                                "text-lg mb-6 italic leading-relaxed",
                                isDark ? "text-zinc-300" : "text-zinc-700",
                            ]}
                        >
                            "{d.texto}"
                        </p>

                        <div class="flex items-center gap-4">
                            <div
                                class:list={[
                                    "w-12 h-12 rounded-full flex items-center justify-center font-black text-sm shrink-0",
                                    isDark
                                        ? "bg-purple-500/20 text-purple-300"
                                        : "bg-purple-100 text-purple-700",
                                ]}
                            >
                                {d.avatar || d.nome.charAt(0)}
                            </div>
                            <div>
                                <p
                                    class:list={[
                                        "font-bold",
                                        isDark ? "text-white" : "text-zinc-900",
                                    ]}
                                >
                                    {d.nome}
                                </p>
                                {d.cargo && (
                                    <p
                                        class:list={[
                                            "text-sm",
                                            isDark
                                                ? "text-zinc-500"
                                                : "text-zinc-500",
                                        ]}
                                    >
                                        {d.cargo}
                                    </p>
                                )}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
