---
/**
 * FAQAccordion - Componente de FAQ com accordion nativo
 * Usa <details>/<summary> para zero JavaScript
 *
 * @usage
 * <FAQAccordion
 *   items={[
 *     { pergunta: "Qual o prazo?", resposta: "Entregamos em 7 dias úteis." },
 *     { pergunta: "Tem garantia?", resposta: "Sim, 30 dias de garantia." },
 *   ]}
 *   theme="dark"
 * />
 */

interface FAQItem {
    pergunta: string;
    resposta: string;
}

interface Props {
    items: FAQItem[];
    /** Título da seção (opcional) */
    title?: string;
    /** Tema visual */
    theme?: "dark" | "light";
}

const { items, title = "Perguntas Frequentes", theme = "dark" } = Astro.props;

const isDark = theme === "dark";
---

<section class="py-20 px-6">
    <div class="max-w-4xl mx-auto">
        {
            title && (
                <h2
                    class:list={[
                        "text-4xl md:text-5xl font-black mb-12 text-center",
                        isDark ? "text-white" : "text-zinc-900",
                    ]}
                >
                    {title}
                </h2>
            )
        }

        <div class="space-y-4">
            {
                items.map((item) => (
                    <details
                        class:list={[
                            "group rounded-2xl border cursor-pointer transition-all",
                            isDark
                                ? "bg-zinc-900/50 border-white/10 open:bg-zinc-800/80"
                                : "bg-white border-zinc-200 open:bg-zinc-50",
                        ]}
                    >
                        <summary
                            class:list={[
                                "list-none flex justify-between items-center p-6 text-lg font-bold [&::-webkit-details-marker]:hidden",
                                isDark ? "text-white" : "text-zinc-900",
                            ]}
                        >
                            {item.pergunta}
                            <span
                                class:list={[
                                    "text-xl group-open:rotate-45 transition-transform shrink-0 ml-4",
                                    isDark
                                        ? "text-purple-400"
                                        : "text-purple-600",
                                ]}
                            >
                                +
                            </span>
                        </summary>
                        <p
                            class:list={[
                                "px-6 pb-6 leading-relaxed",
                                isDark ? "text-zinc-400" : "text-zinc-600",
                            ]}
                        >
                            {item.resposta}
                        </p>
                    </details>
                ))
            }
        </div>
    </div>
</section>
