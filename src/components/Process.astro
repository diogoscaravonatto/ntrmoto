---
import { vetPragasData } from "./content";
import { Image } from "astro:assets";
import inspecaoImg from "@assets/images/inspecao.png";
import planoImg from "@assets/images/plano.png";
import aplicacaoImg from "@assets/images/aplicacao.png";
import monitoramentoImg from "@assets/images/monitoramento.png";

const stepIcons = [inspecaoImg, planoImg, aplicacaoImg, monitoramentoImg];
---

<section id="metodologia" class="py-24 bg-slate-50 relative overflow-hidden">
  <div class="container mx-auto px-6">
    <div class="text-left md:text-center max-w-3xl md:mx-auto mb-20">
      <div class="inline-flex items-center px-3 py-1 bg-accent/10 border border-accent/20 rounded-lg mb-4">
        <span class="text-[10px] font-black text-accent-dark uppercase tracking-wider">
          DEDETIZAÇÃO RÁPIDA EM 4 ETAPAS
        </span>
      </div>
      <h2 class="text-4xl lg:text-7xl font-black text-slate-900 mt-4 mb-8 uppercase tracking-tighter leading-none">
        PROTOCOLOS DE <br /><span class="text-accent">NEUTRALIZAÇÃO</span>
      </h2>
      <p class="text-lg text-slate-500 font-bold leading-relaxed">Garantimos um ambiente seguro através de processos rigorosos e altamente eficientes, veja como funciona:</p>
    </div>

    <div class="grid lg:grid-cols-4 gap-10 lg:gap-12 relative mt-24">
      
      <!-- Desktop Connection Line (Single Long Path) -->
      <div class="hidden lg:block absolute top-[64px] left-[10%] right-[10%] h-[4px] z-0 overflow-visible pointer-events-none">
        <svg class="w-full h-full overflow-visible" preserveAspectRatio="none">
          <!-- Light Gray Dots Rail -->
          <line x1="0" y1="2" x2="100%" y2="2" stroke="#e2e8f0" stroke-width="4" stroke-dasharray="0.1 16" stroke-linecap="round" />
          <!-- Thinner Red Laser (Perfectly Synchronized) -->
          <line 
            x1="0" y1="2" x2="100%" y2="2" 
            pathLength="100"
            stroke="#ef4444" 
            stroke-width="2" 
            stroke-dasharray="100" 
            stroke-dashoffset="100"
            stroke-linecap="round"
            class="animate-path-flow"
          />
        </svg>
      </div>

      {vetPragasData.process.steps.map((step, index) => (
        <div class="relative flex flex-row lg:flex-col items-start lg:items-center text-left lg:text-center group z-10 gap-6 sm:gap-8">
          
          <!-- Mobile Connector (Synchronized Segment) -->
          {index < vetPragasData.process.steps.length - 1 && (
            <div class="lg:hidden absolute top-24 h-16 left-12 sm:left-16 w-[4px] -translate-x-1/2 z-0 overflow-visible pointer-events-none">
               <svg class="w-full h-full overflow-visible">
                 <!-- Dotted Gray Base -->
                 <line x1="2" y1="0" x2="2" y2="100%" stroke="#e2e8f0" stroke-width="4" stroke-dasharray="0.1 16" stroke-linecap="round" />
                 <!-- Fast Sync Red Line -->
                 <line 
                   x1="2" y1="0" x2="2" y2="100%" 
                   pathLength="100"
                   stroke="#ef4444" 
                   stroke-width="2" 
                   stroke-dasharray="100" 
                   stroke-dashoffset="100"
                   stroke-linecap="round"
                   class="animate-mobile-path-flow"
                   style={`animation-delay: ${index * 2}s`}
                 />
               </svg>
            </div>
          )}

          <!-- Card (Icon) -->
          <div class="shrink-0 w-24 h-24 lg:w-32 lg:h-32 mb-0 lg:mb-8 relative">
             <div class="absolute inset-0 bg-white border-2 border-slate-200 rounded-3xl lg:rounded-4xl shadow-xl shadow-slate-200/50"></div>
             
             <!-- Activation Pulse -->
             <div 
                class="absolute inset-[-6px] rounded-[1.8rem] lg:rounded-[2.5rem] border-2 border-accent opacity-0 animate-coordinated-pulse pointer-events-none"
                style={`animation-delay: ${index * 2}s`}
             ></div>

             <!-- Number Badge -->
             <div class="absolute -top-1 -right-1 w-8 h-8 lg:w-10 lg:h-10 bg-accent text-white rounded-xl lg:rounded-2xl flex items-center justify-center font-black text-sm lg:text-lg z-20 shadow-lg shadow-accent/20">
               {step.number}
             </div>

             <!-- Content Image -->
             <div class="relative w-full h-full flex items-center justify-center z-10 group-hover:scale-110 transition-transform duration-500">
              <!-- Icons Using Next Gen Optimisation -->
              <Image src={stepIcons[index]} alt={step.title} width="128" height="128" loading="lazy" decoding="async" class="w-10 h-10 lg:w-16 lg:h-16 relative z-10 drop-shadow-md group-hover:scale-110 transition-transform duration-500" />
             </div>
          </div>

          <!-- Description (Aligned to top) -->
          <div class="flex-1 min-w-0 pt-1 lg:pt-0">
            <h3 
              class="text-lg lg:text-xl font-black text-slate-900 mb-2 lg:mb-4 uppercase tracking-tight animate-coordinated-title"
              style={`animation-delay: ${index * 2}s`}
            >
              {step.title}
            </h3>
            <p class="text-slate-500 text-xs lg:text-sm leading-relaxed font-medium lg:mx-auto overflow-hidden">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Common Cycle: 8s total. 2s per step (25% of 8s). */

  @keyframes path-flow {
    0% { stroke-dashoffset: 100; opacity: 1; }
    /* Desktop line covers all 4 cards in 6s (75% of 8s) */
    75% { stroke-dashoffset: 0; opacity: 1; }
    80%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }

  @keyframes mobile-path-flow {
    0% { stroke-dashoffset: 100; opacity: 0; }
    2% { opacity: 1; }
    /* Mobile segment only covers the distance between TWO cards. */
    /* This must happen in the 2s gap (exactly 25% of the 8s cycle). */
    25% { stroke-dashoffset: 0; opacity: 1; }
    30%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }

  @keyframes coordinated-pulse {
    0% { opacity: 0; transform: scale(0.95); }
    8%, 18% { opacity: 1; transform: scale(1); border-color: rgba(239, 68, 68, 0.8); box-shadow: 0 0 35px rgba(239, 68, 68, 0.6); }
    25%, 100% { opacity: 0; transform: scale(1.05); }
  }

  @keyframes coordinated-title {
    0% { color: #0f172a; transform: scale(1); }
    8%, 18% { color: #ef4444; transform: scale(1.05); }
    25%, 100% { color: #0f172a; transform: scale(1); }
  }

  .animate-path-flow {
    animation: path-flow 8s linear infinite;
  }

  .animate-mobile-path-flow {
    animation: mobile-path-flow 8s linear infinite;
  }

  .animate-coordinated-pulse {
    animation: coordinated-pulse 8s linear infinite;
  }

  .animate-coordinated-title {
    animation: coordinated-title 8s linear infinite;
  }
</style>
