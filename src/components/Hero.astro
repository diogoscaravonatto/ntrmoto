---
import { Image } from "astro:assets";
// Import the image provided by the user
import heroIndustrial from "@assets/images/hero-industrial.png";
import { vetPragasData } from "./content";
---

<section
    class="relative min-h-[90vh] flex items-center pt-32 pb-24 overflow-hidden bg-primary"
>
    <!-- Geometric Brand Background (Bornx Style) -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
        <div
            class="absolute top-0 right-0 w-1/2 h-full bg-primary-dark skew-x-[-15deg] origin-top translate-x-1/4 opacity-50"
        >
        </div>
        <!-- Support Pattern -->
        <div class="absolute inset-0 bg-brand-pattern opacity-10"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <!-- Left Content: High Contrast White/Red on Blue -->
            <div class="max-w-2xl animate-reveal">
                <h2
                    id="geo-city"
                    class="inline-flex items-center gap-2 px-3 py-1 bg-[#FDF3F4] border border-accent/30 text-accent text-[10px] font-black uppercase tracking-[0.3em] mb-8 rounded-sm transition-all duration-700"
                >
                    DEDETIZADORA EM CASCAVEL E REGIÃO
                </h2>

                <h1
                    class="text-[2.75rem] md:text-6xl lg:text-7xl font-black text-white leading-[1.05] md:leading-[0.95] mb-8 tracking-tighter uppercase animate-reveal"
                    style="animation-delay: 0.1s;"
                    set:html={vetPragasData.hero.title}
                />

                <!-- Mobile Image: High impact visible only on smaller screens -->
                <div
                    class="lg:hidden mb-12 animate-reveal"
                    style="animation-delay: 0.1s;"
                >
                    <div
                        class="relative rounded-3xl overflow-hidden shadow-[0_30px_60px_rgba(0,0,0,0.4)] border border-white/10 bg-slate-900"
                    >
                        <Image
                            src={heroIndustrial}
                            alt="VetPragas Mobile Control"
                            class="w-full aspect-4/3 object-cover opacity-90"
                            loading="eager"
                            fetchpriority="high"
                            decoding="async"
                        />
                        <!-- Tech Overlay Gradient -->
                        <div
                            class="absolute inset-0 bg-linear-to-tr from-primary via-transparent to-accent/10 mix-blend-overlay"
                        >
                        </div>
                        <div
                            class="absolute inset-0 bg-linear-to-t from-primary/80 via-transparent to-transparent"
                        >
                        </div>

                        <!-- Subtle Glow for original image icons -->
                        <div
                            class="absolute bottom-6 left-0 right-0 z-10 flex justify-around items-center px-6 pointer-events-none"
                        >
                            {
                                [1, 2, 3, 4, 5].map((_) => (
                                    <div class="w-10 h-10 bg-accent/80 blur-2xl rounded-full animate-pulse" />
                                ))
                            }
                        </div>

                        <!-- Effect 3: Holographic HUD Overlay (TOP LAYER) -->
                        <div
                            class="absolute inset-0 z-20 pointer-events-none overflow-hidden"
                        >
                            <div class="hologram-scan"></div>
                            <div class="hologram-corners"></div>

                            <!-- New Protection Status Badge -->
                            <div class="protection-status">
                                <span>PROTEÇÃO 24H</span>
                                <div class="flex items-center">
                                    <span class="status-dot mr-2"></span>
                                    <span class="text-accent">ATIVADA</span>
                                </div>
                            </div>

                            <div class="target-point top-1/4 left-1/3">
                                <div class="target-ring"></div>
                                <div class="target-ping"></div>
                            </div>
                            <div class="target-point bottom-1/3 right-1/4">
                                <div class="target-ring"></div>
                                <div class="target-ping"></div>
                            </div>
                            <div class="target-point top-1/2 right-1/3">
                                <div class="target-ring"></div>
                                <div class="target-ping"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <p
                    class="text-xl text-slate-300 mb-10 leading-relaxed max-w-2xl font-medium"
                >
                    Controle de pragas profissional com supervisão veterinária,
                    certificação ISO 9001, especializada em dedetização de <span
                        id="rotating-word"
                        class="text-accent font-black transition-opacity duration-500"
                        >casas e apartamentos</span
                    >
                </p>

                <div class="flex flex-col sm:flex-row gap-5">
                    <a
                        href="https://wa.me/5545991586405"
                        class="px-10 py-5 bg-accent text-white font-bold text-sm uppercase tracking-widest rounded-xl hover:bg-accent-dark transition-all shadow-2xl shadow-accent/20 hover:-translate-y-1 text-center"
                    >
                        {vetPragasData.hero.cta}
                    </a>
                </div>
            </div>

            <!-- Right Content: The Industrial Tech Visual -->
            <div
                class="relative hidden lg:block animate-reveal"
                style="animation-delay: 0.2s;"
            >
                <div
                    class="relative rounded-[3rem] overflow-hidden shadow-[0_50px_100px_rgba(0,0,0,0.5)] group border border-white/10 bg-slate-900"
                >
                    <!-- The user Image placeholder -->
                    <Image
                        src={heroIndustrial}
                        alt="VetPragas Industrial High-Tech Control"
                        class="w-full aspect-4/3 object-cover opacity-90 transition-transform duration-1000 group-hover:scale-105"
                        loading="eager"
                        fetchpriority="high"
                        decoding="async"
                    />

                    <!-- Tech Overlay Gradient -->
                    <div
                        class="absolute inset-0 bg-linear-to-tr from-primary via-transparent to-accent/10 mix-blend-overlay"
                    >
                    </div>
                    <div
                        class="absolute inset-0 bg-linear-to-t from-primary/80 via-transparent to-transparent"
                    >
                    </div>

                    <!-- Glowing Elements -->
                    <div
                        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-[radial-gradient(circle_at_center,rgba(216,22,36,0.1),transparent_70%)] pointer-events-none"
                    >
                    </div>

                    <!-- Subtle Glow for original image icons -->
                    <div
                        class="absolute bottom-10 left-10 right-10 z-10 flex gap-12 items-center pointer-events-none"
                    >
                        {
                            [1, 2, 3, 4, 5].map((_) => (
                                <div class="w-16 h-16 bg-accent/80 blur-[40px] rounded-full animate-pulse" />
                            ))
                        }
                    </div>

                    <!-- Effect 3: Holographic HUD Overlay (TOP LAYER) -->
                    <div
                        class="absolute inset-0 z-20 pointer-events-none overflow-hidden"
                    >
                        <div class="hologram-scan"></div>
                        <div class="hologram-corners"></div>

                        <!-- New Protection Status Badge -->
                        <div class="protection-status">
                            <span>PROTEÇÃO 24H</span>
                            <div class="flex items-center">
                                <span class="status-dot mr-2"></span>
                                <span class="text-accent">ATIVADA</span>
                            </div>
                        </div>

                        <div class="target-point top-1/4 left-1/3">
                            <div class="target-ring"></div>
                            <div class="target-ping"></div>
                        </div>
                        <div class="target-point bottom-1/3 right-1/4">
                            <div class="target-ring"></div>
                            <div class="target-ping"></div>
                        </div>
                        <div class="target-point top-1/2 right-1/3">
                            <div class="target-ring"></div>
                            <div class="target-ping"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Bornx & Jitec Style Reveal */
    .animate-reveal {
        opacity: 0;
        transform: translateY(30px);
        animation: reveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes reveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Effect 3: Holographic HUD Styles - Refined & High Contrast */
    .hologram-scan {
        position: absolute;
        width: 100%;
        height: 120px;
        background: linear-gradient(
            to bottom,
            transparent,
            rgba(216, 22, 36, 0.1),
            rgba(216, 22, 36, 0.4),
            transparent
        );
        top: -120px;
        left: 0;
        animation: scan-move 8s ease-in-out infinite;
        border-bottom: 2px solid rgba(216, 22, 36, 0.6);
        box-shadow: 0 10px 40px rgba(216, 22, 36, 0.2);
    }

    /* Protection Status Style - Black Tech Edition */
    .protection-status {
        position: absolute;
        top: 25px;
        right: 25px;
        background: #000;
        color: white;
        padding: 10px 18px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 950;
        line-height: 1.2;
        letter-spacing: 0.15em;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
        box-shadow:
            0 0 25px rgba(216, 22, 36, 0.4),
            inset 0 0 0 1px rgba(216, 22, 36, 0.3);
        opacity: 0;
        transform: translateY(-10px);
        animation: status-reveal 8s ease-out forwards infinite;
        z-index: 100 !important;
        white-space: nowrap;
    }

    /* Mobile position adjustment to avoid overlap */
    @media (max-width: 1024px) {
        .protection-status {
            top: 15px;
            right: 15px;
            padding: 8px 14px;
            font-size: 9px;
        }
    }

    .status-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        background: #d81624;
        border-radius: 50%;
        box-shadow: 0 0 12px #d81624;
        animation: blink 0.8s ease-in-out infinite;
    }

    @keyframes status-reveal {
        0%,
        40% {
            opacity: 0;
            transform: translateY(-10px) scale(0.9);
            box-shadow: 0 0 0px rgba(216, 22, 36, 0);
        }
        45% {
            opacity: 1;
            transform: translateY(0) scale(1);
            box-shadow: 0 0 30px rgba(216, 22, 36, 0.8);
        }
        50%,
        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
            /* Pulsing effect while visible */
            box-shadow: 0 0 15px rgba(216, 22, 36, 0.4);
        }
    }

    @keyframes blink {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.5;
            transform: scale(1.2);
        }
    }

    .target-point {
        position: absolute;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 30;
    }

    /* Sniper-style Crosshair Lines */
    .target-point::before {
        content: "";
        position: absolute;
        width: 100%;
        height: 1.5px;
        background: radial-gradient(
            circle,
            #d81624 30%,
            transparent 30%,
            transparent 70%,
            #d81624 70%
        );
        opacity: 0.9;
        box-shadow: 0 0 10px rgba(216, 22, 36, 0.5);
    }

    .target-point::after {
        content: "";
        position: absolute;
        height: 100%;
        width: 1.5px;
        background: radial-gradient(
            circle,
            #d81624 30%,
            transparent 30%,
            transparent 70%,
            #d81624 70%
        );
        opacity: 0.9;
        box-shadow: 0 0 10px rgba(216, 22, 36, 0.5);
    }

    /* Realistic Target Segments (Rotating broken circle) */
    .target-ring {
        position: absolute;
        inset: 0;
        border: 2px solid transparent;
        border-top-color: #d81624;
        border-bottom-color: #d81624;
        border-radius: 50%;
        animation: rotate-target 4s linear infinite;
        opacity: 0.8;
        box-shadow: 0 0 15px rgba(216, 22, 36, 0.4);
    }

    .target-ping {
        position: absolute;
        inset: -10px;
        border: 1.5px solid rgba(216, 22, 36, 0.6);
        border-radius: 50%;
        animation: h-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    .hologram-corners::before,
    .hologram-corners::after {
        content: "";
        position: absolute;
        width: 60px;
        height: 60px;
        border-color: #d81624;
        opacity: 0.3;
    }

    .hologram-corners::before {
        top: 30px;
        left: 30px;
        border-top: 2px solid;
        border-left: 2px solid;
    }

    .hologram-corners::after {
        bottom: 30px;
        right: 30px;
        border-bottom: 2px solid;
        border-right: 2px solid;
    }

    @keyframes rotate-target {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }

    @keyframes scan-move {
        0% {
            top: -120px;
        }
        100% {
            top: 100%;
        }
    }
    /* Futuristic Typewriter Cursor */
    .typing::after {
        content: "|";
        display: inline-block;
        margin-left: 2px;
        color: #d81624;
        animation: cursor-blink 0.8s infinite;
    }

    @keyframes cursor-blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }
</style>

<script>
    async function initGeo() {
        const geoElement = document.getElementById("geo-city");
        if (!geoElement) return;

        const defaultText = "DEDETIZADORA EM CASCAVEL E REGIÃO";

        try {
            // Busca a localização com timeout para não travar a página
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 3500);

            // Utilizando ipinfo.io por ter maior precisão de IP no Brasil
            const response = await fetch("https://ipinfo.io/json", {
                signal: controller.signal,
            });
            const data = await response.json();
            clearTimeout(timeoutId);

            if (data && data.city && data.region) {
                // Verifica se o estado é Paraná (proteção contra IPs de 4G roteados por SP/RJ)
                if (data.region.includes("Paraná") || data.region === "PR") {
                    // Cidades de cobertura (Oeste do Paraná)
                    const validCities = [
                        "Cascavel",
                        "Toledo",
                        "Foz do Iguaçu",
                        "Medianeira",
                        "Santa Tereza do Oeste",
                        "Corbélia",
                        "Céu Azul",
                        "Matelândia",
                        "Palotina",
                        "Marechal Cândido Rondon",
                        "Assis Chateaubriand",
                        "Guaíra",
                        "Santa Helena",
                        "Capitão Leônidas Marques",
                        "Lindoeste",
                        "Tupãssi",
                        "Ubiratã",
                        "Quedas do Iguaçu",
                        "São Miguel do Iguaçu",
                        "Itaipulândia",
                        "Missal",
                        "Nova Aurora",
                        "Capanema",
                    ];

                    const city = data.city;
                    const isCovered = validCities.some(
                        (c) => c.toLowerCase() === city.toLowerCase(),
                    );

                    // Só exibe a cidade geolocalizada se ela estiver na lista de cobertura real
                    if (isCovered) {
                        geoElement.textContent = `DEDETIZADORA EM ${city.toUpperCase()} E REGIÃO`;
                        geoElement.classList.add(
                            "bg-[#FDF3F4]",
                            "border-accent/40",
                        );
                        return; // Sai da função, sucesso!
                    }
                }
            }

            // Fallback silencioso para Cascavel se a cidade não for da área de atuação
            geoElement.textContent = defaultText;
        } catch {
            geoElement.textContent = defaultText;
        }
    }

    // Função para rotacionar palavras com efeito de digitação
    async function rotateWords() {
        const rotatingElement = document.getElementById("rotating-word");
        if (!rotatingElement) return;

        const words = [
            "casas e apartamentos",
            "condomínios",
            "restaurantes",
            "indústrias",
            "empresas em geral",
        ];
        let wordIndex = 0;

        async function typeWord(word: string) {
            for (let i = 0; i <= word.length; i++) {
                if (!rotatingElement) return;
                rotatingElement.textContent = word.substring(0, i);
                await new Promise((resolve) => setTimeout(resolve, 100));
            }
        }

        async function deleteWord(word: string) {
            for (let i = word.length; i >= 0; i--) {
                if (!rotatingElement) return;
                rotatingElement.textContent = word.substring(0, i);
                await new Promise((resolve) => setTimeout(resolve, 50));
            }
        }

        while (true) {
            const currentWord = words[wordIndex];

            // Adiciona classe de digitação (opcional para o cursor)
            rotatingElement.classList.add("typing");

            await typeWord(currentWord);
            await new Promise((resolve) => setTimeout(resolve, 2000)); // Tempo visível
            await deleteWord(currentWord);

            rotatingElement.classList.remove("typing");
            await new Promise((resolve) => setTimeout(resolve, 500)); // Pausa antes da próxima

            wordIndex = (wordIndex + 1) % words.length;
        }
    }

    // Força o scroll para o topo imediatamente e após um breve delay
    if (typeof window !== "undefined" && !window.location.hash) {
        window.scrollTo(0, 0);
        if ("scrollRestoration" in history) {
            history.scrollRestoration = "manual";
        }
    }

    function init() {
        initGeo();
        rotateWords();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }
</script>
