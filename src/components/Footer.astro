---
import { Image } from "astro:assets";
import texturaIdImg from "@assets/images/vetpragas-textura-id.png";
---

<footer
    id="contato"
    class="bg-primary pt-24 pb-0 relative overflow-hidden text-white"
>
    <!-- Main Background Texture (Proporcional Desktop e Mobile) -->
    <Image
        src={texturaIdImg}
        alt=""
        format="webp"
        loading="lazy"
        decoding="async"
        class="absolute bottom-0 right-0 w-[300px] sm:w-[350px] lg:w-[600px] max-h-[90%] lg:max-h-[95%] object-contain object-bottom pointer-events-none z-0 opacity-20 lg:opacity-100"
    />

    <div class="container mx-auto px-6 relative z-10 pb-32 lg:pb-12">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 mb-4">
            <!-- Brand Column -->
            <div class="lg:col-span-5">
                <a href="/" class="flex items-center gap-3 mb-10 group">
                    <img
                        src="/logovetpragas1.3.svg"
                        alt="VetPragas Logo"
                        width="200"
                        height="64"
                        loading="lazy"
                        decoding="async"
                        class="h-16 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
                    />
                </a>
                <p
                    class="text-sm text-slate-400 leading-relaxed font-medium max-w-md"
                >
                    Referência em controle especializado de pragas com
                    supervisão veterinária exclusiva para indústrias e empresas
                    de alta complexidade.
                </p>
            </div>

            <!-- Contact Column (Agora mais próxima da logo) -->
            <div class="lg:col-span-4">
                <h4
                    class="text-[10px] font-bold text-white uppercase tracking-[0.3em] mb-10"
                >
                    Contato
                </h4>
                <ul class="space-y-4">
                    <li class="flex items-center gap-3">
                        <svg
                            class="w-4 h-4 text-accent shrink-0"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.81 12.81 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"
                            ></path>
                        </svg>
                        <a
                            href="tel:4533265255"
                            class="text-base font-medium text-white hover:text-accent transition-colors"
                            >(45) 3326-5255</a
                        >
                    </li>
                    <li class="flex items-center gap-3">
                        <svg
                            class="w-4 h-4 text-accent shrink-0"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.414 0 0 5.414 0 12.05c0 2.123.554 4.197 1.608 6.02L0 24l6.132-1.61c1.767.962 3.75 1.47 5.766 1.488h.005c6.632 0 12.045-5.414 12.045-12.05 0-3.212-1.25-6.232-3.52-8.502"
                            ></path>
                        </svg>
                        <a
                            href="https://wa.me/5545991586405"
                            target="_blank"
                            class="text-base font-medium text-white hover:text-accent transition-colors"
                            >(45) 99158-6405</a
                        >
                    </li>
                    <li class="flex items-center gap-3">
                        <svg
                            class="w-4 h-4 text-accent shrink-0"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                            ></path>
                        </svg>
                        <a
                            href="mailto:contato@vetpragas.com.br"
                            class="text-base font-medium text-white hover:text-accent transition-colors"
                            >contato@vetpragas.com.br</a
                        >
                    </li>
                    <li class="flex items-start gap-3">
                        <svg
                            class="w-4 h-4 text-accent shrink-0 mt-1"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                            ></path>
                            <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <a
                            href="https://www.google.com/maps?daddr=R.+Fortaleza,+1339+-+Centro,+Cascavel+-+PR,+85810-051"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-base font-medium text-white hover:text-accent transition-colors leading-tight"
                        >
                            Rua Fortaleza, 1339 • Centro<br />Cascavel - PR
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Empty Column for texture alignment -->
            <div class="hidden lg:block lg:col-span-3"></div>
        </div>

        <div
            class="pt-6 pb-8 lg:pb-12 flex flex-col md:flex-row justify-between items-center gap-6"
        >
            <div
                class="text-[9px] font-bold text-slate-300 uppercase tracking-[0.3em] text-center"
            >
                © 2026 VetPragas • Todos os direitos reservados.
            </div>
        </div>
    </div>
</footer>
