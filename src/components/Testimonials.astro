---
import { Image } from "astro:assets";
import dep1 from "@assets/images/vetpragas-dep1.1.png";
import dep2 from "@assets/images/vetpragas-dep1.2.png";
import dep3 from "@assets/images/vetpragas-dep1.3.png";
import dep4 from "@assets/images/vetpragas-dep1.4.png";
import dep5 from "@assets/images/vetpragas-dep1.5.png";
import dep6 from "@assets/images/vetpragas-dep1.6.png";
import dep7 from "@assets/images/vetpragas-dep1.7.png";
import headerImg from "@assets/images/vetpragas-cabecalho-gmn.png";

const testimonials = [dep1, dep2, dep3, dep4, dep5, dep6, dep7];
---

<section class="py-24 bg-slate-50 relative overflow-hidden">
  <div class="container mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 bg-accent/5 border border-accent/20 text-accent text-[10px] font-black uppercase tracking-[0.3em] mb-6 rounded-sm"
      >
        VETPRAGAS É CONFIÁVEL?
      </div>
      <h2
        class="text-4xl lg:text-5xl font-black text-slate-900 mb-6 uppercase tracking-tighter"
      >
        Opinião de <br />
        <span class="text-accent">Quem Confia</span>
      </h2>
      <p class="text-lg text-slate-500 font-medium">
        Transparência total: confira as avaliações reais extraídas diretamente
        do nosso perfil no Google.
      </p>
    </div>

    <!-- Google Review Board Container -->
    <div
      class="max-w-[700px] mx-auto bg-white shadow-[0_20px_50px_rgba(0,0,0,0.1)] border border-slate-200 relative z-10"
    >
      <!-- Fixed Header -->
      <div
        class="relative z-20 bg-white border-b border-slate-100 flex items-center justify-center p-2 sm:p-4"
      >
        <Image
          src={headerImg}
          alt="Google Reviews Header"
          format="webp"
          widths={[400, 800, 1200]}
          sizes="(max-width: 700px) 100vw, 700px"
          loading="lazy"
          decoding="async"
          class="w-full max-w-full h-auto block object-contain"
        />
      </div>

      <!-- Animated Reviews Window -->
      <div
        class="relative h-[650px] overflow-hidden bg-white"
        style="contain: paint;"
      >
        <div class="testimonial-slider">
          {
            testimonials.map((img, index) => (
              <div class="testimonial-slide">
                <Image
                  src={img}
                  alt={`Depoimento ${index + 1}`}
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto block image-sharp object-contain"
                />
              </div>
            ))
          }
          <!-- Duplicate first for seamless loop -->
          <div class="testimonial-slide">
            <Image
              src={testimonials[0]}
              alt="Depoimento 1 Duplicate"
              format="webp"
              loading="lazy"
              decoding="async"
              class="w-full h-auto block image-sharp object-contain"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Background Decoration -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] -z-10 opacity-[0.03] pointer-events-none"
    >
      <svg
        class="w-full h-full text-slate-900"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
        ></path>
      </svg>
    </div>
  </div>
</section>

<style>
  .image-sharp {
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .testimonial-slider {
    display: flex;
    flex-direction: column;
    /* Continuous linear animation sem engasgos - velocidade aumentada */
    animation: continuous-scroll 120s linear infinite;
    /* Performance optimizations for mobile */
    will-change: transform;
    transform: translate3d(0, 0, 0) rotateZ(0.001deg);
    backface-visibility: hidden;
  }

  .testimonial-slide {
    width: 100%;
    flex-shrink: 0;
    /* Extra layer for image smoothness */
    transform: translate3d(0, 0, 0);
  }

  .testimonial-slider:hover {
    animation-play-state: paused;
  }

  @keyframes continuous-scroll {
    0% {
      transform: translate3d(0, 0, 0) rotateZ(0.001deg);
    }
    100% {
      transform: translate3d(0, -87.5%, 0) rotateZ(0.001deg);
    } /* Uses 3D transform for GPU acceleration */
  }

  @media (max-width: 640px) {
    .testimonial-slider {
      animation-duration: 90s;
    }
    .testimonial-slide img {
      width: 100%;
    }
  }
</style>
