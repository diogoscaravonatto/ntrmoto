---
import { Image } from "astro:assets";
import seloGold from "../assets/images/selo_garantia_7d.png";
---

<section id="garantia" class="relative overflow-hidden bg-black px-4 py-24">
  {/* Background glow suave */}
  <div class="pointer-events-none absolute top-1/2 left-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 bg-[radial-gradient(circle_at_center,rgba(255,51,51,0.05)_0%,transparent_70%)]"></div>

  <div class="relative z-10 mx-auto max-w-5xl text-center">
    {/* Header da Seção */}
    <div class="reveal-up mb-12">
      <div class="mb-4 flex items-center justify-center gap-4">
        <div class="h-[1px] w-12 bg-gradient-to-r from-transparent to-brand-red"></div>
        <span class="text-sm font-bold tracking-[0.2em] text-brand-red uppercase">
          Compra Protegida 100%
        </span>
        <div class="h-[1px] w-12 bg-gradient-to-l from-transparent to-brand-red"></div>
      </div>
      <h2 class="mb-4 flex flex-col text-4xl leading-[0.85] font-black tracking-tight text-white uppercase italic md:block md:text-7xl md:leading-none">
        <span class="md:hidden">GARANTIA TOTAL</span>
        <span class="text-brand-red md:hidden">DE 7 DIAS</span>
        <span class="hidden md:block">
          GARANTIA TOTAL DE <span class="ml-2 text-brand-red">7 DIAS</span>
        </span>
      </h2>
    </div>

    {/* Main Card com Borda Neon */}
    <div class="reveal-up relative overflow-hidden rounded-3xl border border-brand-red/30 bg-[#050505] p-8 shadow-[0_0_50px_rgba(255,51,51,0.15)] md:p-12">
      {/* Linha de brilho superior */}
      <div class="absolute top-0 left-0 h-[2px] w-full bg-gradient-to-r from-transparent via-brand-red to-transparent opacity-50"></div>

      <div class="flex flex-col items-center gap-12 lg:flex-row">
        {/* Selo Dourado */}
        <div class="mb-8 h-64 w-64 shrink-0 drop-shadow-[0_0_30px_rgba(234,179,8,0.2)] md:mb-0 md:h-80 md:w-80">
          <Image
            src={seloGold}
            alt="Selo de Garantia 7 Dias"
            class="h-full w-full scale-125 object-contain md:scale-110"
          />
        </div>

        {/* Texto e Benefícios */}
        <div class="flex-grow text-left">
          <h3 class="mb-6 text-2xl leading-tight font-black text-white md:text-3xl">
            Você tem{" "}
            <span class="text-yellow-500 underline underline-offset-4">7 DIAS INTEIROS</span> para
            testar tudo e colocar em prática.
          </h3>
          <p class="mb-10 text-xl leading-relaxed text-gray-300">
            Se por qualquer motivo você achar que o conteúdo não é para você, basta enviar um e-mail
            e <span class="font-bold text-yellow-500">devolvemos 100% do seu dinheiro.</span> Sem
            perguntas. Sem burocracia.
          </p>

          <div class="mx-auto max-w-md md:mx-0">
            <a
              href="https://sun.eduzz.com/1865589?cupom=especial50off&utm_content=1754141964121_17541415298533"
              class="block w-full transform rounded-lg bg-brand-red px-6 py-5 text-center text-xl font-black tracking-wider text-white uppercase shadow-[0_0_20px_rgba(255,51,51,0.3)] transition-all hover:-translate-y-1 hover:bg-brand-red-dark hover:shadow-[0_0_40px_rgba(255,51,51,0.5)] md:text-2xl"
            >
              TESTAR SEM RISCO AGORA
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Barra de Segurança Final */}
    <div class="reveal-up mt-8 flex flex-col items-center justify-between gap-6 rounded-2xl border border-yellow-500/30 bg-gradient-to-r from-brand-red/10 via-[#111] to-brand-red/10 p-6 shadow-xl md:flex-row md:p-8">
      <div class="flex items-center gap-4">
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl border border-yellow-500/40 bg-yellow-500/10 md:h-20 md:w-20">
          <svg
            class="h-10 w-10 text-yellow-500 md:h-12 md:w-12"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            ></path>
          </svg>
        </div>
        <div class="text-left">
          <h4 class="flex flex-col text-2xl leading-[0.9] font-black tracking-tight text-white uppercase italic md:block md:text-3xl md:leading-none">
            <span class="md:hidden">SUA COMPRA É</span>
            <span class="text-yellow-500 md:hidden">100% SEGURA</span>
            <span class="hidden md:block">
              Sua compra é <span class="text-yellow-500">100% Segura!</span>
            </span>
          </h4>
          <p class="mt-3 text-sm text-gray-400 md:mt-2 md:text-base">
            Ambiente seguro e criptografado.
            <br class="md:hidden" />
            Seus dados estão protegidos.
          </p>
        </div>
      </div>

      <div class="flex shrink-0 items-center gap-6">
        <div class="flex items-center gap-2">
          <svg class="h-6 w-6 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6z" />
          </svg>
          <div class="text-left">
            <p class="text-[10px] leading-none font-bold text-white uppercase">Compra Segura</p>
            <p class="text-[8px] text-gray-600 uppercase">Ambiente Protegido</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-6 w-6 text-green-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" />
          </svg>
          <div class="text-left">
            <p class="text-[10px] leading-none font-bold text-white uppercase">SSL Certificado</p>
            <p class="text-[8px] text-gray-600 uppercase">Dados Protegidos</p>
          </div>
        </div>
      </div>
    </div>

    {/* Prova Social de Alunos */}
    <p class="mt-8 text-xs font-bold tracking-[0.2em] text-yellow-500 uppercase">
      <span class="text-brand-red">●</span> Mais de 12.000 alunos já aprovaram e recomendam este
      conteúdo!
    </p>
  </div>
</section>
