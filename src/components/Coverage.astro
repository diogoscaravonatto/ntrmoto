---
import { vetPragasData } from "./content";
import { Image } from "astro:assets";
import mapaPrImg from "@assets/images/mapa-pr.png";
---

<section class="py-24 bg-white relative">
    <div class="container mx-auto px-6">
        <div
            class="p-16 bg-slate-50 rounded-[3rem] border border-slate-100 relative overflow-hidden"
        >
            <!-- Decoration -->
            <div
                class="absolute top-0 right-0 w-80 h-80 bg-accent/5 rounded-full blur-[80px] -translate-y-1/2 translate-x-1/2"
            >
            </div>

            <div class="grid lg:grid-cols-2 gap-16 items-center relative z-10">
                <div>
                    <span
                        class="text-accent-dark font-bold text-[10px] uppercase tracking-[0.3em] font-mono"
                        >{vetPragasData.coverage.subtitle}</span
                    >
                    <h2
                        class="text-4xl lg:text-5xl font-black text-slate-900 mt-4 mb-8 uppercase tracking-tighter"
                    >
                        Atendimento Ágil <br />
                        <span class="text-accent">em Toda a Região</span>
                    </h2>
                    <p
                        class="text-lg text-slate-500 mb-10 leading-relaxed font-medium"
                    >
                        Equipes de prontidão para garantir a segurança da sua
                        casa ou empresa com o menor tempo de resposta.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-6 mt-12">
                        <a
                            href="https://wa.me/5545991586405"
                            class="px-10 py-5 bg-accent text-white font-bold text-xs uppercase tracking-widest rounded-xl hover:bg-accent-dark transition-all shadow-lg flex items-center justify-center gap-3"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                                ></path></svg
                            >
                            Chamar agora
                        </a>
                        <a
                            href="tel:45991586405"
                            class="px-10 py-5 bg-white text-slate-900 border border-slate-200 font-bold text-xs uppercase tracking-widest rounded-xl hover:border-accent hover:text-accent transition-all flex items-center justify-center gap-3"
                        >
                            (45) 99158-6405
                        </a>
                    </div>
                </div>

                <!-- 3D Paraná Map with Location Pin -->
                <div
                    class="relative flex items-center justify-center py-12 lg:py-0"
                >
                    <div
                        class="relative w-full max-w-[500px] perspective-[1000px]"
                    >
                        <!-- Main 3D Container -->
                        <div
                            class="relative transform rotateX-[25deg] rotateY-[-10deg] rotateZ-[2deg] transition-all duration-700 hover:translate-y-[-10px]"
                        >
                            <!-- The User's Map Image -->
                            <Image
                                src={mapaPrImg}
                                alt="Mapa do Paraná"
                                width="500"
                                height="300"
                                loading="lazy"
                                decoding="async"
                                class="w-full h-auto drop-shadow-[0_20px_40px_rgba(0,0,0,0.3)] filter brightness-90"
                            />

                            <!-- Glowing Pin - Positioned in the extreme West -->
                            <div
                                class="absolute top-[58%] left-[17%] -translate-x-1/2 -translate-y-1/2 z-20"
                            >
                                <div
                                    class="relative flex items-center justify-center"
                                >
                                    <!-- Pulsing circles reach until the center of the map -->
                                    <div
                                        class="absolute w-[280px] h-[280px] bg-accent/20 rounded-full animate-ping shadow-[0_0_100px_rgba(239,68,68,0.4)]"
                                    >
                                    </div>
                                    <div
                                        class="absolute w-[180px] h-[180px] bg-accent/30 rounded-full animate-ping-slow"
                                    >
                                    </div>

                                    <!-- The Pin Icon (Enlarged) -->
                                    <div
                                        class="relative bg-accent p-4 rounded-full shadow-2xl border-4 border-white animate-bounce-subtle"
                                    >
                                        <svg
                                            class="w-12 h-12 text-white"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                            ></path>
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                            ></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes ping-slow {
        75%,
        100% {
            transform: scale(2);
            opacity: 0;
        }
    }
    .animate-ping-slow {
        animation: ping-slow 3s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    @keyframes bounce-subtle {
        0%,
        100% {
            transform: translateY(-10px);
        }
        50% {
            transform: translateY(-15px);
        }
    }
    .animate-bounce-subtle {
        animation: bounce-subtle 2s ease-in-out infinite;
    }
</style>
