---
import { CTX_FAQS } from "../../utils/faqs";
---

<section
  aria-labelledby="ctx-faq-heading"
  class="relative overflow-hidden border-b border-slate-100 bg-slate-50 px-4 py-24"
>
  <div class="relative z-10 mx-auto max-w-3xl">
    <div class="mb-16 text-center">
      <span class="text-sm font-black tracking-wider text-brand-orange uppercase italic">
        Esclareça Suas Dúvidas
      </span>
      <h2
        id="ctx-faq-heading"
        class="mt-2 mb-6 text-3xl font-black tracking-tighter text-slate-900 uppercase italic md:text-5xl"
      >
        DÚVIDAS <span class="text-brand-orange">FREQUENTES</span>
      </h2>
    </div>

    {/* Accordion Nativo (<details> / <summary>) — pesquisável via Ctrl+F e acessível */}
    <div class="space-y-4">
      {CTX_FAQS.map((faq) => (
        <details
          name="ctx-faq"
          class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-colors open:border-brand-orange/40 hover:border-brand-orange/30"
        >
          <summary class="flex cursor-pointer list-none items-center justify-between px-6 py-5 text-left text-base font-bold tracking-tight text-slate-800 uppercase italic select-none md:text-lg">
            <span>{faq.q}</span>
            <svg
              aria-hidden="true"
              class="h-6 w-6 shrink-0 text-brand-orange transition-transform duration-300 group-open:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                d="M19 9l-7 7-7-7"
              />
            </svg>
          </summary>

          <div class="border-t border-slate-100 px-6 py-4 text-sm leading-relaxed text-slate-600">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
