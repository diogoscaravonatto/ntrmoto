---
import { Image } from 'astro:assets';
import imgMockupImpacto from '../../../assets/images/mockup_r4t_impacto3.png';
---

<section class="py-24 px-4 bg-white relative overflow-hidden">
  <div class="max-w-6xl mx-auto relative z-10">
    
    <div class="text-center mb-16">
      <span class="text-brand-orange font-black text-sm uppercase tracking-wider italic">Cómo Funciona el Método</span>
      <h2 class="text-3xl md:text-5xl font-black text-slate-900 mt-2 mb-4 uppercase tracking-tighter italic">
        MIRA LO QUE VAS A APRENDER
      </h2>
      <p class="text-slate-600 text-lg md:text-xl font-bold italic">
        para aumentar la potencia rápido sin gastar ni 1 dólar en piezas:
      </p>
    </div>

    {/* Los Tres Pilares de la Tasa de Compresión */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {[
        {
          num: "01",
          title: "Ajuste Práctico",
          desc: "Cómo medir y calcular la relación de compresión usando herramientas simples que ya tienes en tu taller o en tu casa."
        },
        {
          num: "02",
          title: "Compresión Ideal",
          desc: "Descubre el límite exacto de compresión que tu motor soporta en gasolina comercial o de carreras — sin riesgo de detonación o rotura."
        },
        {
          num: "03",
          title: "El Secreto Técnico",
          desc: "Descubrirás el secreto de los grandes preparadores para ganar torque y potencia a través de la compresión, sin ahogar el motor en altas RPM."
        }
      ].map((item) => (
        <div class="bg-slate-50 border border-slate-100 rounded-3xl p-8 hover:border-brand-orange/30 transition-all duration-300 relative group shadow-[0_4px_20px_rgba(0,0,0,0.01)]">
          <div class="w-12 h-12 rounded-full bg-brand-orange/10 flex items-center justify-center text-brand-orange font-black text-lg mb-6 group-hover:bg-brand-orange group-hover:text-white transition-colors duration-300">
            {item.num}
          </div>
          <h3 class="text-slate-900 font-black text-xl mb-3 uppercase italic tracking-tight">{item.title}</h3>
          <p class="text-slate-500 text-sm leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>

    {/* Faixa de Impacto Principal */}
    <div class="bg-gradient-to-r from-orange-500 to-brand-orange text-white rounded-3xl p-8 md:p-12 text-center shadow-xl mb-24 relative overflow-hidden">
      {/* Decorative speed lines */}
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,transparent_0%,rgba(0,0,0,0.8)_100%)]"></div>
      
      <p class="text-2xl md:text-3xl lg:text-4xl font-black uppercase italic tracking-tighter relative z-10 leading-tight">
        ¡Imagina tu moto más fuerte HOY MISMO, de forma simple, rápida y sin comprar repuestos nuevos!
      </p>
    </div>

    {/* Três Diferenciais / Cartões de Confiança */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
      {[
        {
          title: "ACCESO INMEDIATO",
          desc: "Inmediatamente después de la inscripción recibirás tu acceso a los materiales directo en tu correo electrónico.",
          icon: "⚡"
        },
        {
          title: "RESULTADOS RÁPIDOS",
          desc: "Puedes ver el curso COMPLETO el mismo día y ponerlo en práctica en tu moto inmediatamente.",
          icon: "⏱"
        },
        {
          title: "FÁCIL DE APLICAR",
          desc: "Técnicas paso a paso que cualquier persona puede aplicar, incluso sin experiencia previa en mecánica.",
          icon: "🛠"
        }
      ].map((item) => (
        <div class="bg-slate-50 border border-slate-100 rounded-2xl p-6 text-center shadow-[0_4px_15px_rgba(0,0,0,0.01)] hover:border-brand-orange/20 transition-all duration-300">
          <div class="text-3xl mb-4">{item.icon}</div>
          <h4 class="text-slate-950 font-black text-lg uppercase italic tracking-tight mb-2">{item.title}</h4>
          <p class="text-slate-500 text-sm leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>

    {/* Mockup do Produto */}
    <div class="flex flex-col items-center justify-center reveal-up active">
      <div class="relative">
        <div class="absolute inset-0 bg-brand-orange/5 rounded-full filter blur-3xl -z-10 scale-75"></div>
        <Image 
          src={imgMockupImpacto} 
          alt="Mockup del Curso Completo CTX" 
          class="w-full max-w-4xl h-auto object-contain tilt-card" 
          width={900}
          height={500}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

  </div>
</section>
