---
import { Image } from "astro:assets";
import imgMockupImpacto from "../../../assets/images/mockup_r4t_impacto3.png";
---

<section class="relative overflow-hidden bg-white px-4 py-24">
  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="mb-16 text-center">
      <span class="text-sm font-black tracking-wider text-brand-orange uppercase italic">
        Cómo Funciona el Método
      </span>
      <h2 class="mt-2 mb-4 text-3xl font-black tracking-tighter text-slate-900 uppercase italic md:text-5xl">
        MIRA LO QUE VAS A APRENDER
      </h2>
      <p class="text-lg font-bold text-slate-600 italic md:text-xl">
        para aumentar la potencia rápido sin gastar ni 1 dólar en piezas:
      </p>
    </div>

    {/* Los Tres Pilares de la Tasa de Compresión */}
    <div class="mb-16 grid grid-cols-1 gap-8 md:grid-cols-3">
      {[
        {
          num: "01",
          title: "Ajuste Práctico",
          desc: "Cómo medir y calcular la relación de compresión usando herramientas simples que ya tienes en tu taller o en tu casa.",
        },
        {
          num: "02",
          title: "Compresión Ideal",
          desc: "Descubre el límite exacto de compresión que tu motor soporta en gasolina comercial o de carreras — sin riesgo de detonación o rotura.",
        },
        {
          num: "03",
          title: "El Secreto Técnico",
          desc: "Descubrirás el secreto de los grandes preparadores para ganar torque y potencia a través de la compresión, sin ahogar el motor en altas RPM.",
        },
      ].map((item) => (
        <div class="group relative rounded-3xl border border-slate-100 bg-slate-50 p-8 shadow-[0_4px_20px_rgba(0,0,0,0.01)] transition-all duration-300 hover:border-brand-orange/30">
          <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-full bg-brand-orange/10 text-lg font-black text-brand-orange transition-colors duration-300 group-hover:bg-brand-orange group-hover:text-white">
            {item.num}
          </div>
          <h3 class="mb-3 text-xl font-black tracking-tight text-slate-900 uppercase italic">
            {item.title}
          </h3>
          <p class="text-sm leading-relaxed text-slate-500">{item.desc}</p>
        </div>
      ))}
    </div>

    {/* Faixa de Impacto Principal */}
    <div class="relative mb-24 overflow-hidden rounded-3xl bg-gradient-to-r from-orange-500 to-brand-orange p-8 text-center text-white shadow-xl md:p-12">
      {/* Decorative speed lines */}
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,rgba(0,0,0,0.8)_100%)] opacity-10"></div>

      <p class="relative z-10 text-2xl leading-tight font-black tracking-tighter uppercase italic md:text-3xl lg:text-4xl">
        ¡Imagina tu moto más fuerte HOY MISMO, de forma simple, rápida y sin comprar repuestos
        nuevos!
      </p>
    </div>

    {/* Três Diferenciais / Cartões de Confiança */}
    <div class="mb-20 grid grid-cols-1 gap-8 md:grid-cols-3">
      {[
        {
          title: "ACCESO INMEDIATO",
          desc: "Inmediatamente después de la inscripción recibirás tu acceso a los materiales directo en tu correo electrónico.",
          icon: "⚡",
        },
        {
          title: "RESULTADOS RÁPIDOS",
          desc: "Puedes ver el curso COMPLETO el mismo día y ponerlo en práctica en tu moto inmediatamente.",
          icon: "⏱",
        },
        {
          title: "FÁCIL DE APLICAR",
          desc: "Técnicas paso a paso que cualquier persona puede aplicar, incluso sin experiencia previa en mecánica.",
          icon: "🛠",
        },
      ].map((item) => (
        <div class="rounded-2xl border border-slate-100 bg-slate-50 p-6 text-center shadow-[0_4px_15px_rgba(0,0,0,0.01)] transition-all duration-300 hover:border-brand-orange/20">
          <div class="mb-4 text-3xl">{item.icon}</div>
          <h4 class="mb-2 text-lg font-black tracking-tight text-slate-950 uppercase italic">
            {item.title}
          </h4>
          <p class="text-sm leading-relaxed text-slate-500">{item.desc}</p>
        </div>
      ))}
    </div>

    {/* Mockup do Produto */}
    <div class="reveal-up active flex flex-col items-center justify-center">
      <div class="relative">
        <div class="absolute inset-0 -z-10 scale-75 rounded-full bg-brand-orange/5 blur-3xl filter"></div>
        <Image
          src={imgMockupImpacto}
          alt="Mockup del Curso Completo CTX"
          class="tilt-card h-auto w-full max-w-4xl object-contain"
          width={900}
          height={500}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
