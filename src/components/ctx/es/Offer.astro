---
import { Image } from 'astro:assets';
import imgPgto from '../../../assets/images/pag_seguro.png';
import imgMockupCombo from '../../../assets/images/mockup_r4t_impacto3.png';
import imgMockupNormal from '../../../assets/images/mockup_guia_motores.webp';
---

<section id="oferta" class="py-24 px-4 bg-slate-50 relative overflow-hidden border-b border-slate-100">
  {/* Soft light grid */}
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#e2e8f0_1px,transparent_1px),linear-gradient(to_bottom,#e2e8f0_1px,transparent_1px)] bg-[size:4rem_4rem] opacity-30 pointer-events-none"></div>

  <div class="max-w-5xl mx-auto relative z-10">
    
    <div class="text-center mb-16">
      <span class="text-brand-orange font-black text-sm uppercase tracking-wider italic">Elige tu Paquete</span>
      <h2 class="text-3xl md:text-5xl lg:text-6xl font-black text-slate-900 mt-2 mb-4 uppercase tracking-tighter italic">
        AHORA DEPENDE DE TI:
      </h2>
      <p class="text-slate-600 text-lg md:text-xl font-bold">
        Mira las 2 OPCIONES de Acceso y elige la mejor para ti
      </p>
    </div>

    {/* Tabela de Ofertas */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
      
      {/* Opção 1: Acesso Normal */}
      <div class="bg-white border border-slate-200 rounded-[32px] p-8 md:p-10 flex flex-col justify-between hover:border-slate-300 transition-all duration-300 relative shadow-sm">
        <div class="space-y-6">
          <div>
            <span class="text-slate-400 font-bold text-xs uppercase tracking-wider">Acceso Básico</span>
            <h3 class="text-slate-950 font-black text-2xl uppercase italic tracking-tight mt-1">Acceso Normal</h3>
            <p class="text-slate-500 text-sm mt-1">Solo el Curso de Compresión + Regalos.</p>
          </div>

          <div class="py-6 flex justify-center border-b border-slate-100">
            <Image 
              src={imgMockupNormal} 
              alt="Mockup Acceso Normal" 
              class="h-40 w-auto object-contain opacity-90" 
              loading="lazy"
              decoding="async"
            />
          </div>

          {/* Lista de Atributos */}
          <ul class="space-y-4 text-sm font-bold text-slate-700">
            <li class="flex items-center gap-3">
              <span class="text-brand-orange text-base">✔</span>
              <span>Curso Tasa de Compresión</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-brand-orange text-base">✔</span>
              <span>Tabla de Medidas de Bielas</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-brand-orange text-base">✔</span>
              <span>Tabla de Medidas de Pistones</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-brand-orange text-base">✔</span>
              <span>Masterclass Plan 200km/h</span>
            </li>
            <li class="flex items-center gap-3 text-slate-300 line-through">
              <span class="text-slate-300 text-base">✘</span>
              <span>Curso Carburación Avanzada</span>
            </li>
            <li class="flex items-center gap-3 text-slate-300 line-through">
              <span class="text-slate-300 text-base">✘</span>
              <span>Curso Puesta a Punto Árbol de Levas</span>
            </li>
          </ul>
        </div>

        {/* Preço e Botão */}
        <div class="mt-10 pt-6 border-t border-slate-100 space-y-6">
          <div class="text-center">
            <p class="text-slate-400 text-xs font-bold line-through">Antes $ 27 USD</p>
            <p class="text-slate-500 text-xs font-bold mt-1">Por solo</p>
            <div class="flex items-start justify-center gap-1 mt-1">
              <span class="text-xl text-slate-900 font-black mt-1">$</span>
              <span class="text-6xl font-black text-slate-900 leading-none tracking-tight">7</span>
              <span class="text-xl text-slate-900 font-black mt-1"> USD</span>
            </div>
            <p class="text-slate-500 text-[11px] font-bold mt-2">Pago único sin mensualidades</p>
          </div>

          <a href="#checkout-latam-7" class="block w-full py-4 text-center bg-slate-100 hover:bg-slate-200 text-slate-800 font-black rounded-2xl border border-slate-300 transition-colors uppercase tracking-tight italic text-sm">
            QUIERO ACCESO NORMAL <br/>
            <span class="text-[10px] normal-case font-bold text-slate-500">Solo el Curso de Compresión</span>
          </a>
        </div>
      </div>

      {/* Opção 2: Acesso Premium */}
      <div class="bg-white border-2 border-brand-orange rounded-[32px] p-8 md:p-10 flex flex-col justify-between hover:border-brand-orange-dark transition-all duration-300 relative shadow-[0_15px_40px_rgba(255,90,0,0.08)]">
        {/* Badge Recomendado */}
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-brand-orange text-white px-5 py-1.5 rounded-full font-black text-[10px] md:text-xs uppercase tracking-widest italic animate-glow">
          EL MÁS POPULAR (87% eligen este)
        </div>

        <div class="space-y-6">
          <div class="mt-2">
            <span class="text-brand-orange font-black text-xs uppercase tracking-widest italic">Mejor Oferta del Día</span>
            <h3 class="text-slate-950 font-black text-2xl uppercase italic tracking-tight mt-1">ACCESO PREMIUM</h3>
            <p class="text-slate-500 text-sm mt-1">Combo con 3 Cursos Completos de Preparación.</p>
          </div>

          <div class="py-6 flex justify-center border-b border-slate-100">
            <Image 
              src={imgMockupCombo} 
              alt="Mockup Acceso Premium" 
              class="h-40 w-auto object-contain" 
              loading="lazy"
              decoding="async"
            />
          </div>

          {/* Lista de Atributos */}
          <ul class="space-y-4 text-sm font-bold text-slate-700">
            <li class="flex items-center gap-3 text-brand-orange">
              <span class="text-brand-orange text-base">✔</span>
              <span>Combo con 3 Cursos de Preparación</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-brand-orange text-base">✔</span>
              <span>Curso Tasa de Compresión</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-brand-orange text-base">✔</span>
              <span>Tabla de Medidas de Bielas</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-brand-orange text-base">✔</span>
              <span>Tabla de Medidas de Pistones</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-brand-orange text-base">✔</span>
              <span>Masterclass Plan 200km/h</span>
            </li>
            <li class="flex items-center gap-3 text-brand-orange">
              <span class="text-brand-orange text-base">✔</span>
              <span>Curso Carburación Avanzada</span>
            </li>
            <li class="flex items-center gap-3 text-brand-orange">
              <span class="text-brand-orange text-base">✔</span>
              <span>Curso Puesta a Punto Árbol de Levas</span>
            </li>
          </ul>
        </div>

        {/* Preço e Botão */}
        <div class="mt-10 pt-6 border-t border-slate-100 space-y-6">
          <div class="text-center">
            <p class="text-slate-400 text-xs font-bold line-through">Antes $ 57 USD</p>
            <div class="flex items-start justify-center gap-1 mt-1">
              <span class="text-xl text-slate-900 font-black mt-1">$</span>
              <span class="text-6xl font-black text-brand-orange leading-none tracking-tight">15</span>
              <span class="text-xl text-slate-900 font-black mt-1"> USD</span>
            </div>
            <p class="text-slate-500 text-xs font-bold mt-1">Pago único, acceso de por vida</p>
          </div>

          <a href="#checkout-latam-15" class="block w-full py-5 text-center bg-brand-orange hover:bg-brand-orange-dark text-white font-black rounded-2xl shadow-[0_10px_25px_rgba(255,90,0,0.2)] hover:shadow-[0_15px_30px_rgba(255,90,0,0.3)] transition-all duration-300 transform hover:-translate-y-1 uppercase tracking-tight italic text-sm">
            QUIERO ACCESO PREMIUM <br/>
            <span class="text-[10px] normal-case font-bold text-orange-200">Combo 3 Cursos de Preparación</span>
          </a>
          
          <p class="text-[10px] text-slate-400 text-center font-bold italic mt-2">* En este combo cada curso sale por solo $ 5 USD</p>
        </div>
      </div>

    </div>

    {/* Selo Pagamento Seguro */}
    <div class="mt-16 pt-8 border-t border-slate-200 flex flex-col items-center gap-4">
      <Image 
        src={imgPgto} 
        alt="Pago Seguro Internacional" 
        class="h-12 w-auto object-contain opacity-95"
        loading="lazy"
        decoding="async"
      />
      <p class="text-slate-400 text-[11px] font-bold uppercase tracking-wider">🔒 Pago 100% Criptografado y Seguro. Aceptamos Tarjetas de Crédito, PayPal y Métodos Locales LATAM.</p>
    </div>

  </div>
</section>
