---
import { Image } from 'astro:assets';
import imgBonus1 from '../../../assets/images/mockup_guia_motores.webp';
import imgBonus2 from '../../../assets/images/mockup_fabrica_motores.webp';
import imgBonus3 from '../../../assets/images/mockup_grupo_vip.webp';

const bonuses = [
  {
    tag: "REGALO 1",
    title: "Guía Maestra de Bielas (Tabla de Medidas)",
    desc: "Todo lo que necesitas para acertar la biela con el proyecto ideal está aquí, eliminando las dudas a la hora de elegir y armar el conjunto.",
    price: "$ 10 USD",
    img: imgBonus1
  },
  {
    tag: "REGALO 2",
    title: "Tabla de Medidas de Pistones Especiales",
    desc: "Tabla completa con carrera, diámetro y cilindrada de motores preparados. Ideal para quien necesita rapidez al momento de configurar el motor.",
    price: "$ 15 USD",
    img: imgBonus2
  },
  {
    tag: "REGALO 3",
    title: "El Plan 200km/h",
    desc: "Clase exclusiva con 3 fundamentos técnicos esenciales para proyectos que buscan romper la barrera de los 200 km/h.",
    price: "$ 25 USD",
    img: imgBonus3
  }
];
---

<section class="py-24 px-4 bg-slate-50 relative overflow-hidden border-b border-slate-100">
  <div class="max-w-6xl mx-auto relative z-10">
    
    <div class="text-center mb-16">
      <span class="text-brand-orange font-black text-sm uppercase tracking-wider italic">Paquete de Aceleración</span>
      <h2 class="text-3xl md:text-5xl lg:text-6xl font-black text-slate-900 mt-2 mb-4 uppercase tracking-tighter italic">
        BONOS <span class="text-brand-orange">EXCLUSIVOS</span>
      </h2>
      <p class="text-slate-600 text-lg md:text-xl font-bold">
        Además, tendrás acceso inmediato a estos 3 Regalos Especiales…
      </p>
    </div>

    {/* Cards dos Brindes */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
      {bonuses.map((item) => (
        <div class="bg-white border border-slate-200 rounded-3xl p-8 hover:border-brand-orange/30 transition-all duration-300 flex flex-col justify-between group shadow-sm hover:shadow-md">
          <div class="space-y-4">
            <div class="flex justify-between items-center">
              <span class="bg-brand-orange/10 border border-brand-orange/30 text-brand-orange text-xs font-black uppercase tracking-wider px-3 py-1.5 rounded-full">{item.tag}</span>
              <span class="text-slate-400 font-bold text-xs line-through">Valor: {item.price}</span>
            </div>
            
            {/* Imagem do Mockup do Brinde */}
            <div class="py-6 flex justify-center">
              <Image 
                src={item.img} 
                alt={item.title} 
                class="h-36 w-auto object-contain transition-transform duration-500 group-hover:scale-105" 
                loading="lazy"
                decoding="async"
              />
            </div>

            <h3 class="text-slate-950 font-black text-xl uppercase italic tracking-tight leading-tight">{item.title}</h3>
            <p class="text-slate-500 text-sm leading-relaxed">{item.desc}</p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex justify-between items-center">
            <span class="text-brand-orange font-black text-xs uppercase tracking-wide">Precio de Hoy:</span>
            <span class="text-[#22C55E] font-black text-lg uppercase italic">GRATIS</span>
          </div>
        </div>
      ))}
    </div>

    {/* Quadro de Valorização e CTA */}
    <div class="bg-white border border-slate-200 rounded-3xl p-8 md:p-10 shadow-sm max-w-4xl mx-auto text-center border-l-8 border-l-brand-orange mb-8">
      <p class="text-slate-700 text-lg md:text-xl font-bold leading-relaxed mb-6">
        Solo estos bonos valdrían fácilmente más de $ 50 USD... <br class="hidden md:block" />
        pero hoy te llevas el <span class="text-brand-orange">Curso de Compresión + TODOS los regalos</span> por un único pago.
      </p>
      
      <a href="#oferta" class="inline-block w-full max-w-md py-5 px-6 bg-brand-orange hover:bg-brand-orange-dark text-white text-lg md:text-xl font-black rounded-2xl shadow-[0_15px_30px_rgba(255,90,0,0.3)] transition-all duration-300 transform hover:-translate-y-1 uppercase tracking-tighter italic">
        QUIERO EMPEZAR AHORA
      </a>
    </div>

  </div>
</section>
