---
const faqs = [
  {
    q: "¿Qué es la Capacitación en Tasa de Compresión?",
    a: "La capacitación en Tasa de Compresión es un curso rápido en video clases donde aprenderás a mejorar el rendimiento y potencia de tu motor ajustando la compresión, utilizando herramientas básicas e incluso sin tener experiencia previa.",
  },
  {
    q: "¿Cómo voy a recibir el acceso a las clases?",
    a: "¡El acceso es inmediato! Tan pronto como se confirme tu pago, recibirás un correo electrónico con tus datos de acceso (usuario y contraseña) y el enlace directo a la plataforma de estudiantes.",
  },
  {
    q: "¿En cuánto tiempo veré resultados en mi moto?",
    a: "Puedes ver todas las clases el mismo día y ponerlas en práctica inmediatamente. El aumento de potencia y torque es instantáneo tan pronto como finalizas la regulación correcta en el motor.",
  },
  {
    q: "¿Funciona para alguien sin experiencia en mecánica?",
    a: "Sí, el método está diseñado especialmente para quienes empiezan desde cero. Explicamos el paso a paso de forma simple, directa y sin tecnicismos complicados.",
  },
  {
    q: "¿Existe alguna garantía de que el programa funciona?",
    a: "Sí, cuentas con 7 días de garantía incondicional. Si por cualquier motivo el curso no cumple tus expectativas, solo solicitas la devolución y te reembolsamos el 100% de tu dinero.",
  },
];
---

<section class="relative overflow-hidden border-b border-slate-100 bg-slate-50 px-4 py-24">
  <div class="relative z-10 mx-auto max-w-3xl">
    <div class="mb-16 text-center">
      <span class="text-sm font-black tracking-wider text-brand-orange uppercase italic">
        Aclara tus Dudas
      </span>
      <h2 class="mt-2 mb-6 text-3xl font-black tracking-tighter text-slate-900 uppercase italic md:text-5xl">
        PREGUNTAS <span class="text-brand-orange">FRECUENTES</span>
      </h2>
    </div>

    {/* Accordion List */}
    <div class="space-y-4" id="faq-accordion-es">
      {faqs.map((faq, index) => (
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:border-brand-orange/30">
          <button
            class="faq-trigger-es flex w-full items-center justify-between px-6 py-5 text-left text-base font-bold tracking-tight text-slate-800 uppercase italic select-none focus:outline-none md:text-lg"
            data-index={index}
          >
            <span>{faq.q}</span>
            <svg
              class="faq-icon-es h-6 w-6 transform text-brand-orange transition-transform duration-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="3"
                d="M19 9l-7 7-7-7"
              ></path>
            </svg>
          </button>

          <div class="faq-content-es max-h-0 overflow-hidden transition-all duration-300 ease-out">
            <div class="border-t border-slate-100 p-6 pt-0 text-sm leading-relaxed text-slate-500">
              {faq.a}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const triggers = document.querySelectorAll(".faq-trigger-es");

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const content = trigger.nextElementSibling as HTMLElement;
      const icon = trigger.querySelector(".faq-icon-es") as HTMLElement;

      // Fecha todos os outros FAQs
      document.querySelectorAll(".faq-content-es").forEach((c) => {
        if (c !== content && c.clientHeight > 0) {
          (c as HTMLElement).style.maxHeight = "0px";
          const siblingIcon = c.previousElementSibling?.querySelector(
            ".faq-icon-es",
          ) as HTMLElement;
          if (siblingIcon) siblingIcon.style.transform = "rotate(0deg)";
        }
      });

      // Alterna o estado do item clicado
      if (content.clientHeight === 0) {
        content.style.maxHeight = content.scrollHeight + "px";
        icon.style.transform = "rotate(180deg)";
      } else {
        content.style.maxHeight = "0px";
        icon.style.transform = "rotate(0deg)";
      }
    });
  });
</script>
