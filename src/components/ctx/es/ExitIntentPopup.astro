---
---

<div
  id="exit-intent-popup-es"
  class="fixed inset-0 z-[9999] hidden items-center justify-center p-4"
>
  {/* Backdrop */}
  <div class="absolute inset-0 bg-slate-950/80 backdrop-blur-sm" id="popup-backdrop-es"></div>

  {/* Content Card */}
  <div
    class="relative w-full max-w-lg scale-90 transform rounded-[40px] border-2 border-brand-orange bg-white p-8 text-center opacity-0 shadow-[0_20px_50px_rgba(255,90,0,0.2)] transition-all duration-300 md:p-12"
    id="popup-card-es"
  >
    <div class="mb-8">
      <div class="mb-6 inline-block animate-pulse rounded-full bg-brand-orange px-4 py-1.5 text-[10px] font-black tracking-widest text-white uppercase md:text-xs">
        Oportunidad Única
      </div>

      <h2 class="mb-6 text-3xl leading-none font-black tracking-tighter text-slate-950 uppercase italic md:text-4xl">
        ¡ESPERA! NO DEJES TU MOTO <span class="text-brand-orange">AMARRADA!</span>
      </h2>

      <p class="text-base leading-tight font-semibold text-slate-600 md:text-lg">
        Desbloquea la potencia oculta de tu motor sin gastar en repuestos nuevos. <br />
        Llévate el Curso de Compresión + Todos los Regalos hoy por solo{" "}
        <span class="mt-2 block text-2xl font-black text-brand-orange">$ 7 USD</span>
      </p>
    </div>

    <div class="space-y-6">
      <a
        href="#oferta"
        id="popup-cta-es"
        class="animate-shake inline-block w-full transform rounded-2xl bg-brand-orange px-6 py-5 text-lg font-black tracking-tighter text-white uppercase italic shadow-[0_10px_30px_rgba(255,90,0,0.2)] transition-all hover:-translate-y-1 hover:bg-brand-orange-dark md:text-xl"
      >
        QUIERO ENTRAR AHORA
      </a>

      <p class="text-xs font-bold text-slate-400 italic">
        * Haz clic para asegurar tu acceso sin riesgo (Garantía de 7 días)
      </p>
    </div>
  </div>
</div>

<style>
  @keyframes shake {
    0%,
    100% {
      transform: translateX(0) rotate(-1deg);
    }
    25% {
      transform: translateX(-1px) rotate(1deg);
    }
    75% {
      transform: translateX(1px) rotate(-1deg);
    }
  }
  .animate-shake {
    animation: shake 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) infinite;
  }
</style>

<script is:inline>
  function initExitIntentEs() {
    const popup = document.getElementById("exit-intent-popup-es");
    const card = document.getElementById("popup-card-es");
    const backdrop = document.getElementById("popup-backdrop-es");
    const ctaBtn = document.getElementById("popup-cta-es");

    let popupShown = false;

    if (sessionStorage.getItem("ntr_ctx_es_exit_popup_shown")) {
      return;
    }

    function showPopup() {
      if (popupShown) return;
      popupShown = true;
      sessionStorage.setItem("ntr_ctx_es_exit_popup_shown", "true");

      popup.classList.remove("hidden");
      popup.classList.add("flex");

      setTimeout(() => {
        card.classList.remove("scale-90", "opacity-0");
        card.classList.add("scale-100", "opacity-100");
      }, 10);
    }

    function hidePopup() {
      card.classList.add("scale-90", "opacity-0");
      card.classList.remove("scale-100", "opacity-100");
      setTimeout(() => {
        popup.classList.add("hidden");
        popup.classList.remove("flex");
      }, 300);
    }

    setTimeout(() => {
      document.addEventListener("mouseleave", (e) => {
        if (e.clientY <= 0) {
          showPopup();
        }
      });

      history.pushState(null, null, window.location.href);
      window.addEventListener("popstate", () => {
        if (window.location.hash) return;

        if (!popupShown) {
          showPopup();
          history.pushState(null, null, window.location.href);
        }
      });

      setTimeout(() => {
        showPopup();
      }, 55000);
    }, 5000);

    backdrop.addEventListener("click", hidePopup);
    ctaBtn.addEventListener("click", hidePopup);
  }

  document.addEventListener("DOMContentLoaded", initExitIntentEs);
</script>
