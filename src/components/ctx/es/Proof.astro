---
import { Image } from "astro:assets";
import dep1 from "../../../assets/images/Prints/depoimento_ntr_1.png";
import dep2 from "../../../assets/images/Prints/depoimento_ntr_2.png";
import dep3 from "../../../assets/images/Prints/depoimento_ntr_3.png";
import dep4 from "../../../assets/images/Prints/print_depoimento_4.webp";
import dep5 from "../../../assets/images/Prints/print_depoimento_5.webp";
import dep6 from "../../../assets/images/Prints/print_depoimento_6.webp";
import dep7 from "../../../assets/images/Prints/print_depoimento_7.webp";

const prints = [
  { img: dep1, alt: "Resultado alumno NTR 1" },
  { img: dep2, alt: "Resultado alumno NTR 2" },
  { img: dep3, alt: "Resultado alumno NTR 3" },
  { img: dep4, alt: "Resultado alumno NTR 4" },
  { img: dep5, alt: "Resultado alumno NTR 5" },
  { img: dep6, alt: "Resultado alumno NTR 6" },
  { img: dep7, alt: "Resultado alumno NTR 7" },
];
---

<section class="relative overflow-hidden bg-white px-4 py-24">
  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="mb-16 text-center">
      <span class="text-sm font-black tracking-wider text-brand-orange uppercase italic">
        Alumnos en la Práctica
      </span>
      <h2 class="mt-2 mb-6 text-3xl font-black tracking-tighter text-slate-900 uppercase italic md:text-5xl">
        RESULTADO DE QUIENES <span class="text-brand-orange">HICIERON EL CURSO:</span>
      </h2>
    </div>

    {/* Grid dos prints em formato Galeria */}
    <div class="columns-1 gap-6 space-y-6 sm:columns-2 lg:columns-3">
      {prints.map((item) => (
        <div class="group relative break-inside-avoid overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 p-1.5 shadow-sm transition-all duration-300 hover:border-brand-orange/40 hover:shadow-md">
          <Image
            src={item.img}
            alt={item.alt}
            class="h-auto w-full rounded-xl object-contain transition-transform duration-500 group-hover:scale-[1.01]"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>
</section>
