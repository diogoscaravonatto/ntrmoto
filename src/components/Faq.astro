---
import { vetPragasData } from "./content";
---

<section class="py-24 bg-slate-50 relative overflow-hidden">
    <div class="container mx-auto px-6">
        <div class="grid lg:grid-cols-3 gap-16">
            <!-- Sidebar Content -->
            <div>
                <div
                    class="mb-4 inline-flex items-center px-3 py-1 bg-accent/10 border border-accent/20 rounded-lg"
                >
                    <span
                        class="text-[10px] font-black text-accent-dark uppercase tracking-wider"
                        >Dúvidas sobre Dedetização</span
                    >
                </div>
                <h2
                    class="text-4xl lg:text-5xl font-black text-slate-900 mt-4 mb-8 uppercase tracking-tighter"
                >
                    Perguntas <br /><span class="text-accent">Comuns</span>
                </h2>
                <p class="text-slate-500 leading-relaxed font-medium">
                    Tudo o que você precisa saber para se sentir 100% seguro
                    antes de contratar o nosso serviço.
                </p>
            </div>

            <!-- FAQ Accordion -->
            <div class="lg:col-span-2 space-y-4">
                {
                    vetPragasData.faq.map((item) => (
                        <details class="group bg-white border border-slate-100 rounded-3xl overflow-hidden transition-all duration-300 open:border-accent/30 open:shadow-xl open:shadow-accent/5">
                            <summary class="flex items-center justify-between p-8 cursor-pointer list-none list-outside">
                                <span class="font-bold text-lg text-slate-900 tracking-tight pr-8">
                                    {item.question}
                                </span>
                                <span class="transition-transform group-open:rotate-180 shrink-0 w-10 h-10 bg-slate-50 rounded-full flex items-center justify-center text-accent">
                                    <svg
                                        class="w-6 h-6"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M19 9l-7 7-7-7"
                                        />
                                    </svg>
                                </span>
                            </summary>
                            <div class="px-8 pb-8 text-slate-500 leading-relaxed font-medium border-t border-slate-50 pt-6 whitespace-pre-line">
                                {item.answer}
                            </div>
                        </details>
                    ))
                }

                <!-- Item de FAQ Especial para CTA -->
                <details
                    class="group bg-white border border-slate-100 rounded-3xl overflow-hidden transition-all duration-300 open:border-accent/30 open:shadow-xl open:shadow-accent/5"
                >
                    <summary
                        class="flex items-center justify-between p-8 cursor-pointer list-none list-outside"
                    >
                        <span
                            class="font-bold text-lg text-accent tracking-tight pr-8"
                        >
                            Não encontrou sua dúvida?
                        </span>
                        <span
                            class="transition-transform group-open:rotate-180 shrink-0 w-10 h-10 bg-accent/5 rounded-full flex items-center justify-center text-accent"
                        >
                            <svg
                                class="w-6 h-6"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </span>
                    </summary>
                    <div
                        class="px-8 pb-8 text-slate-500 leading-relaxed font-medium border-t border-slate-50 pt-6"
                    >
                        <p class="mb-4">
                            Nossa equipe técnica está de prontidão para analisar
                            seu caso específico.
                        </p>
                        <a
                            href="https://wa.me/5545991586405"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-accent font-black flex items-center gap-2 hover:gap-3 transition-all py-2"
                        >
                            Clique aqui e fale agora com um especialista
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                            </svg>
                        </a>
                    </div>
                </details>
            </div>
        </div>
    </div>
</section>
