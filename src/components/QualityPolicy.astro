---
import { Image } from "astro:assets";
import isoImg from "@assets/images/Selo-9001-BGA-1024x1024.webp";
---

<section class="py-24 bg-slate-50 relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        <!-- Content Container -->
        <div class="max-w-7xl mx-auto">
            <div
                class="grid lg:grid-cols-12 gap-12 lg:gap-20 items-center mb-24"
            >
                <!-- Certificado Info -->
                <div class="lg:col-span-8">
                    <div
                        class="mb-6 inline-flex items-center px-3 py-1 bg-accent/10 border border-accent/20 rounded-lg"
                    >
                        <span
                            class="text-[10px] font-black text-accent-dark uppercase tracking-wider"
                            >Compromisso com Excelência</span
                        >
                    </div>

                    <h2
                        class="text-4xl md:text-5xl font-black text-slate-900 mb-8 uppercase tracking-tighter"
                    >
                        Política de <span class="text-accent">Qualidade</span>
                    </h2>

                    <p
                        class="text-lg md:text-xl text-slate-600 leading-relaxed font-medium"
                    >
                        A <strong class="text-slate-900"
                            >DEDETIZADORA VETPRAGAS</strong
                        >, empresa especializada no serviço de controle
                        integrado de pragas e preocupada em promover ambientes
                        saudáveis, busca a satisfação dos clientes e demais
                        partes interessadas, atendendo adequadamente às suas
                        necessidades e por meio da melhoria contínua do seu
                        Sistema de Gestão da Qualidade com <strong
                            class="text-accent underline decoration-2 underline-offset-4"
                            >Certificação ISO 9001</strong
                        >.
                    </p>
                </div>

                <!-- Selo ISO Image -->
                <div class="lg:col-span-4 flex justify-center lg:justify-end">
                    <div class="relative w-48 h-48 md:w-64 md:h-64 shrink-0">
                        <div
                            class="absolute inset-0 bg-accent/10 blur-3xl rounded-full mix-blend-multiply"
                        >
                        </div>
                        <Image
                            src={isoImg}
                            alt="Certificação ISO 9001 VetPragas"
                            width={300}
                            height={300}
                            format="webp"
                            loading="lazy"
                            decoding="async"
                            class="relative w-full h-full object-contain drop-shadow-2xl hover:scale-105 transition-transform duration-500"
                        />
                    </div>
                </div>
            </div>

            <!-- Missão, Visão, Valores Grid -->
            <div class="grid md:grid-cols-3 gap-8">
                <!-- Missão -->
                <div
                    class="bg-white p-10 rounded-[2rem] shadow-[0_10px_40px_rgba(0,0,0,0.04)] border border-slate-100 hover:-translate-y-2 transition-transform duration-300"
                >
                    <div
                        class="w-14 h-14 bg-accent/10 rounded-2xl flex items-center justify-center text-accent mb-6"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="28"
                            height="28"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="12" cy="12" r="10"></circle>
                            <circle cx="12" cy="12" r="6"></circle>
                            <circle cx="12" cy="12" r="2"></circle>
                        </svg>
                    </div>
                    <h3
                        class="text-2xl font-black text-slate-900 mb-4 uppercase tracking-tight"
                    >
                        Missão
                    </h3>
                    <p class="text-slate-600 leading-relaxed font-medium">
                        Prestar o serviço de controle de pragas preocupando-se
                        com a saúde humana e respeitando o meio ambiente.
                    </p>
                </div>

                <!-- Visão -->
                <div
                    class="bg-white p-10 rounded-[2rem] shadow-[0_10px_40px_rgba(0,0,0,0.04)] border border-slate-100 hover:-translate-y-2 transition-transform duration-300"
                >
                    <div
                        class="w-14 h-14 bg-accent/10 rounded-2xl flex items-center justify-center text-accent mb-6"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="28"
                            height="28"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"
                            ></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </div>
                    <h3
                        class="text-2xl font-black text-slate-900 mb-4 uppercase tracking-tight"
                    >
                        Visão
                    </h3>
                    <p class="text-slate-600 leading-relaxed font-medium">
                        Ser uma empresa referência no controle de pragas em
                        âmbito nacional.
                    </p>
                </div>

                <!-- Valores -->
                <div
                    class="bg-white p-10 rounded-[2rem] shadow-[0_10px_40px_rgba(0,0,0,0.04)] border border-slate-100 hover:-translate-y-2 transition-transform duration-300"
                >
                    <div
                        class="w-14 h-14 bg-accent/10 rounded-2xl flex items-center justify-center text-accent mb-6"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="28"
                            height="28"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="m12 14 4-4"></path>
                            <path d="M3.34 19a10 10 0 1 1 17.32 0"></path>
                        </svg>
                    </div>
                    <h3
                        class="text-2xl font-black text-slate-900 mb-4 uppercase tracking-tight"
                    >
                        Valores
                    </h3>
                    <p class="text-slate-600 leading-relaxed font-medium">
                        Profissionalismo, qualidade, pontualidade, prevenção e
                        preocupação com meio ambiente e saúde dos colaboradores.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
