---
/**
 * CloudflareVisitorData Component
 *
 * Este componente extrai os dados de localização e IP do visitante fornecidos
 * nativamente pela infraestrutura da Cloudflare através de Headers HTTP.
 *
 * Como o projeto Astro está rodando em SSR (`output: 'server'`) com o adapter da Cloudflare,
 * nós temos acesso imediato à localização real do usuário antes mesmo da página renderizar.
 *
 * Este componente injeta esses dados no Client-Side (navegador), permitindo que você altere
 * dinamicamente textos (ex: "Descubra solteiros em {cidade}"), imagens ou redirecione o usuário.
 *
 * @param globalVarName - Nome da variável a ser injetada no window (default: 'cfVisitor')
 * @param debug - Habilita console.log no navagador com os dados detectados
 */

interface Props {
    globalVarName?: string;
    debug?: boolean;
}

const { globalVarName = "cfVisitor", debug = false } = Astro.props;

const cf = (Astro.request as any).cf || {};
const headers = Astro.request.headers;

// No Astro v6 + Cloudflare v13, o objeto 'cf' fica direto no request
// e o 'Astro.locals.runtime' foi removido.
const visitorData = {
    ip:
        headers.get("cf-connecting-ip") ||
        headers.get("x-real-ip") ||
        "127.0.0.1",
    city: cf.city || headers.get("cf-ipcity") || "Local Desconhecido",
    country: cf.country || headers.get("cf-ipcountry") || "BR",
    continent: cf.continent || headers.get("cf-ipcontinent") || "SA",
    region: cf.region || headers.get("cf-region") || "",
    regionCode: cf.regionCode || headers.get("cf-region-code") || "",
    latitude: cf.latitude || headers.get("cf-iplatitude") || "",
    longitude: cf.longitude || headers.get("cf-iplongitude") || "",
    timezone: cf.timezone || headers.get("cf-timezone") || "America/Sao_Paulo",
};
---

<!-- Cloudflare Visitor Data Integration -->
<script is:inline define:vars={{ visitorData, globalVarName, debug }}>
    (function () {
        // 1. Injeta os dados globalmente no objeto window
        window[globalVarName] = visitorData;

        if (debug) {
            console.log(
                `🌍 [CloudflareVisitorData] Identificado (window.${globalVarName}):`,
                visitorData,
            );
        }

        // 2. Dispara um evento customizado. Exemplo de uso no seu componente frontend:
        // window.addEventListener('cf-visitor-ready', (e) => {
        //    document.getElementById('cidade-alvo').innerText = e.detail.city;
        // });
        const event = new CustomEvent("cf-visitor-ready", {
            detail: visitorData,
        });

        // Usamos requestAnimationFrame ou um leve timeout para garantir que os listeners
        // de outros scripts inseridos logo abaixo tenham tempo de se registrar
        setTimeout(() => window.dispatchEvent(event), 0);
    })();
</script>
