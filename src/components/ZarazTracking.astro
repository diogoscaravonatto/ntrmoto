---
// Telemetria unificada Zaraz (GA4 + Meta CAPI) para páginas nativas Astro em www.ntrmoto.com.br.
---

<script>
  import { resolveOfferBySlug, resolveOfferByUrl } from "../utils/catalog";
  import {
    type AttributionData,
    type FirstTouchData,
    NTR_ATTR_COOKIE,
    NTR_FIRST_TOUCH_COOKIE,
    NTR_ID_COOKIE,
    NTR_JOURNEY_KEY,
    buildCookieDomainSuffix,
    decorateCheckoutUrl,
    decorateCrossDomainUrl,
    detectInAppBrowser,
    extractAttributionParams,
    generateEventId,
    inferTouchFromContext,
    isTrackedCtaDestination,
    mergeAttributionData,
    normalizeLeadPii,
  } from "../utils/tracking";

  type ZarazTrackPayload = Record<string, string | number>;
  type NavigatorWithUAData = Navigator & {
    userAgentData?: {
      getHighEntropyValues?: (
        hints: string[],
      ) => Promise<{ model?: string; platformVersion?: string }>;
    };
  };
  type ZarazWindow = Window & {
    __ntrOpenCookiePrefs?: () => void;
    __ntrTrackingInit?: boolean;
    zaraz?: {
      set?: (key: string, value: unknown, options?: { scope?: string }) => void;
      track?: (eventName: string, properties?: ZarazTrackPayload) => void;
      showConsentModal?: () => void;
    };
  };

  const win = window as ZarazWindow;
  if (!win.__ntrTrackingInit) {
    win.__ntrTrackingInit = true;

    const cookiePrefsButtons = document.querySelectorAll<HTMLButtonElement>(
      "[data-cookie-preferences]",
    );
    for (const btn of cookiePrefsButtons) {
      btn.addEventListener("click", () => {
        if (typeof win.__ntrOpenCookiePrefs === "function") {
          win.__ntrOpenCookiePrefs();
        } else {
          win.zaraz?.showConsentModal?.();
        }
      });
    }

    function readFirstPartyCookie(name: string): string {
      const prefix = `${name}=`;
      for (const part of document.cookie.split(";")) {
        const trimmed = part.trim();
        if (trimmed.startsWith(prefix)) {
          try {
            return decodeURIComponent(trimmed.slice(prefix.length));
          } catch {
            return "";
          }
        }
      }
      return "";
    }

    function writeFirstPartyCookie(name: string, value: string, maxAgeSeconds: number) {
      try {
        const suffix = buildCookieDomainSuffix(window.location.hostname, window.location.protocol);
        document.cookie = `${name}=${encodeURIComponent(value)}${suffix}; Max-Age=${maxAgeSeconds}`;
      } catch {
        // Ignora erro caso cookies estejam bloqueados
      }
    }

    function getOrCreateNtrId(): string {
      let id = readFirstPartyCookie(NTR_ID_COOKIE);
      if (!id) {
        try {
          id = localStorage.getItem(NTR_ID_COOKIE) ?? "";
        } catch {
          id = "";
        }
      }
      if (!id) {
        id =
          typeof crypto !== "undefined" && typeof crypto.randomUUID === "function"
            ? crypto.randomUUID()
            : `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
      }
      writeFirstPartyCookie(NTR_ID_COOKIE, id, 31536000);
      try {
        localStorage.setItem(NTR_ID_COOKIE, id);
      } catch {
        // Ignora erro de armazenamento
      }
      return id;
    }

    function getOrCreateFirstTouch(): FirstTouchData {
      let existing: FirstTouchData | null = null;
      const rawCookie = readFirstPartyCookie(NTR_FIRST_TOUCH_COOKIE);
      if (rawCookie) {
        try {
          existing = JSON.parse(rawCookie) as FirstTouchData;
        } catch {
          existing = null;
        }
      }
      if (!existing) {
        try {
          const rawLs = localStorage.getItem(NTR_FIRST_TOUCH_COOKIE);
          if (rawLs) existing = JSON.parse(rawLs) as FirstTouchData;
        } catch {
          existing = null;
        }
      }
      if (existing && existing.source) {
        if (!rawCookie) {
          writeFirstPartyCookie(NTR_FIRST_TOUCH_COOKIE, JSON.stringify(existing), 15552000);
        }
        return existing;
      }

      const inferred = inferTouchFromContext(
        window.location.search,
        document.referrer,
        window.location.pathname,
      );
      const serialized = JSON.stringify(inferred);
      writeFirstPartyCookie(NTR_FIRST_TOUCH_COOKIE, serialized, 15552000);
      try {
        localStorage.setItem(NTR_FIRST_TOUCH_COOKIE, serialized);
      } catch {
        // Ignora erro de armazenamento
      }
      return inferred;
    }

    function persistAttribution(): AttributionData {
      let stored: AttributionData = {};
      const rawCookie = readFirstPartyCookie(NTR_ATTR_COOKIE);
      if (rawCookie) {
        try {
          stored = JSON.parse(rawCookie) as AttributionData;
        } catch {
          stored = {};
        }
      } else {
        try {
          const rawLs = localStorage.getItem(NTR_ATTR_COOKIE);
          if (rawLs) stored = JSON.parse(rawLs) as AttributionData;
        } catch {
          stored = {};
        }
      }
      const incoming = extractAttributionParams(window.location.search);
      const merged = mergeAttributionData(stored, incoming);
      if (Object.keys(merged).length > 0) {
        const serialized = JSON.stringify(merged);
        writeFirstPartyCookie(NTR_ATTR_COOKIE, serialized, 2592000);
        try {
          localStorage.setItem(NTR_ATTR_COOKIE, serialized);
        } catch {
          // Ignora erro de armazenamento
        }
      }
      return merged;
    }

    function recordJourneyTouch(): number {
      try {
        const raw = localStorage.getItem(NTR_JOURNEY_KEY);
        const list = raw ? (JSON.parse(raw) as Array<{ h: string; p: string }>) : [];
        const entry = { h: window.location.hostname.toLowerCase(), p: window.location.pathname };
        const last = list[list.length - 1];
        if (!last || last.h !== entry.h || last.p !== entry.p) {
          list.push(entry);
          if (list.length > 12) list.splice(0, list.length - 12);
          localStorage.setItem(NTR_JOURNEY_KEY, JSON.stringify(list));
        }
        return list.length;
      } catch {
        return 1;
      }
    }

    const pendingZarazEvents: Array<{ name: string; props: ZarazTrackPayload }> = [];
    let zarazFlushScheduled = false;

    const activeNtrId = getOrCreateNtrId();
    const activeFirstTouch = getOrCreateFirstTouch();
    const activeAttribution = persistAttribution();
    const touchCount = recordJourneyTouch();
    const inAppBrowser = detectInAppBrowser(navigator.userAgent ?? "");
    let detectedDeviceModel = "";

    function applyZarazContext() {
      const z = win.zaraz;
      if (!z?.set) return;
      z.set("first_touch_source", activeFirstTouch.source, { scope: "page" });
      z.set("first_touch_medium", activeFirstTouch.medium, { scope: "page" });
      z.set("first_touch_campaign", activeFirstTouch.campaign ?? "", { scope: "page" });
      z.set("touch_count", touchCount, { scope: "page" });
      z.set("in_app_browser", inAppBrowser, { scope: "page" });
      if (detectedDeviceModel) {
        z.set("device_model", detectedDeviceModel, { scope: "page" });
      }
    }

    function scheduleHighEntropyDeviceModel() {
      const uaData = (navigator as NavigatorWithUAData).userAgentData;
      if (!uaData?.getHighEntropyValues) return;
      const collect = () => {
        uaData
          .getHighEntropyValues?.(["model", "platformVersion"])
          .then((hints) => {
            const model = hints?.model?.trim();
            if (model) {
              detectedDeviceModel = model;
              win.zaraz?.set?.("device_model", model, { scope: "page" });
            }
          })
          .catch(() => {
            // Ignora em navegadores sem suporte
          });
      };
      if (typeof win.requestIdleCallback === "function") {
        win.requestIdleCallback(collect, { timeout: 1500 });
      } else {
        window.setTimeout(collect, 0);
      }
    }
    scheduleHighEntropyDeviceModel();

    function flushPendingZarazEvents() {
      const z = win.zaraz;
      if (!z?.track) return false;
      applyZarazContext();
      while (pendingZarazEvents.length > 0) {
        const item = pendingZarazEvents.shift();
        if (item) z.track(item.name, item.props);
      }
      return true;
    }

    function trackZaraz(eventName: string, props: ZarazTrackPayload) {
      const z = win.zaraz;
      if (z?.track) {
        applyZarazContext();
        z.track(eventName, props);
        return;
      }
      pendingZarazEvents.push({ name: eventName, props });
      if (!zarazFlushScheduled) {
        zarazFlushScheduled = true;
        document.addEventListener("zarazLoaded", () => flushPendingZarazEvents(), { once: true });
        let attempts = 0;
        const timer = window.setInterval(() => {
          attempts += 1;
          if (flushPendingZarazEvents() || attempts >= 20) {
            window.clearInterval(timer);
          }
        }, 250);
      }
    }

    applyZarazContext();

    function decorateAnchor(anchor: HTMLAnchorElement) {
      const decoratedCross = decorateCrossDomainUrl(
        anchor.href,
        window.location.href,
        activeNtrId,
        activeAttribution,
      );
      if (decoratedCross) {
        anchor.href = decoratedCross;
        return;
      }
      const decoratedCheckout = decorateCheckoutUrl(
        anchor.href,
        window.location.href,
        activeNtrId,
        activeAttribution,
        activeFirstTouch,
      );
      if (decoratedCheckout) {
        anchor.href = decoratedCheckout;
      }
    }

    const anchors = document.querySelectorAll<HTMLAnchorElement>("a[href]");
    for (const anchor of anchors) {
      decorateAnchor(anchor);
    }

    const { ntrContentType, ntrContentSlug } = document.body.dataset;
    const pageOffer = ntrContentSlug ? resolveOfferBySlug(ntrContentSlug) : null;

    if (ntrContentType && ntrContentSlug) {
      const viewPayload: ZarazTrackPayload = {
        content_type: ntrContentType,
        content_slug: ntrContentSlug,
        page_path: window.location.pathname,
        event_id: generateEventId("vc"),
        first_touch_source: activeFirstTouch.source,
        first_touch_medium: activeFirstTouch.medium,
        first_touch_campaign: activeFirstTouch.campaign ?? "",
        touch_count: touchCount,
      };
      if (pageOffer) {
        viewPayload.content_ids = pageOffer.id;
        viewPayload.value = pageOffer.value;
        viewPayload.currency = pageOffer.currency;
      }
      trackZaraz("view_content", viewPayload);
    }

    // Rastreamento unificado de CTAs comerciais (Eduzz/Greenn/WhatsApp/escolademotores.com.br)
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const anchor = target.closest("a");
      if (!(anchor instanceof HTMLAnchorElement) || !anchor.href) return;
      try {
        decorateAnchor(anchor);
        const dest = new URL(anchor.href, window.location.href);
        const host = dest.hostname.toLowerCase();
        if (isTrackedCtaDestination(host)) {
          const ctaText = (anchor.textContent ?? "").replace(/\s+/g, " ").trim().slice(0, 120);
          const resolvedOffer = resolveOfferByUrl(dest.href) ?? pageOffer;
          const ctaPayload: ZarazTrackPayload = {
            link_url: dest.href,
            link_host: host,
            page_path: window.location.pathname,
            cta_text: ctaText,
            event_id: generateEventId("cta"),
            first_touch_source: activeFirstTouch.source,
            first_touch_medium: activeFirstTouch.medium,
            first_touch_campaign: activeFirstTouch.campaign ?? "",
            touch_count: touchCount,
          };
          if (resolvedOffer) {
            ctaPayload.content_ids = resolvedOffer.id;
            ctaPayload.value = resolvedOffer.value;
            ctaPayload.currency = resolvedOffer.currency;
          }
          trackZaraz("cta_click", ctaPayload);
        }
      } catch {
        // Ignora URLs inválidas
      }
    });

    // Captura não-destrutiva de formulários com PII (e-mail/telefone/nome) para EMQ elevado em Lead
    document.addEventListener(
      "submit",
      (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
        const phoneInput = form.querySelector<HTMLInputElement>('input[type="tel"]');
        const nameInput = form.querySelector<HTMLInputElement>('input[type="text"]');
        const pii = normalizeLeadPii({
          email: emailInput?.value,
          phone: phoneInput?.value,
          name: nameInput?.value,
        });
        if (!pii.em && !pii.ph) return;
        const leadPayload: ZarazTrackPayload = {
          content_name: pageOffer?.name ?? ntrContentSlug ?? document.title,
          page_path: window.location.pathname,
          event_id: generateEventId("lead"),
          first_touch_source: activeFirstTouch.source,
          first_touch_campaign: activeFirstTouch.campaign ?? "",
          ...pii,
        };
        if (pageOffer) {
          leadPayload.content_ids = pageOffer.id;
          leadPayload.value = pageOffer.value;
          leadPayload.currency = pageOffer.currency;
        }
        trackZaraz("generate_lead", leadPayload);
      },
      true,
    );

    // Rastreamento de profundidade de rolagem (50% e 90%, uma única vez por marco)
    let firedScroll50 = false;
    let firedScroll90 = false;
    let scrollTicking = false;

    function evaluateScrollDepth() {
      scrollTicking = false;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollable <= 0) return;
      const currentY = window.scrollY || window.pageYOffset || 0;
      const pct = (currentY / scrollable) * 100;
      if (!firedScroll50 && pct >= 50) {
        firedScroll50 = true;
        trackZaraz("scroll_depth", {
          percent_scrolled: 50,
          page_path: window.location.pathname,
          event_id: generateEventId("scr50"),
        });
      }
      if (!firedScroll90 && pct >= 90) {
        firedScroll90 = true;
        trackZaraz("scroll_depth", {
          percent_scrolled: 90,
          page_path: window.location.pathname,
          event_id: generateEventId("scr90"),
        });
      }
      if (firedScroll50 && firedScroll90) {
        window.removeEventListener("scroll", onScrollPassive);
      }
    }

    function onScrollPassive() {
      if (scrollTicking) return;
      scrollTicking = true;
      window.requestAnimationFrame(evaluateScrollDepth);
    }

    window.addEventListener("scroll", onScrollPassive, { passive: true });
  }
</script>
