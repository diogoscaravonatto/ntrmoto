---
import CalculatorShell from "./CalculatorShell.astro";
import TelemetryInput from "./TelemetryInput.astro";
import TelemetryReadout from "./TelemetryReadout.astro";
---

<CalculatorShell
  id="cilindrada"
  code="NTR // 01"
  title="Cilindrada do Motor"
  subtitle="Volume deslocado real pelo conjunto cilindro e curso do virabrequim."
  category="bloco"
  spanClass="md:col-span-7"
>
  <span slot="badge" class="ntr-font-mono text-[10px] tracking-wider text-zinc-500 uppercase">
    ((Ø² × C × π) / 4000)
  </span>

  <div class="grid grid-cols-1 items-center gap-4 sm:grid-cols-12">
    {/* Diagrama SVG Dinâmico Cilindro + Pistão */}
    <div class="relative flex min-h-[188px] flex-col items-center justify-center overflow-hidden rounded-2xl border border-white/[0.06] bg-[#09090d] p-4 sm:col-span-5">
      <svg viewBox="0 0 180 150" class="h-auto w-full max-w-[180px]" aria-hidden="true">
        <defs>
          <linearGradient id="ntr-cyl-glow" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#FF2D20" stop-opacity="0.32" />
            <stop offset="100%" stop-color="#FF6B00" stop-opacity="0.04" />
          </linearGradient>
          <linearGradient id="ntr-piston-metal" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#27272f" />
            <stop offset="50%" stop-color="#52525e" />
            <stop offset="100%" stop-color="#27272f" />
          </linearGradient>
        </defs>

        <line
          x1="26"
          y1="22"
          x2="154"
          y2="22"
          stroke="rgba(255,255,255,0.2)"
          stroke-width="1"
          stroke-dasharray="3 3"
        />
        <text
          data-svg="cil-bore-txt"
          x="90"
          y="15"
          text-anchor="middle"
          fill="#a1a1aa"
          font-size="9"
          font-family="JetBrains Mono, monospace"
        >
          Ø 57,3 mm
        </text>

        <line
          x1="162"
          y1="30"
          x2="162"
          y2="122"
          stroke="rgba(255,45,32,0.45)"
          stroke-width="1"
          stroke-dasharray="3 3"
        />
        <text
          data-svg="cil-stroke-txt"
          x="157"
          y="78"
          text-anchor="end"
          fill="#FF5A36"
          font-size="8.5"
          font-family="JetBrains Mono, monospace"
        >
          57,8
        </text>

        <g
          data-svg="cil-chamber"
          style="transform-origin: 90px 76px; transition: transform 600ms cubic-bezier(0.32,0.72,0,1);"
        >
          <rect
            x="48"
            y="30"
            width="84"
            height="92"
            rx="6"
            fill="url(#ntr-cyl-glow)"
            stroke="rgba(255,255,255,0.22)"
            stroke-width="1.4"
          />
          <g class="ntr-piston-motion">
            <rect
              x="52"
              y="76"
              width="76"
              height="30"
              rx="4"
              fill="url(#ntr-piston-metal)"
              stroke="rgba(255,255,255,0.35)"
              stroke-width="1.2"
            />
            <line x1="54" y1="84" x2="126" y2="84" stroke="#FF2D20" stroke-width="1.5" />
            <line
              x1="54"
              y1="90"
              x2="126"
              y2="90"
              stroke="rgba(255,255,255,0.3)"
              stroke-width="1"
            />
            <circle cx="90" cy="98" r="4.5" fill="#09090d" stroke="#FF5A36" stroke-width="1.4" />
            <line
              x1="90"
              y1="102.5"
              x2="90"
              y2="132"
              stroke="rgba(255,255,255,0.4)"
              stroke-width="3"
              stroke-linecap="round"
            />
          </g>
        </g>
      </svg>
      <span
        data-svg="cil-ratio-tag"
        class="ntr-font-mono mt-1 text-[10px] tracking-[0.16em] text-zinc-400 uppercase"
      >
        QUADRADO // 0,99
      </span>
    </div>

    {/* Entradas */}
    <div class="flex flex-col gap-3 sm:col-span-7">
      <TelemetryInput
        id="input-cil-bore"
        label="Diâmetro do Cilindro"
        unit="mm"
        field="bore"
        value={57.3}
        min={0}
        max={2000}
        step={0.1}
        decimals={2}
        hint="Pistão"
      />
      <TelemetryInput
        id="input-cil-stroke"
        label="Curso do Virabrequim"
        unit="mm"
        field="stroke"
        value={57.8}
        min={0}
        max={2000}
        step={0.1}
        decimals={2}
        hint="Curso"
      />
    </div>
  </div>

  {/* Resultado + Ação Sincronizar (Button-in-Button) */}
  <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
    <div class="flex-1">
      <TelemetryReadout
        label="Cilindrada Total"
        outputKey="cilindrada-result"
        unit="cc"
        initialText="149,05"
        accent="red"
      />
    </div>
    <button
      type="button"
      data-sync-engine
      class="group/sync inline-flex cursor-pointer items-center justify-between gap-3 rounded-full bg-[#FF2D20] py-2 pr-2 pl-5 text-xs font-semibold tracking-[0.14em] text-white uppercase transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-[#e52418] active:scale-[0.98]"
    >
      <span data-sync-label>Sincronizar Motor</span>
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-black/20 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover/sync:translate-x-0.5 group-hover/sync:scale-105">
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </span>
    </button>
  </div>
</CalculatorShell>

<style>
  .ntr-piston-motion {
    animation: ntr-piston-cycle 2.8s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
  }

  @keyframes ntr-piston-cycle {
    0%,
    100% {
      transform: translateY(-22px);
    }
    50% {
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ntr-piston-motion {
      animation: none;
    }
  }
</style>
