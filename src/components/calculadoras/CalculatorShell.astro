---
interface Props {
  id: string;
  code: string;
  title: string;
  subtitle: string;
  category: "bloco" | "cabecote" | "alimentacao";
  spanClass?: string;
}

const { id, code, title, subtitle, category, spanClass = "md:col-span-6" } = Astro.props;
---

<article
  id={`calc-card-${id}`}
  data-calc-card={id}
  data-category={category}
  class:list={[
    "ntr-reveal ntr-bezel-outer group relative rounded-[2rem] border border-white/10 bg-white/[0.04] p-1.5 transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]",
    spanClass,
  ]}
>
  <div class="ntr-bezel-inner relative flex h-full flex-col justify-between gap-5 overflow-hidden rounded-[calc(2rem-0.375rem)] bg-[#0b0b0f] p-5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.12)] sm:p-6 md:p-7">
    {/* Spotlight sutil guiado por --mx / --my sem blur */}
    <div class="ntr-spotlight" aria-hidden="true"></div>

    {/* Cabeçalho técnico */}
    <header class="relative z-10 flex items-start justify-between gap-3">
      <div class="min-w-0 space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="ntr-font-mono inline-flex items-center gap-1.5 rounded-full border border-[#FF2D20]/25 bg-[#FF2D20]/10 px-2.5 py-0.5 text-[10px] tracking-[0.18em] text-[#FF5A36] uppercase">
            <span class="h-1.5 w-1.5 rounded-full bg-[#FF2D20]"></span>
            {code}
          </span>
          <slot name="badge" />
        </div>
        <h2 class="ntr-font-display text-xl leading-tight font-bold tracking-tight text-white sm:text-2xl">
          {title}
        </h2>
        <p class="text-xs leading-relaxed text-zinc-400 sm:text-sm">{subtitle}</p>
      </div>

      <button
        type="button"
        data-reset-calc={id}
        title="Restaurar valores padrão"
        aria-label={`Restaurar valores padrão de ${title}`}
        class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-zinc-400 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-white/[0.1] hover:text-white active:scale-95"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
          <path d="M3 3v5h5" />
        </svg>
      </button>
    </header>

    {/* Corpo da Calculadora (inputs, SVG animado e readouts) */}
    <div class="relative z-10 flex flex-grow flex-col justify-between gap-5">
      <slot />
    </div>
  </div>
</article>

<style>
  .ntr-bezel-outer {
    --mx: 50%;
    --my: 0%;
  }

  .ntr-spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      420px circle at var(--mx) var(--my),
      rgba(255, 45, 32, 0.11),
      transparent 60%
    );
    transition: opacity 500ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .ntr-bezel-outer:hover .ntr-spotlight {
    opacity: 1;
  }
</style>
