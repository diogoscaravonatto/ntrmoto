---
import CalculatorShell from "./CalculatorShell.astro";
import TelemetryInput from "./TelemetryInput.astro";
import TelemetryReadout from "./TelemetryReadout.astro";
---

<CalculatorShell
  id="rl"
  code="NTR // 04"
  title="Relação R/L"
  subtitle="Geometria entre o raio do virabrequim e o comprimento entre centros da biela."
  category="bloco"
  spanClass="md:col-span-7"
>
  <span
    slot="badge"
    data-svg="rl-zone-badge"
    class="ntr-font-mono rounded-full border border-emerald-500/30 bg-emerald-500/15 px-2 py-0.5 text-[10px] tracking-wider text-emerald-400 uppercase"
  >
    Ideal &lt; 0,30
  </span>

  <div class="grid grid-cols-1 items-center gap-4 sm:grid-cols-12">
    {/* SVG Cinemático Virabrequim + Biela */}
    <div class="flex min-h-[180px] flex-col items-center justify-center rounded-2xl border border-white/[0.06] bg-[#09090d] p-4 sm:col-span-5">
      <svg viewBox="0 0 180 150" class="h-auto w-full max-w-[175px]" aria-hidden="true">
        <line
          x1="90"
          y1="12"
          x2="90"
          y2="142"
          stroke="rgba(255,255,255,0.12)"
          stroke-width="1"
          stroke-dasharray="3 3"
        />
        <circle
          cx="90"
          cy="108"
          r="28"
          fill="rgba(255,45,32,0.06)"
          stroke="rgba(255,255,255,0.22)"
          stroke-width="1.3"
        />
        <circle cx="90" cy="108" r="4" fill="#FF2D20" />
        <g
          data-svg="rl-rod-group"
          style="transform-origin: 90px 30px; transition: transform 600ms cubic-bezier(0.32,0.72,0,1);"
        >
          <line
            x1="90"
            y1="30"
            x2="114"
            y2="102"
            stroke="#FF5A36"
            stroke-width="3.2"
            stroke-linecap="round"
          />
          <line
            x1="90"
            y1="108"
            x2="114"
            y2="102"
            stroke="rgba(255,255,255,0.55)"
            stroke-width="2"
            stroke-linecap="round"
          />
          <circle cx="114" cy="102" r="4.5" fill="#09090d" stroke="#fff" stroke-width="1.5" />
        </g>
        <rect
          x="74"
          y="18"
          width="32"
          height="22"
          rx="4"
          fill="#1d1d24"
          stroke="rgba(255,255,255,0.3)"
          stroke-width="1.2"
        />
        <circle cx="90" cy="30" r="3.5" fill="#fff" />
        <text x="140" y="72" fill="#a1a1aa" font-size="8.5" font-family="JetBrains Mono, monospace">
          L
        </text>
        <text
          x="128"
          y="118"
          fill="#FF5A36"
          font-size="8.5"
          font-family="JetBrains Mono, monospace"
        >
          R
        </text>
      </svg>
      <span class="ntr-font-mono text-[10px] tracking-[0.14em] text-zinc-500 uppercase">
        Empuxo Lateral do Pistão
      </span>
    </div>

    <div class="flex flex-col gap-3 sm:col-span-7">
      <TelemetryInput
        id="input-rl-stroke"
        label="Curso do Virabrequim"
        unit="mm"
        field="stroke"
        value={57.8}
        min={0}
        max={2000}
        step={0.1}
        decimals={1}
      />
      <TelemetryInput
        id="input-rl-rod"
        label="Comprimento Entre Centros da Biela"
        unit="mm"
        field="rodLength"
        value={103.5}
        min={0.1}
        max={2000}
        step={0.1}
        decimals={1}
      />
    </div>
  </div>

  <TelemetryReadout label="Relação R/L" outputKey="rl-result" initialText="0,28" accent="emerald" />
</CalculatorShell>
