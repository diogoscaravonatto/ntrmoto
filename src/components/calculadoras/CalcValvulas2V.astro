---
import CalculatorShell from "./CalculatorShell.astro";
import TelemetryInput from "./TelemetryInput.astro";
import TelemetryReadout from "./TelemetryReadout.astro";
---

<CalculatorShell
  id="valvulas-2v"
  code="NTR // 07"
  title="Aumento de Válvulas — 2V"
  subtitle="Diâmetro recomendado de admissão e escape para cabeçotes de 2 válvulas por faixa de cilindrada."
  category="cabecote"
  spanClass="md:col-span-7"
>
  <span slot="badge" class="ntr-font-mono text-[10px] tracking-wider text-zinc-500 uppercase">
    Base 30 / 26 mm
  </span>

  {/* Switch Segmentado de Faixa (100–270cc vs 271–2000cc) */}
  <div class="grid grid-cols-2 gap-1.5 rounded-2xl border border-white/[0.08] bg-[#09090d] p-1.5">
    <button
      type="button"
      data-v2-range="ate270"
      aria-pressed="true"
      class="ntr-v2-tab is-active cursor-pointer rounded-xl px-3 py-2 text-xs font-semibold transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
    >
      Até 270cc <span class="ntr-font-mono text-[10px] opacity-75">(100–270)</span>
    </button>
    <button
      type="button"
      data-v2-range="acima271"
      aria-pressed="false"
      class="ntr-v2-tab cursor-pointer rounded-xl px-3 py-2 text-xs font-semibold transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
    >
      +271cc <span class="ntr-font-mono text-[10px] opacity-75">(271–2000)</span>
    </button>
  </div>

  <div class="grid grid-cols-1 items-center gap-4 sm:grid-cols-12">
    {/* SVG Câmara 2 Válvulas */}
    <div class="flex min-h-[164px] flex-col items-center justify-center rounded-2xl border border-white/[0.06] bg-[#09090d] p-4 sm:col-span-5">
      <svg viewBox="0 0 180 120" class="h-auto w-full max-w-[175px]" aria-hidden="true">
        <circle
          cx="90"
          cy="60"
          r="52"
          fill="rgba(255,255,255,0.02)"
          stroke="rgba(255,255,255,0.16)"
          stroke-width="1.4"
          stroke-dasharray="4 3"
        />
        {/* Válvula ADM */}
        <circle
          data-svg="v2-adm"
          cx="66"
          cy="60"
          r="21"
          fill="rgba(255,45,32,0.16)"
          stroke="#FF2D20"
          stroke-width="2"
          style="transform-origin: 66px 60px; transition: transform 600ms cubic-bezier(0.32,0.72,0,1);"
        />
        <text
          x="66"
          y="63"
          text-anchor="middle"
          fill="#fff"
          font-size="9"
          font-family="JetBrains Mono, monospace"
        >
          ADM
        </text>
        {/* Válvula ESC */}
        <circle
          data-svg="v2-esc"
          cx="116"
          cy="60"
          r="18"
          fill="rgba(255,107,0,0.16)"
          stroke="#FF6B00"
          stroke-width="2"
          style="transform-origin: 116px 60px; transition: transform 600ms cubic-bezier(0.32,0.72,0,1);"
        />
        <text
          x="116"
          y="63"
          text-anchor="middle"
          fill="#fff"
          font-size="9"
          font-family="JetBrains Mono, monospace"
        >
          ESC
        </text>
      </svg>
      <div class="ntr-font-mono mt-1 flex items-center gap-3 text-[10px] text-zinc-400">
        <span>
          CC:{" "}
          <strong data-output="v2-pct-cc" class="text-white">
            0,00%
          </strong>
        </span>
        <span>
          Válv:{" "}
          <strong data-output="v2-pct-valv" class="text-[#FF5A36]">
            0,00%
          </strong>
        </span>
      </div>
    </div>

    <div class="flex flex-col gap-3 sm:col-span-7">
      <TelemetryInput
        id="input-v2-cc"
        label="Cilindrada Total"
        unit="cc"
        field="cc"
        value={150}
        min={100}
        max={270}
        step={1}
        decimals={1}
        hint="100–270cc"
      />
      <div class="grid grid-cols-2 gap-2.5">
        <TelemetryReadout
          label="Válvula ADM"
          outputKey="v2-adm-result"
          unit="mm"
          initialText="30,0"
          accent="red"
          size="md"
        />
        <TelemetryReadout
          label="Válvula ESC"
          outputKey="v2-esc-result"
          unit="mm"
          initialText="26,0"
          accent="amber"
          size="md"
        />
      </div>
    </div>
  </div>
</CalculatorShell>

<style>
  .ntr-v2-tab {
    color: #a1a1aa;
    background: transparent;
  }

  .ntr-v2-tab.is-active {
    color: #ffffff;
    background: rgba(255, 45, 32, 0.18);
    box-shadow: inset 0 0 0 1px rgba(255, 45, 32, 0.45);
  }
</style>
