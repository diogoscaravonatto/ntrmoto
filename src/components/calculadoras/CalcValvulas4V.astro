---
import CalculatorShell from "./CalculatorShell.astro";
import TelemetryInput from "./TelemetryInput.astro";
import TelemetryReadout from "./TelemetryReadout.astro";
---

<CalculatorShell
  id="valvulas-4v"
  code="NTR // 08"
  title="Aumento de Válvulas — 4V"
  subtitle="Dimensionamento proporcional de admissão e escape para cabeçotes de 4 válvulas."
  category="cabecote"
  spanClass="md:col-span-5"
>
  <span slot="badge" class="ntr-font-mono text-[10px] tracking-wider text-zinc-500 uppercase">
    Base 28 / 23,5 mm
  </span>

  {/* SVG Câmara 4 Válvulas */}
  <div class="flex flex-col items-center justify-center rounded-2xl border border-white/[0.06] bg-[#09090d] p-3.5">
    <svg viewBox="0 0 180 112" class="h-auto w-full max-w-[168px]" aria-hidden="true">
      <circle
        cx="90"
        cy="56"
        r="49"
        fill="rgba(255,255,255,0.02)"
        stroke="rgba(255,255,255,0.16)"
        stroke-width="1.3"
        stroke-dasharray="4 3"
      />
      <g
        data-svg="v4-adm-group"
        style="transform-origin: 67px 56px; transition: transform 600ms cubic-bezier(0.32,0.72,0,1);"
      >
        <circle
          cx="67"
          cy="36"
          r="14.5"
          fill="rgba(255,45,32,0.18)"
          stroke="#FF2D20"
          stroke-width="1.8"
        />
        <circle
          cx="67"
          cy="76"
          r="14.5"
          fill="rgba(255,45,32,0.18)"
          stroke="#FF2D20"
          stroke-width="1.8"
        />
        <text
          x="67"
          y="39"
          text-anchor="middle"
          fill="#fff"
          font-size="7.5"
          font-family="JetBrains Mono, monospace"
        >
          ADM
        </text>
        <text
          x="67"
          y="79"
          text-anchor="middle"
          fill="#fff"
          font-size="7.5"
          font-family="JetBrains Mono, monospace"
        >
          ADM
        </text>
      </g>
      <g
        data-svg="v4-esc-group"
        style="transform-origin: 113px 56px; transition: transform 600ms cubic-bezier(0.32,0.72,0,1);"
      >
        <circle
          cx="113"
          cy="37"
          r="12.5"
          fill="rgba(255,107,0,0.18)"
          stroke="#FF6B00"
          stroke-width="1.8"
        />
        <circle
          cx="113"
          cy="75"
          r="12.5"
          fill="rgba(255,107,0,0.18)"
          stroke="#FF6B00"
          stroke-width="1.8"
        />
        <text
          x="113"
          y="40"
          text-anchor="middle"
          fill="#fff"
          font-size="7.5"
          font-family="JetBrains Mono, monospace"
        >
          ESC
        </text>
        <text
          x="113"
          y="78"
          text-anchor="middle"
          fill="#fff"
          font-size="7.5"
          font-family="JetBrains Mono, monospace"
        >
          ESC
        </text>
      </g>
    </svg>
    <div class="ntr-font-mono mt-1 flex items-center gap-3 text-[10px] text-zinc-400">
      <span>
        CC:{" "}
        <strong data-output="v4-pct-cc" class="text-white">
          0,00%
        </strong>
      </span>
      <span>
        Válv:{" "}
        <strong data-output="v4-pct-valv" class="text-[#FF5A36]">
          0,00%
        </strong>
      </span>
    </div>
  </div>

  <TelemetryInput
    id="input-v4-cc"
    label="Cilindrada Total (acima de 250cc)"
    unit="cc"
    field="cc"
    value={250}
    min={250}
    max={2000}
    step={1}
    decimals={1}
    hint="250–2000cc"
  />

  <div class="grid grid-cols-2 gap-2.5">
    <TelemetryReadout
      label="Válvula ADM"
      outputKey="v4-adm-result"
      unit="mm"
      initialText="28,0"
      accent="red"
      size="md"
    />
    <TelemetryReadout
      label="Válvula ESC"
      outputKey="v4-esc-result"
      unit="mm"
      initialText="23,5"
      accent="amber"
      size="md"
    />
  </div>
</CalculatorShell>
