---
import CalculatorShell from "./CalculatorShell.astro";
import TelemetryInput from "./TelemetryInput.astro";
import TelemetryReadout from "./TelemetryReadout.astro";
---

<CalculatorShell
  id="vmp"
  code="NTR // 05"
  title="Velocidade Média do Pistão (VMP)"
  subtitle="Avalia o estresse mecânico do conjunto móvel na rotação máxima."
  category="bloco"
  spanClass="md:col-span-6"
>
  <span
    slot="badge"
    data-svg="vmp-zone-badge"
    class="ntr-font-mono rounded-full border border-emerald-500/30 bg-emerald-500/15 px-2 py-0.5 text-[10px] tracking-wider text-emerald-400 uppercase"
  >
    Zona Segura
  </span>

  {/* Arc Tachometer Gauge SVG */}
  <div class="flex flex-col items-center rounded-2xl border border-white/[0.06] bg-[#09090d] px-4 pt-4 pb-3">
    <svg
      viewBox="0 0 220 122"
      class="h-auto w-full max-w-[230px] overflow-visible"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="ntr-vmp-arc" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#10b981" />
          <stop offset="65%" stop-color="#f59e0b" />
          <stop offset="100%" stop-color="#FF2D20" />
        </linearGradient>
      </defs>
      <path
        d="M 24 106 A 86 86 0 0 1 196 106"
        fill="none"
        stroke="rgba(255,255,255,0.08)"
        stroke-width="10"
        stroke-linecap="round"
      />
      <path
        data-svg="vmp-arc-fill"
        d="M 24 106 A 86 86 0 0 1 196 106"
        fill="none"
        stroke="url(#ntr-vmp-arc)"
        stroke-width="10"
        stroke-linecap="round"
        stroke-dasharray="270"
        stroke-dashoffset="105"
        style="transition: stroke-dashoffset 650ms cubic-bezier(0.32,0.72,0,1);"
      />
      <g
        data-svg="vmp-needle"
        style="transform-origin: 110px 106px; transform: rotate(20deg); transition: transform 650ms cubic-bezier(0.32,0.72,0,1);"
      >
        <line
          x1="110"
          y1="106"
          x2="110"
          y2="30"
          stroke="#ffffff"
          stroke-width="2.2"
          stroke-linecap="round"
        />
        <circle cx="110" cy="106" r="6" fill="#FF2D20" stroke="#ffffff" stroke-width="2" />
      </g>
      <text x="20" y="119" fill="#71717a" font-size="8.5" font-family="JetBrains Mono, monospace">
        0
      </text>
      <text
        x="110"
        y="16"
        text-anchor="middle"
        fill="#a1a1aa"
        font-size="8.5"
        font-family="JetBrains Mono, monospace"
      >
        15 m/s
      </text>
      <text
        x="194"
        y="119"
        text-anchor="end"
        fill="#FF5A36"
        font-size="8.5"
        font-family="JetBrains Mono, monospace"
      >
        30+
      </text>
    </svg>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <TelemetryInput
      id="input-vmp-stroke"
      label="Curso do Virabrequim"
      unit="mm"
      field="stroke"
      value={57.8}
      min={0}
      max={2000}
      step={0.1}
      decimals={1}
    />
    <TelemetryInput
      id="input-vmp-rpm"
      label="Rotação Máxima"
      unit="RPM"
      field="rpm"
      value={9500}
      min={0}
      max={20000}
      step={100}
      decimals={0}
      hint="Sem ponto"
    />
  </div>

  <TelemetryReadout
    label="Velocidade Média do Pistão"
    outputKey="vmp-result"
    unit="m/s"
    initialText="18,30"
    accent="red"
  />
</CalculatorShell>
