---
interface Props {
  label: string;
  outputKey: string;
  unit?: string;
  initialText?: string;
  accent?: "red" | "amber" | "emerald" | "neutral";
  size?: "lg" | "md";
}

const { label, outputKey, unit = "", initialText = "—", accent = "red", size = "lg" } = Astro.props;

const accentColors = {
  red: "border-[#FF2D20]/30 bg-gradient-to-br from-[#FF2D20]/[0.09] to-[#111116]",
  amber: "border-[#FF6B00]/30 bg-gradient-to-br from-[#FF6B00]/[0.09] to-[#111116]",
  emerald: "border-emerald-500/30 bg-gradient-to-br from-emerald-500/[0.08] to-[#111116]",
  neutral: "border-white/10 bg-[#121218]",
}[accent];

const valueTextSize = size === "lg" ? "text-2xl sm:text-3xl md:text-[2rem]" : "text-xl sm:text-2xl";
---

<div class:list={["rounded-2xl border px-4 py-3.5", accentColors]}>
  <div class="mb-1 flex items-center justify-between gap-2">
    <span class="ntr-font-mono text-[10px] tracking-[0.16em] text-zinc-400 uppercase">{label}</span>
    <slot name="status" />
  </div>
  <div class="flex items-baseline gap-1.5">
    <output
      data-output={outputKey}
      class:list={["ntr-font-mono leading-none font-bold tracking-tight text-white", valueTextSize]}
    >
      {initialText}
    </output>
    {unit && <span class="ntr-font-mono text-xs font-medium text-zinc-400 sm:text-sm">{unit}</span>}
  </div>
</div>
