---
import CalculatorShell from "./CalculatorShell.astro";
import TelemetryInput from "./TelemetryInput.astro";
import TelemetryReadout from "./TelemetryReadout.astro";
---

<CalculatorShell
  id="carburador"
  code="NTR // 06"
  title="Carburador & TBI"
  subtitle="Dimensionamento do diâmetro de Venturi para alimentação por carburador ou injeção (+10%)."
  category="alimentacao"
  spanClass="md:col-span-6"
>
  {/* SVG Venturi Comparativo Carburador vs TBI */}
  <div class="flex min-h-[120px] items-center justify-around gap-4 rounded-2xl border border-white/[0.06] bg-[#09090d] p-4">
    <div class="flex flex-col items-center gap-1.5">
      <svg viewBox="0 0 90 90" class="h-20 w-20" aria-hidden="true">
        <circle
          cx="45"
          cy="45"
          r="38"
          fill="none"
          stroke="rgba(255,255,255,0.12)"
          stroke-width="1.5"
          stroke-dasharray="4 3"
        />
        <circle
          data-svg="carb-ring"
          cx="45"
          cy="45"
          r="24"
          fill="rgba(255,107,0,0.16)"
          stroke="#FF6B00"
          stroke-width="2"
          style="transform-origin: 45px 45px; transition: transform 600ms cubic-bezier(0.32,0.72,0,1);"
        />
        <circle cx="45" cy="45" r="3" fill="#FF6B00" />
      </svg>
      <span class="ntr-font-mono text-[10px] tracking-wider text-zinc-400 uppercase">
        Carburador
      </span>
    </div>

    <div class="h-12 w-px bg-white/10"></div>

    <div class="flex flex-col items-center gap-1.5">
      <svg viewBox="0 0 90 90" class="h-20 w-20" aria-hidden="true">
        <circle
          cx="45"
          cy="45"
          r="38"
          fill="none"
          stroke="rgba(255,255,255,0.12)"
          stroke-width="1.5"
          stroke-dasharray="4 3"
        />
        <circle
          data-svg="tbi-ring"
          cx="45"
          cy="45"
          r="26"
          fill="rgba(255,45,32,0.18)"
          stroke="#FF2D20"
          stroke-width="2"
          style="transform-origin: 45px 45px; transition: transform 600ms cubic-bezier(0.32,0.72,0,1);"
        />
        <circle cx="45" cy="45" r="3" fill="#FF2D20" />
      </svg>
      <span class="ntr-font-mono text-[10px] tracking-wider text-zinc-400 uppercase">
        TBI (+10%)
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <TelemetryInput
      id="input-carb-cc"
      label="Cilindrada"
      unit="cc"
      field="cc"
      value={149.05}
      min={0}
      max={2000}
      step={0.1}
      decimals={1}
    />
    <TelemetryInput
      id="input-carb-rpm"
      label="Rotação Alvo"
      unit="RPM"
      field="rpm"
      value={9500}
      min={0}
      max={20000}
      step={100}
      decimals={0}
      hint="Em mil RPM"
    />
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <TelemetryReadout
      label="Carburador (Venturi)"
      outputKey="carb-result"
      unit="mm"
      initialText="24,5"
      accent="amber"
      size="md"
    />
    <TelemetryReadout
      label="TBI (Venturi)"
      outputKey="tbi-result"
      unit="mm"
      initialText="26,9"
      accent="red"
      size="md"
    />
  </div>
</CalculatorShell>
