---
import CalculatorShell from "./CalculatorShell.astro";
import TelemetryInput from "./TelemetryInput.astro";
import TelemetryReadout from "./TelemetryReadout.astro";
---

<CalculatorShell
  id="dutos-2v"
  code="NTR // 09"
  title="Dutos — Cabeçote 2 Válvulas"
  subtitle="Cálculo de abertura ideal dos dutos de admissão e escape a partir da sede."
  category="cabecote"
  spanClass="md:col-span-6"
>
  <span slot="badge" class="ntr-font-mono text-[10px] tracking-wider text-zinc-500 uppercase">
    0,948 ADM // 1,095 ESC
  </span>

  {/* SVG Fluxo de Dutos 2V */}
  <div class="flex items-center justify-between gap-4 rounded-2xl border border-white/[0.06] bg-[#09090d] px-4 py-3">
    <svg viewBox="0 0 220 68" class="h-16 w-full" aria-hidden="true">
      <path
        d="M12 22 C 62 22, 74 44, 102 52"
        fill="none"
        stroke="rgba(255,45,32,0.28)"
        stroke-width="14"
        stroke-linecap="round"
      />
      <path
        class="ntr-flow-line"
        d="M12 22 C 62 22, 74 44, 102 52"
        fill="none"
        stroke="#FF2D20"
        stroke-width="2"
        stroke-dasharray="6 8"
        stroke-linecap="round"
      />
      <path
        d="M118 52 C 146 44, 158 22, 208 22"
        fill="none"
        stroke="rgba(255,107,0,0.28)"
        stroke-width="12"
        stroke-linecap="round"
      />
      <path
        class="ntr-flow-line-out"
        d="M118 52 C 146 44, 158 22, 208 22"
        fill="none"
        stroke="#FF6B00"
        stroke-width="2"
        stroke-dasharray="6 8"
        stroke-linecap="round"
      />
      <text x="16" y="11" fill="#a1a1aa" font-size="8.5" font-family="JetBrains Mono, monospace">
        DUTO ADM (×0,948)
      </text>
      <text
        x="204"
        y="11"
        text-anchor="end"
        fill="#a1a1aa"
        font-size="8.5"
        font-family="JetBrains Mono, monospace"
      >
        DUTO ESC (×1,095)
      </text>
    </svg>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <TelemetryInput
      id="input-d2-adm-valve"
      label="Diâmetro Válvula ADM"
      unit="mm"
      field="admValve"
      value={30}
      min={0}
      max={50}
      step={0.1}
      decimals={1}
      hint="Ref."
    />
    <TelemetryInput
      id="input-d2-adm-seat"
      label="Diâmetro Interno Sede ADM"
      unit="mm"
      field="sedeAdm"
      value={25}
      min={0}
      max={50}
      step={0.1}
      decimals={1}
      hint="Calcula ADM"
      highlight={true}
    />
    <TelemetryInput
      id="input-d2-esc-valve"
      label="Diâmetro Válvula ESC"
      unit="mm"
      field="escValve"
      value={26}
      min={0}
      max={50}
      step={0.1}
      decimals={1}
      hint="Ref."
    />
    <TelemetryInput
      id="input-d2-esc-seat"
      label="Diâmetro Interno Sede ESC"
      unit="mm"
      field="sedeEsc"
      value={21}
      min={0}
      max={50}
      step={0.1}
      decimals={1}
      hint="Calcula ESC"
      highlight={true}
    />
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <TelemetryReadout
      label="Duto Admissão"
      outputKey="d2-adm-result"
      unit="mm"
      initialText="23,70"
      accent="red"
      size="md"
    />
    <TelemetryReadout
      label="Duto Escape"
      outputKey="d2-esc-result"
      unit="mm"
      initialText="23,00"
      accent="amber"
      size="md"
    />
  </div>
</CalculatorShell>

<style>
  .ntr-flow-line,
  .ntr-flow-line-out {
    animation: ntr-dash-flow 1.4s linear infinite;
  }

  @keyframes ntr-dash-flow {
    to {
      stroke-dashoffset: -28;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ntr-flow-line,
    .ntr-flow-line-out {
      animation: none;
    }
  }
</style>
