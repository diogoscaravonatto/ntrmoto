---
import { vetPragasData } from "./content";
import { Image } from "astro:assets";
import equipeImg from "@assets/images/vetpragas-equipe.png";
---

<section class="py-32 bg-white relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div class="text-left">
                <div
                    class="mb-6 inline-flex items-center px-3 py-1 bg-accent/10 border border-accent/20 rounded-lg"
                >
                    <span
                        class="text-[10px] font-black text-accent-dark uppercase tracking-wider"
                        >Atendimento Rápido em Dedetização</span
                    >
                </div>

                <!-- Main Heading -->
                <h2
                    class="text-5xl md:text-7xl font-black text-slate-900 mb-8 uppercase tracking-tighter leading-[0.95]"
                >
                    {vetPragasData.finalCta.title}
                </h2>

                <!-- Subtitle -->
                <p
                    class="text-xl md:text-2xl text-slate-600 font-bold mb-10 uppercase tracking-wide"
                >
                    {vetPragasData.finalCta.subtitle}
                </p>

                <!-- Description -->
                <p
                    class="text-lg text-slate-500 mb-12 max-w-2xl leading-relaxed font-medium"
                >
                    {vetPragasData.finalCta.description}
                </p>

                <!-- CTA Buttons -->
                <div class="flex flex-col sm:flex-row gap-6 items-start">
                    <a
                        href="https://wa.me/5545991586405"
                        class="px-12 py-6 bg-accent text-white font-bold text-sm uppercase tracking-widest rounded-2xl hover:bg-accent-dark transition-all shadow-accent/20 hover:-translate-y-1 flex items-center justify-center gap-3"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                            ></path>
                        </svg>
                        CHAMAR AGORA
                    </a>
                    <a
                        href="tel:4533265255"
                        class="px-12 py-6 bg-white text-slate-900 border border-slate-200 font-bold text-sm uppercase tracking-widest rounded-2xl hover:border-accent hover:text-accent transition-all hover:-translate-y-1 flex items-center justify-center gap-3"
                    >
                        <svg
                            class="w-5 h-5 text-accent"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                            ></path>
                        </svg>
                        (45) 3326-5255
                    </a>
                </div>
            </div>

            <!-- Team Image -->
            <div class="relative group">
                <div
                    class="absolute -inset-4 bg-accent/5 rounded-[3rem] blur-2xl group-hover:bg-accent/10 transition-colors"
                >
                </div>
                <Image
                    src={equipeImg}
                    alt="Equipe VetPragas"
                    format="webp"
                    widths={[400, 800, 1200]}
                    sizes="(max-width: 1024px) 100vw, 800px"
                    loading="lazy"
                    decoding="async"
                    class="relative w-full h-auto rounded-[3rem] shadow-2xl transition-transform duration-700 group-hover:scale-[1.02] object-contain"
                />
            </div>
        </div>
    </div>
</section>
