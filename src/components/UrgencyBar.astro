<div
  id="sticky-urgency-bar"
  class="fixed top-0 left-0 z-[100] w-full -translate-y-full transform bg-[#FF3333] px-4 py-3 text-white shadow-lg transition-transform duration-500"
>
  <div class="mx-auto flex max-w-7xl items-center justify-center gap-4 text-center">
    <p class="text-sm font-black tracking-wide uppercase md:text-lg">
      ⚠️ Restam poucas vagas com DESCONTO DE 50%
    </p>
    <a
      href="#oferta"
      class="hidden rounded bg-white px-4 py-1 text-xs font-black text-[#FF3333] uppercase transition-colors hover:bg-gray-100 md:inline-block"
    >
      Aproveitar Agora
    </a>
  </div>
</div>

<script>
  const bar = document.getElementById("sticky-urgency-bar");

  // Atrasar a ativação do listener para não pesar o início
  setTimeout(() => {
    window.addEventListener(
      "scroll",
      () => {
        // Aparece após rolar 800px (aproximadamente depois da Hero/Vídeo)
        if (window.scrollY > 800) {
          bar?.classList.remove("-translate-y-full");
        } else {
          bar?.classList.add("-translate-y-full");
        }
      },
      { passive: true },
    );
  }, 5000);
</script>
