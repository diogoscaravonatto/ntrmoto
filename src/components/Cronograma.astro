---
---

<section class="py-16 px-4 bg-gray-50">
  <div class="max-w-4xl mx-auto text-center">
    <div class="mb-12">
      <svg class="w-12 h-12 text-brand-red mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-2">Cronograma</h2>
      <p class="text-gray-600 font-medium">O passo a passo que você vai aprender na bancada e na ferramenta</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      {/* Card 1 */}
      <div class="bg-white border border-red-100 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-red-300 transition-all text-center">
        <div class="w-12 h-12 bg-red-50 text-brand-red rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <h3 class="font-bold text-gray-900 text-lg">Preparação do Cabeçote, Dutos e Sede</h3>
      </div>

      {/* Card 2 */}
      <div class="bg-white border border-red-100 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-red-300 transition-all text-center">
        <div class="w-12 h-12 bg-red-50 text-brand-red rounded-full flex items-center justify-center mx-auto mb-4">
           <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        </div>
        <h3 class="font-bold text-gray-900 text-lg">Taxa de Compressão e Cava de Válvula</h3>
      </div>

      {/* Card 3 */}
      <div class="bg-white border border-red-100 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-red-300 transition-all text-center">
        <div class="w-12 h-12 bg-red-50 text-brand-red rounded-full flex items-center justify-center mx-auto mb-4">
           <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"></path></svg>
        </div>
        <h3 class="font-bold text-gray-900 text-lg">Folga dos Anéis, Cilindro e Saia de Pistão</h3>
      </div>

      {/* Card 4 */}
      <div class="bg-white border border-red-100 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-red-300 transition-all text-center">
        <div class="w-12 h-12 bg-red-50 text-brand-red rounded-full flex items-center justify-center mx-auto mb-4">
           <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <h3 class="font-bold text-gray-900 text-lg">Comando, Enquadramento e Acerto da Injeção</h3>
      </div>

    </div>
  </div>
</section>
