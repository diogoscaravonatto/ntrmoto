---
import Button from "../../components/Button.astro";

const logos = [
    {
        name: "Forbes",
        src: "https://upload.wikimedia.org/wikipedia/commons/0/0c/Forbes_logo.svg",
    },
    {
        name: "Entrepreneur",
        src: "https://upload.wikimedia.org/wikipedia/commons/6/64/Entrepreneur_logo.svg",
    },
    {
        name: "TechCrunch",
        src: "https://upload.wikimedia.org/wikipedia/commons/b/b9/TechCrunch_logo.svg",
    },
];
---

<div class="text-center space-y-8 animate-fade-in-up delay-500">
    <div class="flex flex-col items-center gap-2">
        <Button
            href="/templates/funnels/marketing-digital-vsl/checkout"
            variant="primary"
            size="xl"
            class="w-full md:w-auto min-w-[300px] shadow-glow animate-pulse-subtle"
        >
            QUERO ACESSAR O MÉTODO AGORA
            <svg
                class="w-6 h-6 ml-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
        </Button>
        <span class="text-xs text-gray-500 uppercase tracking-wider mt-4"
            >Garantia Incondicional de 7 Dias • Acesso Imediato</span
        >
    </div>

    <!-- Social Proof Logos -->
    <div class="pt-8 border-t border-white/5">
        <p
            class="text-sm text-gray-500 mb-6 uppercase tracking-widest font-semibold"
        >
            Como Visto Em:
        </p>
        <div
            class="flex flex-wrap items-center justify-center gap-8 md:gap-16 opacity-40 grayscale hover:grayscale-0 transition-all duration-500"
        >
            {
                logos.map((logo) => (
                    <img
                        src={logo.src}
                        alt={logo.name}
                        class="h-6 md:h-8 object-contain brightness-200 contrast-0 invert"
                    />
                ))
            }
        </div>
    </div>
</div>

<style>
    .shadow-glow {
        box-shadow: 0 0 40px -10px rgba(139, 92, 246, 0.5);
    }
    .animate-pulse-subtle {
        animation: pulse-subtle 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse-subtle {
        0%,
        100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.03);
        }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    .delay-500 {
        animation-delay: 0.5s;
    }
    @keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
