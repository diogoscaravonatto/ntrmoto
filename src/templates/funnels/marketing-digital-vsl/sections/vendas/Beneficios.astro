---
import GlassCard from "../../components/GlassCard.astro";

const beneficios = [
    "A Estrutura Secreta de Oferta",
    "Como Criar Vídeos que Vendem",
    "Copywriting Hipnótico",
    "Automação de Vendas 24/7",
];
---

<GlassCard class="grid md:grid-cols-2 gap-10 bg-white/5! mx-auto max-w-4xl">
    <div>
        <h3 class="text-2xl font-bold text-white mb-6">
            O que você vai dominar:
        </h3>
        <ul class="space-y-4">
            {
                beneficios.map((item) => (
                    <li class="flex items-start gap-3 text-gray-300">
                        <span class="mt-1 shrink-0 w-5 h-5 rounded-full bg-green-500/20 text-green-400 flex items-center justify-center text-xs">
                            ✓
                        </span>
                        {item}
                    </li>
                ))
            }
        </ul>
    </div>
    <div
        class="relative rounded-xl overflow-hidden bg-linear-to-br from-violet-900/50 to-fuchsia-900/50 p-6 flex items-center justify-center group"
    >
        <!-- Decorative background -->
        <div
            class="absolute inset-0 bg-linear-to-br from-violet-600/5 to-fuchsia-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
        >
        </div>
        <div class="text-center relative z-10">
            <span class="text-5xl font-black text-white block mb-2">94%</span>
            <span class="text-sm text-gray-300 uppercase tracking-wider"
                >De Aprovação dos Alunos</span
            >
        </div>
    </div>
</GlassCard>
