---
import GlassCard from "../../components/GlassCard.astro";
import Button from "../../components/Button.astro";
import OrderBump from "../../components/OrderBump.astro";
---

<div class="space-y-6">
    <GlassCard>
        <div class="flex items-center gap-4 mb-8">
            <div
                class="w-10 h-10 rounded-full bg-violet-600 flex items-center justify-center font-bold text-white"
            >
                1
            </div>
            <h2 class="text-2xl font-bold text-white">Dados Pessoais</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div class="space-y-2">
                <label class="text-sm font-medium text-gray-400"
                    >Nome Completo</label
                >
                <input
                    type="text"
                    placeholder="Seu nome aqui"
                    class="w-full bg-[#0f172a] border border-white/10 rounded-lg px-4 py-3 text-white focus:ring-2 focus:ring-violet-500 outline-none transition-all"
                />
            </div>
            <div class="space-y-2">
                <label class="text-sm font-medium text-gray-400"
                    >E-mail Principal</label
                >
                <input
                    type="email"
                    placeholder="seu@email.com"
                    class="w-full bg-[#0f172a] border border-white/10 rounded-lg px-4 py-3 text-white focus:ring-2 focus:ring-violet-500 outline-none transition-all"
                />
            </div>
            <div class="space-y-2 md:col-span-2">
                <label class="text-sm font-medium text-gray-400"
                    >Celular (WhatsApp)</label
                >
                <input
                    type="tel"
                    placeholder="(11) 99999-9999"
                    class="w-full bg-[#0f172a] border border-white/10 rounded-lg px-4 py-3 text-white focus:ring-2 focus:ring-violet-500 outline-none transition-all"
                />
            </div>
        </div>
    </GlassCard>

    <GlassCard>
        <div class="flex items-center gap-4 mb-8">
            <div
                class="w-10 h-10 rounded-full bg-violet-600 flex items-center justify-center font-bold text-white"
            >
                2
            </div>
            <h2 class="text-2xl font-bold text-white">Pagamento Seguro</h2>
        </div>

        <div class="space-y-4 mb-6">
            <div
                class="p-4 rounded-lg border border-violet-500/50 bg-violet-500/10 flex items-center gap-3"
            >
                <span class="w-3 h-3 rounded-full bg-green-500"></span>
                <span class="text-sm text-gray-300"
                    >Ambiente Criptografado de 256-bits</span
                >
            </div>

            <div class="space-y-2">
                <label class="text-sm font-medium text-gray-400"
                    >Número do Cartão</label
                >
                <div class="relative">
                    <input
                        type="text"
                        placeholder="0000 0000 0000 0000"
                        class="w-full bg-[#0f172a] border border-white/10 rounded-lg px-4 py-3 text-white pl-12"
                    />
                    <svg
                        class="w-6 h-6 absolute left-3 top-3 text-gray-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
                        ></path>
                    </svg>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-400"
                        >Validade</label
                    >
                    <input
                        type="text"
                        placeholder="MM/AA"
                        class="w-full bg-[#0f172a] border border-white/10 rounded-lg px-4 py-3 text-white"
                    />
                </div>
                <div class="space-y-2">
                    <label class="text-sm font-medium text-gray-400">CVC</label>
                    <input
                        type="text"
                        placeholder="123"
                        class="w-full bg-[#0f172a] border border-white/10 rounded-lg px-4 py-3 text-white"
                    />
                </div>
            </div>
        </div>

        <OrderBump
            productName="Pack 50 Headlines Hipnóticas"
            price="R$ 27,00"
            originalPrice="R$ 97,00"
            description="Copie e cole as headlines que mais convertem no mercado digital."
        />

        <Button
            href="/templates/funnels/marketing-digital-vsl/oferta-premium"
            variant="primary"
            size="xl"
            fullWidth
            class="mt-8"
        >
            FINALIZAR INSCRIÇÃO AGORA
        </Button>

        <p
            class="text-center text-xs text-gray-500 mt-4 flex justify-center gap-2 items-center"
        >
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"
                ><path
                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                ></path></svg
            >
            Garantia de 7 Dias ou seu dinheiro de volta
        </p>
    </GlassCard>
</div>
