---
import GlassCard from "../../components/GlassCard.astro";

const { product } = Astro.props;
---

<div class="relative">
    <GlassCard class="sticky top-24 border-violet-500/20">
        <h3
            class="text-xl font-bold text-white mb-6 border-b border-white/10 pb-4"
        >
            Resumo do Pedido
        </h3>
        <div class="flex items-start gap-4 mb-6">
            <img
                src="https://images.unsplash.com/photo-1552664730-d307ca884978?q=80&w=200&auto=format&fit=crop"
                class="w-20 h-20 rounded-lg object-cover border border-white/10"
            />
            <div>
                <h4 class="font-bold text-white">{product.name}</h4>
                <p class="text-violet-400 font-bold mt-1 text-lg">
                    {product.price}
                </p>
            </div>
        </div>

        <ul class="space-y-3 mb-8">
            {
                product.features.map((feat: string) => (
                    <li class="flex items-center gap-2 text-sm text-gray-300">
                        <svg
                            class="w-4 h-4 text-green-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"
                            />
                        </svg>
                        {feat}
                    </li>
                ))
            }
        </ul>

        <div class="border-t border-white/10 pt-4 space-y-2">
            <div class="flex justify-between text-gray-400">
                <span>Subtotal</span>
                <span>{product.price}</span>
            </div>
            <div class="flex justify-between text-xl font-bold text-white pt-2">
                <span>Total</span>
                <span>{product.price}</span>
            </div>
        </div>

        <!-- Trust Badges -->
        <div class="mt-8 grid grid-cols-2 gap-2 opacity-50">
            <div
                class="bg-white/5 p-2 rounded text-center text-[10px] text-gray-400 font-mono uppercase"
            >
                Compra Segura
            </div>
            <div
                class="bg-white/5 p-2 rounded text-center text-[10px] text-gray-400 font-mono uppercase"
            >
                Privacidade 100%
            </div>
        </div>
    </GlassCard>
</div>
