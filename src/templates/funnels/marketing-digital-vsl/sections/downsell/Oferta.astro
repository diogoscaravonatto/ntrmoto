---
import GlassCard from "../../components/GlassCard.astro";
import Button from "../../components/Button.astro";

const { offer } = Astro.props;
---

<GlassCard class="p-8! md:p-12! relative overflow-hidden group">
    <!-- Badge -->
    <div
        class="absolute top-0 right-0 bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-bl-xl z-20"
    >
        OFERTA LIGHT
    </div>

    <div class="flex flex-col md:flex-row items-center gap-8">
        <img
            src="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?q=80&w=600&auto=format&fit=crop"
            alt="Pack de Gravações"
            class="w-full md:w-48 rounded-lg shadow-lg -rotate-2 group-hover:rotate-0 transition-transform duration-500"
        />

        <div class="grow space-y-4 text-center md:text-left">
            <h3 class="text-2xl font-bold text-white">
                Leve Apenas as Gravações das Mentorias Antigas
            </h3>
            <p class="text-sm text-gray-400">
                Tenha acesso ao nosso acervo de +50 horas de conteúdo gravado,
                sem as chamadas ao vivo. É ouro puro para estudar no seu ritmo.
            </p>

            <div
                class="flex items-center justify-center md:justify-start gap-3"
            >
                <span class="text-3xl font-bold text-white">{offer.price}</span>
                <span class="text-sm text-gray-500 line-through">R$ 197,00</span
                >
            </div>

            <Button
                href="/templates/funnels/marketing-digital-vsl/obrigado"
                variant="primary"
                fullWidth
            >
                Adicionar Gravações por {offer.price}
            </Button>
        </div>
    </div>

    <div class="mt-6 pt-4 border-t border-white/5 text-center">
        <a
            href="/templates/funnels/marketing-digital-vsl/obrigado"
            class="text-xs text-gray-600 hover:text-white transition-colors cursor-pointer underline decoration-zinc-800"
        >
            Não, obrigado. Vou ficar apenas com minha compra inicial.
        </a>
    </div>
</GlassCard>
