---
import GlassCard from "../../components/GlassCard.astro";
import Button from "../../components/Button.astro";
import ArrowRight from "../../components/ArrowRight.astro";

const { steps } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
        steps.map((step: any) => (
            <GlassCard
                class="flex flex-col h-full group p-0!"
                hoverEffect={true}
            >
                <div class="relative h-48 overflow-hidden border-b border-white/5">
                    <div class="absolute inset-0 bg-linear-to-t from-[#0f172a] to-transparent z-10 opacity-60" />
                    <img
                        src={step.image}
                        alt={step.title}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                    <div class="absolute top-4 left-4 z-20">
                        <span class="px-3 py-1 bg-black/60 backdrop-blur-md rounded-lg text-xs font-bold text-white uppercase tracking-wider border border-white/10">
                            Passo {step.step}
                        </span>
                    </div>
                    <div class="absolute bottom-4 left-4 z-20">
                        <span class="text-xs font-medium text-gray-300 bg-white/10 px-2 py-1 rounded border border-white/5">
                            {step.badge}
                        </span>
                    </div>
                </div>

                <div class="p-6 flex flex-col grow">
                    <h3 class="text-xl font-bold text-white mb-2 group-hover:text-violet-400 transition-colors uppercase tracking-tight">
                        {step.title}
                    </h3>
                    <p class="text-sm text-gray-400 mb-6 grow leading-relaxed">
                        {step.description}
                    </p>

                    <div class="mt-auto">
                        <Button
                            href={step.link}
                            variant="secondary"
                            fullWidth
                            size="sm"
                            class="justify-between group/btn"
                        >
                            Visualizar Template
                            <ArrowRight class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" />
                        </Button>
                    </div>
                </div>
            </GlassCard>
        ))
    }
</div>
