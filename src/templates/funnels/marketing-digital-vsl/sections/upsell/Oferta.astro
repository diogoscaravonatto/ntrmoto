---
import GlassCard from "../../components/GlassCard.astro";
import Button from "../../components/Button.astro";

const { offer } = Astro.props;
---

<GlassCard
    class="text-center space-y-8 py-12! border-violet-500/30 bg-violet-900/10"
>
    <div class="space-y-4">
        <p class="text-gray-300 uppercase tracking-widest text-xs">
            Oferta Exclusiva de Upgrade
        </p>
        <div class="flex items-center justify-center gap-4">
            <span class="text-2xl text-gray-500 line-through decoration-red-500"
                >{offer.originalPrice}</span
            >
            <span class="text-5xl md:text-6xl font-black text-white"
                >{offer.offerPrice}</span
            >
        </div>
        <p
            class="text-green-400 font-bold text-sm bg-green-500/10 inline-block px-3 py-1 rounded-full"
        >
            Economize {offer.savings} Agora
        </p>
    </div>

    <div class="flex flex-col items-center gap-4">
        <Button
            href="/templates/funnels/marketing-digital-vsl/obrigado"
            variant="primary"
            size="xl"
            class="shadow-[0_0_30px_rgba(234,179,8,0.3)] from-yellow-500! to-orange-600! hover:shadow-[0_0_40px_rgba(234,179,8,0.5)]! w-full md:w-auto min-w-[320px]"
        >
            SIM! ADICIONAR AO PEDIDO
        </Button>
        <a
            href="/templates/funnels/marketing-digital-vsl/oferta-basica"
            class="text-sm text-gray-500 hover:text-white underline decoration-gray-700 hover:decoration-white transition-all cursor-pointer"
        >
            Não, obrigado. Eu prefiro percorrer o caminho sozinho e mais
            devagar.
        </a>
    </div>

    <div
        class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-8 border-t border-white/5 text-left text-sm text-gray-400 max-w-2xl mx-auto"
    >
        <div class="flex items-center gap-2">
            <svg
                class="w-4 h-4 text-violet-500"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                ></path></svg
            > Chamadas Quinzenais
        </div>
        <div class="flex items-center gap-2">
            <svg
                class="w-4 h-4 text-violet-500"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                ></path></svg
            > Análise de Funil
        </div>
        <div class="flex items-center gap-2">
            <svg
                class="w-4 h-4 text-violet-500"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                ></path></svg
            > Grupo Mastermind
        </div>
    </div>
</GlassCard>
