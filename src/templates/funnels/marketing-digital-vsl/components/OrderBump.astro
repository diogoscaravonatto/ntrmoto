---
const {
    productName = "Template Pack Extra",
    price = "R$ 27,00",
    originalPrice = "R$ 97,00",
    description = "Leve também nosso pacote de 50 headlines prontas para copiar e colar.",
} = Astro.props;
---

<div
    class="mt-6 p-4 rounded-xl border-2 border-dashed border-yellow-500/50 bg-yellow-500/5 relative overflow-hidden group cursor-pointer hover:bg-yellow-500/10 transition-colors"
>
    <div class="flex items-start gap-4">
        <div class="pt-1">
            <input
                type="checkbox"
                id="order-bump"
                class="w-5 h-5 rounded border-gray-600 text-yellow-500 focus:ring-yellow-500 bg-gray-800 cursor-pointer"
            />
        </div>
        <div class="grow">
            <label for="order-bump" class="block cursor-pointer">
                <span
                    class="text-yellow-400 font-bold uppercase tracking-wider text-xs block mb-1 blink"
                    >Sim! Adicionar ao meu pedido:</span
                >
                <h4 class="text-white font-bold text-lg mb-1">
                    {productName}
                    <span
                        class="text-gray-400 font-normal line-through text-sm ml-2"
                        >{originalPrice}</span
                    >
                    <span class="text-green-400 ml-1">por apenas {price}</span>
                </h4>
                <p class="text-gray-400 text-sm leading-snug">{description}</p>
            </label>
        </div>
    </div>

    <!-- Setup for interactivity -->
    <script>
        // This script would normally handle the toggle logic
    </script>
</div>

<style>
    .blink {
        animation: blinker 2s linear infinite;
    }
    @keyframes blinker {
        50% {
            opacity: 0.5;
        }
    }
</style>
