---
const {
    href,
    class: className,
    variant = "primary",
    size = "md",
    fullWidth = false,
    ...rest
} = Astro.props;

interface Props {
    href?: string;
    class?: string;
    variant?: "primary" | "secondary" | "outline" | "danger";
    size?: "sm" | "md" | "lg" | "xl";
    fullWidth?: boolean;
}

const baseStyles =
    "inline-flex items-center justify-center font-bold rounded-xl transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-[#0f172a] disabled:opacity-50 disabled:cursor-not-allowed group relative overflow-hidden";

const sizeStyles = {
    sm: "px-4 py-2 text-sm",
    md: "px-6 py-3 text-base",
    lg: "px-8 py-4 text-lg",
    xl: "px-10 py-5 text-xl tracking-wide",
};

const variants = {
    primary:
        "bg-linear-to-r from-violet-600 to-fuchsia-600 text-white shadow-[0_0_20px_rgba(139,92,246,0.3)] hover:shadow-[0_0_30px_rgba(232,121,249,0.5)] hover:scale-[1.02] border border-white/10",
    secondary:
        "bg-white/10 text-white backdrop-blur-md hover:bg-white/20 border border-white/10 shadow-lg",
    outline:
        "bg-transparent border-2 border-white/20 text-white hover:border-white/50 hover:bg-white/5",
    danger: "bg-linear-to-r from-red-600 to-orange-600 text-white shadow-[0_0_20px_rgba(220,38,38,0.3)] hover:shadow-[0_0_30px_rgba(220,38,38,0.5)] hover:scale-[1.02]",
};

const widthStyles = fullWidth ? "w-full" : "";

const styles = `${baseStyles} ${sizeStyles[size]} ${variants[variant]} ${widthStyles} ${className || ""}`;
---

{
    href ? (
        <a href={href} class={styles} {...rest}>
            <span class="relative z-10 flex items-center justify-center gap-2">
                <slot />
            </span>
            {/* Glow effect on hover */}
            {variant === "primary" && (
                <div class="absolute inset-0 bg-linear-to-r from-fuchsia-600 to-violet-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            )}
        </a>
    ) : (
        <button class={styles} {...rest}>
            <span class="relative z-10 flex items-center justify-center gap-2">
                <slot />
            </span>
            {variant === "primary" && (
                <div class="absolute inset-0 bg-linear-to-r from-fuchsia-600 to-violet-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            )}
        </button>
    )
}
