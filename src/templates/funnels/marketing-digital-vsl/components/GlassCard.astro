---
const { class: className, hoverEffect = false, ...rest } = Astro.props;

interface Props {
    class?: string;
    hoverEffect?: boolean;
}

const baseStyles =
    "relative bg-white/5 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl p-6 md:p-10 overflow-hidden";
const hoverStyles = hoverEffect
    ? "transition-all duration-300 hover:border-white/20 hover:bg-white/10 hover:shadow-violet-500/10 hover:-translate-y-1"
    : "";

const styles = `${baseStyles} ${hoverStyles} ${className || ""}`;
---

<div class={styles} {...rest}>
    <!-- Shine effect opcional no topo -->
    <div
        class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-white/20 to-transparent opacity-50"
    >
    </div>

    <slot />
</div>
