---
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
    title: string;
    description?: string;
    step?: number;
    totalSteps?: number;
    showProgressBar?: boolean;
}

const {
    title,
    description = "Domine o Marketing Digital - Curso exclusivo",
    step = 1,
    totalSteps = 5,
    showProgressBar = true,
} = Astro.props;

const progressPercentage = (step / totalSteps) * 100;
---

<BaseLayout
    title={title}
    description={description}
    theme="dark"
    colors={{
        primary: "#8b5cf6", // Violeta vibrante
        secondary: "#f472b6", // Rosa suave
        background: "#0f172a", // Slate escuro
    }}
>
    <!-- Background Mesh Gradient Animation -->
    <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
        <div
            class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-violet-600/20 rounded-full blur-[128px] animate-pulse-slow"
        >
        </div>
        <div
            class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-fuchsia-600/20 rounded-full blur-[128px] animate-pulse-slow delay-1000"
        >
        </div>
    </div>

    <div class="flex flex-col min-h-screen text-gray-100 font-sans">
        <!-- Header Minimalista (Logo ou Brand) -->
        <header class="w-full py-6 px-4 flex justify-center z-10">
            <div
                class="font-bold text-xl tracking-wider uppercase bg-clip-text text-transparent bg-linear-to-r from-violet-400 to-fuchsia-400"
            >
                Rocket Growth
            </div>
        </header>

        <!-- Progress Bar (Fixed Top or Inline) -->
        {
            showProgressBar && (
                <div class="w-full h-1.5 bg-white/5 fixed top-0 left-0 z-50 backdrop-blur-sm">
                    <div
                        class="h-full bg-linear-to-r from-violet-500 via-fuchsia-500 to-orange-500 shadow-[0_0_10px_rgba(167,139,250,0.5)] transition-all duration-700 ease-out"
                        style={`width: ${progressPercentage}%`}
                    />
                </div>
            )
        }

        <!-- Main Content -->
        <main
            class="grow flex flex-col items-center justify-center p-4 md:p-8 relative z-10 w-full max-w-7xl mx-auto"
        >
            <slot />
        </main>

        <!-- Simple Footer -->
        <footer class="py-8 text-center text-sm text-gray-500 z-10">
            <p>
                &copy; {new Date().getFullYear()} Rocket Growth VSL. Todos os direitos
                reservados.
            </p>
            <div
                class="mt-3 space-x-6 text-xs uppercase tracking-widest opacity-60"
            >
                <a href="#" class="hover:text-white transition-colors"
                    >Politica de Privacidade</a
                >
                <a href="#" class="hover:text-white transition-colors"
                    >Termos de Uso</a
                >
            </div>
        </footer>
    </div>
</BaseLayout>

<style>
    .animate-pulse-slow {
        animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse {
        0%,
        100% {
            opacity: 0.3;
            transform: scale(1);
        }
        50% {
            opacity: 0.15;
            transform: scale(1.1);
        }
    }
</style>
