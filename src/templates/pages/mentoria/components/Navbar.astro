---
const brand = { name: "Peak", highlight: "Mentor" };
const links = [
    { label: "O Método", href: "#metodo" },
    { label: "Resultados", href: "#resultados" },
    { label: "Vagas", href: "#vagas" },
    { label: "FAQ", href: "#faq" },
];
---

<nav
    class="fixed top-6 left-1/2 -translate-x-1/2 w-[90%] max-w-5xl z-50 bg-white border-[3px] border-black shadow-[6px_6px_0px_#000] rounded-2xl h-16 flex items-center justify-between px-8"
>
    <div class="flex items-center gap-3">
        <div class="size-8 bg-blue-600 border-2 border-black"></div>
        <span class="text-xl font-black uppercase tracking-tighter italic"
            >{brand.name}<span class="text-blue-600 font-black"
                >{brand.highlight}</span
            ></span
        >
    </div>
    <div
        class="hidden md:flex items-center gap-8 text-[10px] font-black uppercase tracking-widest text-zinc-500"
    >
        {
            links.map((link) => (
                <a
                    href={link.href}
                    class="hover:text-blue-600 transition-colors italic"
                >
                    {link.label}
                </a>
            ))
        }
    </div>
    <button
        class="bg-yellow-400 border-2 border-black px-4 py-2 text-[10px] font-black uppercase tracking-widest shadow-[3px_3px_0px_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all outline-hidden group italic"
    >
        Aplicar Agora
    </button>
</nav>
