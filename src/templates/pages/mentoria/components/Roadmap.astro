---
const roadmap = {
    eyebrow: "The Roadmap",
    title: ["90 Dias de", "Transmutação."],
    steps: [
        {
            day: "Dia 01-15",
            title: "Demolição de Ego",
            desc: "Identificamos as mentiras que você conta para si mesmo e que travam seu faturamento.",
        },
        {
            day: "Dia 16-45",
            title: "Engenharia de Oferta",
            desc: "Reconstruímos seu produto/serviço para torná-lo uma oferta irresistível de ticket alto.",
        },
        {
            day: "Dia 46-75",
            title: "Máquina de Aquisição",
            desc: "Implementamos o funil de vendas previsível que solta o freio de mão do seu crescimento.",
        },
        {
            day: "Dia 76-90",
            title: "Governança e Freedom",
            desc: "Contratação, delegação e rituais de CEO para você sair da operação e focar no estratégico.",
        },
    ],
};
---

<section id="metodo" class="py-40 bg-white border-y-[6px] border-black">
    <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-24">
            <span
                class="text-[10px] font-black uppercase tracking-[0.4em] text-blue-600 italic leading-none"
                >{roadmap.eyebrow}</span
            >
            <h2
                class="text-5xl md:text-7xl font-black uppercase tracking-tighter mt-4 italic"
            >
                {roadmap.title[0]}
                <br />{roadmap.title[1]}
            </h2>
        </div>

        <div class="space-y-4">
            {
                roadmap.steps.map((item) => (
                    <div class="p-8 border-[4px] border-black bg-zinc-50 rounded-2xl flex flex-col md:flex-row gap-8 items-start md:items-center hover:bg-blue-600 hover:text-white transition-all group cursor-default">
                        <span class="text-xl font-black bg-yellow-400 text-black px-4 py-1 border-[3px] border-black group-hover:rotate-3 transition-transform italic uppercase leading-none italic shadow-[4px_4px_0px_#000]">
                            {item.day}
                        </span>
                        <div>
                            <h4 class="text-2xl font-black uppercase tracking-tight mb-2 group-hover:translate-x-2 transition-transform italic">
                                {item.title}
                            </h4>
                            <p class="text-sm font-bold opacity-80 leading-relaxed italic lowercase">
                                {item.desc}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
