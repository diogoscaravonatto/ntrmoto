---
const cta = {
    title: ["Vagas", "Escassas."],
    description:
        "Selecionamos apenas 5 novos mentorados por trimestre para garantir o acompanhamento individual. Sendo sincero: Você está pronto?",
    button: "APLICAR PARA A SELEÇÃO",
    tagline: "Última atualização de vagas há 2 horas.",
};
---

<section
    id="vagas"
    class="py-40 px-6 bg-yellow-400 border-y-[6px] border-black italic"
>
    <div class="max-w-5xl mx-auto text-center space-y-16">
        <h2
            class="text-6xl md:text-[9rem] font-black uppercase tracking-tighter leading-[0.8] animate-pulse"
        >
            {cta.title[0]}
            <br />{cta.title[1]}
        </h2>
        <div class="space-y-8">
            <p
                class="text-2xl font-black italic max-w-xl mx-auto leading-tight lowercase"
            >
                {cta.description}
            </p>
            <button
                class="px-20 py-10 bg-black text-white border-[4px] border-black rounded-[2rem] font-black text-2xl uppercase tracking-widest shadow-[15px_15px_0px_#2563eb] hover:translate-x-2 hover:translate-y-2 hover:shadow-none transition-all outline-hidden group italic"
            >
                {cta.button}
            </button>
            <p
                class="text-[10px] font-black uppercase tracking-widest opacity-60 italic lowercase leading-none"
            >
                {cta.tagline}
            </p>
        </div>
    </div>
</section>
