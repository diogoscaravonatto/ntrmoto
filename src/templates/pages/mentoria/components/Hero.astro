---
const hero = {
    badge: "Mentoria de Elite • Edição 2026",
    title: ["Pare de", "Tentar.", "Comece a", "Vencer."],
    description:
        "Um roteiro brutalmente honesto para quem cansa de resultados medianos e quer dominar seu mercado em 90 dias.",
    cta: "QUERO SER MENTOREADO",
    social: "+1.200 Vidas Transformadas",
};
---

<section
    class="min-h-screen flex flex-col items-center justify-center pt-32 px-6 bg-linear-to-b from-blue-50 to-white"
>
    <div class="max-w-6xl mx-auto text-center relative">
        <div
            class="absolute -top-20 -left-10 size-32 bg-yellow-400 border-[3px] border-black rounded-full flex items-center justify-center font-black text-[10px] rotate-[-15deg] animate-bounce-slow italic uppercase shadow-[4px_4px_0px_#000] pointer-events-none"
        >
            GO FAST
        </div>
        <div
            class="absolute -top-10 -right-10 size-24 bg-blue-600 border-[3px] border-black rounded-xl hidden lg:block rotate-12 pointer-events-none opacity-20"
        >
        </div>

        <span
            class="inline-block px-4 py-1 border-[3px] border-black bg-white font-black uppercase tracking-[0.2em] text-[10px] mb-10 shadow-[4px_4px_0px_#000] italic"
        >
            {hero.badge}
        </span>

        <h1
            class="text-7xl md:text-[10rem] font-black leading-[0.8] tracking-tighter uppercase mb-12 italic"
        >
            {hero.title[0]}
            <span
                class="bg-blue-600 text-white border-[5px] border-black px-4 inline-block transform rotate-[-2deg] not-italic"
                >{hero.title[1]}</span
            >
            <br />
            {hero.title[2]}
            <span
                class="text-blue-600 italic underline decoration-black/10 transition-colors hover:text-blue-700"
                >{hero.title[3]}</span
            >
        </h1>

        <p
            class="text-xl md:text-3xl font-black text-zinc-900 max-w-3xl mx-auto mb-16 leading-tight italic lowercase"
        >
            {hero.description}
        </p>

        <div
            class="flex flex-col sm:flex-row items-center justify-center gap-8"
        >
            <button
                class="px-16 py-8 bg-blue-600 text-white border-[4px] border-black rounded-2xl font-black text-xl uppercase tracking-widest shadow-[10px_10px_0px_#000] hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all active:scale-95 outline-hidden group italic"
            >
                {hero.cta}
            </button>
            <div class="flex flex-col items-start gap-1">
                <div class="flex -space-x-4">
                    {
                        [1, 2, 3, 4].map((i) => (
                            <div class="size-12 rounded-full border-[3px] border-black bg-zinc-200 flex items-center justify-center font-black text-[10px] italic">
                                U{i}
                            </div>
                        ))
                    }
                </div>
                <span
                    class="text-[9px] font-black uppercase tracking-tighter text-zinc-500 italic lowercase leading-none"
                >
                    {hero.social}
                </span>
            </div>
        </div>
    </div>
</section>
