---
const marquee = [
    { label: "Foco Total", color: "bg-yellow-400" },
    { label: "Escala Brutal", color: "bg-blue-600" },
    { label: "Liberdade Real", color: "bg-white" },
];
---

<section
    class="bg-black py-10 overflow-hidden border-y-[6px] border-blue-600 rotate-1 scale-105"
>
    <div class="flex whitespace-nowrap animate-marquee">
        {
            [1, 2, 3, 2, 1, 2].map(() => (
                <div class="flex items-center gap-10 mx-10">
                    {marquee.map((item) => (
                        <>
                            <span class="text-white font-black text-4xl uppercase tracking-tighter italic">
                                {item.label}
                            </span>
                            <span class={`size-4 ${item.color} rounded-full`} />
                        </>
                    ))}
                </div>
            ))
        }
    </div>
</section>
