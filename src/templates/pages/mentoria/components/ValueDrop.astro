---
const models = {
    title: ["Value", "Drop."],
    items: [
        {
            title: "Inversão de Risco",
            desc: 'Como fazer o cliente se sentir um idiota se ele disser "não" para você.',
        },
        {
            title: "Janela de Autoridade",
            desc: "O segredo para dominar a percepção de valor antes mesmo do primeiro contato.",
        },
        {
            title: "Fricção Seletiva",
            desc: "Por que dificultar o acesso à sua mentoria vai triplicar sua taxa de fechamento.",
        },
    ],
};
---

<section class="py-40 bg-zinc-950 text-white relative overflow-hidden italic">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="text-center mb-32">
            <h2
                class="text-6xl md:text-8xl font-black uppercase tracking-tighter italic"
            >
                {models.title[0]}
                <span class="text-blue-600 underline decoration-white/20"
                    >{models.title[1]}</span
                >
            </h2>
        </div>
        <div class="grid md:grid-cols-3 gap-12">
            {
                models.items.map((model) => (
                    <div class="p-10 border-[4px] border-white/10 rounded-3xl hover:border-blue-600 transition-colors group cursor-default">
                        <div class="size-12 bg-white/5 border border-white/20 rounded-xl mb-8 flex items-center justify-center font-black text-xl italic text-blue-600 group-hover:scale-110 transition-transform">
                            ?
                        </div>
                        <h4 class="text-2xl font-black uppercase mb-4 tracking-tighter group-hover:text-blue-600 transition-colors">
                            {model.title}
                        </h4>
                        <p class="text-zinc-500 text-sm font-bold leading-relaxed italic lowercase">
                            {model.desc}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
