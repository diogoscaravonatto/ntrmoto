---
const footer = {
    brand: { name: "Peak", highlight: "Mentor" },
    copy: "© 2026 Peak Performance Mentoring. All Rights Reserved. Stop Playing, Start Winning.",
};
---

<footer class="py-20 border-t-[6px] border-black bg-white italic">
    <div
        class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-12"
    >
        <div class="flex items-center gap-3">
            <div class="size-6 bg-blue-600 border-2 border-black"></div>
            <span class="text-lg font-black uppercase tracking-tighter italic"
                >{footer.brand.name}<span class="text-blue-600 font-black"
                    >{footer.brand.highlight}</span
                ></span
            >
        </div>
        <p
            class="text-[10px] font-black text-zinc-400 uppercase tracking-[0.3em] text-center italic lowercase"
        >
            {footer.copy}
        </p>
    </div>
</footer>
