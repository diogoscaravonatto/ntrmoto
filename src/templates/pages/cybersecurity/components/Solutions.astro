---
const solutions = [
    { title: "Endpoint Protection", code: "EDR-X1" },
    { title: "Identity Governance", code: "IAM-V3" },
    { title: "Network Sovereignty", code: "NS-Z9" },
    { title: "Cloud Infrastructure", code: "CIS-01" },
    { title: "Disaster Recovery", code: "DR-BAK" },
    { title: "Vulnerability Mgmt", code: "VM-SCAN" },
    { title: "Threat Intelligence", code: "TI-FEED" },
    { title: "Application Security", code: "APP-WAF" },
];
---

<section id="solutions" class="py-40 px-6 bg-black">
    <div
        class="max-w-7xl mx-auto grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-white/5 border border-white/5 overflow-hidden"
    >
        {
            solutions.map((item) => (
                <div class="bg-black p-10 hover:bg-zinc-950 transition-colors group">
                    <p class="text-[9px] font-black text-red-600 mb-6 tracking-widest">
                        {item.code}
                    </p>
                    <h3 class="text-lg font-black text-white uppercase italic mb-10 group-hover:text-red-500 transition-colors">
                        {item.title}
                    </h3>
                    <div class="size-6 border border-white/10 flex items-center justify-center opacity-30 group-hover:opacity-100 transition-opacity">
                        <svg
                            class="size-3"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 4v16m8-8H4"
                            />
                        </svg>
                    </div>
                </div>
            ))
        }
    </div>
</section>
