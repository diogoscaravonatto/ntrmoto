---
const cta = {
    title: ["Locked", "Down."],
    description:
        "Sua empresa está segura agora mesmo? Solicite um teste de intrusão gratuito e receba seu score de vulnerabilidade.",
    button: "Executar Auditoria de Vulnerabilidade",
    status: "Protegido",
};
---

<section class="py-60 px-6 text-center">
    <div class="max-w-5xl mx-auto space-y-16">
        <h2
            class="text-6xl md:text-[9rem] font-black text-white tracking-widest uppercase leading-none border-b-8 border-red-600 inline-block pb-4 italic"
        >
            {cta.title[0]}
            <br />{cta.title[1]}
        </h2>
        <div class="space-y-12">
            <p
                class="text-xl text-zinc-500 font-bold uppercase tracking-widest max-w-xl mx-auto"
            >
                {cta.description}
            </p>
            <div
                class="flex flex-col md:flex-row items-center justify-center gap-8"
            >
                <button
                    class="px-12 py-7 bg-red-600 text-white font-black text-[11px] uppercase tracking-[0.4em] shadow-3xl shadow-red-600/20 hover:scale-105 transition-all outline-hidden"
                >
                    {cta.button}
                </button>
                <span
                    class="text-zinc-700 font-black text-[10px] uppercase tracking-widest"
                >
                    Status de Monitoramento: <span class="text-green-500"
                        >{cta.status}</span
                    >
                </span>
            </div>
        </div>
    </div>
</section>
