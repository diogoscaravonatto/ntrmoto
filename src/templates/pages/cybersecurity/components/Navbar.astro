---
const brand = { name: "Cyber", highlight: "Fortress" };
const links = [
    { label: "Inteligência de Ameaças", href: "#threats" },
    { label: "SOC 24/7", href: "#soc" },
    { label: "Compliance", href: "#compliance" },
    { label: "FAQ", href: "#faq" },
];
---

<nav
    class="fixed top-0 w-full z-50 border-b border-red-900/10 bg-black/60 backdrop-blur-3xl h-14"
>
    <div
        class="max-w-7xl mx-auto px-6 h-full flex items-center justify-between"
    >
        <div class="flex items-center gap-2">
            <div
                class="size-6 bg-red-600 shadow-[0_0_15px_rgba(220,38,38,0.5)] flex items-center justify-center"
            >
                <svg
                    class="size-4 text-white"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="3"
                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    ></path>
                </svg>
            </div>
            <span class="text-sm font-black tracking-widest uppercase"
                >{brand.name}<span class="text-red-600">{brand.highlight}</span
                ></span
            >
        </div>
        <div
            class="hidden md:flex items-center gap-8 text-[10px] font-bold uppercase tracking-widest text-zinc-600"
        >
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="hover:text-red-500 transition-colors"
                    >
                        {link.label}
                    </a>
                ))
            }
        </div>
        <button
            class="px-5 py-2 border border-red-600/30 text-red-600 text-[9px] font-black uppercase tracking-widest hover:bg-red-600 hover:text-white transition-all"
        >
            System Access
        </button>
    </div>
</nav>
