---
const soc = {
    eyebrow: "Global Security Operations",
    title: ["Vigilância", "Ininterrupta."],
    description:
        "Nosso SOC (Security Operations Center) opera globalmente, neutralizando ataques antes mesmo que sua equipe interna perceba a tentativa de invasão.",
    features: [
        {
            title: "Resposta a Incidentes",
            desc: "SLA de resposta de 15 minutos para qualquer anomalia de rede detectada.",
        },
        {
            title: "Caça a Ameaças (Threat Hunting)",
            desc: "Procuramos proativamente por backdoors e vulnerabilidades dia zero em sua infraestrutura.",
        },
        {
            title: "Monitoramento de Dark Web",
            desc: "Varredura contínua em fóruns restritos para detectar vazamentos de credenciais da sua empresa.",
        },
    ],
};
---

<section
    id="soc"
    class="py-40 bg-zinc-950 border-y border-white/5 relative overflow-hidden"
>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-24 items-center">
            <div class="space-y-12">
                <span
                    class="text-[10px] font-black uppercase tracking-[0.4em] text-red-600"
                    >{soc.eyebrow}</span
                >
                <h2
                    class="text-6xl md:text-8xl font-black text-white leading-tight underline decoration-red-600 italic"
                >
                    {soc.title[0]}
                    <br />{soc.title[1]}
                </h2>
                <p
                    class="text-xl text-zinc-500 font-medium leading-relaxed uppercase tracking-wide"
                >
                    {soc.description}
                </p>

                <div class="space-y-8 pt-10">
                    {
                        soc.features.map((item) => (
                            <div class="group flex gap-8">
                                <div class="size-px h-12 bg-red-600/20 group-hover:bg-red-600 transition-all" />
                                <div>
                                    <h4 class="text-white font-black text-xl mb-2 uppercase italic">
                                        {item.title}
                                    </h4>
                                    <p class="text-zinc-600 text-sm leading-relaxed uppercase tracking-tighter">
                                        {item.desc}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
            <div class="relative aspect-square">
                <div
                    class="absolute inset-0 bg-red-600/5 rounded-full animate-pulse"
                >
                </div>
                <div
                    class="absolute inset-20 bg-red-600/10 rounded-full animate-pulse delay-700"
                >
                </div>
                <div class="absolute inset-0 flex items-center justify-center">
                    <span
                        class="text-red-600 font-black text-2xl animate-pulse uppercase tracking-widest text-center"
                        >LIVE FEED active</span
                    >
                </div>
            </div>
        </div>
    </div>
</section>
