---

---

<!-- PREMIUM NEWSLETTER SECTION -->
<section
    class="py-20 md:py-32 px-4 md:px-8 bg-gradient-to-b from-black via-purple-950/20 to-black relative overflow-hidden"
>
    <!-- Decorative Elements -->
    <div
        class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-purple-500 to-transparent"
    >
    </div>
    <div
        class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-pink-500 to-transparent"
    >
    </div>

    <div class="max-w-5xl mx-auto">
        <div class="relative">
            <!-- Glowing Background -->
            <div
                class="absolute inset-0 bg-gradient-to-br from-purple-600/10 to-pink-600/10 rounded-[3rem] blur-3xl"
            >
            </div>

            <!-- Main Card -->
            <div
                class="relative bg-zinc-900/80 backdrop-blur-xl border-2 border-white/10 rounded-[3rem] p-8 md:p-16 overflow-hidden"
            >
                <!-- Animated Grid Overlay -->
                <div class="absolute inset-0 opacity-5">
                    <div
                        class="absolute inset-0"
                        style="background-image: linear-gradient(white 1px, transparent 1px), linear-gradient(90deg, white 1px, transparent 1px); background-size: 50px 50px;"
                    >
                    </div>
                </div>

                <div
                    class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
                >
                    <!-- Left: Content -->
                    <div>
                        <div
                            class="inline-flex items-center gap-3 px-4 py-2 bg-gradient-to-r from-purple-600 to-pink-600 rounded-full mb-8"
                        >
                            <div
                                class="w-2 h-2 bg-white rounded-full animate-pulse"
                            >
                            </div>
                            <span
                                class="text-xs font-mono uppercase tracking-widest font-bold"
                                >ACESSO VIP</span
                            >
                        </div>

                        <h2
                            class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none mb-6"
                        >
                            ENTRE PARA<br />
                            O <span
                                class="text-transparent bg-clip-text bg-gradient-to-r from-purple-500 to-pink-500"
                                >CÍRCULO INTERNO</span
                            >
                        </h2>

                        <p class="text-xl text-zinc-400 leading-relaxed mb-8">
                            Receba em primeira mão estratégias, bastidores e
                            conteúdos exclusivos que <span
                                class="text-white font-bold">nunca</span
                            > compartilho nas redes sociais.
                        </p>

                        <!-- Benefits List -->
                        <div class="space-y-4 mb-8">
                            {
                                [
                                    "📊 Análises semanais do mercado",
                                    "🎯 Estratégias de crescimento testadas",
                                    "💎 Acesso antecipado a novos projetos",
                                    "🔥 Comunidade privada no Discord",
                                ].map((benefit) => (
                                    <div class="flex items-center gap-3 group">
                                        <div class="w-6 h-6 rounded-full bg-gradient-to-r from-purple-600 to-pink-600 flex items-center justify-center group-hover:scale-110 transition-transform">
                                            <svg
                                                class="w-4 h-4"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="3"
                                                    d="M5 13l4 4L19 7"
                                                />
                                            </svg>
                                        </div>
                                        <span class="text-lg font-medium group-hover:text-white transition-colors">
                                            {benefit}
                                        </span>
                                    </div>
                                ))
                            }
                        </div>

                        <!-- Stats -->
                        <div
                            class="flex items-center gap-8 pt-6 border-t border-white/10"
                        >
                            <div>
                                <div
                                    class="text-3xl font-black text-purple-500"
                                >
                                    47K+
                                </div>
                                <div
                                    class="text-xs font-mono uppercase tracking-widest text-zinc-600"
                                >
                                    INSCRITOS
                                </div>
                            </div>
                            <div class="h-12 w-px bg-white/10"></div>
                            <div>
                                <div class="text-3xl font-black text-pink-500">
                                    98%
                                </div>
                                <div
                                    class="text-xs font-mono uppercase tracking-widest text-zinc-600"
                                >
                                    TAXA DE ABERTURA
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Form -->
                    <div class="relative">
                        <!-- Decorative Corner -->
                        <div
                            class="absolute -top-4 -right-4 w-24 h-24 border-t-2 border-r-2 border-purple-500/30 rounded-tr-3xl"
                        >
                        </div>
                        <div
                            class="absolute -bottom-4 -left-4 w-24 h-24 border-b-2 border-l-2 border-pink-500/30 rounded-bl-3xl"
                        >
                        </div>

                        <div
                            class="bg-black/50 backdrop-blur-sm border border-white/10 rounded-2xl p-8"
                        >
                            <form class="space-y-6">
                                <!-- Name Input -->
                                <div class="relative group">
                                    <label
                                        class="block text-xs font-mono uppercase tracking-widest text-zinc-500 mb-2 group-focus-within:text-purple-400 transition-colors"
                                    >
                                        SEU NOME
                                    </label>
                                    <input
                                        type="text"
                                        placeholder="João Silva"
                                        class="w-full bg-white/5 border-2 border-white/10 rounded-xl px-6 py-4 text-lg font-medium focus:border-purple-500 focus:bg-white/10 outline-none transition-all placeholder:text-zinc-700"
                                    />
                                </div>

                                <!-- Email Input -->
                                <div class="relative group">
                                    <label
                                        class="block text-xs font-mono uppercase tracking-widest text-zinc-500 mb-2 group-focus-within:text-purple-400 transition-colors"
                                    >
                                        SEU MELHOR EMAIL
                                    </label>
                                    <input
                                        type="email"
                                        placeholder="seu@email.com"
                                        class="w-full bg-white/5 border-2 border-white/10 rounded-xl px-6 py-4 text-lg font-medium focus:border-purple-500 focus:bg-white/10 outline-none transition-all placeholder:text-zinc-700"
                                    />
                                </div>

                                <!-- Submit Button -->
                                <button
                                    type="submit"
                                    class="w-full relative group overflow-hidden"
                                >
                                    <div
                                        class="absolute inset-0 bg-gradient-to-r from-purple-600 to-pink-600 rounded-xl"
                                    >
                                    </div>
                                    <div
                                        class="absolute inset-0 bg-gradient-to-r from-pink-600 to-purple-600 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity"
                                    >
                                    </div>
                                    <div
                                        class="relative px-8 py-5 flex items-center justify-center gap-3"
                                    >
                                        <span
                                            class="text-xl font-black uppercase tracking-tight"
                                            >QUERO FAZER PARTE</span
                                        >
                                        <svg
                                            class="w-6 h-6 transform group-hover:translate-x-2 transition-transform"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M13 7l5 5m0 0l-5 5m5-5H6"
                                            ></path>
                                        </svg>
                                    </div>
                                </button>

                                <!-- Privacy Note -->
                                <p
                                    class="text-xs text-center text-zinc-600 leading-relaxed"
                                >
                                    🔒 Seus dados estão seguros. Zero spam.<br
                                    />
                                    Cancele quando quiser com um clique.
                                </p>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Testimonial Ticker -->
                <div class="mt-12 pt-12 border-t border-white/10">
                    <div class="flex items-center gap-6 overflow-hidden">
                        <div
                            class="text-xs font-mono uppercase tracking-widest text-zinc-600 whitespace-nowrap"
                        >
                            O QUE DIZEM:
                        </div>
                        <div class="flex-1 overflow-hidden">
                            <div class="flex gap-8 animate-scroll-slow">
                                {
                                    Array(3)
                                        .fill([
                                            '"Mudou minha forma de criar conteúdo" - @maria.dev',
                                            '"Conteúdo de altíssimo nível" - @pedro.tech',
                                            '"Valeu cada segundo" - @ana.design',
                                        ])
                                        .flat()
                                        .map((quote) => (
                                            <span class="text-sm text-zinc-500 italic whitespace-nowrap">
                                                {quote}
                                            </span>
                                        ))
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes scroll-slow {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-33.333%);
        }
    }
    .animate-scroll-slow {
        animation: scroll-slow 30s linear infinite;
    }
</style>
