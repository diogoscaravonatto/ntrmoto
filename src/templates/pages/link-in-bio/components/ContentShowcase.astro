---
---

<!-- CONTENT SHOWCASE SECTION -->
<section class="py-20 md:py-32 px-4 md:px-8 bg-zinc-950 relative overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-5">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
        <!-- Section Header -->
        <div class="text-center mb-20">
            <div class="inline-block px-6 py-2 bg-gradient-to-r from-purple-600/20 to-pink-600/20 border border-purple-500/30 rounded-full mb-6">
                <span class="text-xs font-mono uppercase tracking-widest text-purple-400">// PORTFOLIO</span>
            </div>
            <h2 class="text-5xl md:text-8xl font-black uppercase tracking-tighter mb-8">
                CONTEÚDO QUE<br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-500 to-pink-500">TRANSFORMA</span>
            </h2>
            <p class="text-xl text-zinc-400 max-w-3xl mx-auto leading-relaxed">
                Mais de <span class="text-white font-bold">2.4 milhões</span> de pessoas acompanham meu trabalho mensalmente. 
                Aqui está o que estou criando agora.
            </p>
        </div>

        <!-- Content Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {[
                {
                    category: "YouTube",
                    title: "Série: Bastidores da Criação",
                    description: "Como eu construí um império digital do zero, sem investimento inicial. 12 episódios revelando cada estratégia.",
                    stats: "847K visualizações",
                    color: "red",
                    image: "https://images.unsplash.com/photo-1611162617474-5b21e879e113?auto=format&fit=crop&w=800&q=80"
                },
                {
                    category: "Podcast",
                    title: "Conversas Sem Filtro",
                    description: "Entrevistas profundas com os maiores nomes do mercado digital. Sem roteiro, sem edição pesada. Só verdade.",
                    stats: "340K ouvintes/mês",
                    color: "purple",
                    image: "https://images.unsplash.com/photo-1590602847861-f357a9332bbc?auto=format&fit=crop&w=800&q=80"
                },
                {
                    category: "Newsletter",
                    title: "Insights Semanais",
                    description: "Análises exclusivas de tendências, ferramentas e estratégias que estou testando. Direto na sua caixa de entrada.",
                    stats: "47K inscritos",
                    color: "blue",
                    image: "https://images.unsplash.com/photo-1586281380349-632531db7ed4?auto=format&fit=crop&w=800&q=80"
                }
            ].map((item, index) => (
                <div 
                    class="group relative"
                    style={`animation-delay: ${index * 0.15}s`}
                >
                    <!-- Card -->
                    <div class="relative bg-zinc-900 border-2 border-white/10 rounded-3xl overflow-hidden transition-all duration-500 group-hover:border-white/30 group-hover:translate-y-[-8px]">
                        <!-- Image -->
                        <div class="aspect-video relative overflow-hidden">
                            <img 
                                src={item.image} 
                                alt={item.title}
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-zinc-900 via-zinc-900/50 to-transparent"></div>
                            
                            <!-- Category Badge -->
                            <div class={`absolute top-4 left-4 px-4 py-2 bg-${item.color}-600 rounded-full`}>
                                <span class="text-xs font-black uppercase tracking-wider">{item.category}</span>
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="p-6 space-y-4">
                            <h3 class="text-2xl font-black uppercase tracking-tight group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-purple-500 group-hover:to-pink-500 transition-all">
                                {item.title}
                            </h3>
                            <p class="text-zinc-400 leading-relaxed">
                                {item.description}
                            </p>
                            
                            <!-- Stats -->
                            <div class="pt-4 border-t border-white/10 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div class="w-2 h-2 rounded-full bg-gradient-to-r from-purple-500 to-pink-500 animate-pulse"></div>
                                    <span class="text-sm font-bold text-purple-400">{item.stats}</span>
                                </div>
                                <svg class="w-6 h-6 text-zinc-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Glow Effect -->
                    <div class={`absolute inset-0 bg-gradient-to-r from-${item.color}-600 to-${item.color}-600 rounded-3xl opacity-0 group-hover:opacity-20 blur-2xl transition-opacity -z-10`}></div>
                </div>
            ))}
        </div>

        <!-- Bottom CTA -->
        <div class="mt-16 text-center">
            <button class="group relative px-12 py-6 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-r from-purple-600 to-pink-600 rounded-2xl"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-pink-600 to-purple-600 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
                <div class="relative flex items-center gap-3">
                    <span class="text-xl font-black uppercase tracking-tight">VER TODO MEU CONTEÚDO</span>
                    <svg class="w-6 h-6 transform group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                </div>
            </button>
        </div>
    </div>
</section>
