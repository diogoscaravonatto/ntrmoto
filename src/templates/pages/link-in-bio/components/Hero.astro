---
const user = {
    title: "ALEX RIVERA",
    subtitle: "Digital Visual Artist & Content Strategist",
    avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=Felix",
};
---

<!-- BRUTALIST GRID HERO -->
<section
    class="min-h-screen bg-black text-white p-4 md:p-8 flex items-center relative overflow-hidden"
>
    <!-- Animated Grid Background -->
    <div class="absolute inset-0 opacity-10">
        <div class="grid grid-cols-12 grid-rows-12 h-full w-full">
            {
                Array(144)
                    .fill(0)
                    .map((_, i) => (
                        <div
                            class="border border-white/20"
                            style={`animation-delay: ${i * 0.01}s`}
                            class="animate-pulse"
                        />
                    ))
            }
        </div>
    </div>

    <div class="max-w-[1800px] mx-auto w-full relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 md:gap-6">
            <!-- Profile Card - Brutalist Style -->
            <div
                class="lg:col-span-4 bg-gradient-to-br from-purple-600 to-pink-600 p-1 rotate-[-1deg] hover:rotate-0 transition-transform duration-500"
            >
                <div class="bg-black p-8 md:p-12 h-full">
                    <div
                        class="aspect-square bg-gradient-to-br from-purple-500 to-blue-500 rounded-none mb-8 overflow-hidden border-4 border-white/20"
                    >
                        <img
                            src={user.avatar}
                            alt={user.title}
                            class="w-full h-full object-cover mix-blend-luminosity hover:mix-blend-normal transition-all duration-700"
                        />
                    </div>
                    <div class="space-y-4">
                        <h1
                            class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none"
                        >
                            {user.title}
                        </h1>
                        <div
                            class="h-1 w-20 bg-gradient-to-r from-purple-500 to-pink-500"
                        >
                        </div>
                        <p
                            class="text-lg text-zinc-400 font-mono uppercase tracking-wider"
                        >
                            {user.subtitle}
                        </p>
                    </div>
                </div>
            </div>

            <!-- Stats Grid -->
            <div
                class="lg:col-span-8 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6"
            >
                <div
                    class="bg-white/5 border-2 border-white/10 p-6 hover:border-purple-500 transition-all group"
                >
                    <div class="text-5xl font-black text-purple-500 mb-2">
                        847K
                    </div>
                    <div
                        class="text-xs font-mono uppercase tracking-widest text-zinc-500 group-hover:text-white transition-colors"
                    >
                        FOLLOWERS
                    </div>
                </div>
                <div
                    class="bg-white/5 border-2 border-white/10 p-6 hover:border-pink-500 transition-all group"
                >
                    <div class="text-5xl font-black text-pink-500 mb-2">
                        2.4M
                    </div>
                    <div
                        class="text-xs font-mono uppercase tracking-widest text-zinc-500 group-hover:text-white transition-colors"
                    >
                        MONTHLY VIEWS
                    </div>
                </div>
                <div
                    class="bg-white/5 border-2 border-white/10 p-6 hover:border-blue-500 transition-all group"
                >
                    <div class="text-5xl font-black text-blue-500 mb-2">
                        98%
                    </div>
                    <div
                        class="text-xs font-mono uppercase tracking-widest text-zinc-500 group-hover:text-white transition-colors"
                    >
                        ENGAGEMENT
                    </div>
                </div>
                <div
                    class="bg-gradient-to-br from-purple-600 to-pink-600 p-6 relative overflow-hidden group cursor-pointer"
                >
                    <div
                        class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-all"
                    >
                    </div>
                    <div class="text-5xl font-black mb-2">TOP</div>
                    <div class="text-xs font-mono uppercase tracking-widest">
                        CREATOR 2026
                    </div>
                </div>

                <!-- Large Quote Block -->
                <div
                    class="col-span-2 md:col-span-4 bg-white text-black p-8 md:p-12 relative overflow-hidden group"
                >
                    <div
                        class="absolute top-0 left-0 text-[20vw] font-black opacity-5 leading-none"
                    >
                        "
                    </div>
                    <blockquote
                        class="relative z-10 text-2xl md:text-4xl font-black uppercase tracking-tight leading-tight"
                    >
                        "NÃO CRIO CONTEÚDO.<br />
                        <span class="text-purple-600">CRIO MOVIMENTOS."</span>
                    </blockquote>
                    <div
                        class="mt-8 h-1 w-32 bg-gradient-to-r from-purple-600 to-pink-600"
                    >
                    </div>
                </div>
            </div>
        </div>

        <!-- Scroll Indicator -->
        <div
            class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4 animate-bounce"
        >
            <div
                class="text-xs font-mono uppercase tracking-widest text-zinc-600"
            >
                SCROLL TO CONNECT
            </div>
            <div
                class="w-px h-16 bg-gradient-to-b from-purple-500 to-transparent"
            >
            </div>
        </div>
    </div>
</section>
