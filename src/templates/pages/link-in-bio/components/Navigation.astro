---
const user = {
    title: "ALEX RIVERA",
    avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=Felix",
    social: [
        { platform: "Instagram", url: "#" },
        { platform: "Twitter", url: "#" },
        { platform: "TikTok", url: "#" },
    ],
};
---

<nav
    class="fixed top-0 left-0 w-full z-50 p-6 flex justify-between items-center bg-black/50 backdrop-blur-xl border-b border-white/5"
>
    <div class="flex items-center gap-3">
        <img
            src={user.avatar}
            alt={user.title}
            class="size-10 rounded-full border border-white/20"
        />
        <span class="font-black italic tracking-tighter uppercase text-sm"
            >{user.title}</span
        >
    </div>
    <div class="flex gap-4">
        {
            user.social.map((s) => (
                <a
                    href={s.url}
                    class="text-zinc-500 hover:text-white transition-colors uppercase font-black text-[10px] tracking-widest"
                >
                    {s.platform}
                </a>
            ))
        }
    </div>
</nav>
