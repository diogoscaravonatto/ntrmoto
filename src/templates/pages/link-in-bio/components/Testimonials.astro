---
---

<!-- TESTIMONIALS SECTION -->
<section class="py-20 md:py-32 px-4 md:px-8 bg-black relative overflow-hidden">
    <!-- Animated Background -->
    <div class="absolute top-0 left-1/3 w-[600px] h-[600px] bg-purple-600/10 rounded-full blur-[150px] animate-pulse"></div>
    <div class="absolute bottom-0 right-1/3 w-[600px] h-[600px] bg-pink-600/10 rounded-full blur-[150px] animate-pulse" style="animation-delay: 2s"></div>

    <div class="max-w-7xl mx-auto relative z-10">
        <!-- Section Header -->
        <div class="mb-20">
            <div class="inline-block px-6 py-2 bg-white/5 border border-white/10 rounded-full mb-6">
                <span class="text-xs font-mono uppercase tracking-widest text-purple-400">// DEPOIMENTOS</span>
            </div>
            <h2 class="text-5xl md:text-8xl font-black uppercase tracking-tighter mb-6">
                O QUE AS PESSOAS<br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-500 to-pink-500">ESTÃO DIZENDO</span>
            </h2>
            <p class="text-xl text-zinc-400 max-w-3xl leading-relaxed">
                Mais de 2.4 milhões de pessoas acompanham meu trabalho. Aqui estão algumas histórias de transformação real.
            </p>
        </div>

        <!-- Testimonials Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {[
                {
                    name: "Marina Costa",
                    role: "Designer de Produto",
                    avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=marina",
                    text: "Comecei a seguir o conteúdo há 6 meses e minha carreira literalmente decolou. Consegui dobrar meu faturamento aplicando as estratégias compartilhadas. O nível de profundidade é absurdo.",
                    rating: 5,
                    platform: "LinkedIn"
                },
                {
                    name: "Rafael Mendes",
                    role: "Desenvolvedor Full-Stack",
                    avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=rafael",
                    text: "Não é só conteúdo de qualidade, é uma masterclass gratuita toda semana. Aprendi mais em 3 meses aqui do que em 2 anos de faculdade. Sério mesmo.",
                    rating: 5,
                    platform: "YouTube"
                },
                {
                    name: "Juliana Ferreira",
                    role: "Empreendedora Digital",
                    avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=juliana",
                    text: "A newsletter mudou completamente minha forma de pensar negócios digitais. Cada edição é um soco no estômago (no bom sentido). Conteúdo denso, direto e aplicável.",
                    rating: 5,
                    platform: "Newsletter"
                },
                {
                    name: "Pedro Oliveira",
                    role: "Product Manager",
                    avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=pedro",
                    text: "Acompanho desde o início e é impressionante ver a evolução. Sempre um passo à frente, sempre trazendo insights que ninguém mais está falando. Referência absoluta.",
                    rating: 5,
                    platform: "Instagram"
                },
                {
                    name: "Camila Santos",
                    role: "UX/UI Designer",
                    avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=camila",
                    text: "O podcast é viciante. Conversas reais, sem filtro, com pessoas incríveis. Já ouvi todos os episódios duas vezes. Cada um é uma aula de vida e negócios.",
                    rating: 5,
                    platform: "Spotify"
                },
                {
                    name: "Lucas Almeida",
                    role: "Growth Hacker",
                    avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=lucas",
                    text: "Se você quer resultados reais, não teoria de coach, esse é o lugar. Estratégias testadas, métricas reais, transparência total. Mudou meu jogo completamente.",
                    rating: 5,
                    platform: "Twitter"
                }
            ].map((testimonial, index) => (
                <div 
                    class="group relative"
                    style={`animation-delay: ${index * 0.1}s`}
                >
                    <!-- Card -->
                    <div class="relative bg-zinc-900 border-2 border-white/10 rounded-3xl p-8 transition-all duration-500 group-hover:border-purple-500/50 group-hover:translate-y-[-4px] h-full flex flex-col">
                        <!-- Header -->
                        <div class="flex items-start justify-between mb-6">
                            <div class="flex items-center gap-4">
                                <img 
                                    src={testimonial.avatar} 
                                    alt={testimonial.name}
                                    class="w-14 h-14 rounded-full border-2 border-white/20"
                                />
                                <div>
                                    <div class="font-bold text-lg">{testimonial.name}</div>
                                    <div class="text-sm text-zinc-500">{testimonial.role}</div>
                                </div>
                            </div>
                            
                            <!-- Platform Badge -->
                            <div class="px-3 py-1 bg-purple-600/20 border border-purple-500/30 rounded-full">
                                <span class="text-xs font-bold text-purple-400">{testimonial.platform}</span>
                            </div>
                        </div>

                        <!-- Quote -->
                        <div class="flex-1 mb-6">
                            <p class="text-zinc-300 leading-relaxed italic">
                                "{testimonial.text}"
                            </p>
                        </div>

                        <!-- Rating -->
                        <div class="flex items-center gap-1 pt-6 border-t border-white/10">
                            {Array(testimonial.rating).fill(0).map(() => (
                                <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                </svg>
                            ))}
                        </div>
                    </div>

                    <!-- Glow Effect -->
                    <div class="absolute inset-0 bg-gradient-to-r from-purple-600 to-pink-600 rounded-3xl opacity-0 group-hover:opacity-10 blur-2xl transition-opacity -z-10"></div>
                </div>
            ))}
        </div>

        <!-- Stats Bar -->
        <div class="mt-20 p-8 md:p-12 bg-gradient-to-r from-purple-600 to-pink-600 rounded-3xl">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                {[
                    { value: "2.4M+", label: "Seguidores Totais" },
                    { value: "4.9/5", label: "Avaliação Média" },
                    { value: "98%", label: "Taxa de Satisfação" },
                    { value: "340K+", label: "Comunidade Ativa" }
                ].map(stat => (
                    <div class="text-center">
                        <div class="text-4xl md:text-5xl font-black mb-2">{stat.value}</div>
                        <div class="text-sm uppercase tracking-wider opacity-90">{stat.label}</div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>
