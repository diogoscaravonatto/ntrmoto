---
// Pricing — Tabela de preços com destaque no plano recomendado
const pricing = {
    title: "O plano para",
    titleHighlight: "Próximo Passo.",
};

const plans = [
    {
        name: "Starter",
        price: "R$ 0",
        desc: "Para desenvolvedores solo e validação de MVPs.",
        features: [
            "Até 5.000 eventos/mês",
            "Retenção de 7 dias",
            "Suporte via Comunidade",
        ],
        popular: false,
    },
    {
        name: "Growth",
        price: "R$ 190",
        desc: "O motor para startups em fase de tração acelerada.",
        features: [
            "Eventos Ilimitados",
            "Retenção de 1 ano",
            "Prioridade em Suporte",
            "Integrações customizadas",
        ],
        popular: true,
    },
    {
        name: "Enterprise",
        price: "Custom",
        desc: "Segurança e governança para escala global.",
        features: [
            "SLA de 99.999%",
            "SSO & SAML Auth",
            "Gerente de Contas Dedicado",
            "Infra On-premise",
        ],
        popular: false,
    },
];
---

<section class="py-40 bg-zinc-950">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-24">
            <h2
                class="text-5xl md:text-7xl font-black uppercase italic tracking-tighter"
            >
                {pricing.title}
                <br />o seu <span class="text-indigo-500"
                    >{pricing.titleHighlight}</span
                >
            </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            {
                plans.map((plan) => (
                    <div
                        class={`p-12 rounded-4xl border ${plan.popular ? "border-indigo-500 bg-indigo-500/5" : "border-white/5 bg-zinc-900/20"} relative`}
                    >
                        {plan.popular && (
                            <span class="absolute -top-4 left-12 px-4 py-1 bg-indigo-500 text-white text-[8px] font-black uppercase rounded-full">
                                Mais Popular
                            </span>
                        )}
                        <h4 class="text-2xl font-black uppercase italic text-white mb-2">
                            {plan.name}
                        </h4>
                        <div class="text-4xl font-black text-white mb-6 italic">
                            {plan.price}
                            <span class="text-sm font-normal text-zinc-500">
                                /mês
                            </span>
                        </div>
                        <p class="text-zinc-500 text-sm mb-10 leading-relaxed">
                            {plan.desc}
                        </p>
                        <ul class="space-y-4 mb-12">
                            {plan.features.map((f) => (
                                <li class="flex items-center gap-3 text-xs text-zinc-300">
                                    <div class="size-1.5 bg-indigo-500 rounded-full" />
                                    {f}
                                </li>
                            ))}
                        </ul>
                        <button
                            class={`w-full py-4 rounded-xl font-bold uppercase tracking-widest text-[10px] transition-all ${plan.popular ? "bg-indigo-600 text-white hover:bg-indigo-700" : "bg-white/5 text-white hover:bg-white/10"}`}
                        >
                            Selecionar Plano
                        </button>
                    </div>
                ))
            }
        </div>
    </div>
</section>
