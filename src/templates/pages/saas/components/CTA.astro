---
// CTA — Call to Action final com gradiente vibrante e noise overlay
const cta = {
    title: "Crescimento",
    titleLine2: "Sem Limites.",
    description:
        "Seu time merece a melhor ferramenta do mercado. Junte-se a 25.000+ empresas disruptivas.",
    button: "Implantar em Produção",
    statusLabel: "Sistemas Operacionais",
};
---

<section id="pricing" class="py-40 px-6">
    <div
        class="max-w-6xl mx-auto rounded-[3.5rem] bg-indigo-600 p-16 md:p-32 text-center relative overflow-hidden"
    >
        <!-- Visual Noise -->
        <div
            class="absolute inset-0 opacity-20 pointer-events-none mix-blend-overlay bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
        >
        </div>

        <div class="relative z-10">
            <h2
                class="text-5xl md:text-[8rem] font-black text-white leading-[0.8] tracking-tighter mb-16 uppercase italic"
            >
                {cta.title}<br />{cta.titleLine2}
            </h2>
            <p
                class="text-indigo-950 text-2xl font-bold max-w-xl mx-auto mb-20 leading-tight"
            >
                {cta.description}
            </p>
            <div
                class="flex flex-col md:flex-row items-center justify-center gap-6"
            >
                <button
                    class="px-12 py-7 bg-white text-black font-black rounded-2xl hover:bg-black hover:text-white transition-all text-xs uppercase tracking-[0.2em]"
                >
                    {cta.button}
                </button>
                <span
                    class="text-indigo-950 font-black text-xs uppercase tracking-widest flex items-center gap-2"
                >
                    <span
                        class="size-1.5 bg-indigo-900 rounded-full animate-ping"
                    ></span>
                    {cta.statusLabel}
                </span>
            </div>
        </div>
    </div>
</section>
