---
// Navbar — Navegação fixa com blur e logo gradiente
const brand = {
    name: "Nova",
    suffix: ".io",
};

const links = [
    { label: "Recursos", href: "#recursos" },
    { label: "Infraestrutura", href: "#infra" },
    { label: "Preços", href: "#pricing" },
];
---

<nav
    class="fixed top-0 w-full z-50 border-b border-white/5 bg-black/40 backdrop-blur-2xl h-16"
>
    <div
        class="max-w-7xl mx-auto px-6 h-full flex items-center justify-between"
    >
        <div class="flex items-center gap-2">
            <div
                class="size-7 bg-linear-to-tr from-indigo-500 to-violet-500 rounded-lg shadow-[0_0_20px_rgba(99,102,241,0.5)]"
            >
            </div>
            <span class="text-xl font-black tracking-tighter uppercase italic"
                >{brand.name}<span class="text-indigo-500">{brand.suffix}</span
                ></span
            >
        </div>
        <div
            class="hidden md:flex items-center gap-8 text-[11px] font-bold uppercase tracking-widest text-zinc-500"
        >
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="hover:text-white transition-colors"
                    >
                        {link.label}
                    </a>
                ))
            }
        </div>
        <div class="flex items-center gap-4">
            <button
                class="text-xs font-bold text-zinc-400 hover:text-white transition-colors"
                >Entrar</button
            >
            <button
                class="px-5 py-2.5 bg-white text-black text-[10px] font-black uppercase tracking-widest rounded-lg hover:bg-indigo-500 hover:text-white transition-all"
                >Teste Grátis</button
            >
        </div>
    </div>
</nav>
