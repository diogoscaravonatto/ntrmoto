---
// Hero — Seção principal com headline impactante e preview de dashboard
const hero = {
    badge: "NOVO",
    badgeText: "Nova V3 Core com Sincronização Preditiva",
    title: "Preveja",
    titleHighlight: "Futuro.",
    description:
        "O Nova unifica seus dados em um único fluxo de consciência operacional. Escale sem as fricções do passado.",
    ctaPrimary: "Comece Agora Gratuitamente",
    ctaSecondary: "Ver Demonstração",
};

// Dados do gráfico mock do dashboard
const chartBars = [1, 3, 2, 5, 4, 7, 6, 8, 5, 9, 7];
---

<section
    class="relative min-h-screen flex flex-col items-center justify-center pt-32 px-6"
>
    <div class="text-center max-w-5xl mx-auto relative z-10">
        <div
            class="inline-flex items-center gap-2 px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] font-bold text-indigo-400 uppercase tracking-[0.2em] mb-10"
        >
            <span
                class="px-2 py-0.5 bg-indigo-500 text-white rounded-full text-[8px] font-black mr-1"
                >{hero.badge}</span
            >
            {hero.badgeText}
        </div>
        <h1
            class="text-7xl md:text-[9.5rem] font-black leading-[0.8] tracking-tighter mb-12 uppercase italic bg-linear-to-b from-white via-white to-white/20 bg-clip-text text-transparent"
        >
            {hero.title}
            <br />O <span class="text-outline-indigo italic"
                >{hero.titleHighlight}</span
            >
        </h1>
        <p
            class="text-xl md:text-2xl text-zinc-400 max-w-3xl mx-auto mb-16 leading-tight font-medium"
        >
            {hero.description}
        </p>
        <div
            class="flex flex-col sm:flex-row items-center justify-center gap-6 mb-20"
        >
            <button
                class="px-12 py-6 bg-indigo-600 text-white font-black rounded-2xl hover:scale-110 active:scale-95 transition-all text-sm uppercase tracking-widest shadow-[0_0_50px_rgba(79,70,229,0.4)]"
            >
                {hero.ctaPrimary}
            </button>
            <button
                class="px-12 py-6 bg-white/5 border border-white/10 text-white font-black rounded-2xl hover:bg-white/10 transition-all text-sm uppercase tracking-widest"
            >
                {hero.ctaSecondary}
            </button>
        </div>

        <!-- Dashboard Preview -->
        <div
            class="relative w-full max-w-5xl mx-auto p-4 rounded-3xl bg-white/5 border border-white/10 shadow-3xl overflow-hidden group"
        >
            <div
                class="absolute inset-x-0 top-0 h-10 bg-zinc-900/50 flex items-center px-4 gap-2"
            >
                <div class="size-2.5 rounded-full bg-red-500/50"></div>
                <div class="size-2.5 rounded-full bg-yellow-500/50"></div>
                <div class="size-2.5 rounded-full bg-green-500/50"></div>
            </div>
            <div
                class="aspect-video bg-zinc-950 flex items-center justify-center text-zinc-800 font-mono text-xs p-12 mt-6 relative overflow-hidden"
            >
                <div class="grid grid-cols-12 gap-6 w-full h-full">
                    <div
                        class="col-span-8 bg-zinc-900/50 rounded-2xl p-6 border border-white/5"
                    >
                        <div
                            class="h-4 w-32 bg-indigo-500/20 rounded-full mb-8"
                        >
                        </div>
                        <div class="grid grid-cols-12 gap-4 h-full pb-10">
                            {
                                chartBars.map((h) => (
                                    <div
                                        class="col-span-1 bg-linear-to-t from-indigo-500/40 to-violet-500/40 rounded-t-lg self-end"
                                        style={`height: ${h * 10}%`}
                                    />
                                ))
                            }
                        </div>
                    </div>
                    <div class="col-span-4 flex flex-col gap-6">
                        <div
                            class="flex-1 bg-zinc-900/50 rounded-2xl p-6 border border-white/5"
                        >
                        </div>
                        <div
                            class="flex-1 bg-zinc-900/50 rounded-2xl p-6 border border-white/5"
                        >
                        </div>
                    </div>
                </div>
            </div>
            <!-- Glow effect on hover -->
            <div
                class="absolute inset-0 bg-linear-to-r from-indigo-500/20 to-violet-500/20 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
            >
            </div>
        </div>
    </div>
</section>

<style>
    .text-outline-indigo {
        -webkit-text-stroke: 1px #6366f1;
        color: transparent;
    }
</style>
