---
// Features — Bento Grid com cards de funcionalidades
const features = {
    title: "Ferramentas para",
    titleHighlight: "Gigantes.",
    main: {
        title: "Neural Insight\nAnalytics",
        description:
            "Não apenas dados. Respostas. Nossa IA analisa padrões comportamentais antes mesmo que eles se tornem tendências.",
    },
    cards: [
        {
            title: "Latência Zero",
            description:
                "Distribuição global edge-native para performance instantânea.",
            iconPath: "M13 10V3L4 14h7v7l9-11h-7z",
            iconBg: "bg-indigo-500/20",
            iconColor: "text-indigo-400",
        },
        {
            title: "Segurança de Fortaleza",
            description:
                "Criptografia quântica-resistente por padrão em cada bit.",
            iconPath:
                "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z",
            iconBg: "bg-violet-500/20",
            iconColor: "text-violet-400",
        },
    ],
    integrations: {
        title: "Integrações",
        description: "Conecte-se com 2.000+ Ferramentas",
    },
};

// Dados do gráfico de barras animadas
const progressBars = [1, 2, 3];
---

<section id="recursos" class="py-40 px-6">
    <div class="max-w-7xl mx-auto">
        <div class="mb-24">
            <h2
                class="text-5xl md:text-7xl font-black uppercase italic tracking-tighter"
            >
                {features.title}
                <span class="text-indigo-500 underline decoration-white/10"
                    >{features.titleHighlight}</span
                >
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 auto-rows-[300px]">
            <!-- Large Feature Card -->
            <div
                class="md:col-span-8 md:row-span-2 rounded-4xl bg-[#09090b] border border-white/5 p-12 relative overflow-hidden group"
            >
                <h3
                    class="text-4xl font-black uppercase italic text-white mb-6"
                >
                    {
                        features.main.title.split("\n").map((line, i) => (
                            <>
                                {i > 0 && <br />}
                                {line}
                            </>
                        ))
                    }
                </h3>
                <p class="text-zinc-500 text-lg leading-relaxed max-w-sm mb-12">
                    {features.main.description}
                </p>
                <div
                    class="absolute bottom-0 right-0 w-[60%] h-[60%] bg-zinc-900/40 p-10 translate-x-10 translate-y-10 rounded-tl-[4rem] border-t border-l border-white/10 group-hover:translate-y-6 transition-transform"
                >
                    <div class="flex flex-col gap-4">
                        {
                            progressBars.map((i) => (
                                <div class="h-4 bg-white/5 rounded-full w-full relative overflow-hidden">
                                    <div
                                        class="absolute inset-0 bg-indigo-500/40"
                                        style={`width: ${40 + i * 15}%`}
                                    />
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>

            <!-- Small Feature Cards -->
            {
                features.cards.map((card) => (
                    <div class="md:col-span-4 rounded-4xl bg-[#09090b] border border-white/5 p-10 flex flex-col justify-between hover:bg-zinc-900/50 transition-all cursor-pointer">
                        <div
                            class={`size-12 rounded-2xl ${card.iconBg} flex items-center justify-center ${card.iconColor}`}
                        >
                            <svg
                                class="size-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d={card.iconPath}
                                />
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-2xl font-black uppercase italic mb-2">
                                {card.title}
                            </h4>
                            <p class="text-zinc-600 text-sm">
                                {card.description}
                            </p>
                        </div>
                    </div>
                ))
            }

            <!-- Integrations Card -->
            <div
                class="md:col-span-4 rounded-4xl bg-linear-to-br from-indigo-900/40 to-zinc-950 border border-indigo-500/20 p-10 flex items-center justify-center relative group"
            >
                <div class="text-center relative z-20">
                    <h4
                        class="text-sm font-black uppercase tracking-widest text-indigo-400 mb-2"
                    >
                        {features.integrations.title}
                    </h4>
                    <p class="text-white font-bold">
                        {features.integrations.description}
                    </p>
                </div>
                <div
                    class="absolute inset-0 flex items-center justify-center overflow-hidden opacity-10"
                >
                    <div class="grid grid-cols-6 gap-4 rotate-12 scale-150">
                        {
                            [...Array(24)].map(() => (
                                <div class="size-10 bg-white rounded-lg" />
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
