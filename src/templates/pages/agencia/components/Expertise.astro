---
import Icon from "@components/Icon.astro";
import AnimateOnScroll from "@components/AnimateOnScroll.vue";

const services = [
    {
        title: "Design de Produto",
        description:
            "Criamos interfaces que não apenas parecem boas, mas que resolvem problemas reais de negócio. Foco total em usabilidade e conversão.",
        tags: ["UX Design", "SaaS", "Mobile First", "Design Systems"],
    },
    {
        title: "Branding Radical",
        description:
            "Identidades visuais que cortam o ruído. Construímos marcas que são reconhecidas instantaneamente no mercado.",
        tags: ["Logotipo", "Voz da Marca", "Manual Visual", "Tipografia"],
    },
    {
        title: "Engenharia Web",
        description:
            "Desenvolvimento de alta performance utilizando as tecnologias mais modernas. Sites rápidos, seguros e escaláveis.",
        tags: ["Nuxt 3", "TypeScript", "SEO", "Web Vitals"],
    },
];
---

<section id="expertise" class="py-32 border-t border-zinc-800">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-20">
            <div class="md:col-span-4 flex flex-col gap-8 sticky top-32 h-fit">
                <AnimateOnScroll client:visible>
                    <span
                        class="text-xs font-mono uppercase tracking-[0.4em] text-zinc-500 font-bold"
                        >Expertise</span
                    >
                    <h2
                        class="text-6xl font-black tracking-tighter uppercase leading-none mt-4"
                    >
                        O Que<br />Fazemos.
                    </h2>
                    <p
                        class="text-xl text-zinc-400 leading-relaxed max-w-sm mt-6"
                    >
                        Não somos uma agência de tudo. Somos especialistas no
                        que importa para o seu crescimento digital.
                    </p>
                </AnimateOnScroll>

                <div
                    class="pt-8 flex flex-col gap-4 text-xs font-mono uppercase tracking-widest text-zinc-400"
                >
                    <div class="flex items-center gap-3">
                        <div class="size-2 rounded-full bg-primary-500"></div>
                        <span>Estratégia Primeiro</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="size-2 rounded-full bg-primary-500"></div>
                        <span>Design de Elite</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="size-2 rounded-full bg-primary-500"></div>
                        <span>Código Impecável</span>
                    </div>
                </div>
            </div>

            <div
                class="md:col-span-8 flex flex-col gap-px bg-zinc-800 border border-zinc-800"
            >
                {
                    services.map((service, index) => (
                        <AnimateOnScroll client:visible>
                            <div class="p-10 md:p-16 bg-black group hover:bg-zinc-900 transition-all cursor-default w-full">
                                <div class="flex flex-col md:flex-row gap-12 items-start">
                                    <span class="text-xs font-mono text-zinc-700 mt-2">
                                        0{index + 1}
                                    </span>
                                    <div class="flex-1 flex flex-col gap-6">
                                        <h3 class="text-4xl font-black uppercase tracking-tighter group-hover:text-primary-500 transition-colors">
                                            {service.title}
                                        </h3>
                                        <p class="text-lg text-zinc-400 max-w-2xl leading-relaxed">
                                            {service.description}
                                        </p>
                                        <div class="flex flex-wrap gap-3">
                                            {service.tags.map((tag) => (
                                                <span class="text-[10px] font-mono border border-zinc-800 px-4 py-1.5 uppercase tracking-widest font-bold">
                                                    {tag}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                    <Icon
                                        name="lucide:arrow-up-right"
                                        class="size-10 text-zinc-800 group-hover:text-white transition-all transform group-hover:rotate-45"
                                    />
                                </div>
                            </div>
                        </AnimateOnScroll>
                    ))
                }
            </div>
        </div>
    </div>
</section>
