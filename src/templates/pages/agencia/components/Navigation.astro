---
const links = [
    { label: "Trabalhos", href: "/templates/agencia#trabalhos" },
    { label: "Expertise", href: "/templates/agencia#expertise" },
    { label: "Manifesto", href: "/templates/agencia#manifesto" },
    { label: "Contato", href: "/templates/agencia#contato" },
];
---

<nav
    class="sticky top-0 z-50 bg-black/80 backdrop-blur-md border-b border-zinc-800/50"
>
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex justify-between items-center py-6">
            <div
                class="text-2xl font-black tracking-tighter uppercase group cursor-pointer text-white"
            >
                Agência<span
                    class="text-zinc-400 group-hover:text-primary-500 transition-colors"
                    >.Visionária</span
                >
            </div>

            <div
                class="hidden md:flex gap-10 text-xs font-bold tracking-[0.2em] items-center uppercase text-zinc-400"
            >
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            class="hover:text-white transition-colors"
                        >
                            {link.label}
                        </a>
                    ))
                }
            </div>

            <div class="flex items-center gap-4">
                <button
                    class="bg-white text-black px-8 py-3 font-black uppercase tracking-widest text-[10px] rounded-none hover:scale-105 transition-transform"
                >
                    Iniciar Projeto
                </button>
            </div>
        </div>
    </div>
</nav>
