---
import { Image } from "astro:assets";
import Icon from "@components/Icon.astro";

const projects = [
    {
        id: "nexus",
        title: "Nexus Pay",
        description:
            "Redefinindo a experiência de checkout para a Web3 com foco em confiança visual.",
        year: "2024",
        tags: ["Fintech", "Web3", "UI Design"],
        image: "https://placehold.co/1200x800/18181b/ffffff?text=Nexus+Pay",
        gridClass: "md:col-span-8 md:h-[600px]",
    },
    {
        id: "lumina",
        title: "Lumina",
        description:
            "Plataforma de saúde preventiva com interface minimalista e humanizada.",
        year: "2023",
        tags: ["Health", "App", "Branding"],
        image: "https://placehold.co/800x1200/18181b/ffffff?text=Lumina",
        gridClass: "md:col-span-4 md:h-[600px]",
    },
    {
        id: "vanguard",
        title: "Vanguard",
        description:
            "Imobiliária de alto luxo com foco em showcase cinematográfico.",
        year: "2024",
        tags: ["Real Estate", "Web", "Motion"],
        image: "https://placehold.co/800x800/18181b/ffffff?text=Vanguard",
        gridClass: "md:col-span-12 md:h-[400px]",
    },
];
---

<section id="trabalhos" class="py-32">
    <div class="max-w-7xl mx-auto px-6">
        <div
            class="flex flex-col md:flex-row justify-between items-end gap-12 mb-24"
        >
            <div class="flex flex-col gap-6">
                <span
                    class="text-xs font-mono uppercase tracking-[0.4em] text-zinc-400 font-bold"
                    >Portfólio</span
                >
                <h2
                    class="text-6xl md:text-8xl font-black tracking-tighter uppercase leading-none text-white"
                >
                    Trabalhos<br /><span class="text-zinc-700">De Impacto</span>
                </h2>
            </div>
            <div class="flex gap-4">
                <button
                    class="rounded-full size-12 flex items-center justify-center border border-zinc-800 hover:bg-zinc-800 transition-colors"
                >
                    <Icon name="lucide:arrow-left" class="size-6 text-white" />
                </button>
                <button
                    class="rounded-full size-12 flex items-center justify-center border border-zinc-800 hover:bg-zinc-800 transition-colors"
                >
                    <Icon name="lucide:arrow-right" class="size-6 text-white" />
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
            {
                projects.map((project) => (
                    <div
                        class:list={[
                            project.gridClass,
                            "group relative overflow-hidden bg-zinc-900 border border-zinc-800",
                        ]}
                    >
                        <div class="aspect-16/10 md:aspect-auto h-full overflow-hidden">
                            <Image
                                src={project.image}
                                alt={project.title}
                                width={1200}
                                height={800}
                                class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000 group-hover:scale-105"
                                widths={[400, 800, 1200]}
                                sizes="(max-width: 768px) 100vw, 800px"
                                format="webp"
                            />
                        </div>

                        <div class="absolute inset-0 bg-black/80 opacity-0 group-hover:opacity-100 transition-all duration-500 p-10 flex flex-col justify-between">
                            <div class="flex justify-between items-start translate-y-[-20px] group-hover:translate-y-0 transition-transform duration-500">
                                <span class="text-[10px] font-mono uppercase tracking-widest bg-white text-black px-3 py-1 font-bold">
                                    {project.year}
                                </span>
                                <div class="flex gap-2">
                                    {project.tags.map((tag) => (
                                        <span class="text-[10px] font-mono text-zinc-400 border border-zinc-700 px-2 py-1 uppercase">
                                            {tag}
                                        </span>
                                    ))}
                                </div>
                            </div>

                            <div class="translate-y-[20px] group-hover:translate-y-0 transition-transform duration-500">
                                <h3 class="text-4xl font-black uppercase tracking-tighter text-white mb-2">
                                    {project.title}
                                </h3>
                                <p class="text-zinc-400 font-medium tracking-tight mb-8 max-w-sm">
                                    {project.description}
                                </p>
                                <button class="px-0 flex items-center gap-4 group/btn text-white hover:text-white">
                                    <span class="uppercase font-mono text-xs tracking-widest font-bold">
                                        Ver Estudo
                                    </span>
                                    <Icon
                                        name="lucide:arrow-right"
                                        class="size-4 group-hover/btn:translate-x-2 transition-transform"
                                    />
                                </button>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>

        <div class="mt-20 flex justify-center">
            <button
                class="px-20 py-6 border-2 border-zinc-800 font-black uppercase tracking-[0.2em] text-xs rounded-none hover:bg-zinc-900 transition-colors text-white"
            >
                Ver Todos os Projetos
            </button>
        </div>
    </div>
</section>
