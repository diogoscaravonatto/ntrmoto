---
const clients = [
    "Google",
    "Spotify",
    "Linear",
    "Vercel",
    "Airbnb",
    "Nike",
    "Stripe",
    "Figma",
    "Slack",
];
---

<section
    class="py-24 border-y border-zinc-800 overflow-hidden relative bg-zinc-950"
>
    <div
        class="absolute inset-y-0 left-0 w-32 bg-linear-to-r from-zinc-950 to-transparent z-10"
    >
    </div>
    <div
        class="absolute inset-y-0 right-0 w-32 bg-linear-to-l from-zinc-950 to-transparent z-10"
    >
    </div>

    <div class="flex whitespace-nowrap gap-16 animate-marquee items-center">
        {
            Array.from({ length: 2 }).map(() =>
                clients.map((client) => (
                    <span class="text-4xl md:text-6xl font-black uppercase tracking-[0.2em] text-zinc-800 hover:text-white transition-colors cursor-default px-8">
                        {client}
                    </span>
                )),
            )
        }
    </div>
</section>

<style>
    @keyframes marquee {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }

    .animate-marquee {
        animation: marquee 30s linear infinite;
    }
</style>
