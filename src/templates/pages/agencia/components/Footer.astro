---
import Icon from "@components/Icon.astro";

const linkGroups = [
    {
        title: "Explorar",
        links: [
            { id: 1, label: "Projetos", href: "/templates/agencia#trabalhos" },
            { id: 2, label: "Expertise", href: "/templates/agencia#expertise" },
            { id: 3, label: "Agência", href: "/templates/agencia#manifesto" },
        ],
    },
    {
        title: "Social",
        links: [
            { id: 1, label: "Instagram", href: "#" },
            { id: 2, label: "Behance", href: "#" },
            { id: 3, label: "Dribbble", href: "#" },
        ],
    },
    {
        title: "Escritório",
        links: [
            { id: 1, label: "São Paulo", href: "#" },
            { id: 2, label: "Lisboa", href: "#" },
            { id: 3, label: "New York", href: "#" },
        ],
    },
];
---

<footer class="py-20 bg-black text-zinc-500 border-t border-zinc-900">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-20">
            <div class="md:col-span-4 flex flex-col gap-10">
                <div
                    class="text-3xl font-black tracking-tighter uppercase text-white"
                >
                    Agência<span class="text-zinc-600">.Visionária</span>
                </div>
                <p class="max-w-xs leading-relaxed text-sm">
                    Projetando o futuro da experiência digital, um pixel por
                    vez. A estética é nossa bússola, a performance nossa
                    promessa.
                </p>
                <div class="flex gap-4">
                    <button
                        class="rounded-full size-10 flex items-center justify-center border border-zinc-900 hover:bg-zinc-900 transition-colors text-white"
                    >
                        <Icon name="simple-icons:instagram" class="size-5" />
                    </button>
                    <button
                        class="rounded-full size-10 flex items-center justify-center border border-zinc-900 hover:bg-zinc-900 transition-colors text-white"
                    >
                        <Icon name="simple-icons:x" class="size-5" />
                    </button>
                    <button
                        class="rounded-full size-10 flex items-center justify-center border border-zinc-900 hover:bg-zinc-900 transition-colors text-white"
                    >
                        <Icon name="simple-icons:linkedin" class="size-5" />
                    </button>
                </div>
            </div>

            <div
                class="md:col-span-8 grid grid-cols-2 sm:grid-cols-3 gap-12 text-zinc-500"
            >
                {
                    linkGroups.map((group) => (
                        <div class="flex flex-col gap-6">
                            <span class="text-[10px] font-mono font-black uppercase tracking-[0.3em] text-zinc-700">
                                {group.title}
                            </span>
                            <ul class="flex flex-col gap-4">
                                {group.links.map((link) => (
                                    <li>
                                        <a
                                            href={link.href}
                                            class="text-xs font-bold uppercase tracking-widest hover:text-white transition-colors"
                                        >
                                            {link.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>

        <div
            class="mt-32 pt-10 border-t border-zinc-900 flex flex-col md:flex-row justify-between items-center gap-6"
        >
            <span
                class="text-[10px] font-mono uppercase tracking-widest leading-none"
            >
                © 2024 AGÊNCIA VISIONÁRIA. TODOS OS DIREITOS RESERVADOS.
            </span>
            <div
                class="flex gap-10 text-[10px] font-mono uppercase tracking-widest font-bold"
            >
                <a href="#privacy" class="hover:text-white transition-colors"
                    >Privacidade</a
                >
                <a href="#terms" class="hover:text-white transition-colors"
                    >Termos</a
                >
                <a href="#cookies" class="hover:text-white transition-colors"
                    >Cookies</a
                >
            </div>
        </div>
    </div>
</footer>
