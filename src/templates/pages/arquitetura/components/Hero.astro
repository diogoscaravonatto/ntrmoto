---
import { Image } from "astro:assets";
---

<!-- LUXURY HERO SECTION -->
<section
    class="relative min-h-screen bg-[#fdfdfb] flex items-center justify-center overflow-hidden px-8 md:px-16"
>
    <!-- Immersive Background Image -->
    <div class="absolute inset-0 z-0">
        <img
            src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80"
            alt="Arquitetura de Alto Padrão"
            width="1920"
            height="1080"
            class="w-full h-full object-cover opacity-60 scale-105"
            loading="eager"
            fetchpriority="high"
        />
        <div
            class="absolute inset-0 bg-linear-to-t from-[#fdfdfb] via-transparent to-transparent"
        >
        </div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
        <div class="mb-12 animate-fade-in">
            <span
                class="text-[10px] tracking-[0.5em] uppercase font-bold text-zinc-600 block mb-6 px-4"
                >Estúdio de Arquitetura & Design</span
            >
            <div class="aspect-4/5 overflow-hidden"></div>
        </div>

        <h1
            class="text-[clamp(3.5rem,10vw,8rem)] font-serif leading-[0.9] tracking-tighter text-[#1c1c1c] mb-16 animate-title-reveal italic"
        >
            Silêncio é a <br />
            <span class="not-italic">nova forma de luxo.</span>
        </h1>

        <div
            class="flex flex-col md:flex-row gap-8 justify-center items-center animate-fade-in-up"
        >
            <button
                class="px-12 py-5 bg-[#1c1c1c] text-white text-[10px] tracking-[0.4em] uppercase font-bold hover:bg-[#333] transition-all hover:scale-105 active:scale-95 shadow-2xl"
            >
                Ver Projetos
            </button>
            <button
                class="px-12 py-5 border border-[#1c1c1c]/20 text-[#1c1c1c] text-[10px] tracking-[0.4em] uppercase font-bold hover:bg-white transition-all"
            >
                Manifesto do Studio
            </button>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div
        class="absolute bottom-12 left-1/2 -translate-x-1/2 flex items-center flex-col gap-6 opacity-40"
    >
        <div class="h-16 w-px bg-zinc-900 animate-pulse"></div>
        <span
            class="text-[9px] tracking-[0.6em] uppercase font-bold rotate-90 origin-left translate-x-1 translate-y-2"
            >Scroll</span
        >
    </div>
</section>

<style>
    @keyframes titleReveal {
        from {
            opacity: 0;
            transform: translateY(40px) skewY(2deg);
        }
        to {
            opacity: 1;
            transform: translateY(0) skewY(0);
        }
    }
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-title-reveal {
        animation: titleReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .animate-fade-in {
        animation: fadeInUp 1s ease-out forwards;
    }
    .animate-fade-in-up {
        animation: fadeInUp 1s ease-out 0.4s forwards;
        opacity: 0;
    }
</style>
