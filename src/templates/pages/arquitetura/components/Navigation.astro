---

---

<nav
    class="fixed top-0 left-0 w-full z-50 px-8 py-8 md:px-16 md:py-12 flex justify-between items-center transition-all duration-700 pointer-events-none"
    id="luxury-nav"
>
    <!-- Logo -->
    <div class="pointer-events-auto">
        <a
            href="#"
            class="text-xl md:text-2xl font-serif tracking-tighter text-[#1c1c1c] group"
        >
            Architectural <span
                class="group-hover:italic transition-all duration-500"
                >Studio</span
            >
        </a>
    </div>

    <!-- Navigation Menu (Minimal) -->
    <div class="hidden lg:flex gap-16 pointer-events-auto">
        {
            ["Projetos", "Manifesto", "Escritório", "Contato"].map((item) => (
                <a
                    href="#"
                    class="text-[9px] tracking-[0.6em] uppercase font-black text-zinc-400 hover:text-zinc-900 transition-colors relative group"
                >
                    {item}
                    <span class="absolute -bottom-2 left-0 w-0 h-px bg-zinc-900 transition-all duration-500 group-hover:w-full" />
                </a>
            ))
        }
    </div>

    <!-- Actions -->
    <div class="pointer-events-auto flex items-center gap-12">
        <div class="hidden sm:flex flex-col items-end gap-1">
            <span
                class="text-[8px] tracking-[0.4em] uppercase font-bold text-zinc-300"
                >Portfólio 2026</span
            >
            <div class="h-px w-12 bg-zinc-200"></div>
        </div>
        <button
            class="w-10 h-10 flex flex-col justify-center items-center gap-2 group cursor-pointer bg-white shadow-xl rounded-full lg:bg-transparent lg:shadow-none lg:rounded-none"
        >
            <div class="w-6 h-px bg-zinc-900 group-hover:w-8 transition-all">
            </div>
            <div
                class="w-6 h-px bg-zinc-900 group-hover:w-4 transition-all self-end"
            >
            </div>
        </button>
    </div>
</nav>

<script>
    const nav = document.getElementById("luxury-nav");
    window.addEventListener("scroll", () => {
        if (!nav) return;
        if (window.scrollY > 100) {
            nav.classList.add(
                "bg-white/80",
                "backdrop-blur-xl",
                "py-6",
                "md:py-8",
                "shadow-sm",
                "border-b",
                "border-zinc-100",
            );
            nav.classList.remove("py-8", "md:py-12");
        } else {
            nav.classList.remove(
                "bg-white/80",
                "backdrop-blur-xl",
                "py-6",
                "md:py-8",
                "shadow-sm",
                "border-b",
                "border-zinc-100",
            );
            nav.classList.add("py-8", "md:py-12");
        }
    });
</script>
