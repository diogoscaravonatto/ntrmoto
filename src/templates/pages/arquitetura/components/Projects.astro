---
import { Image } from "astro:assets";
---

<!-- LUXURY PROJECTS GALLERY -->
<section class="py-40 bg-white px-8 md:px-16" id="projects">
    <div class="max-w-[1600px] mx-auto">
        <!-- Section Title with Editorial look -->
        <div class="flex flex-col md:flex-row justify-between items-baseline mb-40">
            <div class="max-w-2xl">
                <span class="text-[10px] tracking-[0.5em] uppercase font-bold text-zinc-400 block mb-6">Arquitetura Selecionada / Obras</span>
                <h2 class="text-6xl md:text-9xl font-serif italic tracking-tighter leading-none mb-4">Portfólio.</h2>
                <div class="h-2 w-48 bg-zinc-900 mt-8 mb-12"></div>
            </div>
            <div class="text-right hidden lg:block">
                <div class="text-4xl font-serif text-zinc-300 italic mb-4">(2020 — 2026)</div>
                <div class="text-[10px] tracking-[0.2em] uppercase font-bold text-zinc-400">Curadoria de Excelência</div>
            </div>
        </div>

        <!-- Vertical High-End List -->
        <div class="space-y-48">
            {[
                {
                    title: "Pavilhão de Vidro e Luz",
                    location: "Curitiba, PR",
                    area: "420m²",
                    year: "2025",
                    image: "https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1600&q=80",
                    description: "Uma imersão na transparência, onde a estrutura metálica fina desaparece na paisagem."
                },
                {
                    title: "Residência Bruta",
                    location: "Brasília, DF",
                    area: "650m²",
                    year: "2024",
                    image: "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1600&q=80",
                    description: "Concreto aparente e madeira em uma dança de peso e leveza."
                },
                {
                    title: "Nexus Headquarters",
                    location: "São Paulo, SP",
                    area: "2.400m²",
                    year: "2026",
                    image: "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1600&q=80",
                    description: "A arquitetura como ferramenta de inovação corporativa."
                }
            ].map((project, index) => (
                <div class="group grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
                    <div class:list={['lg:col-span-12 xl:col-span-8 relative', { 'xl:order-2': index % 2 !== 0 }]}>
                        <div class="aspect-16/10 overflow-hidden bg-zinc-100">
                            <img 
                                src={`${project.image}&auto=format&fit=crop&w=1600&q=80`}
                                alt={project.title}
                                width="1600"
                                height="1000"
                                class="w-full h-full object-cover transition-all duration-1000 group-hover:scale-105"
                                loading="lazy"
                            />
                        </div>
                        <!-- Number Accent -->
                        <div class="absolute -top-12 -left-12 text-[10vw] font-serif italic text-zinc-100/50 -z-10 group-hover:text-zinc-200 transition-colors pointer-events-none">
                            {index + 1}
                        </div>
                    </div>
                    
                    <div class:list={['lg:col-span-12 xl:col-span-4 space-y-8', { 'xl:order-1 lg:text-right': index % 2 !== 0 }]}>
                        <div class="space-y-4">
                            <h3 class="text-4xl md:text-5xl font-serif tracking-tight text-[#1c1c1c] group-hover:italic transition-all duration-500">{project.title}</h3>
                            <p class="text-zinc-400 font-light text-lg italic leading-relaxed">{project.description}</p>
                        </div>
                        
                        <div class:list={['flex flex-wrap gap-x-8 gap-y-4 text-[10px] tracking-[0.3em] font-bold uppercase text-zinc-400', { 'justify-end': index % 2 !== 0 }]}>
                            <span>{project.location}</span>
                            <span>{project.area}</span>
                            <span>{project.year}</span>
                        </div>

                        <div class="pt-8 group/btn cursor-pointer inline-block">
                            <span class="text-[10px] font-bold tracking-[0.5em] uppercase border-b border-zinc-900 pb-2 group-hover/btn:pr-8 transition-all">Ver Detalhes</span>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
