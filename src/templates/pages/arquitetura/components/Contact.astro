---

---

<section
    class="py-40 bg-[#1c1c1c] text-white px-8 md:px-16 overflow-hidden"
    id="contact"
>
    <div class="max-w-[1400px] mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-32 items-start">
            <!-- Left Header -->
            <div class="lg:col-span-12 xl:col-span-5">
                <div class="space-y-12">
                    <div class="space-y-6">
                        <span
                            class="text-[10px] tracking-[0.5em] uppercase font-bold text-zinc-500"
                            >Inicie um Diálogo</span
                        >
                        <h3
                            class="text-6xl md:text-8xl font-serif italic tracking-tighter leading-[0.9]"
                        >
                            Vamos criar algo <br />
                            <span class="not-italic text-white">atemporal.</span
                            >
                        </h3>
                    </div>

                    <p
                        class="text-xl text-zinc-400 font-light leading-relaxed max-w-sm"
                    >
                        Estamos prontos para transformar sua visão em uma
                        realidade arquitetônica suprema. Agende uma reunião
                        presencial em nosso studio.
                    </p>

                    <div
                        class="grid grid-cols-1 md:grid-cols-2 gap-12 pt-12 border-t border-zinc-800"
                    >
                        <div>
                            <div
                                class="text-[10px] tracking-[0.3em] uppercase font-bold text-zinc-500 mb-6"
                            >
                                Localização
                            </div>
                            <address
                                class="not-italic text-lg font-light text-zinc-400 space-y-2"
                            >
                                <p>Av. Europa, 1200</p>
                                <p>Jardins, São Paulo — SP</p>
                            </address>
                        </div>
                        <div>
                            <div
                                class="text-[10px] tracking-[0.3em] uppercase font-bold text-zinc-500 mb-6"
                            >
                                Digital
                            </div>
                            <div
                                class="text-lg font-light text-zinc-400 space-y-2"
                            >
                                <p>ola@estudioarquitetura.com</p>
                                <p>+55 11 98765 4321</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Form - REFINED LUXURY MINIMAL -->
            <div
                class="lg:col-span-12 xl:col-span-7 bg-[#212121] p-12 md:p-20 shadow-[0_50px_100px_-20px_rgba(0,0,0,0.5)] relative border border-white/5"
            >
                <div
                    class="absolute top-0 right-0 w-64 h-64 bg-white/5 blur-[120px] -z-10"
                >
                </div>

                <form class="space-y-12">
                    <!-- Nome -->
                    <div
                        class="group border-b border-zinc-800 focus-within:border-zinc-400 transition-all duration-500 pb-4"
                    >
                        <label
                            class="block text-[9px] tracking-[0.5em] uppercase font-bold text-zinc-400 mb-4 group-focus-within:text-white transition-colors"
                            >Seu Nome</label
                        >
                        <input
                            type="text"
                            name="name"
                            placeholder="Nome completo"
                            class="w-full bg-transparent border-none p-0 text-2xl font-serif italic text-white placeholder-zinc-800 focus:outline-none focus:ring-0 focus:placeholder-zinc-700 transition-all"
                        />
                    </div>

                    <!-- Grid: Email e Telefone -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
                        <div
                            class="group border-b border-zinc-800 focus-within:border-zinc-400 transition-all duration-500 pb-4"
                        >
                            <label
                                class="block text-[9px] tracking-[0.5em] uppercase font-bold text-zinc-400 mb-4 group-focus-within:text-white transition-colors"
                                >Email Corporativo</label
                            >
                            <input
                                type="email"
                                name="email"
                                placeholder="email@exemplo.com"
                                class="w-full bg-transparent border-none p-0 text-xl font-serif italic text-white placeholder-zinc-800 focus:outline-none focus:ring-0 focus:placeholder-zinc-700 transition-all"
                            />
                        </div>
                        <div
                            class="group border-b border-zinc-800 focus-within:border-zinc-400 transition-all duration-500 pb-4"
                        >
                            <label
                                class="block text-[9px] tracking-[0.5em] uppercase font-bold text-zinc-400 mb-4 group-focus-within:text-white transition-colors"
                                >Telefone direto</label
                            >
                            <input
                                type="tel"
                                name="phone"
                                placeholder="+55 11 0000-0000"
                                class="w-full bg-transparent border-none p-0 text-xl font-serif italic text-white placeholder-zinc-800 focus:outline-none focus:ring-0 focus:placeholder-zinc-700 transition-all"
                            />
                        </div>
                    </div>

                    <!-- Mensagem -->
                    <div
                        class="group border-b border-zinc-800 focus-within:border-zinc-400 transition-all duration-500 pb-4"
                    >
                        <label
                            class="block text-[9px] tracking-[0.5em] uppercase font-bold text-zinc-400 mb-4 group-focus-within:text-white transition-colors"
                            >Sobre o Projeto</label
                        >
                        <textarea
                            name="message"
                            rows="3"
                            placeholder="Conte-nos sua visão..."
                            class="w-full bg-transparent border-none p-0 text-xl font-serif italic text-white placeholder-zinc-800 focus:outline-none focus:ring-0 focus:placeholder-zinc-700 transition-all resize-none"
                        ></textarea>
                    </div>

                    <!-- Botão -->
                    <div class="pt-12">
                        <button
                            type="submit"
                            class="group flex items-center gap-8 text-[11px] tracking-[0.7em] uppercase font-black text-white hover:text-zinc-400 transition-all duration-500"
                        >
                            Enviar Solicitação
                            <span
                                class="w-16 h-[2px] bg-white group-hover:w-24 group-hover:bg-zinc-400 transition-all duration-700"
                            ></span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<style>
    /* Prevent default browser styles */
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus,
    textarea:-webkit-autofill,
    textarea:-webkit-autofill:hover,
    textarea:-webkit-autofill:focus {
        -webkit-text-fill-color: white;
        -webkit-box-shadow: 0 0 0px 1000px #212121 inset;
        transition: background-color 5000s ease-in-out 0s;
    }
</style>
