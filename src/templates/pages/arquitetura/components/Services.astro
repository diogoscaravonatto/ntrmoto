---

---

<section class="py-40 bg-[#fbfbf9] px-8 md:px-16" id="services">
    <div class="max-w-[1600px] mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-32">
            <!-- Left Info -->
            <div class="lg:col-span-5">
                <div class="sticky top-40 space-y-12">
                    <div class="space-y-6">
                        <span
                            class="text-[10px] tracking-[0.5em] uppercase font-bold text-zinc-400"
                            >Nossa Prática / Disciplinas</span
                        >
                        <h3
                            class="text-5xl md:text-7xl font-serif italic text-zinc-900 tracking-tight leading-[1.1]"
                        >
                            Onde a precisão técnica <br /> encontra a <span
                                class="not-italic">poesia.</span
                            >
                        </h3>
                    </div>
                    <p
                        class="text-zinc-500 font-light text-xl leading-relaxed max-w-md"
                    >
                        De residências privadas a complexos corporativos, nossa
                        abordagem é pautada pelo rigor e pela busca inabalável
                        por soluções arquitetônicas atemporais.
                    </p>
                    <!-- Small stats or details -->
                    <div
                        class="grid grid-cols-2 gap-12 pt-12 border-t border-zinc-100"
                    >
                        <div>
                            <span class="block text-3xl font-serif italic mb-2"
                                >120+</span
                            >
                            <span
                                class="text-[9px] tracking-widest uppercase font-bold text-zinc-400"
                                >Projetos Executados</span
                            >
                        </div>
                        <div>
                            <span class="block text-3xl font-serif italic mb-2"
                                >12</span
                            >
                            <span
                                class="text-[9px] tracking-widest uppercase font-bold text-zinc-400"
                                >Prêmios Internacionais</span
                            >
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Services List -->
            <div class="lg:col-span-7">
                <div class="divide-y divide-zinc-100">
                    {
                        [
                            {
                                title: "Arquitetura Residencial de Luxo",
                                desc: "Criação de refúgios únicos que refletem a individualidade Suprema, priorizando o equilíbrio entre volume e luz natural.",
                                details: [
                                    "Residências Unifamiliares",
                                    "Design de Interiores Curado",
                                    "Paisagismo Integrado",
                                ],
                            },
                            {
                                title: "Espaços Corporativos & Culturais",
                                desc: "Ambientes que potencializam a criatividade e o bem-estar, projetados como marcos arquitetônicos urbanos.",
                                details: [
                                    "Sedes Administrativas",
                                    "Galerias e Museus",
                                    "Showrooms Conceito",
                                ],
                            },
                            {
                                title: "Gestão e Consultoria Técnica",
                                desc: "Acompanhamento rigoroso para garantir que o projeto seja entregue com fidelidade absoluta ao design original.",
                                details: [
                                    "Supervisão de Obra",
                                    "Viabilidade Técnica",
                                    "Curadoria de Materiais",
                                ],
                            },
                        ].map((service, index) => (
                            <div class="group py-20 first:pt-0">
                                <div class="flex justify-between items-start mb-8">
                                    <span class="text-[10px] tracking-[0.4em] font-bold text-zinc-200 group-hover:text-zinc-900 transition-colors">
                                        0{index + 1}
                                    </span>
                                    <div class="w-12 h-12 rounded-full border border-zinc-100 flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:bg-zinc-900 group-hover:text-white transition-all duration-700">
                                        <svg
                                            class="w-4 h-4"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M14 5l7 7m0 0l-7 7m7-7H3"
                                            />
                                        </svg>
                                    </div>
                                </div>
                                <h4 class="text-3xl md:text-4xl font-serif text-zinc-900 mb-8 transition-all group-hover:italic">
                                    {service.title}
                                </h4>
                                <p class="text-zinc-500 font-light text-lg leading-relaxed mb-12 max-w-xl">
                                    {service.desc}
                                </p>
                                <div class="flex flex-wrap gap-4">
                                    {service.details.map((detail) => (
                                        <span class="px-4 py-2 bg-white border border-zinc-100 text-[9px] tracking-widest uppercase font-bold text-zinc-400 group-hover:border-zinc-200 transition-colors">
                                            {detail}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>
