---
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";
import diferenciaisImg from "../../../../assets/images/templates/pet/diferenciais.png";

const features = [
    "Ambiente 100% monitorado por câmeras",
    "Profissionais certificados e apaixonados",
    "Área de lazer ao ar livre",
    "Atendimento veterinário 24h",
    "Transporte Pet Táxi climatizado",
];
---

<section id="diferenciais" class="py-24 bg-[#FFFDF7] overflow-hidden">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex flex-col md:flex-row items-center gap-16">
            <!-- Image Composition -->
            <div class="md:w-1/2 relative">
                <div
                    class="relative z-10 rounded-[3rem] overflow-hidden border-[10px] border-white shadow-2xl skew-y-1"
                >
                    <Image
                        src={diferenciaisImg}
                        alt="Veterinária examinando cão"
                        class="w-full h-auto object-cover"
                        widths={[400, 800]}
                        sizes="(max-width: 768px) 100vw, 800px"
                        format="webp"
                    />
                </div>
                <!-- Decorative Blob -->
                <div
                    class="absolute -bottom-10 -left-10 w-full h-full bg-orange-100 rounded-[3rem] -z-10 rotate-3 animate-pulse"
                >
                </div>
            </div>

            <!-- Content -->
            <div class="md:w-1/2">
                <div
                    class="inline-block bg-orange-100 text-orange-600 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-6 leading-none"
                >
                    Por que nos escolher?
                </div>
                <h2
                    class="text-4xl md:text-5xl font-display font-bold text-slate-800 mb-6 leading-tight tracking-tight"
                >
                    Seu pet em boas mãos, <br />
                    <span class="text-orange-500">sempre.</span>
                </h2>
                <p class="text-slate-500 text-lg mb-8 leading-relaxed">
                    Entendemos que deixar seu pet sob cuidados de terceiros
                    exige confiança. Por isso, construímos uma estrutura
                    transparente e segura.
                </p>

                <ul class="space-y-4">
                    {
                        features.map((feature) => (
                            <li class="flex items-center gap-4 group">
                                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-orange-100 flex items-center justify-center group-hover:bg-orange-500 transition-colors duration-300">
                                    <Icon
                                        name="lucide:check"
                                        class="w-5 h-5 text-orange-600 group-hover:text-white transition-colors"
                                    />
                                </div>
                                <span class="text-slate-700 font-bold text-lg">
                                    {feature}
                                </span>
                            </li>
                        ))
                    }
                </ul>

                <div class="mt-10">
                    <a
                        href="#contato"
                        class="bg-orange-600/10 text-orange-600 rounded-full px-8 py-4 font-bold hover:bg-orange-600 hover:text-white transition-all inline-flex items-center gap-2"
                    >
                        Conheça nossa estrutura
                        <Icon name="lucide:arrow-right" class="w-5 h-5" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
