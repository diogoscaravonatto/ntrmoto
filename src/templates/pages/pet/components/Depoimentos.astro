---
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";

const testimonials = [
  {
    text: "A equipe da PetLove salvou a vida do Thor. Nunca vi tanto carinho e dedicação em uma clínica. Sou eternamente grata!",
    author: "Maria Oliveira",
    pet: "Thor (Golden Retriever)",
    image: "https://i.pravatar.cc/100?img=5",
    bg: "bg-blue-50 border-blue-100",
  },
  {
    text: "O banho e tosa é impecável. A Mel sai cheirosa e super feliz, sem aquele trauma de pet shop comum.",
    author: "Carlos Santos",
    pet: "Mel (Shih Tzu)",
    image: "https://i.pravatar.cc/100?img=11",
    bg: "bg-pink-50 border-pink-100",
  },
  {
    text: "Deixo o Bob no hotelzinho sempre que viajo. Recebo fotos e vídeos o dia todo, viajo tranquilo sabendo que ele está bem.",
    author: "Ana Costa",
    pet: "Bob (Vira-lata)",
    image: "https://i.pravatar.cc/100?img=9",
    bg: "bg-orange-50 border-orange-100",
  },
]
---

<section id="depoimentos" class="py-24 bg-white relative">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-display font-bold text-slate-800 mb-4 uppercase tracking-tighter">Histórias Felizes</h2>
        <div class="w-24 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
        <p class="text-slate-500 max-w-2xl mx-auto font-medium">
          Veja o que os tutores dizem sobre a experiência na PetLove.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {testimonials.map((item) => (
          <div
            class:list={[item.bg, 'border p-8 rounded-4xl relative hover:-translate-y-2 transition-all duration-300 shadow-sm']}
          >
            <!-- Quote Icon -->
            <div class="absolute top-6 right-8 text-6xl opacity-10 font-serif text-orange-800 pointer-events-none">"</div>

            <div class="flex items-center gap-4 mb-6 relative z-10">
              <img src={item.image} alt={item.author} width="100" height="100" loading="lazy" class="w-12 h-12 rounded-full border-2 border-white shadow-sm object-cover" />
              <div>
                <h4 class="font-bold text-slate-800 text-sm">{item.author}</h4>
                <p class="text-xs text-slate-500 font-medium">{item.pet}</p>
              </div>
            </div>

            <p class="text-slate-600 italic leading-relaxed relative z-10">
              "{item.text}"
            </p>

            <div class="mt-6 flex text-amber-500 gap-0.5 relative z-10">
              {[1, 2, 3, 4, 5].map(() => (
                <Icon name="lucide:star" class="w-4 h-4 fill-current" />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
</section>
