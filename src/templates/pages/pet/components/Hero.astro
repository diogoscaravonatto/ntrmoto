---
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";
import heroImage from "../../../../assets/images/templates/pet/hero.png";
---

<section class="pt-20 pb-32 md:pt-32 relative overflow-hidden">
    <!-- Blobs Background -->
    <div
        class="absolute top-0 right-0 -translate-y-1/4 translate-x-1/4 w-[800px] h-[800px] bg-orange-100/50 rounded-full blur-3xl -z-10"
    >
    </div>
    <div
        class="absolute bottom-0 left-0 translate-y-1/4 -translate-x-1/4 w-[600px] h-[600px] bg-neutral-100/50 rounded-full blur-3xl -z-10"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4">
        <div class="flex flex-col md:flex-row items-center gap-12 md:gap-20">
            <!-- Content -->
            <div class="md:w-1/2 flex flex-col items-start gap-6">
                <div
                    class="inline-flex items-center gap-3 bg-white px-4 py-2 rounded-full shadow-sm border border-slate-100 animate-bounce-slow"
                >
                    <span class="text-xl">🐶</span>
                    <span class="text-sm font-bold text-slate-600"
                        >Amor em primeiro lugar</span
                    >
                </div>

                <h1
                    class="text-5xl md:text-7xl font-display font-bold text-slate-800 leading-[1.1] tracking-tight"
                >
                    Cuidado que faz o <span
                        class="text-orange-500 relative whitespace-nowrap"
                    >
                        coração
                        <svg
                            class="absolute -bottom-2 left-0 w-full h-3 text-orange-200 -z-10"
                            viewBox="0 0 100 10"
                            preserveAspectRatio="none"
                        >
                            <path
                                d="M0 5 Q 50 10 100 5"
                                stroke="currentColor"
                                stroke-width="8"
                                fill="none"></path>
                        </svg>
                    </span> bater mais forte.
                </h1>

                <p
                    class="text-xl text-slate-500 font-medium leading-relaxed max-w-lg"
                >
                    Somos um centro completo de bem-estar animal. Clínica, Spa e
                    Hotel com profissionais que amam o que fazem.
                </p>

                <div
                    class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto mt-4"
                >
                    <a
                        href="#servicos"
                        class="bg-orange-600 text-white rounded-full px-10 py-4 font-bold shadow-lg shadow-orange-200/50 hover:scale-105 transition-transform text-center"
                    >
                        Conhecer Serviços
                    </a>
                    <a
                        href="#contato"
                        class="bg-white text-slate-600 border border-slate-200 rounded-full px-10 py-4 font-bold hover:bg-slate-50 transition-colors shadow-sm text-center flex items-center justify-center gap-2"
                    >
                        <Icon name="lucide:phone" class="w-5 h-5" />
                        Falar com Vet
                    </a>
                </div>

                <div
                    class="flex items-center gap-4 mt-6 text-sm font-bold text-slate-500"
                >
                    <div class="flex -space-x-3">
                        <img
                            class="w-10 h-10 rounded-full border-2 border-white object-cover"
                            src="https://i.pravatar.cc/100?img=1"
                            alt="Avatar"
                            width="100"
                            height="100"
                            loading="eager"
                        />
                        <img
                            class="w-10 h-10 rounded-full border-2 border-white object-cover"
                            src="https://i.pravatar.cc/100?img=5"
                            alt="Avatar"
                            width="100"
                            height="100"
                            loading="eager"
                        />
                        <img
                            class="w-10 h-10 rounded-full border-2 border-white object-cover"
                            src="https://i.pravatar.cc/100?img=8"
                            alt="Avatar"
                            width="100"
                            height="100"
                            loading="eager"
                        />
                    </div>
                    <p>+2.000 pets felizes</p>
                </div>
            </div>

            <!-- Image -->
            <div class="md:w-1/2 relative mt-12 md:mt-0">
                <div
                    class="relative z-10 rounded-6xl overflow-hidden rotate-2 hover:rotate-0 transition-transform duration-500 shadow-2xl shadow-neutral-900/10 border-8 border-white"
                >
                    <Image
                        src={heroImage}
                        alt="Cachorro e Gato Felizes"
                        class="w-full h-auto object-cover"
                        widths={[400, 800, 1200]}
                        sizes="(max-width: 768px) 100vw, 800px"
                        loading="eager"
                        fetchpriority="high"
                        format="webp"
                    />
                </div>

                <!-- Decorative Elements -->
                <div
                    class="absolute -top-12 -right-12 z-0 animate-spin-slow opacity-30"
                >
                    <Icon
                        name="lucide:flower-2"
                        class="w-24 h-24 text-orange-200"
                    />
                </div>
                <div
                    class="absolute -bottom-8 -left-8 z-20 bg-white p-4 rounded-2xl shadow-xl animate-float border border-slate-50"
                >
                    <div class="flex items-center gap-3">
                        <div class="bg-green-100 p-2 rounded-full">
                            <Icon
                                name="lucide:check"
                                class="w-5 h-5 text-green-600"
                            />
                        </div>
                        <div>
                            <p
                                class="text-[10px] text-slate-400 font-bold uppercase tracking-widest"
                            >
                                Status
                            </p>
                            <p class="font-bold text-slate-700 text-sm">
                                Aberto Agora
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .animate-bounce-slow {
        animation: bounce-custom 3s infinite;
    }
    .animate-spin-slow {
        animation: spin-custom 10s linear infinite;
    }
    .animate-float {
        animation: float-custom 6s ease-in-out infinite;
    }

    @keyframes bounce-custom {
        0%,
        100% {
            transform: translateY(-5%);
            animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
        }
        50% {
            transform: none;
            animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
        }
    }
    @keyframes spin-custom {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
    @keyframes float-custom {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }
</style>
