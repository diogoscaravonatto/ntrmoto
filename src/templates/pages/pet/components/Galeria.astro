---
import { Image } from "astro:assets";
import galeria1 from "../../../../assets/images/templates/pet/galeria-1.png";
import galeria2 from "../../../../assets/images/templates/pet/galeria-2.png";
import galeria3 from "../../../../assets/images/templates/pet/galeria-3.png";
import heroImage from "../../../../assets/images/templates/pet/hero.png";

const images = [galeria1, galeria2, galeria3, heroImage];
---

<section id="galeria" class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-16">
            <div
                class="inline-block bg-orange-100 text-orange-600 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-4 leading-none"
            >
                Nossa Estrutura
            </div>
            <h2
                class="text-4xl md:text-5xl font-display font-bold text-slate-800 mb-4 tracking-tight"
            >
                Um paraíso para seu pet
            </h2>
            <p class="text-slate-500 text-lg max-w-2xl mx-auto">
                Conheça cada detalhe do nosso centro de bem-estar, projetado
                para oferecer o máximo de conforto e segurança.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 h-auto md:h-[600px]">
            <!-- Large Item -->
            <div
                class="md:col-span-2 md:row-span-2 relative group overflow-hidden rounded-4xl shadow-xl aspect-square md:aspect-auto"
            >
                <Image
                    src={images[0]}
                    alt="Suíte Luxo Pet"
                    class="w-full h-full object-cover group-hover:scale-105 transition-all duration-700"
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 100vw, 800px"
                    format="webp"
                    loading="lazy"
                />
                <div
                    class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-8"
                >
                    <span class="text-white font-bold text-2xl"
                        >Suítes de Luxo</span
                    >
                </div>
            </div>

            <!-- Small Items -->
            <div
                class="relative group overflow-hidden rounded-4xl shadow-lg aspect-square md:aspect-auto"
            >
                <Image
                    src={images[1]}
                    alt="Pet Spa"
                    class="w-full h-full object-cover group-hover:scale-105 transition-all duration-700"
                    widths={[300, 600]}
                    sizes="(max-width: 768px) 100vw, 400px"
                    format="webp"
                    loading="lazy"
                />
                <div
                    class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-4"
                >
                    <span class="text-white font-bold text-lg"
                        >Grooming & Spa</span
                    >
                </div>
            </div>
            <div
                class="relative group overflow-hidden rounded-4xl shadow-lg aspect-square md:aspect-auto"
            >
                <Image
                    src={images[2]}
                    alt="Área de Lazer"
                    class="w-full h-full object-cover group-hover:scale-105 transition-all duration-700"
                    widths={[300, 600]}
                    sizes="(max-width: 768px) 100vw, 400px"
                    format="webp"
                    loading="lazy"
                />
                <div
                    class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-4"
                >
                    <span class="text-white font-bold text-lg"
                        >Parque Recreativo</span
                    >
                </div>
            </div>

            <!-- Wide Bottom Item -->
            <div
                class="md:col-span-2 relative group overflow-hidden rounded-4xl shadow-lg aspect-2/1 md:aspect-auto"
            >
                <Image
                    src={images[3]}
                    alt="Recepção"
                    class="w-full h-full object-cover group-hover:scale-105 transition-all duration-700"
                    widths={[400, 800, 1200]}
                    sizes="(max-width: 768px) 100vw, 800px"
                    format="webp"
                    loading="lazy"
                />
                <div
                    class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6"
                >
                    <span class="text-white font-bold text-xl"
                        >Recepção Aconchegante</span
                    >
                </div>
            </div>
        </div>
    </div>
</section>
