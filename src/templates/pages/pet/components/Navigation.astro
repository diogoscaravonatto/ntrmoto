---
import Icon from "@components/Icon.astro";

const links = [
    { label: "Serviços", to: "/templates/pet#servicos" },
    { label: "Sobre Nós", to: "/templates/pet#diferenciais" },
    { label: "Depoimentos", to: "/templates/pet#depoimentos" },
    { label: "Contato", to: "/templates/pet#contato" },
];
---

<nav class="sticky top-4 z-50 mx-4 md:mx-auto max-w-7xl">
    <div
        class="bg-white/80 backdrop-blur-md rounded-full shadow-lg border border-white/50 px-6 py-4 flex items-center justify-between"
    >
        <!-- Logo -->
        <a href="/templates/pet" class="flex items-center gap-2 group">
            <div
                class="bg-orange-100 p-2 rounded-full group-hover:bg-orange-200 transition-colors"
            >
                <Icon name="lucide:paw-print" class="w-6 h-6 text-orange-600" />
            </div>
            <span
                class="text-xl font-display font-bold text-slate-800 tracking-tight"
            >
                Pet<span class="text-orange-500">Love</span>
            </span>
        </a>

        <!-- Desktop Links -->
        <div class="hidden md:flex items-center gap-8">
            {
                links.map((link) => (
                    <a
                        href={link.to}
                        class="font-sans font-bold text-slate-500 hover:text-orange-600 transition-colors"
                    >
                        {link.label}
                    </a>
                ))
            }
        </div>

        <!-- CTA -->
        <div class="hidden md:block">
            <a
                href="/templates/pet#contato"
                class="bg-orange-500 text-white rounded-full px-6 py-2.5 font-bold shadow-md shadow-orange-200 hover:scale-105 transition-transform inline-block"
            >
                Agendar Visita
            </a>
        </div>

        <!-- Mobile Menu Button (SSR placeholder) -->
        <button class="md:hidden p-2 text-slate-500">
            <Icon name="lucide:menu" class="w-6 h-6" />
        </button>
    </div>
</nav>
