---
import Icon from "@components/Icon.astro";

const services = [
    {
        icon: "lucide:stethoscope",
        title: "Clínica Veterinária",
        description:
            "Consultas, vacinas e exames com quem entende e ama o que faz. Equipamentos modernos e ambiente tranquilo.",
        color: "text-blue-500",
        bg: "bg-blue-50",
    },
    {
        icon: "lucide:scissors",
        title: "Banho & Tosa",
        description:
            "Estética animal com produtos hipoalergênicos e profissionais carinhosos. Seu pet limpo e cheiroso.",
        color: "text-pink-500",
        bg: "bg-pink-50",
    },
    {
        icon: "lucide:home",
        title: "Hotelzinho & Day Care",
        description:
            "Hospedagem livre de gaiolas, com monitores 24h e muitas brincadeiras para gastar energia.",
        color: "text-orange-500",
        bg: "bg-orange-50",
    },
    {
        icon: "lucide:shopping-bag",
        title: "Boutique Pet",
        description:
            "Rações super premium, brinquedos educativos e acessórios exclusivos para seu melhor amigo.",
        color: "text-purple-500",
        bg: "bg-purple-50",
    },
];
---

<section id="servicos" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span
                class="text-orange-500 font-bold tracking-wider uppercase text-sm mb-2 block"
                >Nossos Serviços</span
            >
            <h2
                class="text-4xl font-display font-bold text-slate-800 mb-4 tracking-tight"
            >
                Tudo que seu pet precisa em um só lugar
            </h2>
            <p class="text-slate-500 text-lg">
                Facilitamos sua vida reunindo os melhores cuidados com a máxima
                conveniência.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {
                services.map((service) => (
                    <div class="group p-8 rounded-[2rem] border border-slate-100 bg-white shadow-xl shadow-slate-200/50 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
                        <div
                            class:list={[
                                service.bg,
                                "w-16 h-16 rounded-2xl flex items-center justify-center mb-6 transition-transform group-hover:scale-110",
                            ]}
                        >
                            <Icon
                                name={service.icon}
                                class:list={[service.color, "w-8 h-8"]}
                            />
                        </div>

                        <h3 class="text-xl font-display font-bold text-slate-800 mb-3">
                            {service.title}
                        </h3>
                        <p class="text-slate-500 leading-relaxed text-sm font-medium">
                            {service.description}
                        </p>

                        <div class="mt-6">
                            <a
                                href="#"
                                class:list={[
                                    "font-bold group-hover:underline text-sm",
                                    service.color,
                                ]}
                            >
                                Saiba mais
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
