---
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";

const mapImage =
    "https://images.unsplash.com/photo-1524661135-423995f22d0b?q=80&w=2074&auto=format&fit=crop";
---

<section id="contato" class="py-24 bg-[#FFFDF7]">
    <div class="max-w-7xl mx-auto px-4">
        <div
            class="bg-orange-600 rounded-[3rem] overflow-hidden shadow-2xl relative"
        >
            <div class="grid md:grid-cols-2">
                <!-- Contact Form Area -->
                <div class="p-10 md:p-16 text-white relative z-10">
                    <h2 class="text-4xl font-display font-bold mb-6">
                        Agende uma visita
                    </h2>
                    <p class="text-orange-100 mb-8 text-lg leading-relaxed">
                        Venha conhecer nosso espaço e traga seu pet para ganhar
                        um petisco de boas-vindas!
                    </p>

                    <form class="space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <input
                                type="text"
                                placeholder="Seu Nome"
                                class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white placeholder-orange-100 focus:outline-none focus:bg-white/20 transition"
                            />
                            <input
                                type="text"
                                placeholder="Nome do Pet"
                                class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white placeholder-orange-100 focus:outline-none focus:bg-white/20 transition"
                            />
                        </div>
                        <input
                            type="email"
                            placeholder="Seu Email"
                            class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white placeholder-orange-100 focus:outline-none focus:bg-white/20 transition"
                        />
                        <textarea
                            rows="3"
                            placeholder="Como podemos ajudar?"
                            class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white placeholder-orange-100 focus:outline-none focus:bg-white/20 transition resize-none"
                        ></textarea>

                        <button
                            type="button"
                            class="w-full py-4 bg-white text-orange-700 rounded-xl font-bold hover:bg-orange-50 transition-colors shadow-lg"
                        >
                            Enviar Mensagem
                        </button>
                    </form>
                </div>

                <!-- Map/Image Area -->
                <div class="relative h-96 md:h-auto bg-slate-200">
                    <img
                        src={`${mapImage}&w=800&q=80`}
                        alt="Mapa Localização"
                        width="800"
                        height="600"
                        loading="lazy"
                        class="w-full h-full object-cover opacity-80"
                    />
                    <div class="absolute inset-0 bg-orange-900/10"></div>

                    <!-- Pin -->
                    <div
                        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
                    >
                        <div class="relative">
                            <div
                                class="w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-xl animate-bounce"
                            >
                                <Icon
                                    name="lucide:map-pin"
                                    class="w-8 h-8 text-orange-600"
                                />
                            </div>
                            <div
                                class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-8 h-2 bg-black/20 rounded-full blur-sm"
                            >
                            </div>
                        </div>
                    </div>

                    <div
                        class="absolute bottom-8 left-8 right-8 bg-white/90 backdrop-blur rounded-2xl p-6 shadow-lg"
                    >
                        <div class="flex items-start gap-4">
                            <Icon
                                name="lucide:navigation"
                                class="w-6 h-6 text-orange-600 mt-1"
                            />
                            <div>
                                <h4 class="font-bold text-slate-800">
                                    PetLove Center
                                </h4>
                                <p class="text-slate-500 text-sm">
                                    Rua dos Bichinhos, 123 - Jardins, SP
                                </p>
                                <p class="text-slate-500 text-sm mt-1">
                                    Seg a Sáb: 08h às 20h
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
