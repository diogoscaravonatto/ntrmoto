<footer class="bg-white py-12 px-6 border-t border-gray-100">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="text-xl font-bold tracking-tighter text-black">POCKET.</div>
        
        <div class="flex gap-8 text-sm text-gray-500 font-medium">
            <a href="#" class="hover:text-black transition-colors">Shop</a>
            <a href="#" class="hover:text-black transition-colors">About</a>
            <a href="#" class="hover:text-black transition-colors">Journal</a>
            <a href="#" class="hover:text-black transition-colors">Contact</a>
        </div>

        <div class="flex gap-4">
             {["instagram", "twitter", "facebook"].map(social => (
                 <a href="#" class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-900 hover:bg-black hover:text-white transition-all">
                     <span class="sr-only">{social}</span>
                     <div class="w-4 h-4 bg-current opacity-50"></div> <!-- Placeholder for icon -->
                 </a>
             ))}
        </div>
    </div>
    <div class="text-center mt-12 text-xs text-gray-400">
        © 2026 Pocket Store Inc. All rights reserved.
    </div>
</footer>
