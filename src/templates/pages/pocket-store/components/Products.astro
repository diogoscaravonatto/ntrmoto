---

---

<!-- PRODUCT GRID - CARD BASED -->
<section class="py-32 px-6 md:px-12 bg-white">
    <div class="max-w-[1600px] mx-auto">
        <div class="flex justify-between items-end mb-16">
            <h2 class="text-3xl font-semibold tracking-tight text-gray-900">
                Latest Drops
            </h2>
            <a
                href="#"
                class="text-sm font-medium text-gray-500 hover:text-black border-b border-transparent hover:border-black transition-all pb-1"
                >View All</a
            >
        </div>

        <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-16"
        >
            {
                [
                    {
                        name: "Basic Tee",
                        price: "$32",
                        img: "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=800&q=80",
                    },
                    {
                        name: "Oxford Shirt",
                        price: "$89",
                        img: "https://images.unsplash.com/photo-1596755094514-f87e34085b2c?auto=format&fit=crop&w=800&q=80",
                    },
                    {
                        name: "Chino Pants",
                        price: "$65",
                        img: "https://images.unsplash.com/photo-1473966968600-fa801b869a1a?auto=format&fit=crop&w=800&q=80",
                    },
                    {
                        name: "Leather Boot",
                        price: "$150",
                        img: "https://images.unsplash.com/photo-1638247025967-b4e38f787b76?auto=format&fit=crop&w=800&q=80",
                    },
                    {
                        name: "Minimal Watch",
                        price: "$199",
                        img: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=800&q=80",
                    },
                    {
                        name: "Canvas Bag",
                        price: "$45",
                        img: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=800&q=80",
                    },
                    {
                        name: "Sun Glasses",
                        price: "$120",
                        img: "https://images.unsplash.com/photo-1572635196237-14b3f281503f?auto=format&fit=crop&w=800&q=80",
                    },
                    {
                        name: "Wool Hat",
                        price: "$28",
                        img: "https://images.unsplash.com/photo-1575428652377-a2d80e2277fc?auto=format&fit=crop&w=800&q=80",
                    },
                ].map((product) => (
                    <div class="group cursor-pointer">
                        <div class="aspect-3/4 rounded-xl bg-gray-100 overflow-hidden mb-6 relative">
                            <img
                                src={product.img}
                                alt={product.name}
                                class="w-full h-full object-center object-cover group-hover:scale-105 transition-transform duration-500"
                            />
                            <button class="absolute bottom-4 right-4 w-10 h-10 bg-white rounded-full flex items-center justify-center text-black opacity-0 group-hover:opacity-100 transition-all shadow-md hover:bg-black hover:text-white translate-y-2 group-hover:translate-y-0">
                                <svg
                                    class="w-4 h-4"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M12 4v16m8-8H4"
                                    />
                                </svg>
                            </button>
                        </div>
                        <div>
                            <h3 class="text-base font-medium text-gray-900 group-hover:underline decoration-1 underline-offset-4">
                                {product.name}
                            </h3>
                            <p class="text-sm text-gray-500 mt-1">
                                {product.price}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
