---

---

<!-- CONTACT / LOCATION -->
<section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-12">
        <div
            class="bg-[#f7f5f3] rounded-[3rem] p-12 lg:p-20 overflow-hidden relative"
        >
            <!-- Decorative Blob -->
            <div
                class="absolute -top-40 -right-40 w-96 h-96 bg-[#e6dcd3] rounded-full mix-blend-multiply filter blur-3xl opacity-50"
            >
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 relative z-10">
                <div>
                    <h2 class="text-4xl font-serif text-[#5d5248] mb-8">
                        Vamos conversar?
                    </h2>
                    <p class="text-[#8c7b6d] mb-12 text-lg">
                        O primeiro passo é sempre o mais difícil. Estou aqui
                        para torná-lo acolhedor.
                    </p>

                    <div class="space-y-6">
                        <div class="flex items-center gap-4">
                            <div
                                class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-[#8c7b6d] shadow-sm"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                    ></path></svg
                                >
                            </div>
                            <div>
                                <div
                                    class="text-sm uppercase tracking-widest text-[#8c7b6d] opacity-70"
                                >
                                    Telefone / WhatsApp
                                </div>
                                <div class="text-[#5d5248] font-medium">
                                    (11) 9 9999-9999
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-4">
                            <div
                                class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-[#8c7b6d] shadow-sm"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path></svg
                                >
                            </div>
                            <div>
                                <div
                                    class="text-sm uppercase tracking-widest text-[#8c7b6d] opacity-70"
                                >
                                    Consultório
                                </div>
                                <div class="text-[#5d5248] font-medium">
                                    Av. Paulista, 1000 - Jardins
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-3xl p-8 shadow-sm">
                    <form class="space-y-6">
                        <div class="space-y-2">
                            <label
                                class="text-sm uppercase tracking-wider text-[#8c7b6d] font-medium"
                                >Nome</label
                            >
                            <input
                                type="text"
                                class="w-full bg-[#f7f5f3] border-none rounded-xl p-4 text-[#5d5248] focus:ring-2 focus:ring-[#d3e0e6] transition-all"
                            />
                        </div>
                        <div class="space-y-2">
                            <label
                                class="text-sm uppercase tracking-wider text-[#8c7b6d] font-medium"
                                >Contato</label
                            >
                            <input
                                type="text"
                                class="w-full bg-[#f7f5f3] border-none rounded-xl p-4 text-[#5d5248] focus:ring-2 focus:ring-[#d3e0e6] transition-all"
                            />
                        </div>
                        <button
                            class="w-full py-4 bg-[#8c7b6d] text-[#f7f5f3] rounded-xl font-medium hover:bg-[#6e6056] transition-colors shadow-lg shadow-[#8c7b6d]/20"
                        >
                            Enviar Mensagem
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
