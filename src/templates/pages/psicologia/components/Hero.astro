---
import { Image } from "astro:assets";
---

<!-- HERO - ORGANIC STYLE -->
<section
    class="min-h-screen relative overflow-hidden bg-[#f7f5f3] flex items-center pt-20"
>
    <!-- Organic Blobs Background -->
    <div
        class="absolute top-0 right-0 w-[800px] h-[800px] bg-[#e6dcd3] rounded-full mix-blend-multiply filter blur-3xl opacity-50 animate-blob"
    >
    </div>
    <div
        class="absolute top-0 left-0 w-[600px] h-[600px] bg-[#d3e0e6] rounded-full mix-blend-multiply filter blur-3xl opacity-50 animate-blob animation-delay-2000"
    >
    </div>
    <div
        class="absolute -bottom-32 left-1/4 w-[600px] h-[600px] bg-[#e6d3d3] rounded-full mix-blend-multiply filter blur-3xl opacity-50 animate-blob animation-delay-4000"
    >
    </div>

    <div
        class="max-w-7xl mx-auto px-6 md:px-12 relative z-10 w-full grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
    >
        <!-- Content -->
        <div class="space-y-8">
            <span
                class="inline-block px-4 py-2 rounded-full bg-white/50 backdrop-blur-sm border border-[#cec2b5] text-[#8c7b6d] text-sm tracking-widest uppercase font-medium"
            >
                Psicologia Clínica & Psicanálise
            </span>

            <h1
                class="text-6xl md:text-7xl font-serif text-[#5d5248] leading-[1.1]"
            >
                Um espaço seguro para <span class="italic text-[#8c7b6d]"
                    >reencontrar</span
                > sua essência.
            </h1>

            <p class="text-xl text-[#8c7b6d] leading-relaxed max-w-lg">
                Terapia não é sobre consertar o que está quebrado, é sobre
                descobrir o que foi silenciado. Vamos iniciar essa jornada
                juntos?
            </p>

            <div class="flex flex-col sm:flex-row gap-4 pt-4">
                <button
                    class="px-8 py-4 bg-[#8c7b6d] text-[#f7f5f3] rounded-full font-medium hover:bg-[#6e6056] transition-colors shadow-lg shadow-[#8c7b6d]/20"
                >
                    Agendar Primeira Sessão
                </button>
                <button
                    class="px-8 py-4 bg-white/50 text-[#5d5248] border border-[#cec2b5] rounded-full font-medium hover:bg-white transition-colors"
                >
                    Conhecer Abordagem
                </button>
            </div>

            <div class="flex items-center gap-4 pt-8 text-[#8c7b6d] text-sm">
                <div class="flex -space-x-2">
                    <span
                        class="w-8 h-8 rounded-full bg-[#d3e0e6] border-2 border-[#f7f5f3]"
                    ></span>
                    <span
                        class="w-8 h-8 rounded-full bg-[#e6d3d3] border-2 border-[#f7f5f3]"
                    ></span>
                    <span
                        class="w-8 h-8 rounded-full bg-[#e6dcd3] border-2 border-[#f7f5f3]"
                    ></span>
                </div>
                <span>+200 pacientes atendidos</span>
            </div>
        </div>

        <!-- Image Mask -->
        <div class="relative">
            class="aspect-4/5 relative rounded-[10rem_10rem_2rem_2rem]
            overflow-hidden border-8 border-white/50 shadow-2xl"
            <Image
                src="https://images.unsplash.com/photo-1544027993-37dbfe43562a?auto=format&fit=crop&w=800&q=80"
                alt="Therapist"
                width={800}
                height={1000}
                class="w-full h-full object-cover"
                layout="constrained"
            />
        </div>
        <!-- Floating Reviews Card -->
        <div
            class="absolute bottom-12 -left-8 bg-white/80 backdrop-blur-md p-6 rounded-2xl shadow-xl max-w-xs border border-white"
        >
            <p class="text-[#5d5248] italic mb-4 text-sm">
                "Nunca me senti tão acolhida. A Dra. Sarah tem uma escuta que
                transforma."
            </p>
            <div class="flex items-center gap-2">
                <span class="text-[#8c7b6d] font-bold text-xs uppercase"
                    >Mariana S.</span
                >
                <span class="text-yellow-500 text-xs">★★★★★</span>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes blob {
        0% {
            transform: translate(0px, 0px) scale(1);
        }
        33% {
            transform: translate(30px, -50px) scale(1.1);
        }
        66% {
            transform: translate(-20px, 20px) scale(0.9);
        }
        100% {
            transform: translate(0px, 0px) scale(1);
        }
    }
    .animate-blob {
        animation: blob 7s infinite;
    }
    .animation-delay-2000 {
        animation-delay: 2s;
    }
    .animation-delay-4000 {
        animation-delay: 4s;
    }
</style>
