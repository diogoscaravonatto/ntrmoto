---
const stats = [
    { val: "R$ 4B+", label: "Ativos sob Gestão" },
    { val: "15 ANOS", label: "Histórico de Performance" },
    { val: "24/7", label: "Conselho Consultivo" },
    { val: "OFFSHORE", label: "Eficiência Fiscal" },
];
---

<section class="py-32 border-y border-white/5 bg-zinc-950">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-12">
            {
                stats.map((stat) => (
                    <div class="group cursor-default">
                        <h4 class="text-4xl md:text-5xl font-black text-white italic mb-2 group-hover:text-emerald-500 transition-colors uppercase tracking-tight">
                            {stat.val}
                        </h4>
                        <p class="text-[10px] font-black text-zinc-600 uppercase tracking-[0.2em]">
                            {stat.label}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
