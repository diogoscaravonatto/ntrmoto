---
const brand = { name: "Wealth", highlight: "Master" };
const links = [
    { label: "Metodologia", href: "#estrategias" },
    { label: "Serviços", href: "#servicos" },
    { label: "Sócios", href: "#df" },
];
---

<nav
    class="fixed top-0 w-full z-50 border-b border-white/5 bg-black/20 backdrop-blur-xl h-20"
>
    <div
        class="max-w-7xl mx-auto px-6 h-full flex items-center justify-between"
    >
        <div class="flex items-center gap-2">
            <div
                class="size-8 bg-emerald-500 rounded-lg flex items-center justify-center font-black text-black"
            >
                W
            </div>
            <span class="font-bold tracking-tighter text-xl uppercase italic"
                >{brand.name}<span class="text-emerald-500"
                    >{brand.highlight}</span
                ></span
            >
        </div>
        <div
            class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-400"
        >
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="hover:text-white transition-colors"
                    >
                        {link.label}
                    </a>
                ))
            }
        </div>
        <a
            href="#contato"
            class="px-5 py-2.5 bg-emerald-500 text-black text-xs font-black uppercase tracking-widest rounded-full hover:bg-emerald-400 transition-all hover:scale-105 outline-hidden"
        >
            Consultoria Privada
        </a>
    </div>
</nav>
