---
const footer = {
    brand: { name: "Wealth", highlight: "Master" },
    copy: "© 2026 Wealth Master. Todos os direitos reservados. Privatização e Sigilo Garantidos.",
};
---

<footer class="py-20 border-t border-white/5 bg-black">
    <div
        class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-12"
    >
        <div class="flex items-center gap-2">
            <div
                class="size-6 bg-emerald-500 rounded flex items-center justify-center font-black text-black text-[10px]"
            >
                W
            </div>
            <span class="font-bold tracking-tighter text-lg uppercase italic"
                >{footer.brand.name}<span class="text-emerald-500"
                    >{footer.brand.highlight}</span
                ></span
            >
        </div>
        <div
            class="text-[10px] font-black text-zinc-600 uppercase tracking-[0.3em] text-center"
        >
            {footer.copy}
        </div>
        <div class="flex gap-6 text-zinc-500">
            <div
                class="size-5 hover:text-emerald-500 transition-colors cursor-pointer"
            >
                <svg fill="currentColor" viewBox="0 0 24 24">
                    <path
                        d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.761 0 5-2.239 5-5v-14c0-2.761-2.239-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                    ></path>
                </svg>
            </div>
        </div>
    </div>
</footer>
