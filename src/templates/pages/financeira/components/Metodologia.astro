---
const methodology = {
    eyebrow: "Metodologia",
    title: ["Engenharia de", "Preservação."],
    description:
        "Não acreditamos em fórmulas prontas. Nosso processo é cirúrgico, dividindo a gestão do seu patrimônio em 4 fases críticas de maturidade financeira.",
    steps: [
        {
            step: "01",
            title: "Diagnóstico de Exposição",
            desc: "Análise profunda de riscos fiscais, sucessórios e de mercado no seu portfólio atual.",
        },
        {
            step: "02",
            title: "Blindagem de Ativos",
            desc: "Estruturação de holdings e veículos offshore para proteção contra instabilidades globais.",
        },
        {
            step: "03",
            title: "Alocação de Ativos Dinâmica",
            desc: "Distribuição inteligente de capital focada em Alpha e preservação de poder de compra.",
        },
        {
            step: "04",
            title: "Governança Sucessória",
            desc: "Planejamento detalhado para que seu legado passe pelas gerações sem fricção jurídica.",
        },
    ],
};
---

<section id="estrategias" class="py-40 bg-black relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-24 items-center">
            <div class="space-y-8">
                <span
                    class="text-[10px] font-black uppercase tracking-[0.4em] text-emerald-500"
                    >{methodology.eyebrow}</span
                >
                <h2
                    class="text-5xl md:text-7xl font-black uppercase italic tracking-tighter leading-tight"
                >
                    {methodology.title[0]}
                    <br />{methodology.title[1]}
                </h2>
                <p class="text-zinc-500 text-lg leading-relaxed">
                    {methodology.description}
                </p>

                <div class="space-y-12 pt-10">
                    {
                        methodology.steps.map((item) => (
                            <div class="group flex gap-8">
                                <span class="text-4xl font-black italic text-emerald-500/20 group-hover:text-emerald-500 transition-colors uppercase leading-none">
                                    {item.step}
                                </span>
                                <div>
                                    <h4 class="text-xl font-black uppercase italic mb-2 tracking-tight">
                                        {item.title}
                                    </h4>
                                    <p class="text-zinc-600 text-sm leading-relaxed italic">
                                        {item.desc}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
            <div class="relative">
                <div
                    class="aspect-square rounded-[4rem] border border-white/5 bg-zinc-950 p-16 flex items-center justify-center relative z-10 group"
                >
                    <div
                        class="size-full rounded-full border-2 border-emerald-500/10 flex items-center justify-center p-10 animate-[spin_10s_linear_infinite]"
                    >
                        <div
                            class="size-full rounded-full border-2 border-emerald-500/20 flex items-center justify-center p-10"
                        >
                            <div
                                class="size-full rounded-full border-2 border-emerald-500/40"
                            >
                            </div>
                        </div>
                    </div>
                    <div
                        class="absolute inset-0 flex items-center justify-center text-center"
                    >
                        <div class="space-y-2">
                            <p
                                class="text-[10px] font-black uppercase tracking-widest text-emerald-500"
                            >
                                Proteção de Capital
                            </p>
                            <p
                                class="text-4xl font-black italic text-white uppercase italic"
                            >
                                99.9%
                            </p>
                            <p
                                class="text-[8px] font-black uppercase tracking-widest text-zinc-600"
                            >
                                Taxa de Confiabilidade
                            </p>
                        </div>
                    </div>
                </div>
                <div
                    class="absolute -top-20 -right-20 size-80 bg-emerald-500/5 blur-[120px] pointer-events-none"
                >
                </div>
            </div>
        </div>
    </div>
</section>
