---
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";

const testimonials = [
    {
        name: "Roberto Camargo",
        role: "Empresário",
        text: "A precisão digital me impressionou. Recuperei meu sorriso em tempo recorde sem sentir absolutamente nada de dor durante o processo.",
        avatar: "https://i.pravatar.cc/150?u=4",
    },
    {
        name: "Ana Paula Mendes",
        role: "Arquiteta",
        text: "O atendimento é impecável. O design do meu novo sorriso ficou super natural, exatamente como eu planejei com a equipe da Aura Dental.",
        avatar: "https://i.pravatar.cc/150?u=5",
    },
    {
        name: "Ricardo Silveira",
        role: "Engenheiro",
        text: "A tecnologia de carga imediata salvou meu projeto. Profissionais altamente capacitados e ambiente de primeiro mundo.",
        avatar: "https://i.pravatar.cc/150?u=6",
    },
];
---

<section
    id="depoimentos"
    class="py-32 bg-[#05050a] text-white overflow-hidden relative"
>
    <!-- Decorative Glows -->
    <div
        class="absolute -top-40 -left-20 w-240 h-240 bg-indigo-500/10 rounded-full blur-[120px] z-0 animate-pulse"
    >
    </div>
    <div
        class="absolute -bottom-40 -right-20 w-160 h-160 bg-blue-500/10 rounded-full blur-[100px] z-0 animate-pulse delay-1000"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="text-center max-w-2xl mx-auto mb-24 space-y-6">
            <span
                class="text-[10px] font-black uppercase tracking-[0.4em] text-indigo-400 block font-mono"
                >// Feedback de Nossos Pacientes</span
            >
            <h2
                class="text-5xl md:text-7xl font-black leading-[0.9] tracking-tighter"
            >
                Histórias de <br /><span
                    class="text-indigo-400 font-light italic"
                    >Transformação</span
                >
            </h2>
        </div>

        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10"
        >
            {
                testimonials.map((testimonial) => (
                    <div class="group bg-white/5 backdrop-blur-xl p-10 md:p-12 rounded-3xl border border-white/10 flex flex-col justify-between hover:bg-white/8 transition-all duration-500 hover:-translate-y-2">
                        <div class="space-y-8">
                            <div class="flex gap-1 text-amber-400 group-hover:text-indigo-400 transition-colors">
                                {[1, 2, 3, 4, 5].map(() => (
                                    <Icon
                                        name="lucide:star"
                                        class="w-5 h-5 fill-current"
                                    />
                                ))}
                            </div>
                            <p class="text-xl font-light leading-relaxed italic text-slate-300">
                                "{testimonial.text}"
                            </p>
                        </div>

                        <div class="mt-12 flex items-center gap-5 pt-8 border-t border-white/5">
                            <div class="size-16 rounded-2xl overflow-hidden ring-2 ring-indigo-500/20 group-hover:ring-indigo-500/50 transition-all">
                                <Image
                                    src={testimonial.avatar}
                                    alt={testimonial.name}
                                    width={150}
                                    height={150}
                                    class="w-full h-full object-cover"
                                />
                            </div>
                            <div>
                                <p class="font-black text-white text-lg tracking-tight uppercase">
                                    {testimonial.name}
                                </p>
                                <p class="text-[10px] text-indigo-400 font-black tracking-widest uppercase mt-0.5">
                                    {testimonial.role}
                                </p>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- Google Reviews Badge -->
        <div
            class="mt-24 pt-16 border-t border-white/5 flex flex-col items-center gap-6"
        >
            <div class="flex items-center gap-3">
                <Icon name="lucide:search" class="w-8 h-8 text-white" />
                <span class="text-2xl font-black tracking-tighter uppercase"
                    >Excelente</span
                >
            </div>
            <div class="flex gap-1.5 text-amber-400">
                {
                    [1, 2, 3, 4, 5].map(() => (
                        <Icon name="lucide:star" class="w-8 h-8 fill-current" />
                    ))
                }
            </div>
            <p
                class="text-slate-500 text-sm font-bold uppercase tracking-widest text-center"
            >
                Baseado em mais de <span class="text-white">850 avaliações</span
                >
                no Google Maps
            </p>
        </div>
    </div>
</section>
