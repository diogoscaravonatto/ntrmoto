---
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";

const technologies = [
    {
        title: "Escaneamento Intraoral 3D",
        description:
            "Eliminamos as massas de moldagem. Um scanner digital captura cada detalhe do seu sorriso em segundos.",
        icon: "lucide:monitor",
    },
    {
        title: "Cirurgia Guiada por Computador",
        description:
            "Implantes instalados sem cortes, com planejamento virtual prévio e máxima precisão cirúrgica.",
        icon: "lucide:target",
    },
    {
        title: "Design de Sorriso Digital",
        description:
            "Veja como seu sorriso ficaria antes mesmo de começar o tratamento com simulação 3D realista.",
        icon: "lucide:camera",
    },
];
---

<section id="tecnologia" class="py-32 bg-[#f8fafc]/50 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
            <!-- Visual Content -->
            <div class="relative order-2 lg:order-1 group">
                <div
                    class="relative z-10 rounded-[3rem] overflow-hidden shadow-[0_40px_100px_-20px_rgba(79,70,229,0.2)] skew-y-1 transition-transform duration-700 group-hover:skew-y-0"
                >
                    <Image
                        src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&q=80&w=1000"
                        alt="Tecnologia Aura Dental"
                        width={1000}
                        height={1000}
                        class="w-full h-auto object-cover scale-105 group-hover:scale-100 transition-transform duration-1000"
                        layout="constrained"
                    />
                    <div
                        class="absolute inset-0 bg-[#4f46e5]/5 mix-blend-multiply group-hover:opacity-0 transition-opacity"
                    >
                    </div>
                </div>

                <!-- Decorative Floating Card -->
                <div
                    class="absolute -bottom-10 -right-6 md:-right-10 z-20 bg-white p-10 rounded-[2.5rem] shadow-2xl border border-slate-100 max-w-sm transition-all hover:-translate-y-2 duration-500"
                >
                    <div class="flex items-center gap-5 mb-6">
                        <div
                            class="w-14 h-14 rounded-2xl bg-indigo-600 flex items-center justify-center text-white shadow-xl shadow-indigo-500/30"
                        >
                            <Icon name="lucide:cpu" class="w-7 h-7" />
                        </div>
                        <h4
                            class="text-xl font-black text-slate-900 tracking-tight"
                        >
                            Digital Workflow
                        </h4>
                    </div>
                    <p
                        class="text-sm text-slate-500 leading-relaxed font-medium"
                    >
                        Diga adeus às moldagens. Trabalhamos com fluxo 100%
                        digital, desde o escaneamento até a impressão 3D com
                        precisão nanométrica.
                    </p>
                </div>

                <!-- Glow Effect -->
                <div
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] h-[140%] bg-indigo-200/20 rounded-full blur-[120px] -z-10 group-hover:bg-indigo-300/30 transition-colors duration-1000"
                >
                </div>
            </div>

            <!-- Text Content -->
            <div class="flex flex-col gap-12 order-1 lg:order-2">
                <div class="space-y-8">
                    <span
                        class="text-[10px] font-black uppercase tracking-[0.3em] text-[#4f46e5] block font-mono"
                        >// Sua Experiência 4.0</span
                    >
                    <h2
                        class="text-4xl md:text-7xl font-black text-slate-900 leading-[0.95] tracking-tighter"
                    >
                        A Odontologia do Futuro, <br /><span
                            class="italic text-[#4f46e5] font-light"
                            >Disponível Hoje</span
                        >
                    </h2>
                    <p
                        class="text-xl text-slate-500 font-medium leading-relaxed max-w-xl"
                    >
                        Não fazemos apenas dentes. Usamos ciência da computação
                        e robótica para prever resultados com precisão
                        micrométrica, eliminando surpresas e garantindo
                        conforto.
                    </p>
                </div>

                <div class="space-y-10">
                    {
                        technologies.map((tech) => (
                            <div class="flex gap-8 group">
                                <div class="shrink-0 w-14 h-14 rounded-full border-2 border-slate-100 flex items-center justify-center group-hover:bg-[#4f46e5] group-hover:border-[#4f46e5] transition-all duration-300 bg-white shadow-sm group-hover:shadow-indigo-500/20">
                                    <Icon
                                        name={tech.icon}
                                        class="w-6 h-6 text-[#4f46e5] group-hover:text-white transition-colors"
                                    />
                                </div>
                                <div class="space-y-2">
                                    <h3 class="text-2xl font-black text-slate-900 tracking-tight group-hover:text-indigo-600 transition-colors">
                                        {tech.title}
                                    </h3>
                                    <p class="text-slate-500 leading-relaxed font-medium max-w-md">
                                        {tech.description}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>

                <div class="pt-6">
                    <a
                        href="#servicos"
                        class="inline-block rounded-2xl border-2 border-[#4f46e5] text-[#4f46e5] hover:bg-[#4f46e5] hover:text-white font-black px-10 py-5 transition-all text-xs uppercase tracking-widest hover:shadow-xl hover:shadow-indigo-500/20"
                    >
                        Ver Diferenciais Tecnológicos
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
