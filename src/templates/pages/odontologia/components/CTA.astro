---
import Icon from "@components/Icon.astro";
---

<section class="py-24 bg-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div
            class="relative bg-[#4f46e5] rounded-[4rem] p-10 md:p-24 overflow-hidden text-center text-white shadow-[0_40px_100px_-20px_rgba(79,70,229,0.3)]"
        >
            <!-- Background Decorations -->
            <div
                class="absolute top-0 right-0 w-[40rem] h-[40rem] bg-white/5 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/2"
            >
            </div>
            <div
                class="absolute bottom-0 left-0 w-[40rem] h-[40rem] bg-indigo-400/10 rounded-full blur-[100px] translate-y-1/2 -translate-x-1/2"
            >
            </div>

            <div class="relative z-10 max-w-4xl mx-auto space-y-12">
                <div class="space-y-8">
                    <span
                        class="text-[10px] font-black uppercase tracking-[0.4em] text-indigo-300 block font-mono"
                        >// Próximo Passo</span
                    >
                    <h2
                        class="text-5xl md:text-8xl font-black leading-[0.9] tracking-tighter"
                    >
                        Pronto para sorrir com <br /><span
                            class="text-indigo-200 font-light italic"
                            >liberdade?</span
                        >
                    </h2>
                    <p
                        class="text-xl md:text-2xl text-indigo-100/80 font-medium leading-relaxed max-w-2xl mx-auto"
                    >
                        Agende agora sua consulta de avaliação e descubra como a
                        tecnologia digital pode elevar sua autoestima em 24
                        horas.
                    </p>
                </div>

                <div
                    class="flex flex-col sm:flex-row gap-6 justify-center items-center"
                >
                    <a
                        href="#contato"
                        class="w-full sm:w-auto flex items-center justify-center gap-3 rounded-[2rem] font-black px-12 py-6 bg-white text-[#4f46e5] hover:bg-indigo-50 shadow-2xl transition-all hover:-translate-y-1 active:scale-[0.98]"
                    >
                        Agendar Avaliação Online
                        <Icon name="lucide:arrow-right" class="w-5 h-5" />
                    </a>
                    <a
                        href="https://wa.me/5511999999999"
                        class="w-full sm:w-auto flex items-center justify-center gap-3 rounded-[2rem] font-black px-12 py-6 border-2 border-white/20 text-white hover:bg-white/10 transition-all hover:-translate-y-1 active:scale-[0.98] backdrop-blur-sm"
                    >
                        Falar com Especialista
                        <Icon name="lucide:message-circle" class="w-5 h-5" />
                    </a>
                </div>

                <div
                    class="flex flex-col md:flex-row items-center justify-center gap-8 pt-6 border-t border-white/10"
                >
                    <div class="flex items-center gap-3">
                        <Icon
                            name="lucide:check-circle"
                            class="w-5 h-5 text-indigo-300"
                        />
                        <span
                            class="text-xs font-black uppercase tracking-widest text-indigo-100/60"
                            >Vagas Limitadas p/ Semana</span
                        >
                    </div>
                    <div class="flex items-center gap-3">
                        <Icon
                            name="lucide:clock"
                            class="w-5 h-5 text-indigo-300"
                        />
                        <span
                            class="text-xs font-black uppercase tracking-widest text-indigo-100/60"
                            >Avaliação VIP em 24h</span
                        >
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
