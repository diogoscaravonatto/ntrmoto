---
import Icon from "@components/Icon.astro";

const faqItems = [
    {
        label: "Os tratamentos com implantes são dolorosos?",
        content:
            "Graças às tecnologias de sedação consciente e cirurgia guiada por computador, os procedimentos de implante na Aura Dental são praticamente indolores e possuem um pós-operatório muito tranquilo.",
    },
    {
        label: "Quanto tempo dura o tratamento com Lentes de Contato?",
        content:
            "Com o fluxo digital, o planejamento é feito em uma sessão e a instalação pode ocorrer em apenas 24h a 48h após a aprovação do design do sorriso pelo paciente.",
    },
    {
        label: "Aceitam planos de saúde ou convênios?",
        content:
            "Trabalhamos no sistema de reembolso assistido e atendimento particular de elite, garantindo exclusividade e materiais de procedência internacional que convênios tradicionais não cobrem.",
    },
    {
        label: "O Invisalign funciona para casos complexos?",
        content:
            "Sim! Os alinhadores invisíveis modernos são capazes de tratar desde casos simples até desalinhamentos complexos, garantindo estética durante todo o processo ortodôntico.",
    },
];
---

<section id="faq" class="py-32 bg-[#f8fafc] relative overflow-hidden">
    <!-- Decorative side accent -->
    <div
        class="absolute left-0 top-0 w-2 h-full bg-gradient-to-b from-[#4f46e5]/0 via-[#4f46e5]/20 to-[#4f46e5]/0 pointer-events-none"
    >
    </div>

    <div class="max-w-4xl mx-auto px-6 relative z-10">
        <div class="text-center max-w-2xl mx-auto mb-20 space-y-6">
            <span
                class="text-[10px] font-black uppercase tracking-[0.4em] text-[#4f46e5] block font-mono"
                >// Dúvidas Frequentes</span
            >
            <h2
                class="text-5xl md:text-7xl font-black text-slate-900 leading-[0.95] tracking-tighter"
            >
                Esclareça suas <br /><span
                    class="text-indigo-600 font-light italic"
                    >Interrogações</span
                >
            </h2>
        </div>

        <div class="space-y-6">
            {
                faqItems.map((item, index) => (
                    <div class="faq-item group">
                        <button class="faq-header w-full text-left p-8 md:p-10 bg-white hover:bg-[#4f46e5]/5 rounded-3xl border border-slate-100 flex justify-between items-center transition-all duration-300 hover:shadow-xl hover:shadow-indigo-500/5">
                            <span class="text-lg md:text-xl font-black text-slate-900 group-hover:text-indigo-600 transition-colors tracking-tight">
                                {item.label}
                            </span>
                            <div class="size-10 rounded-full border border-slate-200 flex items-center justify-center shrink-0 group-hover:border-indigo-400 group-hover:bg-white transition-all">
                                <Icon
                                    name="lucide:chevron-down"
                                    class="w-5 h-5 text-slate-400 group-hover:text-indigo-600 transition-all duration-300"
                                />
                            </div>
                        </button>
                        <div class="faq-content overflow-hidden max-h-0 transition-all duration-500 ease-in-out">
                            <div class="p-8 md:p-10 pt-4 text-slate-500 font-medium leading-relaxed md:text-lg">
                                {item.content}
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    const faqItems = document.querySelectorAll(".faq-item");

    faqItems.forEach((item) => {
        const header = item.querySelector(".faq-header");
        const content = item.querySelector(".faq-content");
        const icon = item.querySelector("svg");

        header?.addEventListener("click", () => {
            // Close other items
            faqItems.forEach((otherItem) => {
                if (otherItem !== item) {
                    otherItem
                        .querySelector(".faq-content")
                        ?.setAttribute("style", "max-height: 0");
                    otherItem
                        .querySelector("svg")
                        ?.setAttribute("style", "transform: rotate(0deg)");
                    otherItem.classList.remove("active");
                }
            });

            // Toggle current item
            const isActive = item.classList.contains("active");
            if (isActive) {
                content?.setAttribute("style", "max-height: 0");
                icon?.setAttribute("style", "transform: rotate(0deg)");
                item.classList.remove("active");
            } else {
                content?.setAttribute(
                    "style",
                    `max-height: ${content.scrollHeight}px`,
                );
                icon?.setAttribute("style", "transform: rotate(180deg)");
                item.classList.add("active");
            }
        });
    });
</script>

<style>
    .faq-item.active .faq-header {
        border-color: rgba(79, 70, 229, 0.3);
        box-shadow: 0 20px 40px -10px rgba(79, 70, 229, 0.1);
    }
</style>
