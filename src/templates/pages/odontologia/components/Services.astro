---
import Icon from "@components/Icon.astro";

const services = [
    {
        title: 'Implantes Dentários',
        description: 'Recupere a funcionalidade e segurança ao mastigar com implantes de última geração e carga imediata.',
        icon: 'lucide:wrench'
    },
    {
        title: 'Lentes de Contato',
        description: 'Transforme a cor e formato dos seus dentes com finíssimas camadas de porcelana de alta resistência.',
        icon: 'lucide:sparkles'
    },
    {
        title: 'Alinhadores Invisíveis',
        description: 'Corrija seus dentes de forma discreta e confortável, sem o uso de braquetes ou fios metálicos.',
        icon: 'lucide:badge-check'
    },
    {
        title: 'Reabilitação Oral',
        description: 'Um planejamento completo para devolver a harmonia estética e funcional de todo o seu sorriso.',
        icon: 'lucide:smile'
    },
    {
        title: 'Harmonização Facial',
        description: 'Equilíbrio perfeito entre o seu sorriso e as proporções do seu rosto para uma aparência rejuvenescida.',
        icon: 'lucide:user'
    },
    {
        title: 'Prevenção de Elite',
        description: 'Check-ups digitais preventivos para manter sua saúde oral sempre em dia e evitar problemas futuros.',
        icon: 'lucide:shield-check'
    }
];
---

<section id="servicos" class="py-32 bg-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-24 space-y-6">
            <span class="text-[10px] font-black uppercase tracking-[0.3em] text-[#4f46e5] block">// Especialidades de Alta Performance</span>
            <h2 class="text-4xl md:text-6xl font-black text-slate-900 leading-[1.1] tracking-tighter">
                Tratamentos Completos para uma <br /><span class="italic text-[#4f46e5]">Saúde Oral Impecável</span>
            </h2>
            <p class="text-lg text-slate-500 font-medium leading-relaxed">
                Utilizamos as tecnologias mais disruptivas da odontologia moderna para garantir resultados previsíveis, estéticos e ultra-duradouros.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12">
            {services.map((service) => (
                <div class="group bg-[#f8fafc]/50 p-10 lg:p-12 rounded-[2.5rem] border border-slate-100 hover:border-indigo-200 transition-all duration-500 hover:shadow-[0_40px_80px_-20px_rgba(79,70,229,0.1)] hover:-translate-y-2 relative overflow-hidden">
                    <!-- Background Decoration -->
                    <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-indigo-500/5 rounded-full blur-2xl group-hover:bg-indigo-500/10 transition-colors"></div>
                    
                    <div class="w-16 h-16 rounded-2xl bg-white border border-indigo-100 flex items-center justify-center mb-10 group-hover:bg-[#4f46e5] group-hover:border-[#4f46e5] transition-all duration-500 shadow-sm group-hover:shadow-indigo-500/20">
                        <Icon name={service.icon} class="w-8 h-8 text-[#4f46e5] group-hover:text-white transition-colors duration-500" />
                    </div>
                    
                    <h3 class="text-2xl font-black text-slate-900 mb-5 tracking-tight group-hover:text-indigo-600 transition-colors">{service.title}</h3>
                    <p class="text-slate-500 leading-relaxed mb-10 font-medium">
                        {service.description}
                    </p>
                    
                    <a href="#" class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-[#4f46e5] group-hover:gap-4 transition-all">
                        Explorar Tratamento
                        <Icon name="lucide:arrow-right" class="w-4 h-4" />
                    </a>
                </div>
            ))}
        </div>
    </div>
</section>
