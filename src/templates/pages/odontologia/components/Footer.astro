---
import Icon from "@components/Icon.astro";

const linkGroups = [
    {
        title: "Tratamentos",
        links: [
            { label: "Implantes", href: "#" },
            { label: "Lentes de Porcelana", href: "#" },
            { label: "Invisalign", href: "#" },
            { label: "Clareamento", href: "#" },
            { label: "Odontopediatria", href: "#" },
        ],
    },
    {
        title: "A Clínica",
        links: [
            { label: "Nossa Unidade", href: "#" },
            { label: "Corpo Clínico", href: "#" },
            { label: "Tecnologia", href: "#" },
            { label: "Blog da Saúde", href: "#" },
            { label: "Trabalhe Conosco", href: "#" },
        ],
    },
];

const currentYear = new Date().getFullYear();
---

<footer
    class="bg-white pt-32 pb-16 border-t border-slate-100 relative overflow-hidden"
>
    <!-- Background Text Accent -->
    <div
        class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 text-slate-50 font-black text-[20rem] tracking-tighter select-none pointer-events-none"
    >
        AURA
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-16 mb-24"
        >
            <!-- Brand -->
            <div class="lg:col-span-2 space-y-10">
                <a
                    href="/templates/odontologia"
                    class="flex items-center gap-3 group"
                >
                    <div
                        class="p-2.5 bg-[#4f46e5] rounded-xl shadow-lg shadow-indigo-500/20 group-hover:scale-110 transition-transform"
                    >
                        <Icon
                            name="lucide:sparkles"
                            class="w-6 h-6 text-white"
                        />
                    </div>
                    <span
                        class="text-3xl font-black tracking-tighter text-slate-900 uppercase"
                    >
                        Aura<span class="text-[#4f46e5]">Dental</span>
                    </span>
                </a>
                <p
                    class="text-lg text-slate-500 font-medium leading-relaxed max-w-sm"
                >
                    Redefinindo os padrões da odontologia estética com
                    tecnologia robótica e atendimento de alta performance.
                </p>
                <div class="flex gap-4">
                    {
                        ["instagram", "facebook", "linkedin", "youtube"].map(
                            (social) => (
                                <a
                                    href="#"
                                    class="size-12 rounded-2xl border border-slate-100 flex items-center justify-center text-slate-400 hover:text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50/50 transition-all hover:-translate-y-1 active:scale-95"
                                >
                                    <Icon
                                        name={`lucide:${social}`}
                                        class="w-5 h-5"
                                    />
                                </a>
                            ),
                        )
                    }
                </div>
            </div>

            <!-- Links -->
            {
                linkGroups.map((group) => (
                    <div class="space-y-8">
                        <h5 class="text-[10px] font-black uppercase tracking-[0.3em] text-slate-900 border-l-2 border-indigo-600 pl-4">
                            {group.title}
                        </h5>
                        <ul class="space-y-4">
                            {group.links.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        class="text-slate-500 hover:text-indigo-600 transition-all font-bold text-sm hover:pl-2"
                                    >
                                        {link.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }

            <!-- Newsletter -->
            <div class="lg:col-span-2 space-y-8">
                <h5
                    class="text-[10px] font-black uppercase tracking-[0.3em] text-slate-900 border-l-2 border-indigo-600 pl-4"
                >
                    Premium Insights
                </h5>
                <p class="text-slate-500 font-medium leading-relaxed">
                    Receba atualizações sobre novas tecnologias e casos de
                    transformação oral.
                </p>
                <div class="flex flex-col gap-4">
                    <input
                        type="email"
                        placeholder="Seu melhor e-mail"
                        class="w-full h-16 px-8 rounded-2xl bg-slate-50 border border-slate-100 focus:border-indigo-400 outline-none transition-all font-medium text-slate-900"
                    />
                    <button
                        class="w-full h-16 rounded-2xl font-black text-xs uppercase tracking-widest bg-[#4f46e5] text-white hover:bg-[#4338ca] shadow-xl shadow-indigo-500/20 active:scale-95 transition-all"
                    >
                        Inscrever-se na Lista VIP
                    </button>
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <div
            class="pt-12 border-t border-slate-100 flex flex-col md:flex-row justify-between items-center gap-8"
        >
            <div
                class="flex flex-col md:flex-row items-center gap-4 text-slate-400 text-[10px] font-black uppercase tracking-widest"
            >
                <span>&copy; {currentYear} Aura Dental Studio Ltda.</span>
                <span class="hidden md:block opacity-30">•</span>
                <span class="text-indigo-600/50">CNPJ: 00.000.000/0001-00</span>
            </div>
            <div
                class="flex gap-10 text-[10px] font-black uppercase tracking-widest text-slate-400"
            >
                <a href="#" class="hover:text-indigo-600 transition-colors"
                    >Privacidade</a
                >
                <a href="#" class="hover:text-indigo-600 transition-colors"
                    >Termos</a
                >
                <a href="#" class="hover:text-indigo-600 transition-colors"
                    >Cookies</a
                >
            </div>
        </div>
    </div>
</footer>
