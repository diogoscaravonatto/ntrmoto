---
import Icon from "@components/Icon.astro";

const navItems = [
    { label: "Especialidades", href: "#servicos" },
    { label: "Tecnologia", href: "#tecnologia" },
    { label: "Resultados", href: "#resultados" },
    { label: "Depoimentos", href: "#depoimentos" },
    { label: "Contato", href: "#contato" },
];
---

<header
    id="main-header"
    class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-lg border-b border-slate-100 transition-all duration-300 py-6"
>
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center justify-between">
            <!-- Logo -->
            <a
                href="/templates/odontologia"
                class="flex items-center gap-2 group"
            >
                <div
                    class="p-2 bg-[#4f46e5] rounded-xl group-hover:scale-110 transition-transform duration-300 shadow-lg shadow-indigo-500/20"
                >
                    <Icon name="lucide:sparkles" class="w-6 h-6 text-white" />
                </div>
                <span class="text-2xl font-bold tracking-tight text-slate-900">
                    Aura<span class="text-[#4f46e5]">Dental</span>
                </span>
            </a>

            <!-- Navigation -->
            <nav class="hidden md:flex items-center gap-8">
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            class="text-sm font-medium text-slate-600 hover:text-[#4f46e5] transition-colors relative group/link"
                        >
                            {item.label}
                            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-[#4f46e5] transition-all duration-300 group-hover/link:w-full" />
                        </a>
                    ))
                }
            </nav>

            <!-- CTA -->
            <div class="flex items-center gap-4">
                <a
                    href="#contato"
                    class="hidden sm:flex items-center justify-center rounded-full font-bold px-8 py-3 bg-[#4f46e5] hover:bg-[#4338ca] text-white transition-all hover:shadow-xl hover:shadow-[#4f46e5]/30 hover:-translate-y-0.5"
                >
                    Agendar Consulta
                </a>

                <!-- Mobile Menu Button -->
                <button
                    id="mobile-menu-btn"
                    class="md:hidden p-2 text-slate-600 hover:text-[#4f46e5] transition-colors"
                    aria-label="Menu"
                >
                    <Icon name="lucide:menu" class="w-6 h-6" />
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <div
        id="mobile-menu"
        class="hidden absolute top-full left-0 right-0 bg-white border-b border-slate-100 py-8 px-6 md:hidden shadow-2xl animate-fade-in-down"
    >
        <div class="flex flex-col gap-6">
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        class="text-xl font-bold text-slate-900 py-2 border-b border-slate-50 flex justify-between items-center group"
                    >
                        {item.label}
                        <Icon
                            name="lucide:arrow-right"
                            class="w-5 h-5 opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0"
                        />
                    </a>
                ))
            }
            <a
                href="#contato"
                class="mt-4 rounded-2xl font-black py-5 bg-[#4f46e5] text-white text-center shadow-xl shadow-indigo-500/20 active:scale-[0.98] transition-all"
            >
                Agendar Consulta
            </a>
        </div>
    </div>
</header>

<script>
    const header = document.getElementById("main-header");
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    // Scroll Effect
    window.addEventListener("scroll", () => {
        if (window.scrollY > 20) {
            header?.classList.add("py-4", "shadow-sm", "bg-white/95");
            header?.classList.remove("py-6", "bg-white/80");
        } else {
            header?.classList.add("py-6", "bg-white/80");
            header?.classList.remove("py-4", "shadow-sm", "bg-white/95");
        }
    });

    // Mobile Menu Toggle
    mobileMenuBtn?.addEventListener("click", () => {
        mobileMenu?.classList.toggle("hidden");
    });

    // Close menu on link click
    const menuLinks = mobileMenu?.querySelectorAll("a");
    menuLinks?.forEach((link) => {
        link.addEventListener("click", () => {
            mobileMenu?.classList.add("hidden");
        });
    });
</script>

<style>
    @keyframes fade-in-down {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in-down {
        animation: fade-in-down 0.3s ease-out forwards;
    }
</style>
