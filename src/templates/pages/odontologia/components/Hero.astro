---
import Icon from "@components/Icon.astro";
---

<section
    class="relative min-h-[90vh] flex items-center pt-32 pb-32 overflow-hidden bg-[#f8fafc]"
>
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
        <div
            class="absolute top-0 right-0 w-200 h-200 bg-indigo-500/10 rounded-full blur-[120px] animate-pulse-slow translate-x-1/3 -translate-y-1/3"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 w-160 h-160 bg-indigo-500/5 rounded-full blur-[100px] animate-pulse-slower -translate-x-1/3 translate-y-1/3"
        >
        </div>

        <!-- Animated Particles/Dots -->
        <div
            class="absolute bottom-40 left-1/4 w-2 h-2 bg-indigo-200 rounded-full animate-float-slow"
        >
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 w-full">
        <div
            class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center"
        >
            <!-- Text Content -->
            <div class="flex flex-col gap-10 animate-fade-in-up">
                <div class="space-y-8">
                    <!-- Premium Badge -->
                    <div
                        class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full bg-white border border-indigo-100 shadow-xl shadow-indigo-500/5"
                    >
                        <span class="relative flex h-3 w-3">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#4f46e5] opacity-75"
                            ></span>
                            <span
                                class="relative inline-flex rounded-full h-3 w-3 bg-[#4f46e5]"
                            ></span>
                        </span>
                        <span
                            class="text-[10px] font-black uppercase tracking-[0.2em] text-[#4f46e5]"
                        >
                            Tecnologia & Estética Dental
                        </span>
                    </div>

                    <!-- Main Headline -->
                    <h1
                        class="text-5xl md:text-8xl font-black leading-[0.9] text-slate-900 tracking-tighter"
                    >
                        Seu Sorriso<br />
                        <span
                            class="bg-linear-to-r from-indigo-600 via-blue-500 to-indigo-400 bg-clip-text text-transparent bg-size-[200%_auto] animate-gradient"
                        >
                            Perfeito
                        </span>
                        <br />
                        <span
                            class="text-3xl md:text-6xl font-light text-slate-400 tracking-tight"
                            >em 24 horas</span
                        >
                    </h1>

                    <!-- Subheadline -->
                    <p
                        class="text-xl text-slate-500 max-w-xl leading-relaxed font-medium mt-6"
                    >
                        Transformação completa com <span
                            class="text-indigo-600 font-bold"
                            >tecnologia 3D</span
                        >, cirurgia guiada e resultados de alta precisão
                        estética.
                    </p>
                </div>

                <!-- CTA Buttons -->
                <div class="flex flex-col sm:flex-row gap-5">
                    <a
                        href="#contato"
                        class="group flex items-center justify-center gap-3 rounded-2xl font-black px-10 py-5 bg-[#4f46e5] hover:bg-[#4338ca] text-white shadow-2xl shadow-indigo-500/20 hover:shadow-indigo-500/40 hover:-translate-y-1 transition-all duration-300"
                    >
                        Agendar Avaliação VIP
                        <Icon
                            name="lucide:arrow-right"
                            class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                        />
                    </a>

                    <a
                        href="#resultados"
                        class="flex items-center justify-center rounded-2xl font-black px-10 py-5 border-2 border-slate-200 text-slate-600 hover:bg-white hover:border-indigo-200 transition-all"
                    >
                        Ver Casos Reais
                    </a>
                </div>

                <!-- Social Proof Stats -->
                <div
                    class="flex flex-wrap items-center gap-8 lg:gap-12 pt-4 border-t border-slate-100"
                >
                    <div class="flex flex-col">
                        <span class="text-3xl font-black text-indigo-600"
                            >15k+</span
                        >
                        <span
                            class="text-[10px] text-slate-400 uppercase font-black tracking-widest mt-1"
                            >Sorrisos Criados</span
                        >
                    </div>
                    <div class="w-px h-10 bg-slate-200 hidden sm:block"></div>
                    <div class="flex flex-col">
                        <span class="text-3xl font-black text-indigo-600"
                            >99%</span
                        >
                        <span
                            class="text-[10px] text-slate-400 uppercase font-black tracking-widest mt-1"
                            >Satisfação</span
                        >
                    </div>
                    <div class="w-px h-10 bg-slate-200 hidden sm:block"></div>
                    <div class="flex flex-col">
                        <div class="flex gap-0.5 text-amber-400 mb-1">
                            {
                                [1, 2, 3, 4, 5].map(() => (
                                    <Icon
                                        name="lucide:star"
                                        class="w-4 h-4 fill-current"
                                    />
                                ))
                            }
                        </div>
                        <span
                            class="text-[10px] text-slate-400 uppercase font-black tracking-widest mt-1"
                            >4.9/5 Google</span
                        >
                    </div>
                </div>
            </div>

            <!-- Visual Content -->
            <div
                class="relative animate-fade-in-right opacity-0"
                style="animation-delay: 0.3s"
            >
                <!-- Main Image - Hospital/Clinic Interior -->
                <div
                    class="relative z-10 rounded-5xl overflow-hidden shadow-[0_40px_100px_-20px_rgba(79,70,229,0.3)] border-8 border-white/50 bg-white"
                >
                    <img
                        src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&q=80&w=1000"
                        alt="Clínica Aura Dental Interior"
                        width="1000"
                        height="1250"
                        class="w-full aspect-4/5 object-cover scale-105 hover:scale-110 transition-transform duration-1000"
                        loading="eager"
                    />
                    <!-- Overlay Gradient -->
                    <div
                        class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent pointer-events-none"
                    >
                    </div>
                </div>

                <!-- Floating Card 1 - Patient Result -->
                <div
                    class="absolute -top-6 -right-4 md:-top-12 md:-right-16 z-30 bg-white p-4 md:p-6 rounded-4xl shadow-2xl border border-slate-100 animate-float-delayed max-w-[140px] md:max-w-[200px]"
                >
                    <div
                        class="relative rounded-2xl overflow-hidden mb-4 shadow-xl bg-slate-100"
                    >
                        <img
                            src="https://images.unsplash.com/photo-1557053910-d9eadeed1c58?auto=format&fit=crop&q=80&w=400"
                            alt="Paciente Satisfeito"
                            width="400"
                            height="400"
                            class="w-full aspect-square object-cover"
                            loading="lazy"
                        />
                    </div>
                    <div class="space-y-1">
                        <p
                            class="text-[10px] font-black text-indigo-600 uppercase tracking-widest font-mono"
                        >
                            // Antes & Depois
                        </p>
                        <p
                            class="text-sm font-black text-slate-900 leading-tight"
                        >
                            Resultado<br />Protocolo Digital
                        </p>
                    </div>
                    <div
                        class="absolute -top-3 -right-3 size-10 bg-[#4f46e5] rounded-full flex items-center justify-center text-white shadow-xl shadow-indigo-500/40 border-4 border-white"
                    >
                        <Icon name="lucide:check" class="w-4 h-4" />
                    </div>
                </div>

                <!-- Floating Card 2 - Tech Badge (Bottom Left) -->
                <div
                    class="absolute -bottom-6 -left-4 md:-bottom-10 md:-left-20 z-20 bg-[#f8fafc] p-4 md:p-6 rounded-5xl border border-slate-200 shadow-2xl animate-float max-w-[180px] md:max-w-[240px] hidden sm:block"
                >
                    <div class="flex items-center gap-4 mb-4">
                        <div
                            class="size-12 rounded-2xl bg-[#4f46e5] flex items-center justify-center text-white shadow-lg shadow-indigo-500/20"
                        >
                            <Icon name="lucide:cpu" class="w-6 h-6" />
                        </div>
                        <div class="flex flex-col">
                            <span
                                class="text-[10px] font-black text-indigo-600 uppercase tracking-widest font-mono"
                                >Infraestrutura</span
                            >
                            <span class="text-xs font-bold text-slate-900"
                                >Lab Center 3D</span
                            >
                        </div>
                    </div>
                    <p class="text-xs font-bold text-slate-500 leading-relaxed">
                        Sistema CAD/CAM de alta precisão para restaurações em
                        tempo recorde.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes fadeInRight {
        from {
            opacity: 0;
            transform: translateX(30px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
    @keyframes float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-20px);
        }
    }
    @keyframes pulse-slow {
        0%,
        100% {
            opacity: 0.1;
            transform: scale(1);
        }
        50% {
            opacity: 0.2;
            transform: scale(1.1);
        }
    }
    @keyframes gradient-move {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }

    .animate-fade-in-up {
        animation: fadeInUp 1s ease-out forwards;
    }
    .animate-fade-in-right {
        animation: fadeInRight 1s ease-out forwards;
    }
    .animate-float {
        animation: float 6s ease-in-out infinite;
    }
    .animate-float-delayed {
        animation: float 6s ease-in-out 1.5s infinite;
    }
    .animate-pulse-slow {
        animation: pulse-slow 8s ease-in-out infinite;
    }
    .animate-gradient {
        animation: gradient-move 4s ease-in-out infinite;
    }
</style>
