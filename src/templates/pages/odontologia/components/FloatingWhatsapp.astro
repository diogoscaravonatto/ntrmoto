---
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";
---

<div
    class="fixed bottom-8 right-8 z-100 flex flex-col items-end gap-6 pointer-events-none"
>
    <!-- Message Bubble -->
    <div
        id="whatsapp-bubble"
        class="hidden bg-white p-6 rounded-4xl shadow-[0_20px_60px_rgba(0,0,0,0.1)] border border-slate-100 max-w-[280px] pointer-events-auto transform transition-all duration-700 translate-y-4 opacity-0"
    >
        <div class="flex items-center gap-4 mb-4">
            <div
                class="size-10 rounded-full overflow-hidden ring-2 ring-emerald-500/20"
            >
                <Image
                    src="https://i.pravatar.cc/100?u=nurse"
                    alt="Atendente"
                    width={100}
                    height={100}
                    class="w-full h-full object-cover"
                />
            </div>
            <div class="flex flex-col">
                <span
                    class="text-[10px] font-black text-slate-400 uppercase tracking-widest"
                    >Suporte Aura</span
                >
                <span
                    class="text-[9px] font-bold text-emerald-500 uppercase tracking-widest flex items-center gap-1"
                >
                    <span
                        class="size-1.5 bg-emerald-500 rounded-full animate-pulse"
                    ></span>
                    Online agora
                </span>
            </div>
        </div>
        <p class="text-sm text-slate-700 font-bold leading-relaxed">
            Olá! Vamos transformar seu sorriso? Posso agendar sua avaliação
            agora mesmo. 🦷✨
        </p>

        <!-- Triangle Pointer -->
        <div
            class="absolute bottom-[-8px] right-8 size-4 bg-white rotate-45 border-r border-b border-slate-100"
        >
        </div>
    </div>

    <!-- Floating Button -->
    <a
        href="https://wa.me/5511999999999"
        target="_blank"
        class="w-20 h-20 bg-[#25D366] text-white rounded-4xl shadow-[0_20px_40px_rgba(37,211,102,0.4)] flex items-center justify-center hover:scale-110 active:scale-95 transition-all duration-300 pointer-events-auto group relative overflow-hidden"
    >
        <!-- Pulse Effect -->
        <span
            class="absolute inset-0 rounded-full bg-white opacity-0 group-hover:opacity-20 group-hover:scale-150 transition-all duration-700"
        ></span>
        <Icon name="lucide:message-circle" class="w-10 h-10 relative z-10" />
    </a>
</div>

<script>
    const bubble = document.getElementById("whatsapp-bubble");

    setTimeout(() => {
        if (bubble) {
            bubble.classList.remove("hidden");
            setTimeout(() => {
                bubble.classList.remove("translate-y-4", "opacity-0");
            }, 100);
        }
    }, 4000);
</script>

<style>
    @keyframes float-y {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }
    #whatsapp-bubble:not(.hidden) {
        animation: float-y 4s ease-in-out infinite;
    }
</style>
