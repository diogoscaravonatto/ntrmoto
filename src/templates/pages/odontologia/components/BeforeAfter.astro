---
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";

const cases = [
    {
        title: 'Transformação Total Superior',
        treatment: '10 Lentes de Porcelana E-MAX',
        image: 'https://images.unsplash.com/photo-1606811841689-23dfddce3e95?q=80&w=2574&auto=format&fit=crop'
    },
    {
        title: 'Reabilitação Funcional',
        treatment: 'Implantes com Carga Imediata',
        image: 'https://images.unsplash.com/photo-1598256989800-fe5f95da9787?q=80&w=2670&auto=format&fit=crop'
    }
];
---

<section id="resultados" class="py-32 bg-white overflow-hidden relative">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-end mb-24">
            <div class="flex-1 space-y-8">
                <span class="text-[10px] font-black uppercase tracking-[0.3em] text-[#4f46e5] block font-mono">// Galeria de Resultados</span>
                <h2 class="text-5xl md:text-7xl font-black text-slate-900 leading-[0.95] tracking-tighter">
                    A Arte de Criar <br /><span class="text-[#4f46e5] font-light italic">Sorrisos Poderosos</span>
                </h2>
            </div>
            <div class="flex-1">
                <p class="text-xl text-slate-500 font-medium leading-relaxed max-w-lg">
                    Nossos casos são planejados digitalmente para harmonizar com a face de cada paciente. Confira a precisão estética em resultados reais.
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
            {cases.map((caseItem) => (
                <div class="relative group cursor-pointer overflow-hidden rounded-3xl shadow-2xl shadow-indigo-500/5">
                    <img 
                        src={`${caseItem.image}&auto=format&fit=crop&w=1200&q=80`}
                        alt={caseItem.title} 
                        width="1200"
                        height="750"
                        class="w-full aspect-16/10 object-cover transition-transform duration-1000 group-hover:scale-110" 
                        loading="lazy"
                    />
                    
                    <!-- Transformation Overlay -->
                    <div class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-900/20 to-transparent opacity-60 group-hover:opacity-100 transition-opacity duration-700"></div>
                    
                    <div class="absolute inset-0 flex flex-col justify-end p-8 md:p-12 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                        <h3 class="text-white text-3xl font-black mb-3 tracking-tight">{caseItem.title}</h3>
                        <p class="text-indigo-400 font-black text-xs uppercase tracking-widest flex items-center gap-3">
                            <span class="w-8 h-px bg-indigo-400/50"></span>
                            {caseItem.treatment}
                        </p>
                    </div>

                    <!-- Label -->
                    <div class="absolute top-8 left-8 bg-white/95 backdrop-blur-md px-5 py-2.5 rounded-full text-[10px] font-black uppercase tracking-[0.2em] text-[#4f46e5] shadow-xl border border-indigo-100/30">
                        Resultado Aura Dental
                    </div>
                    
                    <!-- View Icon Overlay -->
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 size-20 bg-white/10 backdrop-blur-xl rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all scale-50 group-hover:scale-100 duration-500 border border-white/20">
                        <Icon name="lucide:eye" class="w-8 h-8 text-white" />
                    </div>
                </div>
            ))}
        </div>

        <div class="mt-20 text-center">
            <a 
                href="https://instagram.com"
                class="inline-flex items-center gap-4 text-slate-900 hover:text-[#4f46e5] font-black text-sm uppercase tracking-widest transition-all group"
            >
                <div class="size-12 rounded-full border border-slate-200 flex items-center justify-center group-hover:border-[#4f46e5] transition-colors">
                    <Icon name="lucide:camera" class="w-5 h-5" />
                </div>
                Ver galeria completa no Instagram
            </a>
        </div>
    </div>
</section>
