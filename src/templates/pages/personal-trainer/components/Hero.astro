---
const trainer = {
    name: "MARCUS IRON",
    tagline: "TRANSFORME SUA MENTE, SEU CORPO VIRÁ EM SEGUIDA.",
};
---

<section
    class="relative min-h-screen flex flex-col justify-center px-6 md:px-20 overflow-hidden bg-black"
>
    <div class="absolute inset-0 z-0">
        <div
            class="absolute inset-x-0 bottom-0 h-1/2 bg-linear-to-t from-black to-transparent z-10"
        >
        </div>
        <img
            src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=1600&q=80"
            alt="Training"
            class="absolute w-full h-full object-cover scale-110 opacity-40 grayscale group-hover:grayscale-0 transition-all duration-1000"
        />
    </div>

    <div class="relative z-20 max-w-7xl mx-auto">
        <div class="flex items-center gap-6 mb-12">
            <span class="p-3 bg-red-600 rounded-lg shadow-2xl">
                <svg
                    class="size-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="3"
                        d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                >
            </span>
            <span
                class="text-white font-black italic uppercase text-xs tracking-[0.4em]"
                >PEAK PERFORMANCE ONLY</span
            >
        </div>
        <h1
            class="text-[15vw] md:text-[15rem] font-black italic tracking-tighter leading-[0.8] mb-8 md:mb-12 uppercase text-white animate-fade-in"
        >
            {trainer.name.split(" ")[0]}<br />
            <span class="text-transparent border-text"
                >{trainer.name.split(" ").slice(1).join(" ")}</span
            >
        </h1>
        <p
            class="text-2xl md:text-6xl text-white/50 font-black italic uppercase tracking-tighter mb-12 md:mb-20 max-w-2xl"
        >
            {trainer.tagline}
        </p>
        <button
            class="w-full md:w-auto px-10 md:px-20 py-6 md:py-8 bg-white text-black font-black italic uppercase text-xl md:text-3xl hover:bg-red-600 hover:text-white transition-all skew-x-[-10deg] shadow-[10px_10px_0px_#cc0000] active:translate-y-1 active:shadow-none"
            >START TRANSFORMATION</button
        >
    </div>
</section>

<style>
    .border-text {
        -webkit-text-stroke: 2px white;
    }
</style>
