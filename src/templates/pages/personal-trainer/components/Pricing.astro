---

<!-- PRICING / START NOW -->
<section class="py-24 bg-yellow-500 text-black px-4 relative overflow-hidden">
    <!-- Grunge Texture Overlay -->
    <div
        class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/concrete-wall.png')]"
    >
    </div>

    <div class="max-w-4xl mx-auto relative z-10 text-center">
        <h2
            class="text-6xl md:text-9xl font-black italic uppercase leading-[0.85] tracking-tighter mb-12 transform -rotate-2"
        >
            COMECE<br />AGORA
        </h2>

        <div
            class="bg-black text-white p-8 md:p-12 transform rotate-1 border-4 border-white shadow-[20px_20px_0px_rgba(255,255,255,0.2)]"
        >
            <div
                class="text-xl font-bold uppercase tracking-widest text-yellow-500 mb-4"
            >
                Plano Consultoria Online
            </div>
            <div class="text-5xl md:text-7xl font-black mb-8 italic">
                R$ 297<span class="text-2xl text-zinc-500 not-italic"
                    >/mês</span>
            </div>

            <ul
                class="text-left max-w-md mx-auto space-y-4 mb-12 font-bold text-lg"
            >
                <li class="flex gap-4 items-center">
                    <span class="text-yellow-500 text-2xl">✓</span> Treinos Personalizados
                    no App
                </li>
                <li class="flex gap-4 items-center">
                    <span class="text-yellow-500 text-2xl">✓</span> Plano Alimentar
                    Flexível
                </li>
                <li class="flex gap-4 items-center">
                    <span class="text-yellow-500 text-2xl">✓</span> Suporte WhatsApp
                    24h
                </li>
                <li class="flex gap-4 items-center">
                    <span class="text-yellow-500 text-2xl">✓</span> Análise de Execução
                    de Movimentos
                </li>
            </ul>

            <button
                class="w-full py-6 bg-yellow-500 text-black text-3xl font-black italic uppercase hover:bg-white hover:text-black transition-all hover:scale-105 shadow-[10px_10px_0px_#333]"
            >
                QUERO MUDAR MEU CORPO
            </button>
            <p
                class="mt-4 text-zinc-500 text-xs uppercase font-bold tracking-widest"
            >
                Sem fidelidade. Cancele quando quiser.
            </p>
        </div>
    </div>
</section>
