---
const agenda = [
    { time: '19:00', title: 'O Fim dos Juniors', desc: 'Como a IA redefiniu a senioridade no mercado tech.' },
    { time: '19:40', title: 'Arquitetura de Agentes', desc: 'Construindo sistemas autônomos que realmente funcionam.' },
    { time: '20:30', title: 'Live Coding', desc: 'Criando um SaaS com RAG e LangChain do zero.' },
    { time: '21:15', title: 'Q&A Estratégico', desc: 'Mentoria ao vivo com os maiores nomes do setor.' },
];
---

<div class="mt-32 md:mt-48 max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-5xl font-black tracking-tighter text-center mb-20 uppercase">
        Cronograma <span class="text-red-600">Intensivo</span>
    </h2>

    <div class="space-y-12 relative">
        <!-- Connector Line -->
        <div class="absolute left-[27px] top-4 bottom-4 w-[2px] bg-zinc-800"></div>

        {agenda.map((item, index) => (
            <div class="relative pl-20 group">
                <!-- Dot -->
                <div class="absolute left-0 top-0 size-[56px] rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center group-hover:border-red-600 group-hover:scale-110 transition-all duration-300 z-10">
                    <span class="text-xs font-mono text-zinc-500 group-hover:text-white transition-colors">{index + 1}</span>
                </div>

                <div class="bg-zinc-900/50 border border-white/5 p-8 rounded-2xl group-hover:border-white/10 transition-colors">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-2">
                        <h3 class="text-xl font-bold text-white group-hover:text-red-500 transition-colors">
                            {item.title}
                        </h3>
                        <span class="font-mono text-sm text-red-500 px-3 py-1 bg-red-500/10 rounded w-fit">
                            {item.time}
                        </span>
                    </div>
                    <p class="text-zinc-400">
                        {item.desc}
                    </p>
                </div>
            </div>
        ))}
    </div>
</div>
