---

---

<!-- CONTACT SECTION -->
<section class="py-32 md:py-48 px-8 md:px-16 bg-zinc-950 text-white">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20">
            <!-- Left: Info -->
            <div>
                <div class="flex items-center gap-6 mb-8">
                    <div class="h-px w-24 bg-white/20"></div>
                    <span
                        class="text-xs tracking-[0.3em] uppercase text-white/60 font-light"
                        >Contato</span
                    >
                </div>

                <h2 class="font-serif text-6xl md:text-8xl leading-tight mb-12">
                    Agende sua<br />
                    <span class="italic font-light text-white/40"
                        >visita privativa</span
                    >
                </h2>

                <p
                    class="text-2xl text-white/80 leading-relaxed mb-16 font-light"
                >
                    Nossa equipe de consultores especializados está pronta para
                    apresentar cada detalhe desta residência excepcional.
                    Visitas agendadas com 48h de antecedência.
                </p>

                <!-- Contact Methods -->
                <div class="space-y-8 mb-16">
                    {
                        [
                            {
                                icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
                                label: "Telefone",
                                value: "+55 (11) 9 8765-4321",
                                sublabel: "WhatsApp disponível 24/7",
                            },
                            {
                                icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
                                label: "Email",
                                value: "exclusive@luxuryproperties.com",
                                sublabel: "Resposta em até 2 horas",
                            },
                            {
                                icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
                                label: "Showroom",
                                value: "Av. Paulista, 1000 - São Paulo",
                                sublabel: "Seg-Sex: 9h-19h | Sáb: 10h-16h",
                            },
                        ].map((method) => (
                            <div class="flex gap-6 group cursor-pointer">
                                <div class="flex-shrink-0 w-16 h-16 rounded-full border-2 border-white/20 flex items-center justify-center group-hover:bg-white group-hover:border-white transition-all">
                                    <svg
                                        class="w-8 h-8 text-white/60 group-hover:text-zinc-900 transition-colors"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1.5"
                                            d={method.icon}
                                        />
                                    </svg>
                                </div>
                                <div class="flex-1">
                                    <div class="text-xs tracking-[0.3em] uppercase text-white/40 mb-2">
                                        {method.label}
                                    </div>
                                    <div class="font-serif text-2xl mb-1 group-hover:text-white/80 transition-colors">
                                        {method.value}
                                    </div>
                                    <div class="text-sm text-white/60">
                                        {method.sublabel}
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>

                <!-- Broker Info -->
                <div
                    class="p-8 bg-white/5 border border-white/10 backdrop-blur-sm rounded-2xl"
                >
                    <div class="flex items-center gap-6 mb-6">
                        <img
                            src="https://api.dicebear.com/7.x/avataaars/svg?seed=broker"
                            alt="Broker"
                            class="w-20 h-20 rounded-full border-2 border-white/20"
                        />
                        <div>
                            <div class="font-serif text-2xl mb-1">
                                Ricardo Almeida
                            </div>
                            <div class="text-sm text-white/60">
                                Consultor Sênior | CRECI 123.456
                            </div>
                        </div>
                    </div>
                    <p class="text-white/80 leading-relaxed mb-6">
                        Especialista em imóveis de alto padrão com 15 anos de
                        experiência. Responsável por mais de R$ 2 bilhões em
                        transações de luxo.
                    </p>
                    <button
                        class="w-full py-4 bg-white text-zinc-900 font-black uppercase text-sm tracking-wider hover:bg-white/90 transition-all"
                    >
                        FALAR COM RICARDO
                    </button>
                </div>
            </div>

            <!-- Right: Form -->
            <div class="bg-white text-zinc-900 p-12 rounded-3xl">
                <h3 class="font-serif text-4xl mb-8">Solicite Informações</h3>

                <form class="space-y-6">
                    <!-- Name -->
                    <div>
                        <label
                            class="block text-xs tracking-[0.3em] uppercase text-zinc-500 mb-3 font-medium"
                        >
                            Nome Completo *
                        </label>
                        <input
                            type="text"
                            placeholder="João Silva"
                            class="w-full px-6 py-4 bg-zinc-50 border-2 border-zinc-200 rounded-xl focus:border-zinc-900 outline-none transition-all text-lg"
                            required
                        />
                    </div>

                    <!-- Email -->
                    <div>
                        <label
                            class="block text-xs tracking-[0.3em] uppercase text-zinc-500 mb-3 font-medium"
                        >
                            Email *
                        </label>
                        <input
                            type="email"
                            placeholder="joao@email.com"
                            class="w-full px-6 py-4 bg-zinc-50 border-2 border-zinc-200 rounded-xl focus:border-zinc-900 outline-none transition-all text-lg"
                            required
                        />
                    </div>

                    <!-- Phone -->
                    <div>
                        <label
                            class="block text-xs tracking-[0.3em] uppercase text-zinc-500 mb-3 font-medium"
                        >
                            Telefone *
                        </label>
                        <input
                            type="tel"
                            placeholder="+55 (11) 9 8765-4321"
                            class="w-full px-6 py-4 bg-zinc-50 border-2 border-zinc-200 rounded-xl focus:border-zinc-900 outline-none transition-all text-lg"
                            required
                        />
                    </div>

                    <!-- Interest -->
                    <div>
                        <label
                            class="block text-xs tracking-[0.3em] uppercase text-zinc-500 mb-3 font-medium"
                        >
                            Interesse
                        </label>
                        <select
                            class="w-full px-6 py-4 bg-zinc-50 border-2 border-zinc-200 rounded-xl focus:border-zinc-900 outline-none transition-all text-lg"
                        >
                            <option>Agendar Visita Presencial</option>
                            <option>Tour Virtual 360°</option>
                            <option>Receber Documentação</option>
                            <option>Proposta de Compra</option>
                            <option>Consultoria Financeira</option>
                        </select>
                    </div>

                    <!-- Message -->
                    <div>
                        <label
                            class="block text-xs tracking-[0.3em] uppercase text-zinc-500 mb-3 font-medium"
                        >
                            Mensagem
                        </label>
                        <textarea
                            rows="4"
                            placeholder="Conte-nos mais sobre seu interesse..."
                            class="w-full px-6 py-4 bg-zinc-50 border-2 border-zinc-200 rounded-xl focus:border-zinc-900 outline-none transition-all text-lg resize-none"
                        ></textarea>
                    </div>

                    <!-- Privacy -->
                    <div class="flex items-start gap-3">
                        <input
                            type="checkbox"
                            id="privacy"
                            class="mt-1 w-5 h-5 rounded border-2 border-zinc-300"
                            required
                        />
                        <label
                            for="privacy"
                            class="text-sm text-zinc-600 leading-relaxed"
                        >
                            Concordo em receber comunicações sobre este e outros
                            imóveis exclusivos. Seus dados estão protegidos pela
                            LGPD.
                        </label>
                    </div>

                    <!-- Submit -->
                    <button
                        type="submit"
                        class="w-full py-6 bg-zinc-900 text-white font-black uppercase tracking-wider text-lg hover:bg-zinc-800 transition-all rounded-xl"
                    >
                        ENVIAR SOLICITAÇÃO
                    </button>

                    <p
                        class="text-xs text-center text-zinc-500 leading-relaxed"
                    >
                        🔒 Suas informações são confidenciais e nunca serão
                        compartilhadas.<br />
                        Retornaremos em até 2 horas úteis.
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>
