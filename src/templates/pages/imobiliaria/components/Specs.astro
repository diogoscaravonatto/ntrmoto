---
const property = {
    price: "R$ 12.500.000",
    specs: ["4 Quartos", "6 Banheiros", "800m² Área", "4 Vagas"],
};
---

<section class="bg-zinc-950 py-16 px-6 border-b border-white/5">
    <div
        class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-12"
    >
        <div class="flex gap-12 flex-wrap">
            {
                property.specs.map((spec) => (
                    <div class="flex flex-col gap-2">
                        <span class="text-[10px] font-black text-zinc-500 uppercase tracking-widest">
                            {spec.split(" ")[1]}
                        </span>
                        <span class="text-3xl font-black text-white italic leading-none">
                            {spec.split(" ")[0]}
                        </span>
                    </div>
                ))
            }
        </div>
        <div class="h-20 w-px bg-white/10 hidden lg:block"></div>
        <div class="flex flex-col gap-2">
            <span
                class="text-[10px] font-black text-zinc-500 uppercase tracking-widest"
                >ASKSING PRICE</span
            >
            <span class="text-5xl font-black text-white italic"
                >{property.price}</span
            >
        </div>
    </div>
</section>
