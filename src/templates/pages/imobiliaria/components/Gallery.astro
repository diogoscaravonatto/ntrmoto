---

---

<!-- GALLERY SECTION -->
<section class="py-32 md:py-48 px-8 md:px-16 bg-[#f5f1eb]">
    <div class="max-w-[1800px] mx-auto">
        <!-- Section Header -->
        <div class="mb-24">
            <div class="flex items-center gap-6 mb-8">
                <div class="h-px w-24 bg-zinc-300"></div>
                <span
                    class="text-xs tracking-[0.3em] uppercase text-zinc-500 font-light"
                    >Visual Tour</span
                >
            </div>
            <h2
                class="font-serif text-6xl md:text-9xl leading-tight text-zinc-900 max-w-5xl"
            >
                Cada detalhe foi<br />
                <span class="italic font-light text-zinc-400"
                    >pensado para você</span
                >
            </h2>
        </div>

        <!-- Masonry Gallery -->
        <div class="grid grid-cols-12 gap-6">
            <!-- Large Image 1 -->
            <div
                class="col-span-12 md:col-span-7 aspect-[16/10] relative overflow-hidden group"
            >
                <img
                    src="https://images.unsplash.com/photo-1600607687644-c7171b42498f?auto=format&fit=crop&w=1600&q=80"
                    alt="Living Room"
                    class="w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-105"
                />
                <div
                    class="absolute bottom-0 left-0 right-0 p-8 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
                >
                    <div class="text-white">
                        <div
                            class="text-xs tracking-[0.3em] uppercase mb-2 opacity-80"
                        >
                            Sala de Estar
                        </div>
                        <div class="font-serif text-2xl">
                            Pé-direito duplo com 6 metros de altura
                        </div>
                    </div>
                </div>
            </div>

            <!-- Small Image 1 -->
            <div
                class="col-span-6 md:col-span-5 aspect-square relative overflow-hidden group"
            >
                <img
                    src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=800&q=80"
                    alt="Kitchen"
                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                />
                <div
                    class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/40 transition-all"
                >
                    <div
                        class="text-white opacity-0 group-hover:opacity-100 transition-opacity text-center"
                    >
                        <div class="font-serif text-xl">Cozinha Gourmet</div>
                    </div>
                </div>
            </div>

            <!-- Small Image 2 -->
            <div
                class="col-span-6 md:col-span-5 aspect-square relative overflow-hidden group"
            >
                <img
                    src="https://images.unsplash.com/photo-1600585154526-990dced4db0d?auto=format&fit=crop&w=800&q=80"
                    alt="Bedroom"
                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                />
                <div
                    class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/40 transition-all"
                >
                    <div
                        class="text-white opacity-0 group-hover:opacity-100 transition-opacity text-center"
                    >
                        <div class="font-serif text-xl">Suíte Master</div>
                    </div>
                </div>
            </div>

            <!-- Medium Image -->
            <div
                class="col-span-12 md:col-span-7 aspect-[16/9] relative overflow-hidden group"
            >
                <img
                    src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1600&q=80"
                    alt="Bathroom"
                    class="w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-105"
                />
                <div
                    class="absolute bottom-0 left-0 right-0 p-8 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
                >
                    <div class="text-white">
                        <div
                            class="text-xs tracking-[0.3em] uppercase mb-2 opacity-80"
                        >
                            Banheiro
                        </div>
                        <div class="font-serif text-2xl">
                            Mármore Carrara importado da Itália
                        </div>
                    </div>
                </div>
            </div>

            <!-- Info Card -->
            <div
                class="col-span-12 md:col-span-5 bg-zinc-900 text-white p-12 flex flex-col justify-between"
            >
                <div>
                    <div
                        class="text-xs tracking-[0.3em] uppercase text-white/60 mb-6"
                    >
                        Tour Virtual
                    </div>
                    <h3 class="font-serif text-4xl mb-6 leading-tight">
                        Conheça cada ambiente em realidade virtual
                    </h3>
                    <p class="text-white/80 leading-relaxed mb-8">
                        Agende uma visita guiada em 360° com nossa equipe de
                        consultores especializados. Disponível também para
                        clientes internacionais.
                    </p>
                </div>
                <button
                    class="w-full py-4 border-2 border-white/20 text-xs tracking-[0.2em] uppercase font-medium hover:bg-white hover:text-zinc-900 transition-all"
                >
                    AGENDAR TOUR VIRTUAL
                </button>
            </div>

            <!-- Wide Image -->
            <div
                class="col-span-12 aspect-[21/9] relative overflow-hidden group"
            >
                <img
                    src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=80"
                    alt="View"
                    class="w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-105"
                />
                <div
                    class="absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/30 transition-all"
                >
                    <div
                        class="text-white text-center opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                        <div class="font-serif text-5xl md:text-7xl mb-4">
                            Vista Panorâmica
                        </div>
                        <div
                            class="text-xs tracking-[0.3em] uppercase opacity-80"
                        >
                            180° de oceano
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom CTA -->
        <div class="mt-24 text-center">
            <p class="text-zinc-500 mb-8 text-lg">
                +47 ambientes fotografados profissionalmente
            </p>
            <button
                class="px-16 py-6 bg-zinc-950 text-white font-black italic uppercase text-xl hover:bg-zinc-800 transition-all"
            >
                VER GALERIA COMPLETA
            </button>
        </div>
    </div>
</section>
