---

---

<!-- LUXURY FEATURES - EDITORIAL LAYOUT -->
<section class="py-32 md:py-48 px-8 md:px-16 bg-white">
    <div class="max-w-[1600px] mx-auto">
        <!-- Section Header -->
        <div class="mb-24 md:mb-32">
            <div class="flex items-center gap-6 mb-8">
                <div class="h-px w-24 bg-zinc-300"></div>
                <span
                    class="text-xs tracking-[0.3em] uppercase text-zinc-500 font-light"
                    >The Experience</span
                >
            </div>
            <h2
                class="font-serif text-6xl md:text-8xl leading-tight text-zinc-900 max-w-4xl"
            >
                Uma residência que<br />
                <span class="italic font-light text-zinc-400"
                    >redefine o conceito</span
                ><br />
                de exclusividade
            </h2>
        </div>

        <!-- Feature Grid -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
            <!-- Large Feature Image -->
            <div class="md:col-span-7 space-y-8">
                <div class="aspect-4/5 relative overflow-hidden group">
                    <img
                        src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=80"
                        alt="Interior"
                        class="w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-105"
                    />
                    <div
                        class="absolute bottom-0 left-0 right-0 p-8 bg-gradient-to-t from-black/60 to-transparent"
                    >
                        <div
                            class="text-xs tracking-[0.3em] uppercase text-white/80 font-light mb-2"
                        >
                            01 / Architecture
                        </div>
                        <div class="font-serif text-3xl text-white">
                            Minimalismo Atemporal
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-8">
                    <div class="aspect-square relative overflow-hidden group">
                        <img
                            src="https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&w=800&q=80"
                            alt="Kitchen"
                            class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                        />
                    </div>
                    <div
                        class="aspect-square bg-zinc-100 p-8 flex flex-col justify-between"
                    >
                        <div>
                            <div class="font-serif text-5xl text-zinc-900 mb-4">
                                450m²
                            </div>
                            <div
                                class="text-xs tracking-[0.3em] uppercase text-zinc-500 font-light"
                            >
                                Área Construída
                            </div>
                        </div>
                        <div class="h-px w-16 bg-zinc-300"></div>
                    </div>
                </div>
            </div>

            <!-- Feature List -->
            <div class="md:col-span-5 flex flex-col justify-between">
                <div class="space-y-16">
                    <!-- Feature 1 -->
                    <div class="group cursor-pointer">
                        <div class="flex items-start gap-6 mb-6">
                            <div
                                class="w-12 h-12 rounded-full border border-zinc-200 flex items-center justify-center text-xs font-light group-hover:bg-zinc-900 group-hover:text-white group-hover:border-zinc-900 transition-all"
                            >
                                01
                            </div>
                            <div class="flex-1">
                                <h3
                                    class="font-serif text-3xl text-zinc-900 mb-4 group-hover:text-zinc-600 transition-colors"
                                >
                                    Design Assinado
                                </h3>
                                <p
                                    class="text-zinc-600 leading-relaxed font-light"
                                >
                                    Projeto arquitetônico exclusivo desenvolvido
                                    pelo renomado escritório Herzog & de Meuron,
                                    vencedor do Pritzker Prize. Cada detalhe foi
                                    pensado para criar uma experiência sensorial
                                    única.
                                </p>
                            </div>
                        </div>
                        <div
                            class="h-px w-full bg-zinc-200 group-hover:bg-zinc-900 transition-colors"
                        >
                        </div>
                    </div>

                    <!-- Feature 2 -->
                    <div class="group cursor-pointer">
                        <div class="flex items-start gap-6 mb-6">
                            <div
                                class="w-12 h-12 rounded-full border border-zinc-200 flex items-center justify-center text-xs font-light group-hover:bg-zinc-900 group-hover:text-white group-hover:border-zinc-900 transition-all"
                            >
                                02
                            </div>
                            <div class="flex-1">
                                <h3
                                    class="font-serif text-3xl text-zinc-900 mb-4 group-hover:text-zinc-600 transition-colors"
                                >
                                    Sustentabilidade Premium
                                </h3>
                                <p
                                    class="text-zinc-600 leading-relaxed font-light"
                                >
                                    Certificação LEED Platinum com sistema de
                                    captação de água da chuva, painéis solares
                                    integrados e automação inteligente que reduz
                                    o consumo energético em até 70%.
                                </p>
                            </div>
                        </div>
                        <div
                            class="h-px w-full bg-zinc-200 group-hover:bg-zinc-900 transition-colors"
                        >
                        </div>
                    </div>

                    <!-- Feature 3 -->
                    <div class="group cursor-pointer">
                        <div class="flex items-start gap-6 mb-6">
                            <div
                                class="w-12 h-12 rounded-full border border-zinc-200 flex items-center justify-center text-xs font-light group-hover:bg-zinc-900 group-hover:text-white group-hover:border-zinc-900 transition-all"
                            >
                                03
                            </div>
                            <div class="flex-1">
                                <h3
                                    class="font-serif text-3xl text-zinc-900 mb-4 group-hover:text-zinc-600 transition-colors"
                                >
                                    Localização Privilegiada
                                </h3>
                                <p
                                    class="text-zinc-600 leading-relaxed font-light"
                                >
                                    Situada no ponto mais nobre da costa, com
                                    vista panorâmica para o oceano. Acesso
                                    privativo à praia e heliponto exclusivo para
                                    residentes.
                                </p>
                            </div>
                        </div>
                        <div
                            class="h-px w-full bg-zinc-200 group-hover:bg-zinc-900 transition-colors"
                        >
                        </div>
                    </div>
                </div>

                <!-- CTA Card -->
                <div class="mt-16 p-8 bg-zinc-900 text-white">
                    <div
                        class="text-xs tracking-[0.3em] uppercase text-white/60 font-light mb-4"
                    >
                        Agende sua visita
                    </div>
                    <div class="font-serif text-2xl mb-6">
                        Experiência personalizada com nosso time de consultores
                    </div>
                    <button
                        class="w-full py-4 border border-white/20 text-xs tracking-[0.2em] uppercase font-medium hover:bg-white hover:text-zinc-900 transition-all"
                    >
                        SOLICITAR AGENDAMENTO
                    </button>
                </div>
            </div>
        </div>

        <!-- Bottom Quote -->
        <div class="mt-32 pt-16 border-t border-zinc-200">
            <div class="max-w-4xl">
                <blockquote
                    class="font-serif text-4xl md:text-5xl text-zinc-900 leading-tight mb-8"
                >
                    "A arquitetura deve falar de seu tempo e lugar, mas almejar
                    a atemporalidade."
                </blockquote>
                <div class="flex items-center gap-4">
                    <div class="h-px w-16 bg-zinc-300"></div>
                    <cite
                        class="text-xs tracking-[0.3em] uppercase text-zinc-500 font-light not-italic"
                        >Frank Gehry, Arquiteto</cite
                    >
                </div>
            </div>
        </div>
    </div>
</section>
