---
import { Image } from "astro:assets";
---

<!-- PREMIUM LEGAL HERO -->
<section
    class="relative min-h-screen bg-[#050505] text-white overflow-hidden flex items-center px-6 md:px-12 py-32"
>
    <!-- Subtle Background Overlay -->
    <div class="absolute inset-0 z-0">
        <Image
            src="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=1920&q=80"
            alt="Firma de Advocacia"
            width={1920}
            height={1080}
            class="w-full h-full object-cover opacity-10"
            layout="constrained"
        />
        <div
            class="absolute inset-0 bg-linear-to-r from-black via-black/90 to-transparent"
        >
        </div>
    </div>

    <div class="max-w-[1400px] mx-auto w-full relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
            <!-- Left: Content -->
            <div class="lg:col-span-12 xl:col-span-8 text-center lg:text-left">
                <!-- Badge - METALLIC GOLD -->
                <div class="inline-flex items-center gap-6 mb-10">
                    <div
                        class="h-[2px] w-16 bg-linear-to-r from-[#9A7B2C] via-[#C5A028] to-transparent shadow-[0_0_15px_rgba(197,160,40,0.3)]"
                    >
                    </div>
                    <span
                        class="text-xs font-bold uppercase tracking-[0.5em] text-[#C5A028] filter drop-shadow-md"
                        >Escritório de Excelência</span
                    >
                </div>

                <!-- Main Title - METALLIC TEXT -->
                <h1
                    class="text-6xl md:text-9xl font-serif leading-[0.95] mb-12 tracking-tight"
                >
                    <span class="metallic-text">Liderança</span><br />
                    <span class="text-white opacity-95">Jurídica.</span><br />
                    <span class="italic metallic-text-soft">Autoridade.</span>
                </h1>

                <p
                    class="text-xl md:text-2xl font-light leading-relaxed mb-16 max-w-2xl text-zinc-400 border-l border-[#C5A028]/40 pl-10"
                >
                    Atuamos na <span class="text-[#E5C07B]"
                        >proteção estratégica</span
                    > de grandes corporações e patrimônios familiares de alto vulto,
                    entregando segurança onde outros veem incerteza.
                </p>

                <!-- Stats Row - PREMIUM BRONZE GOLD -->
                <div
                    class="grid grid-cols-1 sm:grid-cols-3 gap-16 mb-20 justify-center lg:justify-start"
                >
                    {
                        [
                            {
                                value: "R$ 3.5Bi",
                                label: "Patrimônio Protegido",
                            },
                            { value: "95%", label: "Taxa de Sucesso" },
                            { value: "20+", label: "Anos de Tradição" },
                        ].map((stat) => (
                            <div class="relative group">
                                <div class="text-5xl md:text-6xl font-serif metallic-text mb-3">
                                    {stat.value}
                                </div>
                                <div class="text-[10px] font-bold uppercase tracking-[0.4em] text-zinc-500">
                                    {stat.label}
                                </div>
                                <div class="absolute -left-8 top-0 bottom-0 w-[1px] bg-linear-to-b from-[#C5A028]/50 to-transparent" />
                            </div>
                        ))
                    }
                </div>

                <!-- CTAs - REFINED METALLIC -->
                <div
                    class="flex flex-col sm:flex-row gap-10 justify-center lg:justify-start"
                >
                    <button
                        class="metallic-btn px-14 py-6 text-black font-bold uppercase text-sm tracking-[0.4em] transition-all duration-500 shadow-2xl"
                    >
                        Agendar Consultoria
                    </button>
                    <button
                        class="px-14 py-6 border border-[#C5A028]/50 text-[#C5A028] font-bold uppercase text-sm tracking-[0.4em] hover:bg-[#C5A028] hover:text-black transition-all duration-500"
                    >
                        Nossas Práticas
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Metallic Gold Colors */
    .metallic-text {
        background: linear-gradient(
            135deg,
            #9a7b2c 0%,
            #c5a028 25%,
            #e5c07b 50%,
            #c5a028 75%,
            #9a7b2c 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-size: 200% auto;
        animation: shine 5s linear infinite;
    }

    .metallic-text-soft {
        color: #c5a028;
        filter: drop-shadow(0 0 10px rgba(197, 160, 40, 0.2));
    }

    .metallic-btn {
        background: linear-gradient(
            135deg,
            #9a7b2c 0%,
            #c5a028 50%,
            #9a7b2c 100%
        );
        background-size: 200% auto;
    }
    .metallic-btn:hover {
        background-position: right center;
        box-shadow: 0 0 40px rgba(197, 160, 40, 0.4);
        transform: translateY(-2px);
    }

    @keyframes shine {
        to {
            background-position: 200% center;
        }
    }
</style>
