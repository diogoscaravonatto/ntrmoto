---

<nav
    class="fixed top-0 left-0 w-full z-50 px-8 py-6 md:px-12 md:py-8 flex justify-between items-center transition-all duration-500 bg-transparent"
    id="premium-nav"
>
    <!-- Logo - Formal -->
    <div class="flex items-center gap-4">
        <div
            class="w-10 h-10 border border-[#C5A028] flex items-center justify-center"
        >
            <span class="text-xs font-serif text-[#C5A028]">M&A</span>
        </div>
        <div class="text-xl font-serif tracking-[0.2em] uppercase text-white">
            Mendes <span class="text-[#C5A028]">&</span> Assoc.
        </div>
    </div>

    <!-- Navigation Links -->
    <div
        class="hidden lg:flex gap-12 text-[10px] font-bold uppercase tracking-[0.4em] text-zinc-400"
    >
        <a href="#" class="hover:text-[#C5A028] transition-colors">Expertise</a>
        <a href="#" class="hover:text-[#C5A028] transition-colors"
            >Corpo Jurídico</a
        >
        <a href="#" class="hover:text-[#C5A028] transition-colors">Manifesto</a>
        <a href="#" class="hover:text-[#C5A028] transition-colors">Contato</a>
    </div>

    <!-- Right Side -->
    <div class="flex items-center gap-8">
        <button
            class="hidden sm:block px-6 py-2 border border-[#C5A028] text-[10px] font-bold uppercase tracking-widest text-[#C5A028] hover:bg-[#C5A028] hover:text-black hover:shadow-[0_0_20px_rgba(197,160,40,0.4)] transition-all duration-300 active:scale-95"
        >
            Consultoria Online
        </button>
        <!-- Mobile Menu Icon (Simplified) -->
        <div
            class="lg:hidden w-8 flex flex-col gap-1.5 opacity-70 cursor-pointer"
        >
            <div class="h-px w-full bg-[#C5A028]"></div>
            <div class="h-px w-2/3 bg-[#C5A028]"></div>
        </div>
    </div>
</nav>

<script>
    const nav = document.getElementById("premium-nav");
    window.addEventListener("scroll", () => {
        if (!nav) return;
        if (window.scrollY > 50) {
            nav.classList.add(
                "bg-black/90",
                "backdrop-blur-xl",
                "py-4",
                "border-b",
                "border-white/5",
            );
            nav.classList.remove("py-8");
        } else {
            nav.classList.remove(
                "bg-black/90",
                "backdrop-blur-xl",
                "py-4",
                "border-b",
                "border-white/5",
            );
            nav.classList.add("py-8");
        }
    });
</script>

<style>
    /* Consolidating Metallic Theme */
    .hover\:text-black:hover {
        color: #000 !important;
    }
    .hover\:bg-\[\#C5A028\]:hover {
        background-color: #c5a028 !important;
    }
</style>
