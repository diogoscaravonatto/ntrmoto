---
import { Image } from "astro:assets";
---

<!-- PREMIUM TEAM SECTION -->
<section class="py-32 bg-black text-white px-6 md:px-12">
    <div class="max-w-[1400px] mx-auto">
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row justify-between items-end mb-24 gap-12">
            <div class="max-w-2xl">
                <h2 class="text-xs font-bold uppercase tracking-[0.5em] text-[#C5A028] mb-6">Conselho Superior</h2>
                <h3 class="text-5xl md:text-7xl font-serif leading-[1.1] tracking-tight">
                    Sócios <span class="italic metallic-text">Estratégicos</span>.
                </h3>
            </div>
            <p class="text-zinc-500 max-w-sm text-lg font-light leading-relaxed border-l border-[#C5A028]/30 pl-8">
                Lideranças com trânsito nas mais altas cortes e histórico comprovado na resolução de conflitos corporativos.
            </p>
        </div>

        <!-- Team grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
            {[
                {
                    name: "Dr. Carlos Mendes",
                    role: "Sócio Fundador | Tributário",
                    image: "https://images.unsplash.com/photo-1556157382-97eda2d62296?auto=format&fit=crop&w=800&q=80",
                    info: "PhD pela USP, 25 anos de carreira"
                },
                {
                    name: "Dra. Ana Paula",
                    role: "Sócia | M&A e Societário",
                    image: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=80",
                    info: "Mestre por Harvard Law School"
                },
                {
                    name: "Dr. Roberto Silva",
                    role: "Sócio | Contencioso Cível",
                    image: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=800&q=80",
                    info: "Especialista em Arbitragem Internacional"
                },
                {
                    name: "Dra. Júlia Costa",
                    role: "Sócia | Direito Digital",
                    image: "https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=800&q=80",
                    info: "Conselheira de Segurança de Dados"
                }
            ].map((member) => (
                <div class="group">
                    <div class="aspect-3/4 mb-8 relative overflow-hidden bg-zinc-900 border border-white/5">
                        <Image 
                            src={member.image} 
                            alt={member.name}
                            width={600}
                            height={800}
                            class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
                            layout="constrained"
                        />
                        <div class="absolute inset-0 bg-linear-to-t from-black via-transparent to-transparent opacity-80"></div>
                        <!-- Corner Accent -->
                        <div class="absolute top-0 right-0 w-8 h-8 border-t border-r border-[#C5A028]/0 group-hover:border-[#C5A028]/50 transition-all duration-500"></div>
                    </div>
                    
                    <h4 class="text-2xl font-serif text-white mb-2 tracking-tight group-hover:text-[#C5A028] transition-colors">{member.name}</h4>
                    <div class="text-[10px] font-bold uppercase tracking-[0.3em] text-[#C5A028] mb-4">{member.role}</div>
                    <p class="text-sm text-zinc-500 font-light italic">{member.info}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .metallic-text {
        background: linear-gradient(135deg, #9A7B2C 0%, #C5A028 50%, #E5C07B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>
