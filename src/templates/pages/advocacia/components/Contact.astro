---

---

<!-- PREMIUM CONTACT SECTION -->
<section
    class="py-32 bg-[#050505] text-white px-6 md:px-12 relative overflow-hidden"
>
    <!-- Decorative Subtle Glow -->
    <div
        class="absolute -bottom-48 -right-48 w-96 h-96 bg-gold-900/5 rounded-full blur-[120px]"
    >
    </div>

    <div class="max-w-[1400px] mx-auto relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-32">
            <!-- Left Info -->
            <div class="flex flex-col justify-between">
                <div>
                    <h2
                        class="text-xs font-bold uppercase tracking-[0.5em] text-[#C5A028] mb-8"
                    >
                        Consulte-nos
                    </h2>
                    <h3
                        class="text-5xl md:text-8xl font-serif leading-[0.9] tracking-tighter mb-12"
                    >
                        Inicie sua <br />
                        <span class="italic metallic-text">Defesa</span>.
                    </h3>
                    <p
                        class="text-xl text-zinc-500 font-light leading-relaxed mb-16 max-w-lg"
                    >
                        Disponibilidade imediata para casos de urgência.
                        Atendimento exclusivo e sob total sigilo profissional.
                    </p>

                    <div class="space-y-10">
                        <div class="flex items-start gap-8 group">
                            <div class="mt-1 text-[#C5A028]">
                                <svg
                                    class="w-6 h-6"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                    ></path></svg
                                >
                            </div>
                            <div>
                                <div
                                    class="text-[10px] font-bold uppercase tracking-[0.4em] text-zinc-600 mb-2"
                                >
                                    Central 24h
                                </div>
                                <div
                                    class="text-2xl font-serif text-white group-hover:text-[#C5A028] transition-colors"
                                >
                                    +55 11 3000-0000
                                </div>
                            </div>
                        </div>

                        <div class="flex items-start gap-8 group">
                            <div class="mt-1 text-[#C5A028]">
                                <svg
                                    class="w-6 h-6"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.5"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path></svg
                                >
                            </div>
                            <div>
                                <div
                                    class="text-[10px] font-bold uppercase tracking-[0.4em] text-zinc-600 mb-2"
                                >
                                    Sede Principal
                                </div>
                                <div
                                    class="text-2xl font-serif text-white group-hover:text-[#C5A028] transition-colors"
                                >
                                    Av. Brigadeiro Faria Lima, 4500 <br /> São Paulo
                                    — SP
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div
                    class="mt-20 pt-10 border-t border-zinc-900 flex gap-12 font-bold uppercase tracking-widest text-[10px] text-zinc-600"
                >
                    <a href="#" class="hover:text-[#C5A028] transition-colors"
                        >LinkedIn</a
                    >
                    <a href="#" class="hover:text-[#C5A028] transition-colors"
                        >Digital Press</a
                    >
                    <a href="#" class="hover:text-[#C5A028] transition-colors"
                        >Privacy Policy</a
                    >
                </div>
            </div>

            <!-- Right Form - WITH GOLDEN FOCUS -->
            <div
                class="bg-zinc-950 p-12 md:p-16 border border-white/5 shadow-2xl relative group"
            >
                <div
                    class="absolute top-0 right-0 w-32 h-32 bg-[#C5A028]/5 -z-10 blur-3xl"
                >
                </div>
                <h4 class="text-3xl font-serif text-white mb-12 tracking-tight">
                    Agendar Consulta
                </h4>

                <form class="space-y-8">
                    <div
                        class="space-y-2 border-b border-zinc-800 focus-within:border-[#C5A028] transition-colors pb-4"
                    >
                        <label
                            class="block text-[10px] font-bold uppercase tracking-[0.3em] text-zinc-600 focus-within:text-[#C5A028]"
                            >Nome do Solicitante</label
                        >
                        <input
                            type="text"
                            class="w-full bg-transparent border-none p-0 text-white font-light text-lg focus:ring-0 placeholder-zinc-800"
                            placeholder="Ex: João Silva"
                        />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div
                            class="space-y-2 border-b border-zinc-800 focus-within:border-[#C5A028] transition-colors pb-4"
                        >
                            <label
                                class="block text-[10px] font-bold uppercase tracking-[0.3em] text-zinc-600"
                                >Email Corporativo</label
                            >
                            <input
                                type="email"
                                class="w-full bg-transparent border-none p-0 text-white font-light text-lg focus:ring-0 placeholder-zinc-800"
                                placeholder="empresa@exemplo.com"
                            />
                        </div>
                        <div
                            class="space-y-2 border-b border-zinc-800 focus-within:border-[#C5A028] transition-colors pb-4"
                        >
                            <label
                                class="block text-[10px] font-bold uppercase tracking-[0.3em] text-zinc-600"
                                >Telefone / WhatsApp</label
                            >
                            <input
                                type="tel"
                                class="w-full bg-transparent border-none p-0 text-white font-light text-lg focus:ring-0 placeholder-zinc-800"
                                placeholder="(11) 90000-0000"
                            />
                        </div>
                    </div>

                    <div
                        class="space-y-2 border-b border-zinc-800 focus-within:border-[#C5A028] transition-colors pb-4"
                    >
                        <label
                            class="block text-[10px] font-bold uppercase tracking-[0.3em] text-zinc-600"
                            >Resumo da Demanda Jurídica</label
                        >
                        <textarea
                            rows="4"
                            class="w-full bg-transparent border-none p-0 text-white font-light text-lg focus:ring-0 placeholder-zinc-800 resize-none"
                            placeholder="Descreva brevemente sua necessidade..."
                        ></textarea>
                    </div>

                    <button
                        class="w-full py-6 metallic-btn text-black font-bold uppercase text-sm tracking-[0.4em] transition-all duration-500"
                    >
                        Enviar Solicitação de Contato
                    </button>

                    <p
                        class="text-center text-[10px] font-medium text-zinc-600 uppercase tracking-widest"
                    >
                        Confidencialidade estrita de acordo com o Estatuto da
                        OAB.
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

<style>
    .metallic-text {
        background: linear-gradient(
            135deg,
            #9a7b2c 0%,
            #c5a028 50%,
            #e5c07b 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .metallic-btn {
        background: linear-gradient(
            135deg,
            #9a7b2c 0%,
            #c5a028 50%,
            #9a7b2c 100%
        );
        background-size: 200% auto;
    }
    .metallic-btn:hover {
        background-position: right center;
        box-shadow: 0 0 30px rgba(197, 160, 40, 0.3);
    }
</style>
