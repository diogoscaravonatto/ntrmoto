---

---

<!-- PREMIUM EXPERTISE SECTION -->
<section class="py-32 bg-[#050505] px-6 md:px-12 border-y border-[#C5A028]/10">
    <div class="max-w-[1400px] mx-auto">
        <!-- Section Header -->
        <div class="text-center mb-32">
            <div
                class="inline-block px-8 py-3 border border-[#C5A028]/30 mb-10 relative group"
            >
                <div
                    class="absolute inset-0 border border-[#C5A028]/50 translate-x-1 translate-y-1 group-hover:translate-x-0 group-hover:translate-y-0 transition-transform"
                >
                </div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.5em] text-[#C5A028]"
                    >Domínios Jurídicos</span
                >
            </div>
            <h2
                class="text-5xl md:text-8xl font-serif text-white mb-10 tracking-tight"
            >
                Soluções de <span class="italic font-light metallic-text"
                    >Alto Vulto</span
                >
            </h2>
            <div
                class="w-48 h-px bg-gradient-to-r from-transparent via-[#C5A028] to-transparent mx-auto"
            >
            </div>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                [
                    {
                        title: "Direito Corporativo",
                        desc: "Assessoria estratégica em fusões, aquisições e estruturação societária de alta complexidade.",
                        icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
                    },
                    {
                        title: "Litígios Estratégicos",
                        desc: "Representação incisiva em arbitragens e processos judiciais de grande vulto nos tribunais superiores.",
                        icon: "M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3",
                    },
                    {
                        title: "Direito Tributário",
                        desc: "Planejamento fiscal preventivo e defesa administrativa e judicial contra exigências tributárias.",
                        icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
                    },
                ].map((item) => (
                    <div class="group relative bg-[#0a0a0a] p-16 border border-white/5 hover:border-[#C5A028]/30 transition-all duration-700 overflow-hidden">
                        <div class="mb-12 text-[#C5A028] group-hover:scale-110 transition-transform duration-500">
                            <svg
                                class="w-14 h-14"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1"
                                    d={item.icon}
                                />
                            </svg>
                        </div>

                        <h3 class="text-3xl font-serif text-white mb-6 tracking-tight group-hover:text-[#C5A028] transition-colors">
                            {item.title}
                        </h3>
                        <p class="text-zinc-500 font-light leading-relaxed mb-12 text-lg">
                            {item.desc}
                        </p>

                        <a
                            href="#"
                            class="inline-flex items-center gap-4 text-[10px] font-bold uppercase tracking-[0.4em] text-[#C5A028] group-hover:text-[#E5C07B] transition-colors"
                        >
                            Protocolo de Ação{" "}
                            <span class="translate-x-0 group-hover:translate-x-4 transition-transform text-xl">
                                →
                            </span>
                        </a>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .metallic-text {
        background: linear-gradient(
            135deg,
            #9a7b2c 0%,
            #c5a028 50%,
            #e5c07b 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>
