---
import Icon from "@components/Icon.astro";

const features = [
  {
    title: 'Sincronização Real-time',
    description: 'Seus dados atualizados em todos os dispositivos, instantaneamente.',
    icon: 'lucide:zap',
    color: 'text-amber-400',
  },
  {
    title: 'Modo Offline',
    description: 'Continue trabalhando mesmo sem internet. Sincronizamos tudo depois.',
    icon: 'lucide:wifi-off',
    color: 'text-emerald-400',
  },
  {
    title: 'Criptografia Ponta-a-Ponta',
    description: 'Sua privacidade é nossa prioridade. Ninguém lê seus dados além de você.',
    icon: 'lucide:shield-check',
    color: 'text-blue-400',
  },
  {
    title: 'Colaboração',
    description: 'Convide seu time e trabalhe em projetos compartilhados sem atrito.',
    icon: 'lucide:users',
    color: 'text-purple-400',
  },
]
---

<section id="recursos" class="py-32 border-t border-white/5">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-6 text-white">
        Poderoso. Simples.
      </h2>
      <p class="text-zinc-400 text-lg font-medium">
        Removemos a complexidade para que você foque apenas no que importa: fazer acontecer.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature, i) => (
        <div
          class:list={[
            i === 0 || i === 3 ? 'lg:col-span-2' : '',
            'group p-8 rounded-3xl bg-zinc-900/50 border border-white/5 hover:border-indigo-500/30 hover:bg-zinc-900/80 transition-all duration-300 relative overflow-hidden'
          ]}
        >
          <!-- Background Icon -->
          <div
            class="absolute top-0 right-0 p-8 opacity-5 group-hover:opacity-10 transition-opacity duration-300 pointer-events-none"
          >
            <Icon name={feature.icon} class="size-32" />
          </div>

          <div
            class:list={[
                'size-12 rounded-xl flex items-center justify-center mb-6 bg-zinc-800/50 border border-white/5 group-hover:scale-110 transition-transform duration-300',
                feature.color
            ]}
          >
            <Icon name={feature.icon} class="size-6" />
          </div>

          <h3 class="text-xl font-bold mb-3 text-white">
            {feature.title}
          </h3>
          <p class="text-zinc-400 leading-relaxed font-medium">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
</section>
