---
import Icon from "@components/Icon.astro";

const stats = [
    { value: "4.9", label: "App Store" },
    { value: "2M+", label: "Downloads" },
    { value: "150k", label: "Usuários Ativos" },
];
---

<header class="pt-20 pb-32 lg:pt-32 lg:pb-48">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8 text-center lg:text-left">
            <div
                class="inline-flex items-center gap-2 bg-indigo-500/10 text-indigo-400 rounded-full px-4 py-1.5 backdrop-blur-md border border-indigo-500/20 text-xs font-semibold"
            >
                <span class="relative flex h-2 w-2 mr-2">
                    <span
                        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"
                    ></span>
                    <span
                        class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"
                    ></span>
                </span>
                V2.0 já disponível
            </div>

            <h1
                class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.05] text-white"
            >
                Organize sua vida,<br />
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-400 to-indigo-400 animate-gradient"
                >
                    sem esforço.
                </span>
            </h1>

            <p
                class="text-xl text-zinc-400 leading-relaxed max-w-lg mx-auto lg:mx-0"
            >
                O Flowstate combina tarefas, calendário e notas em um único
                lugar. Projetado para quem valoriza foco e estética.
            </p>

            <div
                class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-4"
            >
                <a
                    href="#"
                    class="bg-white text-black rounded-2xl h-16 px-8 flex items-center gap-3 shadow-[0_0_20px_rgba(255,255,255,0.15)] hover:shadow-[0_0_30px_rgba(255,255,255,0.25)] hover:scale-105 transition-all duration-300"
                >
                    <Icon name="simple-icons:apple" class="w-6 h-6" />
                    <div class="flex flex-col items-start leading-none">
                        <span
                            class="text-[10px] opacity-70 font-semibold uppercase tracking-wider"
                            >Download na</span
                        >
                        <span class="text-lg font-bold">App Store</span>
                    </div>
                </a>
            </div>

            <div
                class="flex items-center justify-center lg:justify-start gap-8 pt-8"
            >
                {
                    stats.map((stat) => (
                        <div>
                            <div class="text-2xl font-bold text-white">
                                {stat.value}
                            </div>
                            <div class="text-xs text-zinc-500 uppercase tracking-wider font-semibold">
                                {stat.label}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- 3D Phone Mockup Area -->
        <div class="relative perspective-1000 group hidden lg:block">
            <!-- Glow behind phone -->
            <div
                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[700px] bg-gradient-to-b from-indigo-500/30 to-purple-500/10 blur-[80px] rounded-full"
            >
            </div>

            <!-- Phone Container -->
            <div
                class="relative w-[320px] mx-auto h-[650px] bg-[#0A0A0A] rounded-[3.5rem] border-[8px] border-[#1a1a1a] shadow-2xl overflow-hidden transform transition-all duration-700 ease-out hover:rotate-y-12 hover:rotate-x-6 hover:scale-[1.02] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.5)]"
            >
                <!-- Dynamic Island -->
                <div
                    class="absolute top-0 left-1/2 -translate-x-1/2 w-[100px] h-[30px] bg-black z-20 rounded-b-2xl"
                >
                </div>

                <!-- Screen Content -->
                <div
                    class="w-full h-full bg-zinc-900 overflow-y-auto no-scrollbar relative"
                >
                    <!-- App Header -->
                    <div
                        class="p-6 pt-14 bg-gradient-to-b from-[#111] to-zinc-900 border-b border-white/5"
                    >
                        <div class="text-zinc-400 text-sm font-medium mb-1">
                            Bom dia, Alex
                        </div>
                        <div class="text-2xl font-bold text-white">
                            Meu Flow
                        </div>

                        <!-- Daily Progress -->
                        <div class="mt-6 flex justify-between items-end">
                            <div class="text-4xl font-bold text-indigo-400">
                                85%
                            </div>
                            <div class="text-xs text-zinc-500 mb-1">
                                Meta Diária
                            </div>
                        </div>
                        <div
                            class="h-2 bg-zinc-800 rounded-full mt-2 overflow-hidden"
                        >
                            <div
                                class="h-full w-[85%] bg-gradient-to-r from-indigo-500 to-purple-500 rounded-full"
                            >
                            </div>
                        </div>
                    </div>

                    <!-- App List -->
                    <div class="p-4 space-y-3">
                        {
                            [1, 2, 3, 4, 5].map((_) => (
                                <div class="p-4 bg-zinc-800/50 rounded-2xl border border-white/5 flex items-center gap-4">
                                    <div class="size-5 rounded-full border-2 border-zinc-600" />
                                    <div class="flex-1">
                                        <div class="h-2 w-24 bg-zinc-700 rounded mb-2" />
                                        <div class="h-1.5 w-16 bg-zinc-800 rounded" />
                                    </div>
                                </div>
                            ))
                        }
                    </div>

                    <!-- Floating Fab -->
                    <div
                        class="absolute bottom-8 right-8 size-14 bg-indigo-500 rounded-full flex items-center justify-center shadow-lg shadow-indigo-500/40 text-white"
                    >
                        <Icon name="lucide:plus" class="size-8" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<style>
    .perspective-1000 {
        perspective: 1000px;
    }

    .rotate-y-12 {
        transform: rotateY(15deg);
    }

    .rotate-x-6 {
        transform: rotateX(5deg);
    }

    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .animate-gradient {
        background-size: 200% auto;
        animation: gradient 4s linear infinite;
    }

    @keyframes gradient {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }
</style>
