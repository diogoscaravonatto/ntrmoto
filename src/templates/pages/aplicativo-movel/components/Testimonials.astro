---

---

<section id="depoimentos" class="py-20 overflow-hidden relative">
    <div
        class="absolute left-0 top-0 bottom-0 w-32 bg-gradient-to-r from-[#050505] to-transparent z-10 pointer-events-none"
    >
    </div>
    <div
        class="absolute right-0 top-0 bottom-0 w-32 bg-gradient-to-l from-[#050505] to-transparent z-10 pointer-events-none"
    >
    </div>

    <div class="flex gap-6 animate-scroll w-max hover:pause">
        {
            Array.from({ length: 16 }).map((_, i) => (
                <div class="w-[350px] shrink-0 border border-zinc-800 rounded-2xl bg-zinc-900/40 border-white/5 backdrop-blur-md p-6">
                    <div class="flex items-center gap-3 mb-4">
                        <img
                            src={`https://i.pravatar.cc/150?u=${i}`}
                            alt="User"
                            class="size-10 rounded-full border border-white/10"
                        />
                        <div>
                            <div class="font-bold text-sm text-white">
                                Usuário {(i % 8) + 1}
                            </div>
                            <div class="text-xs text-zinc-500 font-mono">
                                @usuario{(i % 8) + 1}
                            </div>
                        </div>
                    </div>
                    <p class="text-zinc-300 text-sm leading-relaxed italic font-medium">
                        "Simplesmente o melhor app de produtividade que já usei.
                        A interface é linda e super rápida. Recomendo para
                        todos!"
                    </p>
                </div>
            ))
        }
    </div>
</section>

<style>
    @keyframes scroll {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-50%);
        }
    }

    .animate-scroll {
        animation: scroll 40s linear infinite;
    }

    .hover\:pause:hover {
        animation-play-state: paused;
    }
</style>
