---
const portfolio = {
    eyebrow: "The Selection",
    title: ["Curadoria", "Global."],
    tagline:
        '"Não vendemos metros quadrados. Vendemos ângulos de visão e silêncio monumental."',
    items: [
        {
            title: "The Sky Sanctuary",
            loc: "Penthouse • Manhattan",
            price: "$ 45M",
            desc: "Vista 360º de NY com heliponto privado e automação absoluta.",
        },
        {
            title: "Tuscan Vineyards",
            loc: "Historical Estate • Florença",
            price: "€ 18M",
            desc: "140 hectares de vinhedos produtivos com castelo restaurado do século XVI.",
        },
        {
            title: "Obsidian Villa",
            loc: "Architecture • Malibu",
            price: "$ 84M",
            desc: "Projeto premiado construído sobre a rocha, com acesso direto à praia privada.",
        },
    ],
};
---

<section id="curadoria" class="py-40 bg-[#070708]">
    <div class="max-w-7xl mx-auto px-6">
        <div
            class="flex flex-col md:flex-row justify-between items-end gap-12 mb-32"
        >
            <div class="space-y-6">
                <span
                    class="text-[10px] font-bold uppercase tracking-[0.4em] text-zinc-600 italic leading-none"
                    >{portfolio.eyebrow}</span
                >
                <h2
                    class="text-5xl md:text-7xl font-serif text-white leading-none tracking-tight"
                >
                    {portfolio.title[0]}
                    <span class="italic text-[#f1e7d0]"
                        >{portfolio.title[1]}</span
                    >
                </h2>
            </div>
            <p
                class="max-w-xs text-zinc-500 text-sm font-light italic leading-relaxed"
            >
                {portfolio.tagline}
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
            {
                portfolio.items.map((item) => (
                    <div class="group relative aspect-4/5 bg-zinc-900/50 rounded-2xl border border-white/5 overflow-hidden">
                        <div class="absolute inset-0 bg-linear-to-b from-transparent via-transparent to-black z-10 pointer-events-none" />
                        <div class="absolute inset-0 z-20 p-10 flex flex-col justify-between">
                            <div class="flex justify-between items-start pointer-events-none">
                                <span class="text-[9px] font-black text-[#f1e7d0] uppercase tracking-widest border border-[#f1e7d0]/30 px-3 py-1 rounded-full italic lowercase">
                                    {item.loc}
                                </span>
                            </div>
                            <div class="space-y-4 translate-y-6 group-hover:translate-y-0 transition-transform duration-500">
                                <h3 class="text-3xl font-serif text-white tracking-tight">
                                    {item.title}
                                </h3>
                                <p class="text-zinc-500 text-xs font-light leading-relaxed h-0 group-hover:h-12 opacity-0 group-hover:opacity-100 transition-all duration-500 overflow-hidden italic lowercase">
                                    {item.desc}
                                </p>
                                <div class="flex items-center justify-between pt-4">
                                    <span class="text-lg font-serif text-[#f1e7d0] uppercase tracking-tight">
                                        {item.price}
                                    </span>
                                    <span class="text-[10px] font-black uppercase tracking-widest text-zinc-600 hover:text-white transition-colors cursor-pointer italic lowercase">
                                        Ver Espólio
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
