---
const hero = {
    badge: "Exclusividade Off-Market",
    title: ["Onde o endereço", "torna-se seu", "legado."],
    description:
        "Curadoria impecável de ativos imobiliários globais. De vilas na Toscana a coberturas exclusivas em Nova York, conectamos visão, luxo e patrimônio.",
    cta: "Consultar Portfólio Privado",
    briefing: "Agendar Briefing Confidencial",
    quotes: {
        text: '"A arquitetura é o jogo sábio, correto e magnífico dos volumes sob a luz."',
        featured: {
            label: "Propriedade em Destaque",
            title: "the obsidian pavilion. • malibu",
        },
    },
    stats: [
        { val: "$ 140M", tag: "penthouses", label: "Transação Recorde" },
        { val: "12 PAÍSES", tag: "network", label: "Presença Global" },
    ],
};
---

<section
    class="relative min-h-screen flex flex-col lg:flex-row overflow-hidden border-b border-white/5"
>
    <!-- Left: Visual Impact -->
    <div class="lg:w-1/2 h-screen relative group">
        <div
            class="absolute inset-0 bg-zinc-900 overflow-hidden pointer-events-none"
        >
            <div
                class="absolute inset-0 bg-[linear-gradient(45deg,#000_25%,transparent_25%,transparent_50%,#000_50%,#000_75%,transparent_75%,transparent)] bg-size-[20px_20px] opacity-10"
            >
            </div>
            <div
                class="absolute inset-0 bg-linear-to-r from-black/80 to-transparent"
            >
            </div>
            <div
                class="absolute inset-0 flex items-center justify-center p-20 text-center"
            >
                <div
                    class="italic font-serif text-white text-4xl opacity-50 group-hover:scale-110 transition-transform duration-1000"
                >
                    {hero.quotes.text}
                </div>
            </div>
        </div>
        <div class="absolute bottom-12 left-12 flex flex-col gap-6">
            <div class="flex items-center gap-4">
                <span
                    class="text-[10px] font-black text-[#f1e7d0] uppercase tracking-[0.4em]"
                    >{hero.quotes.featured.label}</span
                >
                <div class="h-px w-20 bg-[#f1e7d0]/30"></div>
            </div>
            <h3
                class="text-4xl font-serif text-white font-light lowercase italic tracking-tight"
            >
                {hero.quotes.featured.title}
            </h3>
        </div>
    </div>

    <!-- Right: Content & Action -->
    <div
        class="lg:w-1/2 min-h-screen bg-[#050505] flex flex-col justify-center px-12 lg:px-24 py-32 space-y-16"
    >
        <div>
            <span
                class="inline-block px-3 py-1 bg-zinc-900 border border-white/5 text-[#f1e7d0] text-[9px] font-black uppercase tracking-[0.5em] mb-12 animate-fade-in"
            >
                {hero.badge}
            </span>
            <h1
                class="text-6xl md:text-[8rem] font-serif font-light text-white leading-[0.85] mb-10 tracking-tighter"
            >
                {hero.title[0]}
                <br />{hero.title[1]}
                <span class="italic text-[#f1e7d0]">{hero.title[2]}</span>
            </h1>
            <p
                class="text-xl text-zinc-500 font-light leading-relaxed max-w-xl italic"
            >
                {hero.description}
            </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-12 border-y border-white/5 py-12">
            {
                hero.stats.map((stat) => (
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-widest text-zinc-600 mb-2 italic lowercase">
                            {stat.label}
                        </p>
                        <h4 class="text-2xl font-serif text-white tracking-tight uppercase">
                            {stat.val}{" "}
                            <span class="text-[#f1e7d0] text-sm italic">
                                {stat.tag}
                            </span>
                        </h4>
                    </div>
                ))
            }
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-8">
            <button
                class="w-full sm:w-auto px-12 py-7 bg-[#f1e7d0] text-black font-black rounded-sm hover:translate-y-[-4px] transition-all text-xs uppercase tracking-[0.3em] shadow-2xl outline-hidden group italic"
            >
                {hero.cta}
            </button>
            <a
                href="#"
                class="text-[10px] font-black uppercase tracking-widest text-zinc-400 hover:text-white transition-colors border-b border-zinc-800 pb-1 italic"
            >
                {hero.briefing}
            </a>
        </div>
    </div>
</section>
