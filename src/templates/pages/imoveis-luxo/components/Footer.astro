---
const footer = {
    brand: { name: "Legacy", highlight: "Estates" },
    tagline: "Curadores de Ativos & Assessores de Investimento.",
    hubs: "Londres • Zurique • Miami • São Paulo • Dubai",
    copy: "© 2026 Legacy Estates Ltd. Confidencialidade é nosso pilar fundamental.",
};
---

<footer class="py-20 border-t border-white/5 bg-black">
    <div
        class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-12 text-center md:text-left"
    >
        <div class="space-y-4">
            <div
                class="flex items-center gap-2 justify-center md:justify-start"
            >
                <div class="size-4 bg-[#f1e7d0] transform rotate-45"></div>
                <span
                    class="text-lg tracking-[0.2em] font-light uppercase text-white"
                    >{footer.brand.name}<span class="text-[#f1e7d0] font-bold"
                        >{footer.brand.highlight}</span
                    ></span
                >
            </div>
            <p
                class="text-zinc-700 text-[10px] font-black uppercase tracking-[0.2em] italic"
            >
                {footer.tagline}
            </p>
        </div>
        <div class="flex gap-16">
            <div class="space-y-4">
                <p
                    class="text-[9px] font-black uppercase tracking-widest text-[#f1e7d0] italic lowercase"
                >
                    HUBS
                </p>
                <p
                    class="text-zinc-500 font-bold text-[11px] leading-relaxed uppercase tracking-widest italic"
                >
                    {footer.hubs}
                </p>
            </div>
        </div>
    </div>
    <div
        class="mt-20 text-center opacity-20 text-[8px] font-black uppercase tracking-[0.5em] text-zinc-700 italic lowercase"
    >
        {footer.copy}
    </div>
</footer>
