---
const concierge = {
    eyebrow: "Lifestyle Management",
    title: ["Além das", "Paredes."],
    description:
        "Nossa assessoria não termina na assinatura da escritura. Atuamos como seu family office imobiliário global.",
    services: [
        {
            title: "Gestão de Ativos",
            desc: "Administração integral de propriedades, garantindo valorização e prontidão de uso.",
        },
        {
            title: "Tax & Legal Global",
            desc: "Apoio jurídico especializado para aquisições transfronteiriças e otimização fiscal.",
        },
        {
            title: "Private Relocation",
            desc: "Apoio na transição de residência, do transporte de arte à curadoria educacional local.",
        },
    ],
};
---

<section id="concierge" class="py-40 bg-black overflow-hidden relative">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-24 items-center">
            <div class="space-y-12">
                <span
                    class="text-[10px] font-bold uppercase tracking-[0.5em] text-[#f1e7d0] italic leading-none"
                    >{concierge.eyebrow}</span
                >
                <h2
                    class="text-6xl md:text-8xl font-serif text-white leading-tight underline decoration-white/5 italic tracking-tighter"
                >
                    {concierge.title[0]}
                    <br />{concierge.title[1]}
                </h2>
                <p
                    class="text-xl text-zinc-500 font-light leading-relaxed italic"
                >
                    {concierge.description}
                </p>

                <div class="space-y-8 pt-10">
                    {
                        concierge.services.map((serv) => (
                            <div class="group flex gap-8">
                                <div class="size-px h-12 bg-[#f1e7d0]/20 group-hover:bg-[#f1e7d0] transition-colors" />
                                <div>
                                    <h4 class="text-white font-serif text-xl mb-2 tracking-tight">
                                        {serv.title}
                                    </h4>
                                    <p class="text-zinc-600 text-sm leading-relaxed font-light italic lowercase">
                                        {serv.desc}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
            <div class="relative aspect-square">
                <div
                    class="absolute inset-0 border border-white/5 rounded-full animate-[spin_20s_linear_infinite] pointer-events-none"
                >
                </div>
                <div
                    class="absolute inset-10 border border-white/5 rounded-full animate-[spin_15s_linear_infinite_reverse] pointer-events-none"
                >
                </div>
                <div
                    class="absolute inset-0 flex items-center justify-center pointer-events-none"
                >
                    <span
                        class="text-[#f1e7d0] font-serif text-2xl italic uppercase tracking-widest"
                        >Legacy Network</span
                    >
                </div>
            </div>
        </div>
    </div>
</section>
