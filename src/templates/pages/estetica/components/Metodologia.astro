---
const method = {
    eyebrow: "The Luminous Journey",
    title: ["Ciência na base,", "arte"],
    highlight: "no resultado.",
    description:
        "Não acreditamos em mudanças drásticas. Nosso foco é o refinamento. Através do nosso método proprietário, identificamos os pontos de luz do seu rosto para realçar sua beleza natural.",
    steps: [
        {
            step: "01",
            title: "Mapeamento Facial",
            desc: "Análise milimétrica de proporções e qualidade tecidual para um diagnóstico preciso.",
        },
        {
            step: "02",
            title: "Protocolo Exclusivo",
            desc: "Curadoria de tecnologias e ativos combinados especificamente para suas necessidades.",
        },
        {
            step: "03",
            title: "Execução de Elite",
            desc: "Aplicação técnica rigorosa, priorizando o conforto e a biossegurança em cada etapa.",
        },
    ],
};
---

<section id="metodo" class="py-40 bg-white relative z-10">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-24 items-center">
            <div class="space-y-10">
                <span
                    class="text-[10px] font-black uppercase tracking-[0.4em] text-[#f8b4b4]"
                    >{method.eyebrow}</span
                >
                <h2
                    class="text-5xl md:text-7xl font-bold text-[#4a3a37] tracking-tighter leading-tight"
                >
                    {method.title[0]}
                    <br /><span class="text-[#f8b4b4] italic font-light"
                        >{method.title[1]}</span
                    >
                    {method.highlight}
                </h2>
                <p class="text-[#9d8a87] text-lg leading-relaxed">
                    {method.description}
                </p>

                <div class="space-y-12 pt-10">
                    {
                        method.steps.map((item) => (
                            <div class="flex gap-8 group">
                                <span class="text-4xl font-light italic text-[#f8b4b4]/20 group-hover:text-[#f8b4b4] transition-colors uppercase leading-none">
                                    {item.step}
                                </span>
                                <div>
                                    <h4 class="text-xl font-bold text-[#4a3a37] mb-2 uppercase tracking-tight">
                                        {item.title}
                                    </h4>
                                    <p class="text-[#9d8a87] text-sm leading-relaxed italic">
                                        {item.desc}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
            <div class="relative">
                <div
                    class="aspect-4/5 rounded-[4rem] bg-[#fcf8f6] border border-[#f3e3df] p-16 flex flex-col justify-end group overflow-hidden"
                >
                    <div
                        class="absolute inset-0 bg-linear-to-b from-transparent to-[#f8b4b4]/10 opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                    </div>
                    <span
                        class="text-6xl font-light text-[#f8b4b4]/30 mb-4 italic"
                        >Naturality</span
                    >
                    <p
                        class="text-[#9d8a87] text-[10px] uppercase font-black tracking-widest lowercase"
                    >
                        Respeito à sua Identidade
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
