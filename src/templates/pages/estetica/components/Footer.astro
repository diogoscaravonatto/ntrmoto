---
const footer = {
    brand: { name: "Luminous", highlight: "Esteta" },
    tagline:
        "Estética Avançada • Bem-estar • Autoestima de Luxo. São Paulo | Rio de Janeiro",
    address: {
        label: "Unidade Jardins",
        text: "Rua Oscar Freire, 1140. Piso 12, Corporate Tower.",
    },
    contact: {
        label: "Contato",
        text: "+55 (11) 98765-4321 • contato@luminousesteta.com",
    },
    copy: "© 2026 Luminous Clínica de Estética. Todos os direitos reservados. Responsabilidade Técnica: Dra. Aline S.",
};
---

<footer class="py-20 bg-white border-t border-[#f3e3df]">
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-4 gap-16">
        <div class="md:col-span-2">
            <div class="flex items-center gap-3 mb-8">
                <div class="size-8 rounded-full bg-[#f8b4b4]"></div>
                <span class="text-2xl font-bold tracking-tight text-[#4a3a37]">
                    {footer.brand.name}<span class="font-light italic"
                        >{footer.brand.highlight}</span
                    >
                </span>
            </div>
            <p
                class="text-sm text-[#9d8a87] font-light max-w-xs uppercase tracking-widest leading-relaxed italic"
            >
                {footer.tagline}
            </p>
        </div>
        <div class="space-y-6">
            <p
                class="text-[10px] font-black uppercase tracking-[0.3em] text-[#f8b4b4]"
            >
                {footer.address.label}
            </p>
            <p
                class="text-sm text-[#9d8a87] font-light leading-relaxed font-bold uppercase tracking-widest italic"
            >
                {footer.address.text}
            </p>
        </div>
        <div class="space-y-6">
            <p
                class="text-[10px] font-black uppercase tracking-[0.3em] text-[#f8b4b4]"
            >
                {footer.contact.label}
            </p>
            <p
                class="text-sm text-[#9d8a87] font-light leading-relaxed font-bold uppercase tracking-widest italic"
            >
                {footer.contact.text}
            </p>
        </div>
    </div>
    <div class="mt-32 pt-10 border-t border-[#fcf8f6] text-center">
        <p
            class="text-[8px] font-black text-[#9d8a87] uppercase tracking-[0.5em] opacity-50"
        >
            {footer.copy}
        </p>
    </div>
</footer>
