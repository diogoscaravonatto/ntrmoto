---
const procedures = [
    {
        title: "Harmonização Facial",
        desc: "Protocolo de equilíbrio e realce das proporções faciais com preenchedores de elite.",
    },
    {
        title: "Bioestimuladores",
        desc: "Estímulo natural de colágeno para firmeza e jovialidade duradoura da pele.",
    },
    {
        title: "Tecnologia Laser",
        desc: "Rejuvenescimento a laser para tratamento de manchas, poros e textura da pele.",
    },
    {
        title: "Lipo de Papada",
        desc: "Redução de gordura localizada na região submentoniana com precisão e simetria.",
    },
    {
        title: "Skincare Clínico",
        desc: "Protocolos de limpeza e hidratação profunda combinados com ativos de alta performance.",
    },
    {
        title: "Botox® Advanced",
        desc: "Suavização de rugas dinâmicas mantendo a expressividade e naturalidade.",
    },
];
---

<section id="procedimentos" class="py-40 px-6 bg-white relative z-10">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-24">
            <h2
                class="text-5xl md:text-7xl font-bold text-[#4a3a37] tracking-tighter mb-6"
            >
                Expertise que faz a <span
                    class="italic font-light text-[#f8b4b4]">Diferença</span
                >.
            </h2>
            <p
                class="text-[#9d8a87] text-xl max-w-2xl mx-auto font-light leading-relaxed"
            >
                Procedimentos minimamente invasivos com resultados comprovados e
                naturais.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            {
                procedures.map((card) => (
                    <div class="group p-10 rounded-[3rem] bg-[#fcf8f6] border border-transparent hover:border-[#f8b4b4]/20 hover:bg-white hover:shadow-2xl transition-all duration-500">
                        <div class="size-14 rounded-2xl bg-white flex items-center justify-center mb-8 shadow-sm group-hover:bg-[#f8b4b4] group-hover:text-white transition-all">
                            <svg
                                class="size-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 21l-8.283-4.83c-.522-.305-.717-.967-.412-1.488L12 3l8.695 11.682c.305.52.11 1.183-.412 1.488L12 21z"
                                />
                            </svg>
                        </div>
                        <h3 class="text-2xl font-bold text-[#4a3a37] mb-4 tracking-tight">
                            {card.title}
                        </h3>
                        <p class="text-sm text-[#9d8a87] leading-relaxed mb-8 italic">
                            {card.desc}
                        </p>
                        <button class="text-[10px] font-black uppercase tracking-widest text-[#f8b4b4] flex items-center gap-2 group-hover:translate-x-2 transition-transform outline-hidden">
                            Ver Detalhes <span>→</span>
                        </button>
                    </div>
                ))
            }
        </div>
    </div>
</section>
