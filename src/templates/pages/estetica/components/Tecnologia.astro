---
const tech = {
    eyebrow: "Modernidade & Precisão",
    title: ["Onde a tecnologia realça a sua", "essência."],
    description:
        "Investimos nas plataformas mundiais mais premiadas — FDA approved — para garantir não apenas o resultado estético, mas o máximo de conforto e rapidez na sua recuperação.",
    list: ["Ultraformer III", "FOTONA 4D", "Lavieen", "CoolSculpting"],
};
---

<section id="tecnologia" class="py-40 px-6 bg-[#fcf8f6]">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-16 items-center">
        <div class="lg:col-span-5 relative order-2 lg:order-1">
            <div
                class="aspect-4/3 bg-white rounded-[3rem] shadow-xl p-10 flex flex-col justify-center italic text-[#f8b4b4] text-center"
            >
                <span class="text-5xl font-light mb-4 italic uppercase"
                    >Alta Fidelidade</span
                >
                <span
                    class="text-zinc-400 text-[10px] font-black not-italic uppercase tracking-[0.2em] lowercase"
                    >Nossos Equipamentos</span
                >
            </div>
            <div
                class="absolute -top-10 -left-10 size-40 bg-[#f8b4b4]/40 rotate-12 rounded-3xl blur-2xl -z-10 animate-pulse"
            >
            </div>
        </div>
        <div class="lg:col-span-7 space-y-10 order-1 lg:order-2">
            <span
                class="text-[10px] font-bold uppercase tracking-[0.4em] text-[#f8b4b4]"
                >{tech.eyebrow}</span
            >
            <h2
                class="text-5xl md:text-7xl font-bold text-[#4a3a37] tracking-tighter leading-tight"
            >
                {tech.title[0]}
                <span class="italic font-light">{tech.title[1]}</span>
            </h2>
            <p class="text-lg text-[#9d8a87] leading-relaxed font-light italic">
                {tech.description}
            </p>
            <div class="flex flex-wrap gap-4">
                {
                    tech.list.map((item) => (
                        <span class="px-6 py-3 bg-white border border-[#f3e3df] rounded-full text-[10px] font-black text-[#4a3a37] uppercase tracking-widest hover:border-[#f8b4b4] transition-all cursor-default">
                            {item}
                        </span>
                    ))
                }
            </div>
        </div>
    </div>
</section>
