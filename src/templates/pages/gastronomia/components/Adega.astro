---
const wine = {
    eyebrow: "La Cave",
    title: ["Onde o tempo", "repousa."],
    description:
        "Nossa adega subterrânea abriga safras raras e rótulos selecionados para harmonizar com cada nota do nosso Menu Dégustation.",
    features: [
        "Terroirs Exclusivos",
        "Sommelier Dedicado",
        "Harmonização de Precisão",
    ],
    stats: {
        val: "4.000 Rótulos",
        tag: "Curadoria Exclusiva",
    },
};
---

<section class="py-40 bg-[#050505] relative">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-24 items-center">
            <div
                class="order-2 lg:order-1 relative aspect-square bg-zinc-900 border border-white/5 rounded-full overflow-hidden flex items-center justify-center"
            >
                <div
                    class="text-zinc-800 uppercase font-black text-xl tracking-[1em] rotate-90 pointer-events-none"
                >
                    Millésime
                </div>
                <div
                    class="absolute inset-0 bg-linear-to-b from-transparent to-black/80"
                >
                </div>
                <div class="absolute bottom-16 text-center w-full">
                    <p
                        class="text-[#d4af37] text-xs uppercase tracking-widest font-bold italic"
                    >
                        {wine.stats.val}
                    </p>
                    <p
                        class="text-white text-[10px] uppercase tracking-widest font-medium lowercase italic"
                    >
                        {wine.stats.tag}
                    </p>
                </div>
            </div>
            <div class="order-1 lg:order-2 space-y-10">
                <span
                    class="text-[10px] font-bold uppercase tracking-[0.5em] text-zinc-600"
                    >{wine.eyebrow}</span
                >
                <h2
                    class="text-5xl md:text-7xl font-light text-white italic tracking-tight"
                >
                    {wine.title[0]}
                    <br />{wine.title[1]}
                </h2>
                <p
                    class="text-zinc-400 text-lg font-light leading-relaxed italic"
                >
                    {wine.description}
                </p>
                <ul class="space-y-6 pt-6">
                    {
                        wine.features.map((feature) => (
                            <li class="flex items-center gap-4 text-zinc-500 uppercase tracking-widest text-[10px] lowercase font-bold italic">
                                <div class="size-1 bg-[#d4af37]" />
                                {feature}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>
