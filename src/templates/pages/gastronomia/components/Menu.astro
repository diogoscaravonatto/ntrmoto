---
const menu = {
    title: "Menu de Degustação",
    season: "Temporada de Inverno 2026",
    sections: [
        {
            cat: "Entradas",
            items: [
                {
                    name: "Trufas Negras de Inverno",
                    desc: "Carpaccio de batatas orgânicas, creme de trufas negras e avelãs torradas.",
                    price: "R$ 480",
                },
                {
                    name: "Lagosta da Costa",
                    desc: "Lagosta cozida em baixa temperatura, emulsão de bisque e baunilha natural.",
                    price: "R$ 520",
                },
            ],
        },
        {
            cat: "Pratos Principais",
            items: [
                {
                    name: "Wagyu A5 Grand Cru",
                    desc: "Entrecôte de Wagyu, redução de vinho do porto, mil-folhas de vegetais da estação.",
                    price: "R$ 840",
                },
                {
                    name: "Turbot Selvagem",
                    desc: "Peixe turbot selvagem, molho mousseline de champagne e ovas de esturjão.",
                    price: "R$ 695",
                },
            ],
        },
    ],
};
---

<section id="menu" class="py-40 bg-zinc-950 border-y border-white/5">
    <div class="max-w-4xl mx-auto px-6">
        <div class="text-center mb-32">
            <h2
                class="text-6xl md:text-8xl font-light text-white mb-6 italic underline decoration-[#d4af37]/20 underline-offset-8 tracking-tight"
            >
                {menu.title}
            </h2>
            <p
                class="text-zinc-500 uppercase text-[10px] font-black tracking-[0.4em] lowercase italic"
            >
                {menu.season}
            </p>
        </div>

        <div class="space-y-32">
            {
                menu.sections.map((section) => (
                    <div class="space-y-16">
                        <h3 class="text-center text-[11px] font-black uppercase tracking-[0.6em] text-[#d4af37] lowercase italic">
                            {section.cat}
                        </h3>
                        <div class="space-y-16">
                            {section.items.map((item) => (
                                <div class="flex flex-col items-center text-center space-y-4 group cursor-default">
                                    <h4 class="text-3xl md:text-5xl font-light text-white group-hover:text-[#d4af37] transition-colors tracking-tight">
                                        {item.name}
                                    </h4>
                                    <p class="text-zinc-500 max-w-sm font-light italic text-sm leading-relaxed lowercase">
                                        {item.desc}
                                    </p>
                                    <span class="text-[10px] font-black uppercase tracking-widest text-zinc-700 italic lowercase">
                                        {item.price}
                                    </span>
                                </div>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
