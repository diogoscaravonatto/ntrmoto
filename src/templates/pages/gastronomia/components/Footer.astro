---
const footer = {
    brand: "Aura",
    tagline:
        "Alta Gastronomia & Poesia Sensorial. Michelin Excellence & Hospitality.",
    sections: [
        {
            label: "Horários",
            text: "Terça — Sábado • 19:00 — 23:30",
        },
        {
            label: "Contato",
            text: "+55 11 9999-9999 • contato@aurarestaurante.com.br",
        },
    ],
    copy: "© 2026 Aura Fine Dining. A elegância é uma atitude.",
};
---

<footer class="py-20 bg-zinc-950 border-t border-white/5">
    <div
        class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-start gap-16"
    >
        <div class="space-y-6">
            <span
                class="text-4xl tracking-[0.2em] font-light uppercase text-white"
                >{footer.brand}</span
            >
            <p
                class="text-zinc-600 text-[10px] max-w-xs font-black tracking-widest uppercase italic leading-relaxed"
            >
                {footer.tagline}
            </p>
        </div>
        <div class="grid grid-cols-2 gap-20">
            {
                footer.sections.map((section) => (
                    <div class="space-y-4">
                        <p class="text-[10px] font-black uppercase tracking-widest text-[#d4af37] italic lowercase">
                            {section.label}
                        </p>
                        <p class="text-zinc-500 text-[11px] leading-relaxed italic font-light lowercase">
                            {section.text}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
    <p
        class="text-center mt-32 text-[8px] font-black text-zinc-800 uppercase tracking-[0.5em] italic"
    >
        {footer.copy}
    </p>
</footer>
