---
const ritual = {
    eyebrow: "L'Expérience",
    title: "O Ritual Aura",
    steps: [
        {
            step: "I",
            title: "A Chegada",
            desc: "Uma recepção silenciosa e minimalista, onde o tempo começa a desacelerar.",
        },
        {
            step: "II",
            title: "O Prelúdio",
            desc: "Amuse-bouche autorais que preparam os sentidos para a jornada.",
        },
        {
            step: "III",
            title: "A Sinfonia",
            desc: "Oito atos de alta gastronomia, orquestrados pela nossa cozinha aberta.",
        },
        {
            step: "IV",
            title: "A Memória",
            desc: "Mignardises finais e um digestivo selecionado para eternizar a noite.",
        },
    ],
};
---

<section id="ritual" class="py-40 bg-black overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-32">
            <span
                class="text-[10px] font-bold uppercase tracking-[0.5em] text-[#d4af37]"
                >{ritual.eyebrow}</span
            >
            <h2
                class="text-6xl md:text-8xl font-light text-white mt-6 italic tracking-tight underline decoration-white/5 underline-offset-10"
            >
                {ritual.title}
            </h2>
        </div>

        <div class="grid md:grid-cols-4 gap-12">
            {
                ritual.steps.map((item) => (
                    <div class="space-y-8 group">
                        <span class="text-4xl font-serif italic text-white/10 group-hover:text-[#d4af37] transition-colors leading-none uppercase">
                            {item.step}
                        </span>
                        <h4 class="text-xl text-white uppercase tracking-widest font-light">
                            {item.title}
                        </h4>
                        <p class="text-zinc-600 text-sm leading-relaxed italic font-light">
                            {item.desc}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
