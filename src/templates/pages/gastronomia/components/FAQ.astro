---
const faq = {
    title: "Dúvidas Frequentes",
    items: [
        {
            q: "É necessário traje formal?",
            a: "Sugerimos o traje esporte fino. Buscamos um ambiente de elegância descontraída e respeitosa.",
        },
        {
            q: "Vocês atendem restrições alimentares?",
            a: "Sim, solicitamos que nos informe com pelo menos 48h de antecedência para adaptarmos o menu com a mesma excelência.",
        },
        {
            q: "Possuem estacionamento/valet?",
            a: "Oferecemos serviço de valet cortesia para todos os nossos convidados.",
        },
    ],
};
---

<section class="py-40 bg-black border-y border-white/5">
    <div class="max-w-3xl mx-auto px-6">
        <div class="text-center mb-24">
            <h2
                class="text-4xl md:text-6xl font-light text-white italic tracking-tight"
            >
                {faq.title}
            </h2>
        </div>
        <div class="space-y-12">
            {
                faq.items.map((item) => (
                    <div class="space-y-4">
                        <h4 class="text-white uppercase tracking-widest text-sm font-bold tracking-tight italic">
                            {item.q}
                        </h4>
                        <p class="text-zinc-500 text-sm font-light italic leading-relaxed lowercase">
                            {item.a}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
