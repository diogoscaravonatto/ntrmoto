---
const hero = {
    badge: "Gastronomia Autoral • Michelin Experience",
    title: ["A Efêmera", "Elegância."],
    description:
        '"A cozinha é uma linguagem na qual se pode expressar harmonia, felicidade e poesia."',
    scroll: "Descubra Mais",
};
---

<section
    class="relative h-screen flex flex-col items-center justify-center overflow-hidden"
>
    <div class="absolute inset-0 z-0 bg-[#0a0a0a] pointer-events-none">
        <div
            class="absolute inset-0 bg-linear-to-b from-black/60 via-transparent to-black"
        >
        </div>
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 size-[600px] bg-[#d4af37]/5 rounded-full blur-[120px]"
        >
        </div>
    </div>

    <div class="relative z-10 text-center space-y-10 px-6">
        <span
            class="text-[12px] font-bold uppercase tracking-[0.6em] text-[#d4af37] animate-fade-in"
        >
            {hero.badge}
        </span>
        <h1
            class="text-7xl md:text-[10rem] font-light italic leading-[0.8] text-white animate-slide-up"
        >
            {hero.title[0]}
            <br /><span class="font-serif not-italic tracking-tighter"
                >{hero.title[1]}</span
            >
        </h1>
        <p
            class="text-xl md:text-2xl text-zinc-500 max-w-2xl mx-auto font-light leading-relaxed italic animate-fade-in delay-500"
        >
            {hero.description}
        </p>
    </div>

    <div
        class="absolute bottom-10 left-10 flex items-center gap-4 rotate-90 origin-left text-[9px] font-black uppercase tracking-[0.5em] text-zinc-700"
    >
        <span>{hero.scroll}</span>
        <div class="w-20 h-px bg-zinc-800"></div>
    </div>
</section>
