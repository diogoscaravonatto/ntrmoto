---
import Icon from "@components/Icon.astro";
---

<section class="py-24 px-6 bg-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
        <div
            class="relative rounded-[3rem] bg-[#005a5c] px-6 py-20 md:p-24 text-center overflow-hidden shadow-2xl shadow-[#005a5c]/30"
        >
            <!-- Decorative Glows -->
            <div
                class="absolute top-0 right-0 w-[500px] h-[500px] bg-white/5 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/2 pointer-events-none"
            >
            </div>
            <div
                class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-emerald-500/10 rounded-full blur-[100px] translate-y-1/2 -translate-x-1/2 pointer-events-none"
            >
            </div>

            <div class="relative z-10 max-w-4xl mx-auto space-y-10">
                <span
                    class="inline-block py-1.5 px-4 rounded-full bg-white/10 text-white text-xs font-bold uppercase tracking-widest border border-white/20"
                    >Vagas Limitadas para Consultoria</span
                >

                <h2
                    class="text-4xl md:text-7xl font-black text-white leading-[1.1] tracking-tight"
                >
                    Pronto para o próximo nível de <span
                        class="text-emerald-400 italic">governança?</span
                    >
                </h2>

                <p
                    class="text-xl text-white/80 max-w-2xl mx-auto leading-relaxed"
                >
                    Agende um diagnóstico financeiro gratuito e descubra onde
                    sua empresa está perdendo dinheiro.
                </p>

                <div
                    class="flex flex-col sm:flex-row gap-6 justify-center pt-8"
                >
                    <a
                        href="#contato"
                        class="bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-2xl px-12 py-5 text-xl shadow-2xl transition-all hover:scale-105"
                    >
                        Falar com Especialista
                    </a>
                    <a
                        href="#solucoes"
                        class="bg-transparent text-white font-bold rounded-2xl px-12 py-5 text-xl border-2 border-white/20 hover:bg-white/10 transition-all"
                    >
                        Ver Planos
                    </a>
                </div>

                <p
                    class="text-sm text-white/40 pt-10 flex items-center justify-center gap-2"
                >
                    <Icon name="lucide:shield-check" class="size-4" />
                    Diagnóstico 100% gratuito e confidencial.
                </p>
            </div>
        </div>
    </div>
</section>
