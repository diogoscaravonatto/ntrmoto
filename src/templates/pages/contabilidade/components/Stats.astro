---
import Icon from "@components/Icon.astro";
---

<section class="py-12 px-6 bg-slate-50 border-y border-slate-100">
    <div class="max-w-7xl mx-auto px-6">
        <div
            class="flex flex-col md:flex-row items-center justify-between gap-12"
        >
            <!-- Logos Strip -->
            <div class="w-full md:w-3/5">
                <p
                    class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 mb-8 text-center md:text-left"
                >
                    Ecossistema Integrado
                </p>
                <div
                    class="flex flex-wrap justify-center md:justify-start items-center gap-8 md:gap-12 opacity-30 grayscale saturate-0"
                >
                    <Icon name="lucide:cable" class="w-24 h-8" />
                    <Icon name="lucide:workflow" class="w-24 h-8" />
                    <Icon name="lucide:layers" class="w-24 h-8" />
                    <Icon name="lucide:database" class="w-24 h-8" />
                </div>
            </div>

            <!-- Hard Stats -->
            <div class="flex items-center gap-12 md:gap-16">
                <div class="text-center md:text-left">
                    <p
                        class="text-3xl md:text-4xl font-black text-slate-800 tracking-tighter"
                    >
                        R$ 500mi+
                    </p>
                    <p
                        class="text-[10px] font-bold text-[#005a5c] uppercase tracking-widest mt-1"
                    >
                        Transacionados/ano
                    </p>
                </div>
                <div class="w-[1px] h-12 bg-slate-200 hidden md:block"></div>
                <div class="text-center md:text-left">
                    <p
                        class="text-3xl md:text-4xl font-black text-slate-800 tracking-tighter"
                    >
                        1.200+
                    </p>
                    <p
                        class="text-[10px] font-bold text-[#005a5c] uppercase tracking-widest mt-1"
                    >
                        Empresas Ativas
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
