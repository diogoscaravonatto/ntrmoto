---
import Icon from "@components/Icon.astro";
---

<footer
    class="bg-slate-900 text-white border-t border-slate-800 py-20 px-6 relative z-10 overflow-hidden"
>
    <div
        class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-[#005a5c]/20 rounded-full blur-[120px] pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12">
            <div class="lg:col-span-2 space-y-8">
                <div class="flex items-center gap-3">
                    <div
                        class="size-10 bg-[#005a5c] rounded-xl flex items-center justify-center text-white shadow-lg shadow-[#005a5c]/20"
                    >
                        <Icon name="lucide:landmark" class="text-2xl" />
                    </div>
                    <h2 class="text-2xl font-extrabold tracking-tight">
                        LUX<span class="text-[#005a5c]">FINANCE</span>
                    </h2>
                </div>
                <p
                    class="text-slate-400 text-sm max-w-xs leading-relaxed font-light"
                >
                    Sua parceira estratégica em contabilidade digital e
                    consultoria financeira de alta performance. Transformando
                    números em crescimento.
                </p>
            </div>

            <div>
                <h4 class="font-bold mb-8 text-white">Empresa</h4>
                <ul class="space-y-4 text-sm text-slate-400">
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#005a5c] hover:pl-2 transition-all block"
                            >Sobre Nós</a>
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#005a5c] hover:pl-2 transition-all block"
                            >Carreiras</a>
                    </li>
                </ul>
            </div>

            <div>
                <h4 class="font-bold mb-8 text-white">Soluções</h4>
                <ul class="space-y-4 text-sm text-slate-400">
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#005a5c] hover:pl-2 transition-all block"
                            >Planejamento Fiscal</a>
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#005a5c] hover:pl-2 transition-all block"
                            >Gestão de Folha</a>
                    </li>
                </ul>
            </div>

            <div>
                <h4 class="font-bold mb-8 text-white">Contato</h4>
                <ul class="space-y-6 text-sm text-slate-400">
                    <li class="flex items-start gap-4">
                        <Icon
                            name="lucide:map-pin"
                            class="w-6 h-6 text-[#005a5c] shrink-0"
                        />
                        <span
                            >Av. Paulista, 1000 - Bela Vista<br />São Paulo - SP</span
                        >
                    </li>
                </ul>
            </div>
        </div>

        <div
            class="mt-20 pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center gap-6 text-xs text-slate-500"
        >
            <p>
                © 2024 LuxFinance Accounting Firm. Todos os direitos reservados.
            </p>
            <div class="flex gap-8">
                <a href="#" class="hover:text-white transition-colors"
                    >Política de Privacidade</a
                >
                <a href="#" class="hover:text-white transition-colors"
                    >Termos de Uso</a
                >
            </div>
        </div>
    </div>
</footer>
