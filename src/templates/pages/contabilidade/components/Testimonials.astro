---
import Icon from "@components/Icon.astro";

const testimonials = [
    {
        quote: "Além da contabilidade, eles nos ajudaram a reestruturar todo o nosso fluxo de caixa. Hoje temos previsibilidade real e caixa para investir.",
        author: "Ricardo Santos",
        role: "CEO, TechStart",
        image: "https://i.pravatar.cc/150?u=Ricardo",
    },
    {
        quote: "A melhor decisão que tomamos. A automação nos poupou contratar mais duas pessoas para o financeiro. Eficiência brutal.",
        author: "Ana Oliveira",
        role: "Founder, Creative Studio",
        image: "https://i.pravatar.cc/150?u=Ana",
    },
    {
        quote: "Profissionais que entendem de tecnologia e negócios, não apenas de impostos. É um nível de consultoria que eu não encontrava no mercado.",
        author: "Marcos Valente",
        role: "Diretor, Retail Group",
        image: "https://i.pravatar.cc/150?u=Marcos",
    },
];
---

<section
    id="depoimentos"
    class="py-32 px-6 bg-white border-t border-slate-100 relative overflow-hidden"
>
    <div
        class="absolute top-0 right-0 w-[600px] h-[600px] bg-slate-50 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div
            class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6"
        >
            <div>
                <div class="flex items-center gap-2 text-[#005a5c] mb-3">
                    <Icon name="lucide:star" class="w-5 h-5 fill-[#005a5c]" />
                    <span class="text-sm font-bold uppercase tracking-widest"
                        >Excelência Comprovada</span
                    >
                </div>
                <h3 class="text-3xl md:text-4xl font-bold text-slate-900 mb-2">
                    Histórias de Sucesso
                </h3>
                <p class="text-slate-500 max-w-xl">
                    Descubra por que CEOs e fundadores escolhem a LuxFinance
                    para escalar suas operações.
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                testimonials.map((t, i) => (
                    <div
                        class:list={[
                            "p-8 rounded-[2rem] bg-slate-50 hover:bg-white hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 border border-transparent hover:border-slate-100 group cursor-default",
                            i === 1 ? "md:translate-y-8" : "",
                        ]}
                    >
                        <div class="mb-8 opacity-20 group-hover:opacity-100 transition-opacity duration-500">
                            <Icon
                                name="lucide:message-square-quote"
                                class="size-10 text-[#005a5c]"
                            />
                        </div>
                        <p class="text-slate-700 font-medium leading-relaxed mb-8 text-lg">
                            "{t.quote}"
                        </p>
                        <div class="flex items-center gap-4 pt-6 mt-auto border-t border-slate-200/50">
                            <img
                                src={t.image}
                                alt={t.author}
                                width="150"
                                height="150"
                                loading="lazy"
                                class="size-12 rounded-full ring-2 ring-white object-cover"
                            />
                            <div>
                                <p class="font-bold text-slate-900">
                                    {t.author}
                                </p>
                                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">
                                    {t.role}
                                </p>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
