---
import Icon from "@components/Icon.astro";
---

<section class="py-24 bg-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <!-- Header -->
        <div class="text-center mb-16 max-w-2xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-black text-slate-910 mb-6">
                Muito mais que contabilidade. <br />
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-[#005a5c] to-emerald-500"
                    >Inteligência para crescer.</span
                >
            </h2>
            <p class="text-slate-500 font-medium">
                Uma nova experiência em serviços financeiros, desenhada para
                acelerar seus resultados.
            </p>
        </div>

        <!-- Bento Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
            <!-- Economia -->
            <div
                class="bg-slate-50 p-8 rounded-[2rem] border border-slate-100 md:row-span-2 group hover:bg-white hover:shadow-2xl transition-all duration-500"
            >
                <div
                    class="size-14 rounded-2xl bg-emerald-100 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
                >
                    <Icon
                        name="lucide:banknote"
                        class="size-7 text-[#005a5c]"
                    />
                </div>
                <h3 class="text-2xl font-bold text-slate-900 mb-4">
                    Economia Real
                </h3>
                <p class="text-slate-500 leading-relaxed mb-8">
                    Planejamento tributário minucioso para garantir o melhor
                    regime para sua empresa. Reduza custos de forma legal.
                </p>

                <div class="space-y-4">
                    <div
                        class="flex justify-between text-xs font-bold text-slate-400"
                    >
                        <span>Custo Tradicional</span><span>R$ 10.000</span>
                    </div>
                    <div
                        class="h-2 w-full bg-slate-200 rounded-full overflow-hidden"
                    >
                        <div class="h-full bg-slate-400 w-full opacity-50">
                        </div>
                    </div>
                    <div
                        class="flex justify-between text-xs font-bold text-emerald-600 mt-4"
                    >
                        <span>Com LuxFinance</span><span>R$ 7.500</span>
                    </div>
                    <div
                        class="h-2 w-full bg-emerald-100 rounded-full overflow-hidden"
                    >
                        <div class="h-full bg-emerald-500 w-[75%] rounded-full">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Eficiência -->
            <div
                class="bg-[#005a5c] p-10 rounded-[2rem] md:col-span-2 text-white relative overflow-hidden group"
            >
                <div
                    class="relative z-10 flex flex-col md:flex-row gap-8 items-center"
                >
                    <div class="flex-1">
                        <div
                            class="size-14 rounded-2xl bg-white/10 backdrop-blur-md flex items-center justify-center mb-6 border border-white/20"
                        >
                            <Icon
                                name="lucide:clock"
                                class="size-7 text-white"
                            />
                        </div>
                        <h3 class="text-2xl font-bold mb-4">
                            Eficiência Máxima
                        </h3>
                        <p class="text-slate-200">
                            Monitoramento diário de obrigações e entrega
                            antecipada. Nunca mais pague juros por atraso.
                        </p>
                    </div>
                    <!-- Mini Timeline Visual -->
                    <div
                        class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/10 w-full md:w-64"
                    >
                        <div class="space-y-4">
                            <div class="flex items-center gap-3 opacity-40">
                                <div
                                    class="size-5 rounded-full bg-white/20 flex items-center justify-center"
                                >
                                    <Icon name="lucide:check" class="size-3" />
                                </div><div
                                    class="h-1.5 w-20 bg-white/20 rounded-full"
                                >
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <div
                                    class="size-5 rounded-full bg-emerald-500 flex items-center justify-center shadow-[0_0_10px_rgba(16,185,129,0.5)]"
                                >
                                    <Icon
                                        name="lucide:loader-2"
                                        class="size-3 animate-spin"
                                    />
                                </div><div
                                    class="h-1.5 w-32 bg-white/80 rounded-full"
                                >
                                </div>
                            </div>
                            <div class="flex items-center gap-3 opacity-20">
                                <div
                                    class="size-5 rounded-full border border-white/40"
                                >
                                </div><div
                                    class="h-1.5 w-16 bg-white/20 rounded-full"
                                >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Equipe -->
            <div
                class="bg-slate-50 p-8 rounded-[2rem] border border-slate-100 group hover:bg-white hover:shadow-2xl transition-all duration-500"
            >
                <div
                    class="size-14 rounded-2xl bg-teal-100 flex items-center justify-center mb-6 group-hover:rotate-6 transition-transform"
                >
                    <Icon name="lucide:users" class="size-7 text-teal-600" />
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-2">
                    Equipe de Elite
                </h3>
                <p class="text-slate-500 text-sm">
                    Profissionais em constante atualização com as mudanças na
                    legislação.
                </p>
            </div>

            <!-- Tech -->
            <div
                class="bg-slate-900 p-8 rounded-[2rem] group hover:shadow-2xl transition-all duration-500"
            >
                <div
                    class="size-14 rounded-2xl bg-white/10 flex items-center justify-center mb-6 border border-white/10"
                >
                    <Icon name="lucide:cpu" class="size-7 text-emerald-400" />
                </div>
                <h3 class="text-xl font-bold text-white mb-2">100% Digital</h3>
                <p class="text-slate-400 text-sm">
                    Contabilidade sem papel, ágil e integrada via nuvem.
                </p>
            </div>
        </div>
    </div>
</section>
