---
import Icon from "@components/Icon.astro";

const navItems = [
    { label: "Soluções", href: "#solucoes" },
    { label: "Quem Somos", href: "#sobre" },
    { label: "Planos", href: "#planos" },
    { label: "Depoimentos", href: "#depoimentos" },
    { label: "Contato", href: "#contato" },
];
---

<header
    id="main-header"
    class="fixed top-0 w-full z-50 transition-all duration-300 bg-transparent py-6"
>
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div
                    class="size-10 bg-[#005a5c] rounded-xl flex items-center justify-center text-white shadow-lg shadow-[#005a5c]/20"
                >
                    <Icon name="lucide:landmark" class="text-2xl" />
                </div>
                <h2
                    class="text-xl font-extrabold tracking-tight text-slate-900"
                >
                    LUX<span class="text-[#005a5c]">FINANCE</span>
                </h2>
            </div>

            <nav class="hidden md:flex items-center gap-1">
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            class="px-4 py-2 text-sm font-bold text-slate-600 hover:text-[#005a5c] hover:bg-slate-50 rounded-lg transition-all"
                        >
                            {item.label}
                        </a>
                    ))
                }
            </nav>

            <div class="flex items-center gap-4">
                <a
                    href="#contato"
                    class="text-sm font-bold text-slate-900 hover:text-[#005a5c] hidden md:block"
                >
                    Login
                </a>
                <a
                    href="#contato"
                    class="bg-orange-600 hover:bg-orange-700 text-white font-bold rounded-xl px-6 py-2.5 transition-all shadow-lg shadow-orange-600/20 hover:shadow-xl hover:-translate-y-0.5"
                >
                    Área do Cliente
                </a>
            </div>
        </div>
    </div>
</header>

<script>
    const header = document.getElementById("main-header");
    window.addEventListener("scroll", () => {
        if (window.scrollY > 20) {
            header?.classList.add(
                "bg-white/90",
                "backdrop-blur-xl",
                "border-b",
                "border-slate-200",
                "py-4",
                "shadow-sm",
            );
            header?.classList.remove("bg-transparent", "py-6");
        } else {
            header?.classList.remove(
                "bg-white/90",
                "backdrop-blur-xl",
                "border-b",
                "border-slate-200",
                "py-4",
                "shadow-sm",
            );
            header?.classList.add("bg-transparent", "py-6");
        }
    });
</script>
