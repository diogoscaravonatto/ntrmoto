---
import Icon from "@components/Icon.astro";
---

<section id="contato" class="py-24 px-6 bg-white relative overflow-hidden">
    <!-- Animated Blob Backgrounds -->
    <div
        class="absolute top-0 right-0 w-[500px] h-[500px] bg-[#005a5c]/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none animate-pulse-slow"
    >
    </div>
    <div
        class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-sky-100 rounded-full blur-3xl translate-y-1/3 -translate-x-1/3 pointer-events-none animate-pulse-slow"
        style="animation-delay: 1s"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <!-- Contact Info -->
            <div class="space-y-12 animate-fade-in-left">
                <div class="relative">
                    <span
                        class="inline-block py-1 px-3 rounded-full bg-[#005a5c]/10 text-[#005a5c] text-xs font-bold uppercase tracking-widest mb-4 border border-[#005a5c]/20"
                    >
                        Localização Premium
                    </span>
                    <h2
                        class="text-4xl md:text-5xl font-black text-slate-900 leading-tight mb-6"
                    >
                        Visite nosso <span
                            class="text-[#005a5c] relative inline-block"
                            >HQ
                            <svg
                                class="absolute w-full h-3 -bottom-1 left-0 text-[#005a5c]/20"
                                viewBox="0 0 100 10"
                                preserveAspectRatio="none"
                            >
                                <path
                                    d="M0 5 Q 50 10 100 5"
                                    stroke="currentColor"
                                    stroke-width="3"
                                    fill="none"></path>
                            </svg>
                        </span>
                    </h2>
                    <p
                        class="text-lg text-slate-600 font-light max-w-md leading-relaxed"
                    >
                        Estamos situados no coração financeiro de São Paulo.
                        Venha tomar um café e desenhar o futuro da sua empresa
                        em um ambiente pensado para grandes negócios.
                    </p>
                </div>

                <div class="space-y-6">
                    <div
                        class="flex items-center gap-6 p-6 rounded-3xl bg-slate-50/50 hover:bg-white border border-slate-100 hover:border-[#005a5c]/30 hover:shadow-xl transition-all duration-500 group cursor-pointer backdrop-blur-sm"
                    >
                        <div
                            class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-[#005a5c] shadow-lg shadow-slate-100 group-hover:scale-110 group-hover:rotate-6 transition-all duration-500"
                        >
                            <Icon name="lucide:map-pin" class="w-7 h-7" />
                        </div>
                        <div>
                            <h4
                                class="text-lg font-bold text-slate-900 mb-1 group-hover:text-[#005a5c] transition-colors"
                            >
                                Endereço
                            </h4>
                            <p class="text-slate-500 text-sm">
                                Av. Paulista, 1000 - Bela Vista<br />São Paulo -
                                SP
                            </p>
                        </div>
                    </div>

                    <div
                        class="flex items-center gap-6 p-6 rounded-3xl bg-slate-50/50 hover:bg-white border border-slate-100 hover:border-[#005a5c]/30 hover:shadow-xl transition-all duration-500 group cursor-pointer backdrop-blur-sm"
                    >
                        <div
                            class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-[#005a5c] shadow-lg shadow-slate-100 group-hover:scale-110 group-hover:-rotate-6 transition-all duration-500"
                        >
                            <Icon name="lucide:mail" class="w-7 h-7" />
                        </div>
                        <div>
                            <h4
                                class="text-lg font-bold text-slate-900 mb-1 group-hover:text-[#005a5c] transition-colors"
                            >
                                Contato Direto
                            </h4>
                            <p class="text-slate-500 text-sm">
                                contato@luxfinance.com<br />+55 (11) 3344-5566
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Map Container -->
            <div
                class="relative h-[400px] lg:h-[650px] w-full rounded-[40px] overflow-hidden shadow-2xl border-4 border-white ring-1 ring-slate-100 group animate-fade-in-right"
            >
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3657.148762512163!2d-46.65496462376176!3d-23.56309936165795!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94ce59c8da0aa315%3A0xd59f9431f2c9776a!2sAv.%20Paulista%2C%201000%20-%20Bela%20Vista%2C%20S%C3%A3o%20Paulo%20-%20SP%2C%2001310-100!5e0!3m2!1sen!2sbr!4v1705156687422!5m2!1sen!2sbr"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    class="filter grayscale hover:grayscale-0 transition-all duration-1000 scale-[1.01]"
                >
                </iframe>
            </div>
        </div>
    </div>
</section>

<style>
    .animate-pulse-slow {
        animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.5;
        }
    }

    .animate-fade-in-left {
        animation: fadeInLeft 1s ease-out forwards;
        opacity: 0;
        transform: translateX(-30px);
    }
    .animate-fade-in-right {
        animation: fadeInRight 1s ease-out forwards;
        opacity: 0;
        transform: translateX(30px);
    }
    @keyframes fadeInLeft {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
    @keyframes fadeInRight {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
</style>
