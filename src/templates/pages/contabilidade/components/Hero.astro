---
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";
---

<section
    class="relative overflow-hidden py-32 px-6 bg-white selection:bg-[#005a5c] selection:text-white mt-20"
>
    <!-- Sophisticated Background Elements -->
    <div
        class="absolute top-0 right-0 -translate-y-12 translate-x-12 w-96 h-96 bg-[#005a5c]/5 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
        class="absolute bottom-0 left-0 translate-y-24 -translate-x-12 w-120 h-120 bg-slate-50 rounded-full blur-2xl pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <!-- Text Content -->
            <div class="flex flex-col gap-10">
                <div class="space-y-8 animate-fade-in-up">
                    <div
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-50 border border-slate-200 hover:border-[#005a5c]/30 transition-colors cursor-default"
                    >
                        <span class="relative flex h-2 w-2">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-500 opacity-75"
                            ></span>
                            <span
                                class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"
                            ></span>
                        </span>
                        <span
                            class="text-xs font-bold uppercase tracking-widest text-[#005a5c]"
                            >Nova Era da Contabilidade</span
                        >
                    </div>

                    <h1
                        class="text-5xl md:text-7xl font-bold leading-[1.05] tracking-tight text-slate-900"
                    >
                        Governança Financeira para <br />
                        <span class="relative whitespace-nowrap">
                            <span class="relative z-10 text-[#005a5c]"
                                >Empresas do Futuro</span
                            >
                            <span
                                class="absolute bottom-2 left-0 w-full h-3 bg-[#005a5c]/10 z-0 -rotate-1"
                            ></span>
                        </span>
                    </h1>

                    <p
                        class="text-xl text-slate-500 max-w-lg leading-relaxed font-light"
                    >
                        Abandone a burocracia. Transformamos dados complexos em
                        inteligência estratégica para escalar seu negócio com
                        segurança e previsibilidade.
                    </p>
                </div>

                <div
                    class="flex flex-col sm:flex-row gap-4 animate-fade-in-up"
                    style="animation-delay: 0.1s"
                >
                    <a
                        href="#contato"
                        class="bg-orange-600 hover:bg-orange-700 text-white rounded-xl font-bold px-10 py-5 shadow-xl shadow-orange-600/20 hover:shadow-orange-600/40 hover:-translate-y-1 transition-all duration-300 flex items-center justify-center gap-3 text-lg"
                    >
                        Iniciar Consultoria
                        <Icon name="lucide:arrow-right" class="w-6 h-6" />
                    </a>

                    <a
                        href="#solucoes"
                        class="bg-transparent text-slate-600 rounded-xl font-bold px-10 py-5 border-2 border-slate-200 hover:bg-slate-50 transition-all duration-300 text-center text-lg"
                    >
                        Conhecer a Plataforma
                    </a>
                </div>

                <div
                    class="flex items-center gap-4 text-sm text-slate-500 font-medium animate-fade-in-up"
                    style="animation-delay: 0.2s"
                >
                    <div class="flex -space-x-2">
                        <img
                            src="https://i.pravatar.cc/100?u=1"
                            width="100"
                            height="100"
                            class="w-9 h-9 rounded-full ring-2 ring-white object-cover"
                            alt="User"
                            loading="eager"
                        />
                        <img
                            src="https://i.pravatar.cc/100?u=2"
                            width="100"
                            height="100"
                            class="w-9 h-9 rounded-full ring-2 ring-white object-cover"
                            alt="User"
                            loading="eager"
                        />
                        <img
                            src="https://i.pravatar.cc/100?u=3"
                            width="100"
                            height="100"
                            class="w-9 h-9 rounded-full ring-2 ring-white object-cover"
                            alt="User"
                            loading="eager"
                        />
                        <div
                            class="flex items-center justify-center w-9 h-9 rounded-full bg-slate-100 text-[10px] ring-2 ring-white text-slate-600 font-bold"
                        >
                            +2k
                        </div>
                    </div>
                    <span>Empresas confiam na LuxFinance</span>
                </div>
            </div>

            <!-- Visual Content -->
            <div class="relative group perspective-1000 animate-fade-in-right">
                <div
                    class="absolute -inset-4 bg-linear-to-tr from-[#005a5c]/10 to-transparent rounded-4xl blur-2xl group-hover:bg-[#005a5c]/15 transition-all duration-1000"
                >
                </div>

                <div
                    class="relative rounded-2xl overflow-hidden shadow-2xl border border-slate-200/60 bg-white transform transition-transform duration-500 group-hover:rotate-y-2 group-hover:rotate-x-2 custom-rotate"
                >
                    <img
                        src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=1200&auto=format&fit=crop"
                        alt="Dashboard Financeiro Moderno"
                        width="1200"
                        height="800"
                        class="w-full h-full object-cover grayscale-20 group-hover:grayscale-0 transition-all duration-500 scale-105"
                        loading="eager"
                        fetchpriority="high"
                    />

                    <!-- Floating Card 1 -->
                    <div
                        class="absolute top-8 right-8 bg-white/95 backdrop-blur-md p-4 rounded-xl shadow-lg border border-slate-100 animate-bounce-slow"
                    >
                        <div class="flex items-center gap-3">
                            <div
                                class="p-2 bg-green-100 rounded-lg text-green-600"
                            >
                                <Icon
                                    name="lucide:trending-up"
                                    class="w-5 h-5"
                                />
                            </div>
                            <div>
                                <p
                                    class="text-xs text-slate-400 font-bold uppercase tracking-wider"
                                >
                                    Crescimento Anual
                                </p>
                                <p
                                    class="text-lg font-black text-slate-800 leading-none mt-1"
                                >
                                    +127%
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Floating Card 2 -->
                    <div
                        class="absolute bottom-4 left-4 md:bottom-8 md:left-8 bg-[#005a5c] text-white p-3 md:p-5 rounded-2xl shadow-xl border border-white/10 max-w-[140px] md:max-w-[220px]"
                    >
                        <p
                            class="text-[10px] md:text-xs font-bold text-white/60 mb-1 uppercase tracking-wider"
                        >
                            Economia Tributária
                        </p>
                        <p class="text-xl md:text-3xl font-black mb-2 md:mb-3">
                            R$ 45.2k
                        </p>
                        <div
                            class="w-full bg-white/20 h-1 md:h-1.5 rounded-full overflow-hidden"
                        >
                            <div class="w-[85%] bg-white h-full rounded-full">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .perspective-1000 {
        perspective: 1000px;
    }

    @media (min-width: 768px) {
        .custom-rotate {
            transform: rotateY(-5deg) rotateX(5deg);
        }
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
        opacity: 0;
        transform: translateY(20px);
    }

    .animate-fade-in-right {
        animation: fadeInRight 0.8s ease-out forwards;
        opacity: 0;
        transform: translateX(20px);
    }

    @keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @keyframes fadeInRight {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .animate-bounce-slow {
        animation: bounce-slow 3s infinite;
    }
    @keyframes bounce-slow {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }
</style>
