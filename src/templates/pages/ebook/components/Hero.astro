---

---

<!-- HERO - PREMIUM CONVERSION -->
<section
    class="relative pt-32 pb-24 px-6 md:px-8 bg-[#020403] text-white text-center overflow-hidden"
>
    <!-- Premium Glow Effects -->
    <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-emerald-900/20 blur-[120px] rounded-full pointer-events-none"
    >
    </div>

    <!-- Grid Background -->
    <div
        class="absolute inset-0 opacity-20 pointer-events-none"
        style="background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 50px 50px;"
    >
    </div>

    <div class="max-w-5xl mx-auto relative z-10">
        <!-- Exclusive Badge -->
        <div
            class="inline-flex items-center gap-3 px-5 py-2.5 bg-zinc-900/80 border border-zinc-800 rounded-full mb-10 backdrop-blur-md shadow-xl"
        >
            <span class="relative flex h-2.5 w-2.5">
                <span
                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
                ></span>
                <span
                    class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"
                ></span>
            </span>
            <span
                class="text-[10px] font-bold uppercase tracking-[0.2em] text-zinc-300"
                >Oferta Exclusiva Limitada</span
            >
        </div>

        <!-- Headline -->
        <h1
            class="text-6xl md:text-8xl font-black mb-8 leading-[0.95] tracking-tight font-['Outfit']"
        >
            Dobre seu <br class="hidden md:block" />
            <span
                class="text-transparent bg-clip-text bg-linear-to-r from-emerald-400 via-teal-300 to-emerald-500"
                >Faturamento</span
            >
            <br class="hidden md:block" /> com IA.
        </h1>

        <p
            class="text-xl md:text-2xl text-zinc-400 mb-14 max-w-2xl mx-auto leading-relaxed font-light"
        >
            O protocolo validado por <span class="text-zinc-200 font-semibold"
                >5.000+ empreendedores</span
            > para escalar operações digitais com inteligência artificial.
        </p>

        <!-- VSL Placeholder (Video Sales Letter) -->
        <div class="relative max-w-4xl mx-auto group cursor-pointer mb-16">
            <div
                class="absolute -inset-1 bg-linear-to-r from-emerald-500 to-teal-500 rounded-3xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"
            >
            </div>
            <div
                class="relative aspect-video bg-zinc-900 rounded-2xl shadow-2xl overflow-hidden ring-1 ring-white/10"
            >
                <img
                    src="https://images.unsplash.com/photo-1557804506-669a67965ba0?auto=format&fit=crop&w=1200&q=80"
                    alt="Masterclass Cover"
                    width="1200"
                    height="675"
                    class="w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-700 ease-out"
                    loading="eager"
                />
                <div
                    class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/10 transition-colors"
                >
                    <div
                        class="w-24 h-24 bg-white/10 backdrop-blur-md border border-white/20 rounded-full flex items-center justify-center shadow-2xl group-hover:scale-110 transition-all duration-300"
                    >
                        <div
                            class="w-16 h-16 bg-emerald-500 rounded-full flex items-center justify-center shadow-lg text-black pl-1"
                        >
                            <svg
                                class="w-8 h-8"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path d="M8 5v14l11-7z"></path></svg
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main CTA -->
        <div class="flex flex-col items-center gap-6">
            <button
                class="w-full md:w-auto px-16 py-6 bg-emerald-500 hover:bg-emerald-400 text-[#020403] font-black uppercase text-xl md:text-2xl rounded-xl shadow-[0_0_40px_rgba(16,185,129,0.3)] hover:shadow-[0_0_60px_rgba(16,185,129,0.5)] hover:-translate-y-1 transition-all duration-300"
            >
                Desbloquear Acesso Agora
            </button>
            <div
                class="flex items-center gap-6 text-xs font-medium uppercase tracking-wider text-zinc-500"
            >
                <div class="flex items-center gap-2">
                    <svg
                        class="w-4 h-4 text-emerald-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                        ></path></svg
                    >
                    Garantia de 7 Dias
                </div>
                <div class="flex items-center gap-2">
                    <svg
                        class="w-4 h-4 text-emerald-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                    >
                    Acesso Imediato
                </div>
            </div>
        </div>
    </div>
</section>
