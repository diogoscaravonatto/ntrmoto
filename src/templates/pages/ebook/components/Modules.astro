---

---

<section class="py-32 bg-[#020403] px-6 relative overflow-hidden">
    <!-- Background Decor -->
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1000px] h-[600px] bg-emerald-900/10 blur-[150px] rounded-full pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
        <h2
            class="text-4xl md:text-7xl font-black tracking-tighter uppercase text-center mb-32 text-white"
        >
            O QUE VOCÊ<br /><span class="text-emerald-500">VAI APRENDER.</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div
                class="group cursor-pointer p-8 rounded-3xl bg-white/5 border border-white/5 hover:border-emerald-500/50 hover:bg-emerald-950/10 transition-all duration-500"
            >
                <div
                    class="size-16 mb-8 bg-zinc-900 rounded-2xl flex items-center justify-center text-white shadow-xl group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-black transition-all duration-300"
                >
                    <span class="text-2xl font-black italic">01</span>
                </div>
                <h3
                    class="text-2xl font-black italic uppercase mb-4 text-white"
                >
                    Vibe Selection
                </h3>
                <p
                    class="text-lg text-zinc-500 group-hover:text-zinc-400 font-medium leading-relaxed transition-colors"
                >
                    Como escolher as cores e tipografias que vendem no
                    subconsciente do seu cliente.
                </p>
            </div>
            <div
                class="group cursor-pointer p-8 rounded-3xl bg-white/5 border border-white/5 hover:border-emerald-500/50 hover:bg-emerald-950/10 transition-all duration-500"
            >
                <div
                    class="size-16 mb-8 bg-zinc-900 rounded-2xl flex items-center justify-center text-white shadow-xl group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-black transition-all duration-300"
                >
                    <span class="text-2xl font-black italic">02</span>
                </div>
                <h3
                    class="text-2xl font-black italic uppercase mb-4 text-white"
                >
                    Prompt Mastery
                </h3>
                <p
                    class="text-lg text-zinc-500 group-hover:text-zinc-400 font-medium leading-relaxed transition-colors"
                >
                    A arte de conversar com a I.A. para obter resultados
                    ultra-premium em segundos.
                </p>
            </div>
            <div
                class="group cursor-pointer p-8 rounded-3xl bg-white/5 border border-white/5 hover:border-emerald-500/50 hover:bg-emerald-950/10 transition-all duration-500"
            >
                <div
                    class="size-16 mb-8 bg-zinc-900 rounded-2xl flex items-center justify-center text-white shadow-xl group-hover:scale-110 group-hover:bg-emerald-500 group-hover:text-black transition-all duration-300"
                >
                    <span class="text-2xl font-black italic">03</span>
                </div>
                <h3
                    class="text-2xl font-black italic uppercase mb-4 text-white"
                >
                    Scale Engine
                </h3>
                <p
                    class="text-lg text-zinc-500 group-hover:text-zinc-400 font-medium leading-relaxed transition-colors"
                >
                    Transformando um único produto digital em um império de
                    múltiplos nichos.
                </p>
            </div>
        </div>
    </div>
</section>
