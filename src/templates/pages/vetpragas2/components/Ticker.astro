---
const items = [
    {
        text: "DEDETIZAÇÃO<br>SEM CHEIRO",
        desc: "Tecnologia de aplicação<br>sem odor residual",
        number: "01",
    },
    {
        text: "SEGURO PARA PETs<br>E CRIANÇAS",
        desc: "Protocolos controlados<br>e aplicação responsável",
        number: "02",
    },
    {
        text: "SUPERVISÃO<br>VETERINÁRIA",
        desc: "Acompanhamento técnico<br>focado em biosegurança",
        number: "03",
    },
    {
        text: "SERVIÇO RÁPIDO<br>E EFICIENTE",
        desc: "Ambientes controlados e<br>prontos em poucas horas",
        number: "04",
    },
];
---

<div class="ticker-section">
    <div class="industrial-track">
        <div class="ticker-wrapper animate-ticker">
            {
                [...items, ...items, ...items, ...items].map((item) => (
                    <div class="ticker-node" data-ticker-node>
                        <div class="node-header">
                            <div class="node-check-container">
                                <div class="node-check-glow" />
                                <div class="node-check">
                                    <svg
                                        class="w-3 h-3"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="3"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M5 13l4 4L19 7"
                                        />
                                    </svg>
                                </div>
                            </div>
                            <div class="node-line" />
                        </div>
                        <div class="node-body">
                            <h3 class="node-title" set:html={item.text} />
                            <p class="node-desc" set:html={item.desc} />
                        </div>
                    </div>
                ))
            }
        </div>
    </div>

    <!-- Edge Fading Overlay -->
    <div class="edge-fade left"></div>
    <div class="edge-fade right"></div>
</div>

<script>
    function initTickerEffect() {
        const nodes = document.querySelectorAll("[data-ticker-node]");
        if (nodes.length === 0) return;

        const centerX = window.innerWidth / 2;

        function updatePositions() {
            nodes.forEach((node) => {
                const rect = node.getBoundingClientRect();
                const nodeCenter = rect.left + rect.width / 2;

                const distance = Math.abs(centerX - nodeCenter);
                const maxDistance = 300;

                if (distance < maxDistance) {
                    const intensity = 1 - distance / maxDistance;
                    const scale = 1 + intensity * 0.15;
                    (node as HTMLElement).style.transform = `scale(${scale})`;
                } else {
                    (node as HTMLElement).style.transform = `scale(1)`;
                }
                (node as HTMLElement).style.opacity = `1`;
            });
            requestAnimationFrame(updatePositions);
        }

        updatePositions();
    }

    // Inicializa com um pequeno delay para garantir que o layout mobile estabilizou
    window.addEventListener("load", () => {
        setTimeout(initTickerEffect, 100);
    });
</script>

<style>
    .ticker-section {
        position: relative;
        background: #0f172a;
        height: 180px;
        display: flex;
        align-items: center;
        overflow: hidden;
        z-index: 25;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        max-width: 100vw;
    }

    .industrial-track {
        width: 100%;
        overflow: hidden;
    }

    .animate-ticker {
        display: flex;
        width: fit-content;
        animation: ticker-slide 80s linear infinite;
        will-change: transform;
        padding: 50px 0;
    }

    @keyframes ticker-slide {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-25%);
        }
    }

    .ticker-node {
        display: flex;
        flex-direction: column;
        padding: 0 60px;
        min-width: 420px;
        position: relative;
    }

    .node-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 8px;
        width: 100%;
    }

    .node-check-container {
        position: relative;
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .node-check {
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        color: #d81624;
        border: 2px solid #d81624;
        border-radius: 50%;
        position: relative;
        z-index: 2;
        box-shadow: 0 0 15px rgba(216, 22, 36, 0.5);
        transform: scale(1.1);
    }

    .node-check-glow {
        position: absolute;
        width: 80px;
        height: 80px;
        background: radial-gradient(
            circle,
            rgba(216, 22, 36, 0.45) 0%,
            transparent 70%
        );
        border-radius: 50%;
        opacity: 0.9;
        z-index: 1;
        filter: blur(12px);
        pointer-events: none;
    }

    /* O Traço Gradiente que estava faltando */
    .node-line {
        flex-grow: 1;
        height: 1px;
        background: linear-gradient(90deg, #d81624 0%, transparent 100%);
        opacity: 0.3;
    }

    .node-body {
        padding-left: 2px;
    }

    .node-title {
        color: #fff;
        font-size: 16px;
        font-weight: 900;
        letter-spacing: 0.12em;
        margin-bottom: 4px;
        text-transform: uppercase;
        max-width: 250px; /* Forces wrapping */
        min-height: 2.5em; /* Ensures space for 2 lines */
        display: flex;
        align-items: center;
        line-height: 1.2;
    }

    .node-desc {
        color: #64748b;
        font-size: 12px;
        font-weight: 500;
        text-transform: none;
        line-height: 1.4;
        max-width: 220px; /* Forces wrapping */
        min-height: 2.8em; /* Ensures space for 2 lines */
        display: block;
    }

    .edge-fade {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 150px;
        z-index: 10;
        pointer-events: none;
    }
    .edge-fade.left {
        left: 0;
        background: linear-gradient(90deg, #0f172a 20%, transparent);
    }
    .edge-fade.right {
        right: 0;
        background: linear-gradient(-90deg, #0f172a 20%, transparent);
    }

    .animate-ticker:hover {
        animation-play-state: paused;
    }

    @media (max-width: 768px) {
        .ticker-section {
            height: 140px;
        }
        .ticker-node {
            min-width: 280px;
            padding: 0 20px;
        }
        .node-title {
            font-size: 14px;
            letter-spacing: 0.08em;
        }
        .node-desc {
            font-size: 11px;
            max-width: 180px;
        }
        .node-check-glow {
            width: 50px;
            height: 50px;
        }
        .edge-fade {
            width: 60px;
        }
    }
</style>
