---
import { vetPragasData } from "./content";
---

<section class="py-24 bg-slate-50 relative">
    <div class="container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-20">
            <span
                class="text-accent-dark font-bold text-[10px] uppercase tracking-[0.3em] font-mono"
                >{vetPragasData.results.subtitle}</span
            >
            <h2
                class="text-4xl lg:text-5xl font-black text-slate-900 mt-4 mb-6 uppercase tracking-tighter"
            >
                Eficácia <span class="text-accent">Comprovada</span>
            </h2>
            <p class="text-lg text-slate-500">
                Transparência total nos resultados entregues a cada cliente.
            </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto mb-20">
            {
                vetPragasData.results.cases.map((caseItem) => (
                    <div class="bg-white p-10 rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-500 group">
                        <div class="flex items-center justify-between mb-8">
                            <span class="px-4 py-1.5 bg-accent/5 text-accent-dark font-bold text-[10px] uppercase tracking-widest rounded-full">
                                {caseItem.type}
                            </span>
                            <div class="flex items-center gap-2 text-accent font-black text-sm uppercase tracking-tighter">
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M13 10V3L4 14h7v7l9-11h-7z"
                                    />
                                </svg>
                                {caseItem.timeline}
                            </div>
                        </div>

                        <p class="text-slate-400 text-[10px] font-bold uppercase tracking-[0.2em] mb-2">
                            Situação Inicial
                        </p>
                        <h3 class="text-xl font-black text-slate-900 mb-8 tracking-tight">
                            {caseItem.problem}
                        </h3>

                        <div class="p-6 bg-slate-50 rounded-2xl mb-8 group-hover:bg-accent/5 transition-colors">
                            <p class="text-slate-400 text-[10px] font-bold uppercase tracking-[0.2em] mb-2">
                                Resultado Final
                            </p>
                            <div class="text-accent font-black tracking-tight">
                                {caseItem.result}
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <div class="w-1.5 h-1.5 bg-accent rounded-full" />
                            <span class="text-xs text-slate-500 font-bold uppercase tracking-widest">
                                {caseItem.metric}
                            </span>
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- Stats summary -->
        <div class="flex flex-wrap justify-center gap-12 lg:gap-24">
            {
                vetPragasData.stats.map((stat) => (
                    <div class="text-center group">
                        <div class="text-4xl font-black text-slate-900 group-hover:text-accent transition-colors mb-2">
                            {stat.number}
                        </div>
                        <div class="text-xs text-slate-400 font-bold uppercase tracking-widest leading-none">
                            {stat.label}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
