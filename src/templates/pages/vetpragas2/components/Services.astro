---
import { vetPragasData } from './content';
---

<section id="servicos" class="py-24 bg-[#F8FAFC] relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        <!-- Header -->
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-0 mb-20 animate-reveal lg:items-end">
            <div class="text-left">
                <h2 class="inline-flex items-center gap-2 px-3 py-1 bg-accent/5 border border-accent/20 text-accent text-[10px] font-black uppercase tracking-[0.3em] mb-8 rounded-sm">
                    SERVIÇO DE DEDETIZAÇÃO E SANITIZAÇÃO
                </h2>
                <h2 class="text-5xl lg:text-7xl font-black text-primary uppercase tracking-tighter leading-[0.85]">
                    NOSSOS <br /><span class="text-accent">SERVIÇOS</span>
                </h2>
            </div>
            
            <div class="lg:border-l-2 border-accent lg:pl-10 lg:py-2 max-w-md">
                <p class="text-lg text-slate-500 font-bold leading-relaxed">
                    Muito além de uma aplicação comum, unimos inteligência biológica e rigor veterinário. Conheça nossos serviços e veja como podemos manter seu ambiente livre de invasores:
                </p>
            </div>
        </div>

        <!-- Services Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {vetPragasData.services.items.map((service, index) => (
                <div class="group relative bg-white border border-slate-200/60 p-7 transition-all duration-500 hover:shadow-[0_45px_90px_-20px_rgba(15,23,42,0.12)] hover:-translate-y-2 rounded-2xl overflow-hidden">
                    <div>
                        <!-- Surgical Tech Module Header -->
                        <div class="flex items-start gap-6 mb-6">
                            <!-- Technical Display Unit -->
                            <div class="shrink-0 relative">
                                <!-- Base Display (Monitor Style) -->
                                <div class="w-20 h-20 bg-primary rounded-xl relative overflow-hidden flex items-center justify-center border border-white/10 group-hover:border-accent/50 transition-colors duration-500 shadow-2xl">
                                    
                                    <!-- Permanent Intensity Glow (Red) - Background -->
                                    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(239,68,68,0.15)_0%,transparent_70%)] opacity-100 group-hover:bg-[rgba(239,68,68,0.25)] transition-all"></div>
                                    
                                    <!-- Scan Lines (Static Tech Texture) -->
                                    <div class="absolute inset-0 opacity-10 pointer-events-none bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-size-[100%_2px,3px_100%]"></div>

                                    <!-- Lock-on Brackets (Animate on Hover) -->
                                    <div class="absolute inset-2 border-l border-t border-accent/0 group-hover:border-accent/40 -translate-x-2 -translate-y-2 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-300 rounded-tl-sm w-4 h-4"></div>
                                    <div class="absolute inset-2 right-2 left-auto border-r border-t border-accent/0 group-hover:border-accent/40 translate-x-2 -translate-y-2 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-300 rounded-tr-sm w-4 h-4"></div>
                                    <div class="absolute inset-2 top-auto bottom-2 border-l border-b border-accent/0 group-hover:border-accent/40 -translate-x-2 translate-y-2 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-300 rounded-bl-sm w-4 h-4"></div>
                                    <div class="absolute inset-2 left-auto right-2 top-auto bottom-2 border-r border-b border-accent/0 group-hover:border-accent/40 translate-x-2 translate-y-2 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-300 rounded-br-sm w-4 h-4"></div>


                                    <!-- Main Technical Icon -->
                                    <div class="relative z-10 text-white/90 group-hover:text-white transition-all duration-500 drop-shadow-[0_0_8px_rgba(239,68,68,0.5)]">
                                        {index === 0 && (
                                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><circle cx="12" cy="12" r="3"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M22 12h-2"/><path d="M4 12H2"/></svg>
                                        )}
                                        {index === 1 && (
                                            /* Was in Desratização (index 4) -> Now in Empresas */
                                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18"/><path d="M3 21h18"/><path d="M5 3v18"/><path d="M19 3v18"/><path d="M9 9h6"/><path d="M9 15h6"/><path d="M12 3v18"/></svg>
                                        )}
                                        {index === 2 && (
                                            /* Was in Empresas (index 1) -> Now in Casas */
                                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 12h.01"/><path d="M7 12h.01"/><path d="M12 12h.01"/><path d="M2 20V9l9-7 9 7v11a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2Z"/><path d="M9 22V12h6v10"/></svg>
                                        )}
                                        {index === 3 && (
                                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>
                                        )}
                                        {index === 4 && (
                                            /* Was in Casas (index 2) -> Now in Desratização */
                                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
                                        )}
                                        {index === 5 && (
                                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 22V12"/><path d="M12 22L7 17"/><path d="M12 22L17 17"/><path d="M22 12H12"/><path d="M2 12h10"/></svg>
                                        )}
                                    </div>
                                </div>
                            </div>

                            <!-- Title -->
                            <div class="flex-1 pt-1">
                                <h3 class="text-xl font-black text-primary uppercase tracking-tight group-hover:text-accent transition-colors duration-500 leading-tight">
                                    {service.title}
                                </h3>
                            </div>
                        </div>
                        
                        <p class="text-slate-500 text-[13px] leading-relaxed font-medium line-clamp-3 pr-4 border-l-2 border-slate-100 pl-4 group-hover:border-accent/30 transition-colors">
                            {service.description}
                        </p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .animate-reveal {
        opacity: 0;
        transform: translateY(20px);
        animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes reveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
