---
const footer = {
    brand: { name: "VÉRONIQUE", highlight: "JOAILLERIE" },
    tagline:
        "Alta Joalheria de Herança. Peças Únicas para Histórias Eternas. Paris • Geneva • New York • Tokyo",
    address: {
        label: "Flagship Paris",
        val: "22 Place Vendôme, 75001 Paris, France.",
    },
    social: {
        label: "Suivez-nous",
        links: [
            { label: "Instagram", href: "https://instagram.com" },
            { label: "Vogue Portfolio", href: "https://vogue.com" },
        ],
    },
    copy: "© 2026 Véronique Joaillerie de Luxe. L'éternité é um brilho.",
};
---

<footer class="py-24 bg-white border-t border-zinc-100">
    <div
        class="max-w-7xl mx-auto px-12 grid md:grid-cols-2 lg:grid-cols-4 gap-20"
    >
        <div class="lg:col-span-2 space-y-10">
            <div
                class="text-2xl tracking-[0.3em] font-light uppercase text-black"
            >
                {footer.brand.name}
                <span
                    class="text-[8px] font-black tracking-[0.6em] text-[#d4af37] block -mt-1 italic"
                    >{footer.brand.highlight}</span
                >
            </div>
            <p
                class="text-[10px] text-zinc-400 font-black uppercase tracking-[0.3em] leading-loose max-w-xs italic lowercase"
            >
                {footer.tagline}
            </p>
        </div>
        <div class="space-y-6">
            <p
                class="text-[10px] font-black uppercase tracking-widest text-zinc-900 underline decoration-[#d4af37] underline-offset-4 italic lowercase"
            >
                {footer.address.label}
            </p>
            <p class="text-sm text-zinc-500 font-light italic lowercase">
                {footer.address.val}
            </p>
        </div>
        <div class="space-y-6">
            <p
                class="text-[10px] font-black uppercase tracking-widest text-zinc-900 underline decoration-[#d4af37] underline-offset-4 italic lowercase"
            >
                {footer.social.label}
            </p>
            <div
                class="flex flex-col gap-4 text-sm text-zinc-500 font-light italic lowercase"
            >
                {
                    footer.social.links.map((link) => (
                        <a
                            href={link.href}
                            class="hover:text-black transition-colors"
                        >
                            {link.label}
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
    <div
        class="mt-32 text-center text-[8px] font-black text-zinc-200 uppercase tracking-[0.6em] italic lowercase"
    >
        {footer.copy}
    </div>
</footer>
