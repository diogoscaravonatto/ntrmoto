---
const collections = {
    title: "les pièces d'art.",
    eyebrow: "Curadoria 2026",
    items: [
        {
            title: "Diamant Éternel",
            type: "Rivière Necklace",
            price: "POA",
        },
        {
            title: "Rose Garden",
            type: "Pink Sapphire Ring",
            price: "POA",
        },
        {
            title: "Soleil Couchant",
            type: "Yellow Diamond Earrings",
            price: "POA",
        },
    ],
};
---

<section id="colecoes" class="py-40 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-32 space-y-6">
            <h2
                class="text-6xl md:text-8xl font-light lowercase italic text-zinc-950 tracking-tighter"
            >
                {collections.title}
            </h2>
            <p
                class="text-zinc-400 uppercase text-[10px] font-black tracking-[0.5em] italic"
            >
                {collections.eyebrow}
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-16">
            {
                collections.items.map((item) => (
                    <div class="group cursor-pointer">
                        <div class="aspect-square bg-zinc-50 mb-10 overflow-hidden relative border border-zinc-100 shadow-sm hover:shadow-2xl transition-all duration-700">
                            <div class="absolute inset-0 bg-white/0 group-hover:bg-white/20 transition-all pointer-events-none" />
                            <div class="absolute inset-0 flex items-center justify-center italic text-zinc-200 text-xl font-light opacity-20 group-hover:opacity-100 group-hover:scale-110 transition-all pointer-events-none uppercase tracking-widest leading-none">
                                Preview Piece
                            </div>
                        </div>
                        <div class="text-center space-y-2">
                            <p class="text-[9px] font-black uppercase tracking-[0.4em] text-zinc-400 italic lowercase leading-none">
                                {item.type}
                            </p>
                            <h3 class="text-2xl font-light text-zinc-950 tracking-tight italic">
                                {item.title}
                            </h3>
                            <span class="text-[10px] font-black text-[#d4af37] tracking-[0.2em] italic lowercase leading-none">
                                {item.price}
                            </span>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
