---
const cta = {
    title: ["Votre désir,", "notre art."],
    description:
        "Oferecemos atendimento exclusivo sob agendamento para a criação de peças sob medida e consultoria de gemas raras.",
    button: "Agendar Private Viewing",
    contact: {
        label: "Concierge WhatsApp",
        val: "+33 1 70 80 90 00",
    },
};
---

<section id="contato" class="py-60 bg-[#0a0a0b] text-white">
    <div class="max-w-5xl mx-auto text-center space-y-24 px-6">
        <div class="space-y-12">
            <h2
                class="text-6xl md:text-[9rem] font-light leading-tight italic text-zinc-100 tracking-tighter"
            >
                {cta.title[0]}
                <br />{cta.title[1]}
            </h2>
            <p
                class="text-xl text-zinc-500 font-light max-w-xl mx-auto leading-relaxed italic lowercase"
            >
                {cta.description}
            </p>
        </div>

        <div
            class="flex flex-col md:flex-row items-center justify-center gap-12"
        >
            <button
                class="px-16 py-8 bg-white text-black text-[10px] font-black uppercase tracking-[0.5em] hover:bg-[#d4af37] hover:text-white transition-all outline-hidden group italic"
            >
                {cta.button}
            </button>
            <div class="flex flex-col items-center md:items-start gap-1">
                <span
                    class="text-[11px] font-black text-zinc-400 uppercase tracking-widest italic lowercase"
                    >{cta.contact.label}</span
                >
                <span
                    class="text-sm font-light italic text-[#d4af37] uppercase tracking-widest"
                    >{cta.contact.val}</span
                >
            </div>
        </div>
    </div>
</section>
