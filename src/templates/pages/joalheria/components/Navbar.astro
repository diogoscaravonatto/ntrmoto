---
const brand = { name: "VÉRONIQUE", highlight: "JOAILLERIE" };
const links = [
    { label: "L'Atelier", href: "#atelier" },
    { label: "Collections", href: "#colecoes" },
    { label: "Bespoke", href: "#bespoke" },
    { label: "Private Store", href: "#contato" },
    { label: "FAQ", href: "#faq" },
];
---

<nav
    class="fixed top-0 w-full z-50 flex items-center justify-between px-12 h-24 bg-white/50 backdrop-blur-md border-b border-zinc-100"
>
    <div
        class="hidden lg:flex items-center gap-12 text-[9px] font-bold uppercase tracking-[0.4em] text-zinc-400"
    >
        <a href={links[0].href} class="hover:text-[#d4af37] transition-colors"
            >{links[0].label}</a
        >
        <a href={links[1].href} class="hover:text-[#d4af37] transition-colors"
            >{links[1].label}</a
        >
    </div>
    <div
        class="text-3xl tracking-[0.3em] font-light uppercase text-black flex flex-col items-center"
    >
        {brand.name}
        <span
            class="text-[8px] font-black tracking-[0.6em] text-[#d4af37] -mt-1"
            >{brand.highlight}</span
        >
    </div>
    <div
        class="flex items-center gap-12 text-[9px] font-bold uppercase tracking-[0.4em] text-zinc-400"
    >
        <a href={links[2].href} class="hover:text-[#d4af37] transition-colors"
            >{links[2].label}</a
        >
        <a href={links[3].href} class="hover:text-[#d4af37] transition-colors"
            >{links[3].label}</a
        >
        <a href={links[4].href} class="hover:text-[#d4af37] transition-colors"
            >{links[4].label}</a
        >
    </div>
</nav>
