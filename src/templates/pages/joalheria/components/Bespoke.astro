---
const bespoke = {
    eyebrow: "Sur Mesure",
    title: ["O Seu", "Desejo,", "Eternizado."],
    description:
        "Nossa experiência Bespoke permite que você participe de cada etapa da criação, desde a seleção da gema bruta até o último polimento manual.",
    steps: [
        {
            title: "Consulta Criativa",
            desc: "Briefing privado com nossos designers para traduzir sua história em traços e volumes.",
        },
        {
            title: "Seleção de Gemas",
            desc: "Acesso exclusivo ao nosso cofre de diamantes e pedras coloridas com certificação GIA.",
        },
        {
            title: "Prototipagem 3D & Cera",
            desc: "Visualização da peça antes da fundição final em Ouro 18k de procedência ética.",
        },
    ],
};
---

<section
    id="bespoke"
    class="py-40 bg-zinc-950 text-white overflow-hidden relative"
>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-32 items-center">
            <div class="space-y-16">
                <span
                    class="text-[10px] font-bold uppercase tracking-[0.6em] text-[#d4af37] italic leading-none"
                    >{bespoke.eyebrow}</span
                >
                <h2
                    class="text-6xl md:text-8xl font-light italic leading-none tracking-tighter"
                >
                    {bespoke.title[0]}
                    <br />{bespoke.title[1]}
                    <br /><span class="text-[#d4af37]">{bespoke.title[2]}</span>
                </h2>
                <p
                    class="text-xl text-zinc-500 font-light leading-relaxed italic"
                >
                    {bespoke.description}
                </p>

                <div class="space-y-10 pt-10 border-t border-white/10">
                    {
                        bespoke.steps.map((step) => (
                            <div class="group cursor-default">
                                <h4 class="text-[#d4af37] font-light text-2xl mb-2 group-hover:translate-x-2 transition-transform italic tracking-tight uppercase">
                                    {step.title}
                                </h4>
                                <p class="text-zinc-600 text-sm font-light leading-relaxed italic lowercase">
                                    {step.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
            <div class="relative">
                <div
                    class="aspect-3/4 border border-white/5 rounded-full flex items-center justify-center animate-[spin_20s_linear_infinite] pointer-events-none"
                >
                    <div
                        class="size-px bg-[#d4af37] shadow-[0_0_100px_50px_rgba(212,175,55,0.1)]"
                    >
                    </div>
                </div>
                <div
                    class="absolute inset-0 flex items-center justify-center pointer-events-none"
                >
                    <span
                        class="text-zinc-800 text-[10rem] font-light italic tracking-tighter opacity-20 uppercase"
                        >Unique</span
                    >
                </div>
            </div>
        </div>
    </div>
</section>
