---

---

<!-- TICKETS SECTION -->
<section class="py-24 bg-black relative px-4 overflow-hidden">
    <!-- Matrix Rain Effect (simplified css) -->
    <div
        class="absolute inset-0 opacity-10 bg-[url('https://upload.wikimedia.org/wikipedia/commons/1/17/Matrix_code.gif')] bg-cover mix-blend-screen pointer-events-none"
    >
    </div>

    <div class="max-w-5xl mx-auto relative z-10">
        <h2
            class="text-4xl md:text-5xl font-black text-center text-white mb-16 uppercase tracking-tighter"
        >
            System Access
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Standard -->
            <div
                class="border border-green-500/30 bg-black p-8 hover:border-green-500 transition-colors group relative"
            >
                <div class="absolute top-0 right-0 p-2 opacity-50">
                    <svg
                        class="w-6 h-6 text-green-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                        ></path></svg
                    >
                </div>
                <h3 class="text-green-500 font-mono text-xl mb-4">
                    Standard_Proto
                </h3>
                <div class="text-4xl font-black text-white mb-8">R$ 150</div>
                <ul class="space-y-4 text-zinc-400 font-mono text-sm mb-8">
                    <li class="flex gap-2">
                        <span class="text-green-500">></span> Access to Main Floor
                    </li>
                    <li class="flex gap-2">
                        <span class="text-green-500">></span> 1x Free Drink
                    </li>
                    <li
                        class="flex gap-2 text-zinc-700 decoration-line-through"
                    >
                        <span class="text-zinc-700">></span> VIP Lounge
                    </li>
                </ul>
                <button
                    class="w-full py-3 border border-green-500 text-green-500 font-mono uppercase hover:bg-green-500 hover:text-black transition-all"
                >
                    Initialize
                </button>
            </div>

            <!-- VIP -->
            <div
                class="border-2 border-fuchsia-500 bg-zinc-900/50 p-8 transform md:-translate-y-4 shadow-[0_0_30px_rgba(192,38,211,0.2)] relative overflow-hidden group"
            >
                <div class="absolute inset-0 bg-fuchsia-500/5 animate-pulse">
                </div>
                <div class="relative z-10">
                    <div
                        class="absolute top-0 right-0 bg-fuchsia-500 text-black text-xs font-black px-2 py-1 uppercase"
                    >
                        Recommended
                    </div>
                    <h3 class="text-fuchsia-400 font-mono text-xl mb-4">
                        VIP_Nexus
                    </h3>
                    <div class="text-4xl font-black text-white mb-8">
                        R$ 280
                    </div>
                    <ul class="space-y-4 text-zinc-300 font-mono text-sm mb-8">
                        <li class="flex gap-2">
                            <span class="text-fuchsia-500">></span> Access to All
                            Areas
                        </li>
                        <li class="flex gap-2">
                            <span class="text-fuchsia-500">></span> Open Bar (22h-02h)
                        </li>
                        <li class="flex gap-2">
                            <span class="text-fuchsia-500">></span> Fast Lane Entry
                        </li>
                        <li class="flex gap-2">
                            <span class="text-fuchsia-500">></span> Exclusive NFT
                        </li>
                    </ul>
                    <button
                        class="w-full py-3 bg-fuchsia-600 text-white font-black uppercase hover:bg-fuchsia-500 hover:shadow-[0_0_20px_rgba(192,38,211,0.5)] transition-all"
                    >
                        Execute Access
                    </button>
                </div>
            </div>

            <!-- Backstage -->
            <div
                class="border border-cyan-500/30 bg-black p-8 hover:border-cyan-500 transition-colors group"
            >
                <h3 class="text-cyan-500 font-mono text-xl mb-4">Root_Admin</h3>
                <div class="text-4xl font-black text-white mb-8">R$ 450</div>
                <ul class="space-y-4 text-zinc-400 font-mono text-sm mb-8">
                    <li class="flex gap-2">
                        <span class="text-cyan-500">></span> Backstage Pass
                    </li>
                    <li class="flex gap-2">
                        <span class="text-cyan-500">></span> Artist Meet & Greet
                    </li>
                    <li class="flex gap-2">
                        <span class="text-cyan-500">></span> Full Open Bar
                    </li>
                </ul>
                <button
                    class="w-full py-3 border border-cyan-500 text-cyan-500 font-mono uppercase hover:bg-cyan-500 hover:text-black transition-all"
                >
                    Grant Permission
                </button>
            </div>
        </div>
    </div>
</section>
