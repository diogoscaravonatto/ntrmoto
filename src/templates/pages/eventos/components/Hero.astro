---

---

<!-- HERO - CYBERPUNK STYLE -->
<section
    class="min-h-screen relative flex items-center justify-center bg-black overflow-hidden px-4"
>
    <!-- Neon Background -->
    <div class="absolute inset-0">
        <div
            class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_50%_50%,rgba(76,29,149,0.3),rgba(0,0,0,1))]"
        >
        </div>
        <div
            class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] bg-fuchsia-600/30 blur-[120px] rounded-full mix-blend-screen animate-pulse"
        >
        </div>
        <div
            class="absolute bottom-[10%] right-[10%] w-[40%] h-[40%] bg-cyan-500/20 blur-[100px] rounded-full mix-blend-screen animate-pulse animation-delay-2000"
        >
        </div>

        <!-- Grid Overlay -->
        <div
            class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-size-[40px_40px] [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_100%)]"
        >
        </div>
    </div>

    <!-- Glitch Content -->
    <div class="relative z-10 text-center max-w-5xl mx-auto">
        <div
            class="mb-4 inline-flex items-center gap-2 px-4 py-1 border border-cyan-500/50 rounded bg-cyan-900/10 text-cyan-400 text-xs font-mono tracking-widest uppercase"
        >
            <span class="w-2 h-2 bg-cyan-400 rounded-full animate-ping"></span>
            Live Transmission • Sao Paulo
        </div>

        <h1
            class="text-[15vw] md:text-9xl font-black text-transparent bg-clip-text bg-gradient-to-r from-fuchsia-400 via-cyan-400 to-fuchsia-400 tracking-tighter mb-8 glitch-text"
            data-text="NEON NIGHTS"
        >
            NEON NIGHTS
        </h1>

        <p
            class="text-xl md:text-2xl text-cyan-100/70 font-mono mb-12 max-w-2xl mx-auto"
        >
            A imersão audiovisual definitiva. 12 horas de synthwave, tech-house
            e experiências digitais.
        </p>

        <div class="flex flex-col sm:flex-row gap-6 justify-center">
            <button
                class="relative px-8 py-4 bg-fuchsia-600 hover:bg-fuchsia-500 text-white font-black uppercase text-lg tracking-wider clip-path-polygon hover:shadow-[0_0_30px_rgba(192,38,211,0.6)] transition-all group"
            >
                <span
                    class="absolute inset-0 border-2 border-white/20 clip-path-polygon"
                ></span>
                Get Tickets <span
                    class="ml-2 group-hover:translate-x-1 inline-block transition-transform"
                    >&gt;&gt;</span
                >
            </button>

            <button
                class="px-8 py-4 border border-cyan-500/50 text-cyan-400 font-mono uppercase tracking-wider hover:bg-cyan-950/30 hover:border-cyan-400 hover:text-cyan-300 transition-all hover:shadow-[0_0_20px_rgba(34,211,238,0.2)]"
            >
                View Lineup
            </button>
        </div>

        <!-- Countdown or Date -->
        <div
            class="mt-20 grid grid-cols-2 sm:grid-cols-4 gap-8 sm:gap-4 max-w-lg mx-auto text-cyan-400 font-mono border-t border-cyan-500/20 pt-8"
        >
            <div class="text-center">
                <div class="text-3xl font-bold">12</div>
                <div class="text-[0.6rem] uppercase tracking-widest opacity-60">
                    Sept
                </div>
            </div>
            <div class="text-center border-l border-cyan-500/20">
                <div class="text-3xl font-bold">22:00</div>
                <div class="text-[0.6rem] uppercase tracking-widest opacity-60">
                    Start
                </div>
            </div>
            <div class="text-center border-l border-cyan-500/20">
                <div class="text-3xl font-bold">SP</div>
                <div class="text-[0.6rem] uppercase tracking-widest opacity-60">
                    Loc
                </div>
            </div>
            <div class="text-center border-l border-cyan-500/20">
                <div class="text-3xl font-bold">18+</div>
                <div class="text-[0.6rem] uppercase tracking-widest opacity-60">
                    Age
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .clip-path-polygon {
        clip-path: polygon(10% 0, 100% 0, 100% 70%, 90% 100%, 0 100%, 0 30%);
    }
    .glitch-text::before,
    .glitch-text::after {
        content: attr(data-text);
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: black;
        opacity: 0.5;
    }
    .glitch-text::before {
        clip-path: polygon(0 0, 100% 0, 100% 45%, 0 45%);
        transform: translate(-3px, -2px);
        color: #0ff;
        z-index: -1;
        mix-blend-mode: hard-light;
        animation: glitch-anim-1 2.5s infinite linear alternate-reverse;
    }
    .glitch-text::after {
        clip-path: polygon(0 60%, 100% 60%, 100% 100%, 0 100%);
        transform: translate(3px, 2px);
        color: #f0f;
        z-index: -2;
        mix-blend-mode: hard-light;
        animation: glitch-anim-2 2s infinite linear alternate-reverse;
    }
    @keyframes glitch-anim-1 {
        0% {
            clip-path: inset(20% 0 80% 0);
        }
        20% {
            clip-path: inset(60% 0 10% 0);
        }
        40% {
            clip-path: inset(40% 0 50% 0);
        }
        60% {
            clip-path: inset(80% 0 5% 0);
        }
        80% {
            clip-path: inset(10% 0 70% 0);
        }
        100% {
            clip-path: inset(30% 0 20% 0);
        }
    }
    @keyframes glitch-anim-2 {
        0% {
            clip-path: inset(10% 0 60% 0);
        }
        20% {
            clip-path: inset(30% 0 10% 0);
        }
        40% {
            clip-path: inset(70% 0 5% 0);
        }
        60% {
            clip-path: inset(20% 0 40% 0);
        }
        80% {
            clip-path: inset(50% 0 30% 0);
        }
        100% {
            clip-path: inset(10% 0 80% 0);
        }
    }
</style>
