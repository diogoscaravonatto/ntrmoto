---
---

<!-- LINEUP SECTION -->
<section class="py-24 bg-black relative px-4 border-t border-cyan-900/30">
    <div class="max-w-6xl mx-auto">
        <h2 class="text-4xl md:text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500 mb-16 text-center uppercase tracking-tighter">
            Digital Artists
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {[
                { name: "CYBER MUNK", genre: "Synthwave", time: "23:00", img: "https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?auto=format&fit=crop&w=800&q=80" },
                { name: "NEON DEMON", genre: "Dark Techno", time: "01:00", img: "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=800&q=80" },
                { name: "GLITCH GOD", genre: "Industrial", time: "03:00", img: "https://images.unsplash.com/photo-1599566150163-29194dcaad36?auto=format&fit=crop&w=800&q=80" },
                { name: "VAPOR SOUL", genre: "Chillwave", time: "04:30", img: "https://images.unsplash.com/photo-1527980965255-d3b416303d12?auto=format&fit=crop&w=800&q=80" },
                { name: "PIXEL HEART", genre: "Drum & Bass", time: "22:00", img: "https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=800&q=80" },
                { name: "VOID WALKER", genre: "Ambient", time: "06:00", img: "https://images.unsplash.com/photo-1531427186611-ecfd6d936c79?auto=format&fit=crop&w=800&q=80" }
            ].map(artist => (
                <div class="group relative bg-zinc-900 border border-zinc-800 hover:border-fuchsia-500/50 transition-colors duration-300 overflow-hidden">
                    <div class="aspect-square relative overflow-hidden">
                        <img 
                            src={artist.img} 
                            alt={artist.name}
                            class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-500 mix-blend-luminosity group-hover:mix-blend-normal"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-90"></div>
                        
                        <!-- Glitch overlay on hover -->
                        <div class="absolute inset-0 bg-fuchsia-500/20 mix-blend-overlay opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    </div>
                    
                    <div class="absolute bottom-0 left-0 w-full p-6">
                        <div class="flex justify-between items-end mb-2">
                             <h3 class="text-2xl font-black text-white italic uppercase tracking-wider group-hover:text-fuchsia-400 transition-colors">{artist.name}</h3>
                             <span class="text-sm font-mono text-cyan-400 bg-cyan-950/50 px-2 py-1 border border-cyan-500/30">{artist.time}</span>
                        </div>
                        <p class="text-zinc-500 text-sm font-mono tracking-widest uppercase group-hover:text-white transition-colors">{artist.genre}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
