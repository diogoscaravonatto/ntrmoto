---
import { Image } from "astro:assets";
---

<section class="py-40 bg-zinc-950 px-6 overflow-hidden">
    <div class="max-w-7xl mx-auto">
        <h2
            class="text-5xl md:text-8xl font-black italic tracking-tighter uppercase text-white mb-32"
        >
            THE <span class="text-zinc-800">EXPERIENCE.</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-20">
            <div class="relative group">
                <div
                    class="aspect-video bg-zinc-900 rounded-6xl overflow-hidden border border-white/5 relative"
                >
                    <Image
                        src="https://images.unsplash.com/photo-1514525253361-bee8d48744ad?auto=format&fit=crop&w=800&q=80"
                        alt="Talks"
                        width={800}
                        height={450}
                        class="w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-1000"
                        layout="constrained"
                    />
                    <div
                        class="absolute inset-0 p-10 flex flex-col justify-end bg-linear-to-t from-black to-transparent"
                    >
                        <h3
                            class="text-4xl font-black italic text-white uppercase"
                        >
                            Visionary Talks
                        </h3>
                        <p class="text-zinc-500 font-medium italic mt-4">
                            Hear from the pioneers shaping the next century of
                            human progress.
                        </p>
                    </div>
                </div>
            </div>
            <div class="relative group mt-20">
                <div
                    class="aspect-video bg-zinc-900 rounded-6xl overflow-hidden border border-white/5 relative"
                >
                    <Image
                        src="https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?auto=format&fit=crop&w=800&q=80"
                        alt="Networking"
                        width={800}
                        height={450}
                        class="w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-1000"
                        layout="constrained"
                    />
                    <div
                        class="absolute inset-0 p-10 flex flex-col justify-end bg-linear-to-t from-black to-transparent"
                    >
                        <h3
                            class="text-4xl font-black italic text-white uppercase"
                        >
                            Elite Networking
                        </h3>
                        <p class="text-zinc-500 font-medium italic mt-4">
                            Connect with 500+ leaders in a designed, immersive
                            environment.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
