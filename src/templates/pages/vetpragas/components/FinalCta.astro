---
import { vetPragasData } from "./content";
---

<section
    class="py-32 bg-linear-to-b from-slate-950 to-black relative overflow-hidden"
>
    <!-- Animated Background -->
    <div class="absolute inset-0">
        <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(16,185,129,0.1),transparent_50%)]"
        >
        </div>
        <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_70%_50%,rgba(16,185,129,0.05),transparent_50%)]"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
            <!-- Urgency Badge -->
            <div
                class="inline-flex items-center gap-3 px-4 py-2 bg-red-950/30 border border-red-500/30 rounded-full mb-8 animate-pulse"
            >
                <span class="relative flex h-3 w-3">
                    <span
                        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"
                    ></span>
                    <span
                        class="relative inline-flex rounded-full h-3 w-3 bg-red-500"
                    ></span>
                </span>
                <span
                    class="text-red-400 font-mono text-xs uppercase tracking-widest"
                    >{vetPragasData.finalCta.urgency}</span
                >
            </div>

            <!-- Main Heading -->
            <h2
                class="text-5xl md:text-7xl font-black text-white mb-6 uppercase tracking-tighter leading-none"
            >
                {vetPragasData.finalCta.title}
            </h2>

            <!-- Subtitle -->
            <p
                class="text-2xl md:text-3xl text-emerald-500 font-bold mb-6 uppercase tracking-wide"
            >
                {vetPragasData.finalCta.subtitle}
            </p>

            <!-- Description -->
            <p
                class="text-lg text-slate-400 mb-12 max-w-2xl mx-auto leading-relaxed"
            >
                {vetPragasData.finalCta.description}
            </p>

            <!-- CTA Buttons -->
            <div
                class="flex flex-col sm:flex-row gap-6 justify-center items-center mb-12"
            >
                <a href="https://wa.me/554533265255" class="group relative">
                    <div
                        class="absolute -inset-2 bg-linear-to-r from-emerald-600 to-teal-600 rounded-lg blur opacity-50 group-hover:opacity-100 transition duration-1000 group-hover:duration-200 animate-pulse"
                    >
                    </div>
                    <button
                        class="relative px-12 py-6 bg-emerald-600 text-slate-950 font-black text-sm uppercase tracking-[0.15em] hover:bg-emerald-500 transition-all flex items-center justify-center gap-3 rounded-lg shadow-[0_0_30px_rgba(16,185,129,0.3)]"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                            ></path></svg
                        >
                        {vetPragasData.finalCta.cta}
                    </button>
                </a>

                <a
                    href="https://wa.me/554533265255"
                    class="px-12 py-6 border-2 border-slate-700 text-slate-300 font-bold text-sm uppercase tracking-[0.15em] hover:border-emerald-500 hover:text-emerald-400 transition-all rounded-lg"
                >
                    {vetPragasData.finalCta.secondaryCta}
                </a>
            </div>

            <!-- Trust Indicators -->
            <div
                class="flex flex-wrap justify-center gap-8 pt-12 border-t border-white/5"
            >
                <div class="flex items-center gap-3">
                    <svg
                        class="w-6 h-6 text-emerald-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path></svg
                    >
                    <span class="text-slate-400 text-sm font-medium"
                        >Supervisão Veterinária</span
                    >
                </div>
                <div class="flex items-center gap-3">
                    <svg
                        class="w-6 h-6 text-emerald-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                        ></path></svg
                    >
                    <span class="text-slate-400 text-sm font-medium"
                        >Produtos Autorizados ANVISA</span
                    >
                </div>
                <div class="flex items-center gap-3">
                    <svg
                        class="w-6 h-6 text-emerald-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path></svg
                    >
                    <span class="text-slate-400 text-sm font-medium"
                        >Atendimento 24/48h</span
                    >
                </div>
            </div>
        </div>
    </div>
</section>
