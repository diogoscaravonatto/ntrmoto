---
import { vetPragasData } from "./content";

const iconMap = {
    home: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
    building:
        '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>',
    briefcase:
        '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>',
    zap: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>',
    "credit-card":
        '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>',
    "file-text":
        '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>',
};
---

<section id="precos" class="py-24 bg-slate-900 relative overflow-hidden">
    <!-- Animated Background -->
    <div class="absolute inset-0 opacity-5">
        <div
            class="absolute inset-0 bg-[linear-gradient(45deg,#10b98120_1px,transparent_1px),linear-gradient(-45deg,#10b98120_1px,transparent_1px)] bg-size-[40px_40px] animate-grid-slide"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <!-- Header -->
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span
                class="text-emerald-500 font-mono text-[10px] uppercase tracking-[0.3em]"
                >{vetPragasData.pricing.subtitle}</span
            >
            <h2
                class="text-4xl lg:text-5xl font-black text-white mt-4 mb-6 uppercase tracking-tight"
            >
                {vetPragasData.pricing.title}
            </h2>
            <p class="text-lg text-slate-400">
                {vetPragasData.pricing.description}
            </p>
        </div>

        <!-- Pricing Cards -->
        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto mb-16">
            {
                vetPragasData.pricing.packages.map((pkg, index) => (
                    <div
                        class={`relative group ${pkg.highlight ? "md:-mt-4 md:mb-4" : ""}`}
                        style={`animation: fade-up 0.6s ease-out ${index * 0.15}s both`}
                    >
                        {/* Highlight Badge */}
                        {pkg.highlight && (
                            <div class="absolute -top-4 left-1/2 -translate-x-1/2 z-20">
                                <div class="px-4 py-1 bg-emerald-600 text-slate-950 font-bold text-xs uppercase tracking-widest rounded-full shadow-[0_0_20px_rgba(16,185,129,0.4)] animate-pulse-slow">
                                    {pkg.badge}
                                </div>
                            </div>
                        )}

                        {/* Card */}
                        <div
                            class={`relative h-full bg-slate-950/50 border ${pkg.highlight ? "border-emerald-500/50 shadow-[0_0_30px_rgba(16,185,129,0.2)]" : "border-white/5"} rounded-2xl p-8 hover:border-emerald-500/30 transition-all duration-500 hover:scale-105`}
                        >
                            {/* Glow Effect */}
                            <div class="absolute inset-0 bg-emerald-500/0 group-hover:bg-emerald-500/5 rounded-2xl transition-all duration-500" />

                            <div class="relative z-10">
                                {/* Icon */}
                                <div
                                    class={`w-16 h-16 ${pkg.highlight ? "bg-emerald-950 border-emerald-500/50" : "bg-slate-800 border-emerald-500/20"} border rounded-xl flex items-center justify-center mb-6 text-emerald-500 group-hover:scale-110 transition-transform`}
                                    set:html={
                                        iconMap[
                                            pkg.icon as keyof typeof iconMap
                                        ]
                                    }
                                />

                                {/* Type */}
                                <h3 class="text-2xl font-black text-white mb-2 uppercase tracking-wide">
                                    {pkg.type}
                                </h3>
                                <p class="text-sm text-slate-400 mb-8">
                                    {pkg.description}
                                </p>

                                {/* Services */}
                                <div class="space-y-4 mb-8">
                                    {pkg.services.map((service) => (
                                        <div class="flex items-start justify-between gap-4 pb-4 border-b border-white/5 last:border-0">
                                            <span class="text-slate-300 text-sm font-medium">
                                                {service.name}
                                            </span>
                                            <span class="text-emerald-400 text-sm font-bold whitespace-nowrap">
                                                {service.price}
                                            </span>
                                        </div>
                                    ))}
                                </div>

                                {/* CTA */}
                                <a
                                    href="https://wa.me/554533265255"
                                    class={`block text-center px-6 py-3 ${pkg.highlight ? "bg-emerald-600 text-slate-950 hover:bg-emerald-500" : "border border-slate-700 text-slate-300 hover:border-emerald-500 hover:text-emerald-400"} font-bold text-xs uppercase tracking-widest transition-all rounded-lg`}
                                >
                                    Solicitar Orçamento
                                </a>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- Payment Methods -->
        <div class="max-w-4xl mx-auto mb-12">
            <h3
                class="text-center text-xl font-bold text-white mb-8 uppercase tracking-wide"
            >
                Formas de Pagamento
            </h3>
            <div class="grid md:grid-cols-3 gap-6">
                {
                    vetPragasData.pricing.paymentMethods.map(
                        (method, index) => (
                            <div
                                class="flex items-center gap-4 p-6 bg-slate-950/50 border border-white/5 rounded-xl hover:border-emerald-500/30 transition-all group"
                                style={`animation: slide-in-up 0.5s ease-out ${0.8 + index * 0.1}s both`}
                            >
                                <div
                                    class="w-12 h-12 bg-emerald-950 border border-emerald-500/30 rounded-lg flex items-center justify-center text-emerald-500 group-hover:scale-110 transition-transform"
                                    set:html={
                                        iconMap[
                                            method.icon as keyof typeof iconMap
                                        ]
                                    }
                                />
                                <div>
                                    <div class="text-white font-bold text-sm uppercase tracking-wide">
                                        {method.name}
                                    </div>
                                    <div class="text-emerald-400 text-xs font-medium">
                                        {method.discount ||
                                            method.installments ||
                                            method.info}
                                    </div>
                                </div>
                            </div>
                        ),
                    )
                }
            </div>
        </div>

        <!-- Guarantee Banner -->
        <div class="text-center">
            <div
                class="inline-flex items-center gap-3 px-6 py-3 bg-slate-950/50 border border-emerald-500/20 rounded-full"
            >
                <svg
                    class="w-5 h-5 text-emerald-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path></svg
                >
                <span class="text-slate-300 text-sm font-medium"
                    >{vetPragasData.pricing.guarantee}</span
                >
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes grid-slide {
        0% {
            transform: translate(0, 0);
        }
        100% {
            transform: translate(40px, 40px);
        }
    }

    @keyframes fade-up {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes slide-in-up {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes pulse-slow {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.8;
        }
    }

    .animate-grid-slide {
        animation: grid-slide 20s linear infinite;
    }

    .animate-pulse-slow {
        animation: pulse-slow 3s ease-in-out infinite;
    }
</style>
