---
import { vetPragasData } from "./content";
---

<section id="intel" class="py-24 bg-slate-900 border-b border-white/5">
    <div class="container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-20">
            <h2
                class="text-3xl lg:text-4xl font-black text-white mb-4 uppercase tracking-tighter"
            >
                Relatórios de Campo
            </h2>
            <p
                class="text-slate-500 font-mono text-xs uppercase tracking-widest"
            >
                Confirmações de eficácia por parte dos contratantes.
            </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            {
                vetPragasData.testimonials.map((testimonial) => (
                    <div class="bg-slate-950 p-8 border border-white/5 hover:border-emerald-500/30 transition-all duration-300 group">
                        <div class="flex items-center gap-1 mb-6 opacity-50 group-hover:opacity-100 transition-opacity text-emerald-500">
                            {[1, 2, 3, 4, 5].map(() => (
                                <svg
                                    class="w-3 h-3"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                >
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                            ))}
                        </div>

                        <div class="mb-4">
                            <span class="text-[9px] font-mono text-slate-600 uppercase">
                                CLASSIFICAÇÃO: {testimonial.cif}
                            </span>
                        </div>

                        <p class="text-slate-400 mb-8 italic text-sm leading-relaxed border-l-2 border-emerald-500/20 pl-4 group-hover:border-emerald-500 group-hover:text-slate-300 transition-all">
                            "{testimonial.content}"
                        </p>

                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 bg-slate-800 rounded-full flex items-center justify-center text-slate-500 text-xs font-bold font-mono group-hover:bg-emerald-900 group-hover:text-emerald-400">
                                {testimonial.name.charAt(0)}
                            </div>
                            <div>
                                <p class="font-bold text-slate-200 text-sm uppercase tracking-wide">
                                    {testimonial.name}
                                </p>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
