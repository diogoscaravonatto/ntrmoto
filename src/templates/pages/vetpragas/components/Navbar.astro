---

---

<header
    class="fixed top-0 left-0 right-0 z-50 border-b border-emerald-900/30 bg-slate-950/80 backdrop-blur-md"
>
    <div class="container mx-auto px-6 relative">
        <div class="flex items-center justify-between h-20">
            <!-- Logo -->
            <a href="#" class="group flex items-center gap-3">
                <div
                    class="relative w-10 h-10 flex items-center justify-center bg-slate-900 border border-emerald-500/30 rounded-lg group-hover:border-emerald-500/80 transition-all shadow-[0_0_15px_rgba(16,185,129,0.1)] group-hover:shadow-[0_0_20px_rgba(16,185,129,0.4)]"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="text-emerald-500"
                        ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                        ></path></svg
                    >
                    <div
                        class="absolute inset-0 bg-emerald-500/10 animate-pulse rounded-lg"
                    >
                    </div>
                </div>
                <div class="flex flex-col">
                    <span
                        class="text-lg font-bold tracking-wider text-slate-100 uppercase font-mono"
                        >Vet<span class="text-emerald-500">Pragas</span></span
                    >
                    <span
                        class="text-[0.6rem] text-emerald-500/80 uppercase tracking-[0.2em]"
                        >Bio-Defense Systems</span
                    >
                </div>
            </a>

            <!-- Desktop Menu -->
            <nav class="hidden md:flex items-center gap-8">
                {
                    ["Protocolos", "Tecnologia", "Intel", "Faq"].map((item) => (
                        <a
                            href={`#${item.toLowerCase()}`}
                            class="text-[11px] font-bold uppercase tracking-widest text-slate-400 hover:text-emerald-400 transition-colors relative group"
                        >
                            <span class="absolute -left-3 top-1/2 -translate-y-1/2 w-1 h-1 bg-emerald-500 opacity-0 group-hover:opacity-100 transition-opacity" />
                            {item}
                        </a>
                    ))
                }
            </nav>

            <!-- CTA -->
            <div class="hidden md:flex items-center gap-4">
                <div
                    class="flex items-center gap-2 px-3 py-1 bg-emerald-900/20 border border-emerald-500/20 rounded text-[10px] text-emerald-400 font-mono"
                >
                    <span class="relative flex h-2 w-2">
                        <span
                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
                        ></span>
                        <span
                            class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"
                        ></span>
                    </span>
                    SYSTEM ONLINE
                </div>
                <a
                    href="https://wa.me/554533265255"
                    target="_blank"
                    class="px-6 py-2 bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold text-xs uppercase tracking-widest transition-all duration-300 hover:shadow-[0_0_20px_rgba(16,185,129,0.4)] clip-path-slant"
                >
                    Solicitar Varredura
                </a>
            </div>

            <!-- Mobile Menu Button -->
            <button
                class="md:hidden z-10 p-2 text-emerald-500 border border-emerald-500/30 rounded bg-slate-900/50"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><line x1="4" y1="12" x2="20" y2="12"></line><line
                        x1="4"
                        y1="6"
                        x2="20"
                        y2="6"></line><line x1="4" y1="18" x2="20" y2="18"
                    ></line></svg
                >
            </button>
        </div>
    </div>
</header>

<style>
    .clip-path-slant {
        clip-path: polygon(10% 0, 100% 0, 100% 100%, 0% 100%);
    }
</style>
