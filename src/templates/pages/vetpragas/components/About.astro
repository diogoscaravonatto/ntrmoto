---
import { Image } from "astro:assets";
import aboutImagev1 from "@assets/images/templates/vetpragas/about-v1.jpg";
import { vetPragasData } from "./content";
---

<section id="tecnologia" class="py-32 bg-slate-950 relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-20 items-center">
            <!-- Image Column -->
            <div class="relative order-2 lg:order-1 group">
                <div
                    class="relative rounded-2xl overflow-hidden border border-emerald-500/20 shadow-2xl"
                >
                    <Image
                        src={aboutImagev1}
                        alt="Laboratório VetPragas com tecnologia de ponta"
                        class="w-full h-auto opacity-80 group-hover:opacity-100 transition-all duration-700 saturate-50 group-hover:saturate-100"
                        loading="lazy"
                    />
                    <div
                        class="absolute inset-0 bg-linear-to-t from-slate-950/80 via-transparent to-transparent"
                    >
                    </div>
                </div>

                <!-- Floating Detail Card -->
                <div
                    class="absolute -bottom-6 -right-6 bg-slate-900 border border-emerald-500/30 p-6 rounded-xl shadow-2xl backdrop-blur-xl hidden md:block"
                >
                    <div
                        class="text-3xl font-mono font-black text-emerald-500 mb-1"
                    >
                        99.9%
                    </div>
                    <div
                        class="text-[10px] text-slate-400 font-bold uppercase tracking-widest leading-none"
                    >
                        Eficácia Microbiológica
                    </div>
                </div>
            </div>

            <!-- Content Column -->
            <div class="order-1 lg:order-2">
                <div class="mb-8">
                    <span
                        class="text-emerald-500 font-mono text-[10px] uppercase tracking-[0.3em]"
                    >
                        {vetPragasData.about.subtitle}
                    </span>
                    <h2
                        class="text-4xl md:text-5xl font-black text-white mt-4 uppercase tracking-tighter leading-none font-mono"
                    >
                        {vetPragasData.about.title}
                    </h2>
                </div>

                <p
                    class="text-lg text-slate-400 mb-10 leading-relaxed font-light first-letter:text-4xl first-letter:font-black first-letter:text-emerald-500 first-letter:mr-3 first-letter:float-left"
                >
                    {vetPragasData.about.description}
                </p>

                <ul class="space-y-6 mb-12">
                    {
                        vetPragasData.about.features.map((feature) => (
                            <li class="flex items-center gap-4 group">
                                <div class="shrink-0 w-8 h-8 rounded bg-emerald-950 border border-emerald-500/20 flex items-center justify-center group-hover:border-emerald-500/50 transition-colors">
                                    <svg
                                        class="w-4 h-4 text-emerald-500"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"
                                        />
                                    </svg>
                                </div>
                                <span class="text-slate-300 text-sm uppercase tracking-wide font-mono hover:text-white transition-colors">
                                    {feature}
                                </span>
                            </li>
                        ))
                    }
                </ul>

                <a
                    href="https://wa.me/554533265255"
                    class="inline-flex items-center justify-center px-12 py-5 bg-emerald-600 text-slate-950 font-black text-xs uppercase tracking-widest hover:bg-emerald-500 transition-all shadow-[0_0_30px_rgba(16,185,129,0.3)] hover:-translate-y-1"
                >
                    Conectar com o Laboratório
                </a>
            </div>
        </div>
    </div>
</section>
