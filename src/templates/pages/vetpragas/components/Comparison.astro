---
import { vetPragasData } from './content';
---

<section class="py-24 bg-slate-950 relative overflow-hidden">
  <!-- Animated Grid Background -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#10b98120_1px,transparent_1px),linear-gradient(to_bottom,#10b98120_1px,transparent_1px)] bg-size-[50px_50px] animate-[grid-flow_20s_linear_infinite]"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-emerald-500 font-mono text-[10px] uppercase tracking-[0.3em] animate-fade-in">{vetPragasData.comparison.subtitle}</span>
      <h2 class="text-4xl lg:text-5xl font-black text-white mt-4 mb-6 uppercase tracking-tight animate-slide-up">{vetPragasData.comparison.title}</h2>
      <p class="text-lg text-slate-400 animate-fade-in-delay">{vetPragasData.comparison.description}</p>
    </div>

    <!-- Comparison Table -->
    <div class="max-w-5xl mx-auto">
      <div class="bg-slate-900/50 border border-white/5 rounded-2xl overflow-hidden backdrop-blur-sm">
        
        <!-- Table Header -->
        <div class="grid grid-cols-3 gap-4 p-6 bg-slate-900/80 border-b border-white/5">
          <div class="text-slate-500 font-mono text-xs uppercase tracking-widest">Característica</div>
          <div class="text-center">
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-950 border border-emerald-500/30 rounded-lg">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <span class="text-emerald-400 font-bold text-sm uppercase tracking-wider">VetPragas</span>
            </div>
          </div>
          <div class="text-center text-slate-500 font-mono text-xs uppercase tracking-widest">Outros Serviços</div>
        </div>

        <!-- Table Rows with Stagger Animation -->
        {vetPragasData.comparison.items.map((item, index) => (
          <div 
            class={`grid grid-cols-3 gap-4 p-6 border-b border-white/5 last:border-0 hover:bg-slate-800/30 transition-all duration-300 group ${item.highlight ? 'bg-emerald-950/10' : ''}`}
            style={`animation: slide-in-right 0.5s ease-out ${index * 0.1}s both`}
          >
            <!-- Feature Name -->
            <div class="flex items-center gap-3">
              {item.highlight && (
                <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
              )}
              <span class="text-white font-semibold uppercase tracking-wide text-sm">{item.feature}</span>
            </div>

            <!-- VetPragas -->
            <div class="flex items-center justify-center text-center">
              <div class="flex items-start gap-2 group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span class="text-emerald-400 text-sm font-medium">{item.vetpragas}</span>
              </div>
            </div>

            <!-- Others -->
            <div class="flex items-center justify-center text-center">
              <div class="flex items-start gap-2 opacity-60">
                <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                <span class="text-slate-500 text-sm">{item.others}</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Bottom CTA -->
      <div class="mt-12 text-center animate-fade-in-delay-2">
        <p class="text-slate-500 mb-6 font-mono text-sm uppercase tracking-widest">A diferença está nos detalhes</p>
        <a href="https://wa.me/554533265255" class="inline-flex items-center justify-center px-10 py-4 bg-emerald-600 text-slate-950 font-bold text-xs uppercase tracking-widest hover:bg-emerald-500 transition-all shadow-[0_0_20px_rgba(16,185,129,0.2)] hover:shadow-[0_0_30px_rgba(16,185,129,0.4)] hover:scale-105">
          Quero o Serviço Profissional
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes grid-flow {
    0% { transform: translateY(0); }
    100% { transform: translateY(50px); }
  }

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes fade-in-delay {
    0%, 20% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes fade-in-delay-2 {
    0%, 40% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes slide-in-right {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-slide-up {
    animation: slide-up 0.6s ease-out;
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out;
  }

  .animate-fade-in-delay {
    animation: fade-in-delay 1.2s ease-out;
  }

  .animate-fade-in-delay-2 {
    animation: fade-in-delay-2 1.6s ease-out;
  }
</style>
