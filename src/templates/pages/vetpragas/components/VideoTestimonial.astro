---
import { vetPragasData } from "./content";
---

<section class="py-24 bg-black relative overflow-hidden">
    <!-- Cinematic Background -->
    <div class="absolute inset-0">
        <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(16,185,129,0.1),transparent_70%)]"
        >
        </div>
        <div
            class="absolute top-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-emerald-500/50 to-transparent"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-emerald-500/50 to-transparent"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <!-- Header -->
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span
                class="text-emerald-500 font-mono text-[10px] uppercase tracking-[0.3em] animate-fade-in"
                >{vetPragasData.videoTestimonial.subtitle}</span
            >
            <h2
                class="text-4xl lg:text-5xl font-black text-white mt-4 mb-6 uppercase tracking-tight animate-slide-up"
            >
                {vetPragasData.videoTestimonial.title}
            </h2>
            <p class="text-lg text-slate-400 animate-fade-in-delay">
                {vetPragasData.videoTestimonial.description}
            </p>
        </div>

        <div class="grid lg:grid-cols-5 gap-12 max-w-7xl mx-auto items-center">
            <!-- Video Player -->
            <div class="lg:col-span-3">
                <div class="relative group">
                    <!-- Video Container with Cinematic Frame -->
                    <div
                        class="relative aspect-video bg-slate-950 rounded-2xl overflow-hidden border-2 border-emerald-500/30 shadow-[0_0_50px_rgba(16,185,129,0.3)] group-hover:shadow-[0_0_80px_rgba(16,185,129,0.5)] transition-all duration-500"
                    >
                        {
                            /* Placeholder - Substituir pelo iframe do YouTube real */
                        }
                        <div
                            class="absolute inset-0 flex items-center justify-center bg-slate-900"
                        >
                            <div class="text-center">
                                <div
                                    class="w-20 h-20 mx-auto mb-6 bg-emerald-600 rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(16,185,129,0.4)] hover:scale-110 transition-transform cursor-pointer group/play"
                                >
                                    <svg
                                        class="w-10 h-10 text-slate-950 ml-1"
                                        fill="currentColor"
                                        viewBox="0 0 24 24"
                                        ><path d="M8 5v14l11-7z"></path></svg
                                    >
                                </div>
                                <p
                                    class="text-slate-400 text-sm font-mono uppercase tracking-wider"
                                >
                                    Clique para assistir
                                </p>
                            </div>
                        </div>

                        {/* Quando tiver o vídeo real, usar: */}
                        {
                            /* <iframe 
              src={vetPragasData.videoTestimonial.video.url}
              class="absolute inset-0 w-full h-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe> */
                        }

                        <!-- Corner Accents -->
                        <div
                            class="absolute top-0 left-0 w-16 h-16 border-t-2 border-l-2 border-emerald-500/50"
                        >
                        </div>
                        <div
                            class="absolute top-0 right-0 w-16 h-16 border-t-2 border-r-2 border-emerald-500/50"
                        >
                        </div>
                        <div
                            class="absolute bottom-0 left-0 w-16 h-16 border-b-2 border-l-2 border-emerald-500/50"
                        >
                        </div>
                        <div
                            class="absolute bottom-0 right-0 w-16 h-16 border-b-2 border-r-2 border-emerald-500/50"
                        >
                        </div>
                    </div>

                    <!-- Film Strip Effect -->
                    <div
                        class="absolute -left-4 top-1/2 -translate-y-1/2 w-3 h-32 bg-slate-800 border border-slate-700 rounded-sm opacity-50"
                    >
                    </div>
                    <div
                        class="absolute -right-4 top-1/2 -translate-y-1/2 w-3 h-32 bg-slate-800 border border-slate-700 rounded-sm opacity-50"
                    >
                    </div>
                </div>
            </div>

            <!-- Client Info & Stats -->
            <div class="lg:col-span-2 space-y-8">
                <!-- Quote -->
                <div class="relative">
                    <svg
                        class="absolute -top-4 -left-4 w-12 h-12 text-emerald-500/20"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        ><path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"
                        ></path></svg
                    >
                    <blockquote
                        class="relative z-10 text-xl text-slate-300 italic leading-relaxed pl-8"
                    >
                        "{vetPragasData.videoTestimonial.video.quote}"
                    </blockquote>
                </div>

                <!-- Client Details -->
                <div
                    class="flex items-center gap-4 p-6 bg-slate-950/50 border border-white/5 rounded-xl"
                >
                    <div
                        class="w-16 h-16 bg-emerald-950 border-2 border-emerald-500/30 rounded-full flex items-center justify-center text-emerald-500 font-black text-2xl"
                    >
                        {vetPragasData.videoTestimonial.video.client.charAt(0)}
                    </div>
                    <div>
                        <div class="text-white font-bold text-lg">
                            {vetPragasData.videoTestimonial.video.client}
                        </div>
                        <div class="text-slate-400 text-sm">
                            {vetPragasData.videoTestimonial.video.role}
                        </div>
                        <div
                            class="text-emerald-500 text-xs font-mono uppercase tracking-wider"
                        >
                            {vetPragasData.videoTestimonial.video.location}
                        </div>
                    </div>
                </div>

                <!-- Stats -->
                <div class="grid grid-cols-3 gap-4">
                    {
                        vetPragasData.videoTestimonial.stats.map(
                            (stat, index) => (
                                <div
                                    class="text-center p-4 bg-slate-950/50 border border-white/5 rounded-xl hover:border-emerald-500/30 transition-all hover:scale-110 group"
                                    style={`animation: pop-in 0.5s ease-out ${0.6 + index * 0.1}s both`}
                                >
                                    <div class="text-2xl font-black text-emerald-500 mb-1 group-hover:scale-125 transition-transform">
                                        {stat.value}
                                    </div>
                                    <div class="text-slate-400 text-[10px] uppercase tracking-widest font-mono">
                                        {stat.label}
                                    </div>
                                </div>
                            ),
                        )
                    }
                </div>

                <!-- CTA -->
                <a
                    href="https://wa.me/554533265255"
                    class="block text-center px-8 py-4 bg-emerald-600 text-slate-950 font-bold text-xs uppercase tracking-widest hover:bg-emerald-500 transition-all rounded-lg shadow-[0_0_20px_rgba(16,185,129,0.2)] hover:shadow-[0_0_30px_rgba(16,185,129,0.4)] hover:scale-105"
                >
                    Quero Resultados Assim
                </a>
            </div>
        </div>

        <!-- Trust Bar -->
        <div
            class="mt-16 flex flex-wrap justify-center gap-8 pt-12 border-t border-white/5"
        >
            <div class="flex items-center gap-3">
                <svg
                    class="w-6 h-6 text-emerald-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                    ></path></svg
                >
                <span class="text-slate-400 text-sm font-medium"
                    >Depoimento 100% Real</span
                >
            </div>
            <div class="flex items-center gap-3">
                <svg
                    class="w-6 h-6 text-emerald-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    ></path></svg
                >
                <span class="text-slate-400 text-sm font-medium"
                    >Cliente Verificado</span
                >
            </div>
            <div class="flex items-center gap-3">
                <svg
                    class="w-6 h-6 text-emerald-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
                    ></path></svg
                >
                <span class="text-slate-400 text-sm font-medium"
                    >Avaliação 5 Estrelas</span
                >
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes fade-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fade-in-delay {
        0%,
        20% {
            opacity: 0;
        }
        100% {
            opacity: 1;
        }
    }

    @keyframes pop-in {
        0% {
            opacity: 0;
            transform: scale(0.5);
        }
        50% {
            transform: scale(1.1);
        }
        100% {
            opacity: 1;
            transform: scale(1);
        }
    }

    .animate-fade-in {
        animation: fade-in 0.8s ease-out;
    }

    .animate-slide-up {
        animation: slide-up 0.6s ease-out;
    }

    .animate-fade-in-delay {
        animation: fade-in-delay 1.2s ease-out;
    }
</style>
