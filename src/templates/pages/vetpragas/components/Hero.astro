---
import { Image } from "astro:assets";
import heroImagev1 from "@assets/images/templates/vetpragas/hero-v1.jpg";
import { vetPragasData } from "./content";
---

<section
    class="relative min-h-[90vh] flex items-center justify-center pt-20 overflow-hidden bg-slate-950"
>
    <!-- GRID BACKGROUND -->
    <div class="absolute inset-0 pointer-events-none opacity-20">
        <div
            class="absolute inset-0 bg-[linear-gradient(to_right,#10b98110_1px,transparent_1px),linear-gradient(to_bottom,#10b98110_1px,transparent_1px)] bg-size-[40px_40px] mask-gradient"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <!-- Text Content -->
            <div class="max-w-2xl">
                <div
                    class="inline-flex items-center gap-3 px-4 py-2 bg-emerald-950/30 border border-emerald-500/30 text-emerald-400 text-[10px] font-bold uppercase tracking-[0.2em] mb-8 backdrop-blur-sm"
                >
                    <svg
                        class="w-3 h-3 text-emerald-500"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        ><path
                            d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                        ></path></svg
                    >
                    {vetPragasData.hero.status}
                </div>

                <h1
                    class="text-5xl lg:text-7xl font-black text-slate-100 leading-[0.9] mb-8 tracking-tighter uppercase font-mono"
                    set:html={vetPragasData.hero.title}
                />

                <p
                    class="text-lg text-slate-400 mb-10 leading-relaxed max-w-lg border-l-2 border-emerald-500/50 pl-6"
                >
                    {vetPragasData.hero.subtitle}
                </p>

                <div class="flex flex-col sm:flex-row gap-6">
                    <a href="https://wa.me/554533265255" class="relative group">
                        <div
                            class="absolute -inset-1 bg-linear-to-r from-emerald-600 to-teal-600 rounded blur opacity-25 group-hover:opacity-75 transition duration-1000 group-hover:duration-200"
                        >
                        </div>
                        <button
                            class="relative px-8 py-4 bg-slate-900 ring-1 ring-emerald-500/50 text-emerald-400 font-bold text-xs uppercase tracking-[0.15em] hover:bg-emerald-950/50 transition-all flex items-center justify-center gap-3 w-full sm:w-auto"
                        >
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                            {vetPragasData.hero.cta}
                        </button>
                    </a>

                    <button
                        class="px-8 py-4 bg-transparent border border-slate-700 text-slate-400 font-bold text-xs uppercase tracking-[0.15em] hover:border-slate-500 hover:text-slate-200 transition-all w-full sm:w-auto"
                    >
                        {vetPragasData.hero.secondaryCta}
                    </button>
                </div>

                <!-- STATS BAR -->
                <div
                    class="mt-16 pt-8 border-t border-slate-800 grid grid-cols-2 md:grid-cols-3 gap-8"
                >
                    {
                        vetPragasData.stats.map((stat) => (
                            <div>
                                <h3 class="text-2xl font-mono font-bold text-white mb-1">
                                    {stat.number}
                                </h3>
                                <p class="text-[10px] text-emerald-500/70 uppercase tracking-widest mb-1">
                                    {stat.label}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Hero Visual - Radar/Scanner -->
            <div
                class="relative lg:h-[600px] flex items-center justify-center p-4"
            >
                <div
                    class="relative w-full h-[500px] rounded-2xl overflow-hidden border border-emerald-500/30 group shadow-[0_0_50px_rgba(16,185,129,0.1)]"
                >
                    <!-- Generated Image -->
                    <div
                        class="absolute inset-0 bg-emerald-900/20 mix-blend-overlay z-10 pointer-events-none"
                    >
                    </div>
                    <div
                        class="absolute inset-0 bg-linear-to-t from-slate-950 via-transparent to-transparent z-10 pointer-events-none"
                    >
                    </div>

                    <Image
                        src={heroImagev1}
                        alt="Especialista VetPragas em ação"
                        class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-all duration-700 scale-105 group-hover:scale-100 filter saturate-0 group-hover:saturate-100"
                        fetchpriority="high"
                        loading="eager"
                    />

                    <!-- HUD Elements -->
                    <div class="absolute top-6 left-6 z-20">
                        <div
                            class="flex items-center gap-2 px-3 py-1 bg-black/60 backdrop-blur border border-emerald-500/30 rounded text-[10px] text-emerald-400 font-mono uppercase tracking-widest"
                        >
                            <span
                                class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"
                            ></span>
                            Bio-Scan: Active
                        </div>
                    </div>

                    <div class="absolute bottom-6 right-6 z-20 text-right">
                        <p
                            class="text-[10px] text-emerald-500 font-mono uppercase tracking-widest mb-1"
                        >
                            Target
                        </p>
                        <p class="text-xl text-white font-bold tracking-tight">
                            Zero Pragas
                        </p>
                    </div>

                    <!-- Scanning Line -->
                    <div
                        class="absolute inset-0 bg-linear-to-b from-emerald-500/0 via-emerald-500/10 to-emerald-500/0 h-[20%] w-full animate-[scan_4s_linear_infinite] pointer-events-none z-10"
                    >
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .mask-gradient {
        mask-image: radial-gradient(
            circle at center,
            black 40%,
            transparent 100%
        );
    }
</style>
