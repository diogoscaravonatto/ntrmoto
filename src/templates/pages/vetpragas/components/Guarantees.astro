---
import { vetPragasData } from './content';

const iconMap = {
  'badge': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg>',
  'check-circle': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>',
  'document': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>',
  'shield-check': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>'
};
---

<section class="py-24 bg-slate-900 border-y border-white/5">
  <div class="container mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl lg:text-4xl font-black text-white mb-4 uppercase tracking-tighter">{vetPragasData.guarantees.title}</h2>
      <p class="text-slate-500 font-mono text-xs uppercase tracking-widest">O que nos torna únicos na região</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {vetPragasData.guarantees.items.map((item) => (
        <div class="group relative bg-slate-950/50 border border-white/5 p-8 rounded-2xl hover:border-emerald-500/30 transition-all duration-300">
          <!-- Glow Effect -->
          <div class="absolute inset-0 bg-emerald-500/0 group-hover:bg-emerald-500/5 rounded-2xl transition-colors"></div>
          
          <div class="relative z-10">
            <!-- Icon -->
            <div class="w-12 h-12 bg-emerald-950 border border-emerald-500/30 rounded-lg flex items-center justify-center mb-6 text-emerald-500 group-hover:scale-110 transition-transform" set:html={iconMap[item.icon as keyof typeof iconMap]}></div>

            <!-- Content -->
            <h3 class="text-xl font-bold text-white mb-3 uppercase tracking-wide group-hover:text-emerald-400 transition-colors">{item.title}</h3>
            <p class="text-sm text-slate-400 leading-relaxed">{item.description}</p>
          </div>

          <!-- Corner Accent -->
          <div class="absolute top-0 right-0 w-20 h-20 border-t-2 border-r-2 border-emerald-500/0 group-hover:border-emerald-500/30 rounded-tr-2xl transition-colors"></div>
        </div>
      ))}
    </div>
  </div>
</section>
