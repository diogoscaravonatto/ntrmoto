---
const comparison = {
    title: ["Por que trocar", "agora?"],
    columns: [
        {
            name: "Energia da Rede",
            features: [
                { label: "Aumentos anuais", value: "8 a 15%", bad: true },
                {
                    label: "Bandeiras tarifárias",
                    value: "Sim (Incerteza)",
                    bad: true,
                },
                { label: "Investimento", value: "A fundo perdido", bad: true },
                { label: "Patrimônio", value: "Zero valorização", bad: true },
            ],
        },
        {
            name: "Sistema Solar Aura",
            highlight: true,
            features: [
                { label: "Preço do kWh", value: "Congelado (Sol)", good: true },
                { label: "Bandeiras tarifárias", value: "Isento", good: true },
                {
                    label: "Investimento",
                    value: "Payback em 4 anos",
                    good: true,
                },
                { label: "Patrimônio", value: "+15% no imóvel", good: true },
            ],
        },
    ],
};
---

<section class="py-32 bg-slate-50 italic">
    <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-20 text-slate-900">
            <h2
                class="text-4xl md:text-6xl font-black uppercase tracking-tighter"
            >
                {comparison.title[0]}
                <span class="text-emerald-600">{comparison.title[1]}</span>
            </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
            {
                comparison.columns.map((col) => (
                    <div
                        class={`p-10 rounded-[2.5rem] border ${col.highlight ? "bg-emerald-600 text-white border-emerald-500 shadow-2xl scale-105" : "bg-white text-slate-900 border-slate-100 opacity-80"}`}
                    >
                        <h3 class="text-2xl font-black mb-10 uppercase tracking-tight">
                            {col.name}
                        </h3>
                        <div class="space-y-6">
                            {col.features.map((f) => (
                                <div
                                    class={`flex justify-between items-center py-4 border-b ${col.highlight ? "border-emerald-500/50" : "border-slate-50"}`}
                                >
                                    <span class="text-[11px] font-bold uppercase tracking-widest leading-none">
                                        {f.label}
                                    </span>
                                    <span
                                        class={`text-[11px] font-black uppercase leading-none ${f.bad ? "text-red-500" : f.good ? "text-emerald-200" : ""}`}
                                    >
                                        {f.value}
                                    </span>
                                </div>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
