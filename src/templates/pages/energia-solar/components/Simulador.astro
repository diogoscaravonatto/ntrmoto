---
const simulator = {
    title: ["Simule sua", "economia imediata."],
    description:
        "Arraste o botão abaixo para selecionar sua conta de luz atual e veja quanto você deixaria de pagar em 25 anos.",
};
---

<section class="py-32 bg-slate-50 italic overflow-hidden">
    <div class="max-w-4xl mx-auto px-6">
        <div
            class="bg-white p-12 md:p-20 rounded-[3.5rem] shadow-2xl border border-slate-100 relative overflow-hidden"
        >
            <!-- Decorative Glow -->
            <div
                class="absolute -top-20 -right-20 size-64 bg-emerald-500/10 rounded-full blur-[100px]"
            >
            </div>

            <div class="text-center mb-16 relative z-10">
                <h2
                    class="text-4xl md:text-6xl font-black text-slate-900 leading-tight tracking-tighter uppercase mb-6 italic"
                >
                    {simulator.title[0]}
                    <br /><span
                        class="text-emerald-600 underline decoration-slate-100 decoration-8 underline-offset-10"
                        >{simulator.title[1]}</span
                    >
                </h2>
                <p
                    class="text-sm font-bold text-slate-400 max-w-md mx-auto leading-relaxed lowercase"
                >
                    {simulator.description}
                </p>
            </div>

            <div class="space-y-12 relative z-10">
                <div class="space-y-6">
                    <div class="flex justify-between items-end">
                        <span
                            class="text-[10px] font-black uppercase tracking-widest text-slate-600 italic"
                            >Gasto Mensal Atual</span
                        >
                        <span class="text-3xl font-black text-slate-900 italic"
                            >R$ <span id="val-conta">500</span></span
                        >
                    </div>
                    <input
                        type="range"
                        min="150"
                        max="5000"
                        value="500"
                        step="50"
                        class="w-full h-2 bg-slate-100 rounded-lg appearance-none cursor-pointer accent-emerald-600"
                        id="slider-conta"
                    />
                </div>

                <div
                    class="grid md:grid-cols-2 gap-8 pt-10 border-t border-slate-50"
                >
                    <div
                        class="p-8 bg-emerald-50 rounded-3xl border border-emerald-100"
                    >
                        <p
                            class="text-[9px] font-black uppercase tracking-widest text-emerald-600 mb-2 italic"
                        >
                            Economia em 25 anos
                        </p>
                        <h3
                            class="text-4xl font-black text-emerald-700 italic tracking-tighter"
                        >
                            R$ <span id="val-economia">174.500</span>
                        </h3>
                    </div>
                    <div class="p-8 bg-slate-900 rounded-3xl text-white">
                        <p
                            class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-2 italic"
                        >
                            Nova Conta Estimada
                        </p>
                        <h3
                            class="text-4xl font-black text-white italic tracking-tighter"
                        >
                            R$ <span id="val-nova">35</span>
                        </h3>
                    </div>
                </div>

                <div class="text-center pt-8">
                    <button
                        class="px-12 py-6 bg-emerald-600 text-white rounded-2xl font-black text-lg uppercase tracking-widest shadow-xl hover:bg-emerald-700 hover:scale-105 transition-all w-full md:w-auto cursor-pointer"
                        aria-label="Garantir desconto em energia solar"
                    >
                        Garantir esse Desconto
                    </button>
                    <p
                        class="mt-4 text-[9px] font-bold text-slate-500 uppercase italic"
                    >
                        Cálculo baseado em tarifas vigentes e inflação
                        energética de 8% a.a.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    const slider = document.getElementById("slider-conta");
    const displayConta = document.getElementById("val-conta");
    const displayEco = document.getElementById("val-economia");
    const displayNova = document.getElementById("val-nova");

    slider?.addEventListener("input", (e) => {
        const val = parseInt(e.target.value);
        displayConta.innerText = val.toLocaleString("pt-BR");

        // Cálculo simplificado: (Economia mensal * 12 * 25) + Inflação projetada
        // Simulando economia de 95%
        const economiaMensal = val * 0.95;
        const total = economiaMensal * 12 * 25 * 1.5; // Fator de inflação aproximado
        displayEco.innerText = total.toLocaleString("pt-BR", {
            maximumFractionDigits: 0,
        });

        displayNova.innerText = (val * 0.05).toLocaleString("pt-BR", {
            maximumFractionDigits: 0,
        });
    });
</script>
