---
const process = {
    eyebrow: "A Jornada",
    title: ["Simples,", "Rápido e", "Definitivo."],
    steps: [
        {
            title: "Diagnóstico Digital",
            desc: "Análise via satélite em < 24h.",
            badge: "01",
        },
        {
            title: "Engenharia",
            desc: "Burocracia zero com a rede.",
            badge: "02",
        },
        {
            title: "Instalação Master",
            desc: "Time de elite em campo.",
            badge: "03",
        },
    ],
};
---

<section id="processo" class="py-32 bg-white italic">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div class="space-y-12">
                <div>
                    <span
                        class="text-[10px] font-black uppercase tracking-[0.4em] text-emerald-600 mb-4 block"
                        >{process.eyebrow}</span
                    >
                    <h2
                        class="text-5xl md:text-7xl font-black text-slate-900 leading-tight tracking-tighter uppercase italic"
                    >
                        {process.title[0]}
                        <br />{process.title[1]}
                        <br /><span class="text-emerald-600"
                            >{process.title[2]}</span
                        >
                    </h2>
                </div>
                <div class="space-y-4">
                    {
                        process.steps.map((s) => (
                            <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 flex gap-6 items-center hover:shadow-xl transition-all">
                                <span class="text-3xl font-black text-emerald-600/30 italic">
                                    {s.badge}
                                </span>
                                <div>
                                    <h3 class="text-lg font-black text-slate-900 uppercase italic leading-none mb-1">
                                        {s.title}
                                    </h3>
                                    <p class="text-[11px] font-bold text-slate-500 lowercase italic leading-none">
                                        {s.desc}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
            <div class="relative">
                <div
                    class="aspect-square bg-slate-100 rounded-[2rem] overflow-hidden flex items-center justify-center border-4 border-slate-50"
                >
                    <span
                        class="text-slate-300 font-black text-2xl uppercase italic text-center p-10"
                        >Execução de Excelência</span
                    >
                </div>
                <div
                    class="absolute -bottom-6 -right-6 p-6 bg-emerald-600 text-white rounded-2xl shadow-xl hidden md:block rotate-3"
                >
                    <p class="text-[10px] font-black uppercase mb-1 opacity-80">
                        Garantia
                    </p>
                    <p class="text-xl font-black italic uppercase leading-none">
                        25 Anos
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
