---
const cta = {
    title: ["Comece a", "economizar", "agora."],
    description:
        "Centenas de famílias já garantiram sua autonomia energética este ano. O sol é gratuito, mas o preço da rede elétrica não para de subir.",
    button: "Simular Meu Sistema Agora",
    social: "WhatsApp Consultoria: (11) 99876-5432",
};
---

<section
    class="py-40 px-6 bg-slate-950 text-white relative overflow-hidden italic"
>
    <div class="max-w-6xl mx-auto text-center space-y-12 relative z-10">
        <h2
            class="text-6xl md:text-8xl lg:text-[10rem] font-black uppercase tracking-tighter leading-[0.85] italic"
        >
            {cta.title[0]}
            <br />
            <span class="text-emerald-500">{cta.title[1]}</span>
            <br />
            {cta.title[2]}
        </h2>

        <div class="space-y-12">
            <p
                class="text-lg md:text-xl font-bold italic max-w-2xl mx-auto leading-relaxed lowercase opacity-70"
            >
                {cta.description}
            </p>

            <div class="flex flex-col items-center gap-8">
                <button
                    class="w-full sm:w-auto px-16 py-8 bg-emerald-600 text-white rounded-3xl font-black text-2xl uppercase tracking-widest shadow-2xl hover:bg-emerald-700 hover:scale-105 transition-all outline-hidden cursor-pointer italic"
                    aria-label="Simular sistema de energia solar agora"
                >
                    {cta.button}
                </button>

                <div class="flex flex-col items-center gap-2">
                    <span
                        class="text-[10px] font-black uppercase tracking-widest text-emerald-500 italic leading-none"
                        >{cta.social}</span
                    >
                    <span
                        class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-500 italic leading-none"
                        >Vagas de instalação limitadas para sua região</span
                    >
                </div>
            </div>
        </div>
    </div>
</section>
