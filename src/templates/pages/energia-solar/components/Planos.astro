---
const plans = {
    title: ["Soluções para", "cada necessidade."],
    items: [
        {
            name: "Residencial",
            desc: "Ideal para casas e apartamentos. FOco em conforto térmico e redução de até 95%.",
            features: [
                "Até 10kWp",
                "Monitoramento App",
                "Instalação em 2 dias",
            ],
            icon: "🏠",
        },
        {
            name: "Comercial",
            desc: "Redução de custos operacionais fixos. Aumente o lucro líquido do seu negócio.",
            features: [
                "Sistema On-Grid",
                "Seguro de 2 anos",
                "Consultoria Tributária",
            ],
            icon: "🏢",
            highlight: true,
        },
        {
            name: "Rural/Industrial",
            desc: "Autonomia para grandes áreas e maquinários pesados. Resistência e alta escala.",
            features: [
                "Painéis Bifaciais",
                "Suporte 24/7",
                "Homologação Especializado",
            ],
            icon: "🚜",
        },
    ],
};
---

<section class="py-32 bg-slate-50 italic">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-20">
            <h2
                class="text-5xl md:text-7xl font-black text-slate-900 tracking-tighter uppercase italic leading-none"
            >
                {plans.title[0]}
                <br /><span class="text-emerald-600">{plans.title[1]}</span>
            </h2>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
            {
                plans.items.map((p) => (
                    <div
                        class={`p-10 rounded-[3rem] border transition-all duration-500 flex flex-col ${p.highlight ? "bg-emerald-600 text-white border-emerald-500 shadow-2xl scale-105 z-10" : "bg-white text-slate-900 border-slate-100 hover:shadow-xl"}`}
                    >
                        <div class="text-5xl mb-8">{p.icon}</div>
                        <h3 class="text-3xl font-black mb-4 uppercase tracking-tighter">
                            {p.name}
                        </h3>
                        <p
                            class={`text-sm font-bold leading-relaxed mb-8 lowercase opacity-80 ${p.highlight ? "text-emerald-100" : "text-slate-500"}`}
                        >
                            {p.desc}
                        </p>
                        <ul class="space-y-4 mb-12 flex-grow">
                            {p.features.map((f) => (
                                <li class="flex items-center gap-3 text-[11px] font-black uppercase tracking-widest italic">
                                    <span
                                        class={`size-1.5 rounded-full ${p.highlight ? "bg-emerald-200" : "bg-emerald-500"}`}
                                    />
                                    {f}
                                </li>
                            ))}
                        </ul>
                        <button
                            class={`w-full py-5 rounded-2xl font-black text-xs uppercase tracking-widest transition-all cursor-pointer ${p.highlight ? "bg-white text-emerald-700 hover:bg-slate-50" : "bg-slate-900 text-white hover:bg-emerald-600"}`}
                            aria-label={`Simular orçamento para ${p.name}`}
                        >
                            Simular Orçamento
                        </button>
                    </div>
                ))
            }
        </div>
    </div>
</section>
