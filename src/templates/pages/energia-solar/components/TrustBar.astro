---
const partners = [
    { name: "Canadian Solar", logo: "CN" },
    { name: "Jinko Solar", logo: "JK" },
    { name: "Fronius", logo: "FR" },
    { name: "WEG", logo: "WG" },
    { name: "Solis", logo: "SL" },
];
---

<div class="py-12 bg-white border-y border-slate-50 italic">
    <div class="max-w-7xl mx-auto px-6">
        <p
            class="text-[9px] font-black uppercase tracking-[0.4em] text-slate-500 text-center mb-8 italic"
        >
            Tecnologia Certificada pelos Maiores Fabricantes do Mundo
        </p>
        <div
            class="flex flex-wrap justify-center items-center gap-12 md:gap-24 opacity-50 grayscale hover:grayscale-0 transition-all"
        >
            {
                partners.map((p) => (
                    <div class="text-2xl font-black text-slate-400 tracking-tighter flex items-center gap-2">
                        <span class="size-8 bg-slate-100 rounded flex items-center justify-center text-[10px]">
                            {p.logo}
                        </span>
                        {p.name}
                    </div>
                ))
            }
        </div>
    </div>
</div>
