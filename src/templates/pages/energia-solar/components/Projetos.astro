---
const projects = {
    title: ["Nossos Projetos", "pelo Brasil."],
    items: [
        { city: "Alphaville, SP", panels: "24 Painéis", savings: "R$ 1.200/mês", type: "Residencial Premium" },
        { city: "Curitiba, PR", panels: "68 Painéis", savings: "R$ 4.500/mês", type: "Indústria Têxtil" },
        { city: "Goiânia, GO", panels: "156 Painéis", savings: "R$ 12.000/mês", type: "Condomínio Solar" },
        { city: "Florianópolis, SC", panels: "12 Painéis", savings: "R$ 650/mês", type: "Frente Mar" }
    ]
};
---
<section class="py-32 bg-white italic overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-20 items-end mb-20">
            <h2 class="text-5xl md:text-7xl font-black text-slate-900 tracking-tighter uppercase italic leading-none">
                {projects.title[0]} <br /><span class="text-emerald-600">{projects.title[1]}</span>
            </h2>
            <p class="text-lg text-slate-500 font-bold max-w-sm lowercase opacity-80">Resultados auditados e sistemas operando em performance máxima 24/7.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            {projects.items.map(p => (
                <div class="group relative aspect-4/5 rounded-[2.5rem] overflow-hidden bg-slate-100 flex items-end p-8 border border-slate-200">
                    <!-- Placeholder Visual -->
                    <div class="absolute inset-0 bg-linear-to-t from-slate-950 via-transparent to-transparent z-10"></div>
                    <div class="absolute inset-0 bg-emerald-600/20 opacity-0 group-hover:opacity-100 transition-opacity z-0"></div>
                    
                    <div class="relative z-20 text-white">
                        <p class="text-[9px] font-black uppercase tracking-[0.4em] text-emerald-400 mb-2 italic">{p.type}</p>
                        <h3 class="text-2xl font-black mb-4 tracking-tight uppercase italic leading-none">{p.city}</h3>
                        <div class="space-y-1 border-t border-white/10 pt-4 opacity-0 group-hover:opacity-100 translate-y-4 group-hover:translate-y-0 transition-all duration-500">
                            <p class="text-[10px] font-bold uppercase italic"><span class="text-emerald-400">Geração:</span> {p.panels}</p>
                            <p class="text-[10px] font-bold uppercase italic"><span class="text-emerald-400">Economia:</span> {p.savings}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
