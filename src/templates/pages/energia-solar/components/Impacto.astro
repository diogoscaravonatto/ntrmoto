---
const impact = {
    title: ["Seu bolso agradece,", "o planeta também."],
    items: [
        { label: "CO2 Evitado", value: "12 tons", unit: "por ano" },
        { label: "Árvores", value: "450", unit: "equivalentes" },
        { label: "Entrada", value: "R$ 0", unit: "custo zero" },
    ],
};
---

<section
    class="py-32 bg-emerald-700 text-white overflow-hidden relative italic"
>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="flex flex-col lg:flex-row gap-16 items-center">
            <h2
                class="text-5xl md:text-7xl font-black leading-tight tracking-tighter uppercase italic lg:w-1/2"
            >
                {impact.title[0]}
                <br /><span class="text-emerald-200">{impact.title[1]}</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 lg:w-1/2">
                {
                    impact.items.map((item) => (
                        <div class="text-center md:text-left bg-emerald-800/30 p-6 rounded-2xl border border-emerald-400/20">
                            <p class="text-[9px] font-black uppercase tracking-widest text-emerald-100 mb-4 opacity-70 leading-none">
                                {item.label}
                            </p>
                            <h3 class="text-4xl font-black mb-1 tabular-nums italic leading-none">
                                {item.value}
                            </h3>
                            <p class="text-[9px] font-black uppercase tracking-widest text-emerald-200 italic leading-none">
                                {item.unit}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
