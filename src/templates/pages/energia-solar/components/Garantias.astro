---
const guarantees = {
    title: ["Risco Zero.", "Garantia Total."],
    items: [
        {
            title: "25 Anos",
            label: "Desempenho",
            desc: "Painéis certificados com retenção mínima de 85% de geração em 2.5 decadas.",
            icon: "🛡️",
        },
        {
            title: "12 Anos",
            label: "Inversores",
            desc: "Garantia total contra defeitos de fabricação e suporte técnico prioritário.",
            icon: "⚡",
        },
        {
            title: "7 Anos",
            label: "Instalação",
            desc: "Cobertura total sobre a montagem e estrutura, garantindo vedação e segurança.",
            icon: "🏗️",
        },
        {
            title: "Full Safe",
            label: "Seguro",
            desc: "Seu sistema protegido contra danos externos, ventos e intempéries.",
            icon: "💎",
        },
    ],
};
---

<section class="py-32 bg-slate-950 text-white italic overflow-hidden relative">
    <!-- Energy Glow -->
    <div class="absolute top-0 right-0 size-96 bg-emerald-600/10 blur-[150px]">
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="text-center mb-24">
            <h2
                class="text-5xl md:text-[7rem] font-black tracking-tighter uppercase italic leading-none mb-6"
            >
                {guarantees.title[0]}
                <br /><span class="text-emerald-500">{guarantees.title[1]}</span
                >
            </h2>
            <p
                class="text-emerald-400 font-bold uppercase tracking-[0.5em] text-[10px] italic"
            >
                Sua tranquilidade é nossa maior prioridade financeira
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
            {
                guarantees.items.map((g) => (
                    <div class="p-10 border border-white/5 bg-white/5 rounded-[3rem] hover:border-emerald-500/30 transition-all group">
                        <div class="text-4xl mb-8 group-hover:scale-110 group-hover:rotate-12 transition-transform h-fit w-fit">
                            {g.icon}
                        </div>
                        <h3 class="text-4xl font-black mb-1 italic tracking-tighter">
                            {g.title}
                        </h3>
                        <p class="text-[9px] font-black text-emerald-500 uppercase tracking-widest mb-6 italic">
                            {g.label}
                        </p>
                        <p class="text-[11px] font-bold text-slate-400 leading-relaxed italic lowercase opacity-80 group-hover:opacity-100 transition-opacity">
                            {g.desc}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
