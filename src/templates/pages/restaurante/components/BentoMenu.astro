---

---

<section class="py-40 bg-zinc-950 px-6">
    <div class="max-w-7xl mx-auto">
        <div
            class="flex flex-col md:flex-row justify-between items-end mb-20 gap-10"
        >
            <h2
                class="text-6xl md:text-9xl font-black italic uppercase tracking-tighter leading-none text-white"
            >
                THE <span class="text-zinc-800">CRAFT.</span>
            </h2>
            <p
                class="text-xl text-zinc-500 font-medium italic max-w-md text-right"
            >
                Ingredientes sazonais, técnicas ancestrais e uma visão futurista
                da gastronomia brasileira.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 auto-rows-[350px]">
            <div
                class="md:col-span-2 md:row-span-2 relative rounded-[3rem] overflow-hidden group"
            >
                <img
                    src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80"
                    alt="Dish 1"
                    class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                />
                <div
                    class="absolute inset-0 bg-linear-to-t from-black to-transparent p-10 flex flex-col justify-end"
                >
                    <span
                        class="text-orange-600 font-black italic text-xs uppercase tracking-widest mb-2"
                        >SIGNATURE</span
                    >
                    <h3 class="text-4xl font-black italic text-white uppercase">
                        Wagyu A5
                    </h3>
                </div>
            </div>
            <div
                class="relative rounded-[3rem] overflow-hidden group bg-linear-to-br from-orange-600 to-orange-900 p-10 flex flex-col justify-between"
            >
                <div class="text-white text-5xl font-black italic">
                    WINE<br />LIST
                </div>
                <button
                    class="w-full py-4 bg-white text-black font-black italic uppercase text-xs rounded-full group-hover:translate-y-[-10px] transition-transform"
                    >EXPLORE</button
                >
            </div>
            <div class="relative rounded-[3rem] overflow-hidden group">
                <img
                    src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80"
                    alt="Dish 2"
                    class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                />
            </div>
            <div
                class="md:col-span-2 relative rounded-[3rem] overflow-hidden group"
            >
                <img
                    src="https://images.unsplash.com/photo-1551024506-0bccd828d307?auto=format&fit=crop&w=800&q=80"
                    alt="Dish 3"
                    class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                />
                <div
                    class="absolute inset-0 bg-black/40 p-10 flex items-center justify-center text-center"
                >
                    <h3
                        class="text-4xl font-black italic text-white uppercase underline decoration-orange-600 underline-offset-8"
                    >
                        SEASONAL DESSERTS
                    </h3>
                </div>
            </div>
        </div>
    </div>
</section>
