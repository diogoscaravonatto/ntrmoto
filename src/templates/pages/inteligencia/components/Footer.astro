---
import Icon from "@components/Icon.astro";
---

<footer
    class="bg-black border-t border-white/5 pt-32 pb-16 relative overflow-hidden"
>
    <!-- Background Text -->
    <div
        class="absolute bottom-10 left-1/2 -translate-x-1/2 w-full text-center pointer-events-none opacity-[0.02] select-none"
    >
        <span
            class="text-[250px] font-black uppercase tracking-tighter leading-none"
            >INTELIGENCE</span
        >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div
            class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-16 mb-32"
        >
            <div class="col-span-2 space-y-10">
                <div class="flex items-center space-x-3">
                    <Icon
                        name="lucide:network"
                        class="text-[#FF5500] size-10"
                    />
                    <span
                        class="font-black text-3xl tracking-tighter text-white"
                        >INTELIGENCE</span
                    >
                </div>
                <p
                    class="text-slate-500 text-lg max-w-sm font-light leading-relaxed"
                >
                    Engenharia de dados e sistemas de inteligência para empresas
                    que não aceitam decisões baseadas em palpites.
                </p>
                <div
                    class="flex items-center bg-zinc-950 border border-white/10 rounded-lg overflow-hidden max-w-xs focus-within:border-[#FF5500] transition-colors"
                >
                    <input
                        type="email"
                        class="bg-transparent border-none text-sm flex-1 p-4 focus:ring-0 text-white placeholder-zinc-700 outline-none font-mono"
                        placeholder="Sua_newsletter@IA"
                    />
                    <button
                        class="bg-[#FF5500] p-4 text-black hover:bg-orange-600 transition-colors"
                    >
                        <Icon name="lucide:send" class="size-5" />
                    </button>
                </div>
            </div>

            <div class="space-y-8">
                <h3
                    class="text-[10px] font-black uppercase tracking-[0.3em] opacity-30 text-white"
                >
                    Ecossistema
                </h3>
                <ul class="space-y-6 text-sm font-bold text-slate-400">
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#FF5500] transition-all hover:pl-2"
                            >Home</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#FF5500] transition-all hover:pl-2"
                            >Soluções</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#FF5500] transition-all hover:pl-2"
                            >Metodologia</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#FF5500] transition-all hover:pl-2"
                            >Consultoria</a
                        >
                    </li>
                </ul>
            </div>

            <div class="space-y-8">
                <h3
                    class="text-[10px] font-black uppercase tracking-[0.3em] opacity-30 text-white"
                >
                    Neural Net
                </h3>
                <ul class="space-y-6 text-sm font-bold text-slate-400">
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#FF5500] flex items-center gap-3 transition-all"
                            >LinkedIn</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#FF5500] flex items-center gap-3 transition-all"
                            >Instagram</a
                        >
                    </li>
                    <li>
                        <a
                            href="#"
                            class="hover:text-[#FF5500] flex items-center gap-3 transition-all"
                            >X (Twitter)</a
                        >
                    </li>
                </ul>
            </div>

            <div class="col-span-2 space-y-8">
                <h3
                    class="text-[10px] font-black uppercase tracking-[0.3em] opacity-30 text-white"
                >
                    Sede Tecnológica
                </h3>
                <p class="text-sm text-slate-500 leading-relaxed font-mono">
                    Lab 77 • Innovation Square<br />
                    Vale do Silício • Palo Alto, CA<br />
                    +1 (415) 555-0123
                </p>
                <div class="flex gap-4">
                    <div
                        class="size-8 bg-zinc-900 border border-white/5 rounded flex items-center justify-center text-zinc-600"
                    >
                        ES
                    </div>
                    <div
                        class="size-8 bg-zinc-900 border border-white/5 rounded flex items-center justify-center text-zinc-600"
                    >
                        EN
                    </div>
                    <div
                        class="size-8 bg-[#FF5500]/10 border border-[#FF5500]/30 rounded flex items-center justify-center text-[#FF5500]"
                    >
                        PT
                    </div>
                </div>
            </div>
        </div>

        <div
            class="pt-16 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-8 font-mono text-[10px] text-zinc-600 font-bold uppercase tracking-[0.2em]"
        >
            <p>© 2024 INTELIGENCE WORK. QUANTUM ENCRYPTED.</p>
            <div class="flex items-center gap-8">
                <a href="#" class="hover:text-white transition-colors"
                    >Privacy_Policy</a
                >
                <a href="#" class="hover:text-white transition-colors"
                    >Terms_of_Service</a
                >
                <span class="text-[#FF5500] animate-pulse"
                    >System_Status: Online</span
                >
            </div>
        </div>
    </div>
</footer>
