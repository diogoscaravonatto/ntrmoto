---
import Icon from "@components/Icon.astro";
---

<section id="sobre" class="py-32 bg-black relative overflow-hidden">
    <!-- Lateral Glow -->
    <div
        class="absolute right-0 top-1/2 -translate-y-1/2 w-[30rem] h-[30rem] bg-[#FF5500]/5 rounded-full blur-[120px] pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-20 items-center">
            <div class="space-y-12">
                <div>
                    <span
                        class="text-[#FF5500] font-black text-xs tracking-[0.3em] uppercase mb-6 block"
                        >// DIAGNÓSTICO</span
                    >
                    <h2
                        class="text-5xl md:text-7xl font-black mb-8 leading-none text-white tracking-tighter"
                    >
                        O Novo<br /><span class="text-[#FF5500]">Paradigma</span
                        >
                    </h2>
                </div>

                <div class="space-y-6">
                    <div
                        class="text-8xl md:text-9xl font-black text-white/5 relative"
                    >
                        90%
                        <span
                            class="absolute inset-0 flex items-center text-[#FF5500] text-7xl md:text-8xl"
                            >90%</span
                        >
                    </div>
                    <p class="text-slate-400 text-xl max-w-sm leading-relaxed">
                        das decisões falham por dependerem de <span
                            class="text-white font-bold italic underline decoration-[#FF5500]"
                            >intuição</span
                        > em vez de dados concretos e validados.
                    </p>
                </div>
            </div>

            <div class="relative">
                <!-- Decorative Border -->
                <div
                    class="absolute -inset-1 bg-gradient-to-br from-[#FF5500]/30 to-transparent rounded-3xl blur-sm opacity-50"
                >
                </div>

                <div
                    class="relative bg-zinc-950 p-10 md:p-14 rounded-3xl border border-white/5 backdrop-blur-3xl"
                >
                    <p
                        class="text-xl md:text-2xl mb-12 text-slate-300 italic font-light leading-relaxed"
                    >
                        "Depender de 'feeling' em um mundo orientado a dados é
                        um risco incalculável. A maior parte do budget é
                        desperdiçada em hipóteses não validadas."
                    </p>

                    <div class="space-y-10">
                        <div class="flex gap-6 group">
                            <div
                                class="size-14 bg-white/5 rounded-2xl flex items-center justify-center border border-white/10 group-hover:bg-[#FF5500]/10 group-hover:border-[#FF5500]/30 transition-all duration-500"
                            >
                                <Icon
                                    name="lucide:eye-off"
                                    class="size-7 text-[#FF5500]"
                                />
                            </div>
                            <div class="flex-1">
                                <h3
                                    class="font-black text-white text-lg mb-2 uppercase tracking-wide"
                                >
                                    Cegueira Analítica
                                </h3>
                                <p
                                    class="text-sm text-slate-500 leading-relaxed"
                                >
                                    Decisões sem datasets robustos levam a
                                    estagnação. Quem não mede a realidade, opera
                                    no escuro.
                                </p>
                            </div>
                        </div>

                        <div class="flex gap-6 group">
                            <div
                                class="size-14 bg-white/5 rounded-2xl flex items-center justify-center border border-white/10 group-hover:bg-[#FF5500]/10 group-hover:border-[#FF5500]/30 transition-all duration-500"
                            >
                                <Icon
                                    name="lucide:database-zap"
                                    class="size-7 text-[#FF5500]"
                                />
                            </div>
                            <div class="flex-1">
                                <h3
                                    class="font-black text-white text-lg mb-2 uppercase tracking-wide"
                                >
                                    Silos de Informação
                                </h3>
                                <p
                                    class="text-sm text-slate-500 leading-relaxed"
                                >
                                    Dados desconectados criam visões
                                    distorcidas. Sem um data lake unificado, a
                                    verdade está fragmentada.
                                </p>
                            </div>
                        </div>

                        <div class="flex gap-6 group">
                            <div
                                class="size-14 bg-white/5 rounded-2xl flex items-center justify-center border border-white/10 group-hover:bg-[#FF5500]/10 group-hover:border-[#FF5500]/30 transition-all duration-500"
                            >
                                <Icon
                                    name="lucide:trending-down"
                                    class="size-7 text-[#FF5500]"
                                />
                            </div>
                            <div class="flex-1">
                                <h3
                                    class="font-black text-white text-lg mb-2 uppercase tracking-wide"
                                >
                                    Ineficiência de Recursos
                                </h3>
                                <p
                                    class="text-sm text-slate-500 leading-relaxed"
                                >
                                    Investimentos sem otimização algorítmica
                                    desperdiçam capital. Sem IA, você paga caro
                                    por resultados medíocres.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
