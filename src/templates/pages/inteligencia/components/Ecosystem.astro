---
import Icon from "@components/Icon.astro";
---

<section id="servicos" class="py-32 bg-black overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
        <div
            class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8"
        >
            <div>
                <span
                    class="text-[#FF5500] font-black text-xs tracking-[0.3em] uppercase mb-6 block"
                    >// ECOSSISTEMA INTELIGENCE</span
                >
                <h2
                    class="text-5xl md:text-7xl font-black mb-6 text-white tracking-tighter leading-none"
                >
                    Não vendemos serviços.<br />Estruturamos inteligência.
                </h2>
                <p class="text-slate-400 text-lg max-w-xl">
                    Serviços isolados geram dados fragmentados. Inteligência
                    real exige sistema, integração e visão holística.
                </p>
            </div>
            <div class="text-right hidden md:block">
                <span
                    class="text-[10px] text-zinc-600 block mb-2 tracking-widest font-black uppercase font-mono"
                    >Build Version</span
                >
                <span
                    class="bg-[#FF5500]/10 text-[#FF5500] border border-[#FF5500]/30 px-4 py-2 rounded text-xs font-mono font-bold"
                    >INTELIGENCE_v2.0</span
                >
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
            <div
                class="md:col-span-4 bg-zinc-950 p-10 rounded-[2.5rem] border border-white/5 hover:border-[#FF5500]/40 transition-all duration-500 group"
            >
                <Icon name="lucide:search" class="size-8 text-[#FF5500] mb-8" />
                <h3
                    class="text-2xl font-black mb-4 text-white uppercase tracking-tighter"
                >
                    Consultoria de Dados
                </h3>
                <p class="text-sm text-slate-500 mb-10 leading-relaxed">
                    Diagnóstico de maturidade, governança de dados e roadmap de
                    implementação estratégica de IA.
                </p>
                <a
                    href="#"
                    class="text-xs font-black text-[#FF5500] flex items-center gap-2 group-hover:gap-4 transition-all uppercase tracking-widest"
                >
                    Solicitar Agendamento
                    <Icon name="lucide:arrow-right" class="size-4" />
                </a>
            </div>

            <div
                class="md:col-span-4 bg-zinc-950 p-10 rounded-[2.5rem] border border-white/5 hover:border-[#FF5500]/40 transition-all duration-500 group"
            >
                <Icon
                    name="lucide:database"
                    class="size-8 text-[#FF5500] mb-8"
                />
                <h3
                    class="text-2xl font-black mb-4 text-white uppercase tracking-tighter"
                >
                    Foundation API
                </h3>
                <p class="text-sm text-slate-500 mb-10 leading-relaxed">
                    Implementação de Data Lakes, CDP e infraestrutura robusta
                    para centralização da verdade única.
                </p>
                <a
                    href="#"
                    class="text-xs font-black text-[#FF5500] flex items-center gap-2 group-hover:gap-4 transition-all uppercase tracking-widest"
                >
                    Ver Foundation
                    <Icon name="lucide:arrow-right" class="size-4" />
                </a>
            </div>

            <div
                class="md:col-span-4 bg-zinc-950 p-10 rounded-[2.5rem] border border-white/5 hover:border-[#FF5500]/40 transition-all duration-500 group"
            >
                <Icon
                    name="lucide:shopping-bag"
                    class="size-8 text-[#FF5500] mb-8"
                />
                <h3
                    class="text-2xl font-black mb-4 text-white uppercase tracking-tighter"
                >
                    Retail Intelligence
                </h3>
                <p class="text-sm text-slate-500 mb-10 leading-relaxed">
                    Solução verticalizada para Varejo e E-commerce, integrando
                    estoque, vendas e predição.
                </p>
                <a
                    href="#"
                    class="text-xs font-black text-[#FF5500] flex items-center gap-2 group-hover:gap-4 transition-all uppercase tracking-widest"
                >
                    Solução Retail
                    <Icon name="lucide:arrow-right" class="size-4" />
                </a>
            </div>

            <div
                class="md:col-span-8 bg-gradient-to-br from-zinc-900 to-black p-12 md:p-16 rounded-[3rem] border border-white/10 text-white relative overflow-hidden group"
            >
                <!-- Background Effect -->
                <div
                    class="absolute top-0 right-0 w-full h-full bg-[#FF5500]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-1000"
                >
                </div>
                <div
                    class="absolute -right-20 -top-20 w-80 h-80 bg-[#FF5500]/20 rounded-full blur-[100px] pointer-events-none opacity-50 group-hover:opacity-100 transition-all duration-1000"
                >
                </div>

                <div class="relative z-10">
                    <span
                        class="bg-[#FF5500]/20 text-[#FF5500] px-4 py-1.5 rounded-full text-[10px] font-black tracking-[0.2em] uppercase mb-8 inline-block border border-[#FF5500]/30 shadow-2xl"
                        >CORE SYSTEM</span
                    >
                    <h3
                        class="text-4xl md:text-6xl font-black mb-6 tracking-tighter"
                    >
                        Inteligence Core
                    </h3>
                    <p
                        class="text-slate-400 text-lg max-w-lg mb-10 leading-relaxed font-light"
                    >
                        O cérebro da sua operação. Um sistema unificado que
                        ingere, processa e distribui inteligência preditiva para
                        todas as áreas da empresa.
                    </p>

                    <div
                        class="grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-12 mb-12"
                    >
                        <div class="flex items-center space-x-4">
                            <div
                                class="size-2 bg-[#FF5500] rounded-full shadow-[0_0_10px_#FF5500]"
                            >
                            </div>
                            <span
                                class="text-sm font-bold tracking-wide uppercase text-slate-200"
                                >Ingestão de Dados</span
                            >
                        </div>
                        <div class="flex items-center space-x-4">
                            <div
                                class="size-2 bg-[#FF5500] rounded-full shadow-[0_0_10px_#FF5500]"
                            >
                            </div>
                            <span
                                class="text-sm font-bold tracking-wide uppercase text-slate-200"
                                >Processamento em IA</span
                            >
                        </div>
                        <div class="flex items-center space-x-4">
                            <div
                                class="size-2 bg-[#FF5500] rounded-full shadow-[0_0_10px_#FF5500]"
                            >
                            </div>
                            <span
                                class="text-sm font-bold tracking-wide uppercase text-slate-200"
                                >Real-time Dashboards</span
                            >
                        </div>
                        <div class="flex items-center space-x-4">
                            <div
                                class="size-2 bg-[#FF5500] rounded-full shadow-[0_0_10px_#FF5500]"
                            >
                            </div>
                            <span
                                class="text-sm font-bold tracking-wide uppercase text-slate-200"
                                >Insights Autônomos</span
                            >
                        </div>
                    </div>

                    <a
                        href="#"
                        class="inline-block bg-white text-black px-10 py-5 rounded-md font-black text-sm uppercase tracking-widest hover:bg-[#FF5500] transition-all hover:-translate-y-1"
                    >
                        Conhecer o Core →
                    </a>
                </div>
            </div>

            <div
                class="md:col-span-4 bg-zinc-950 p-12 rounded-[3rem] border border-white/5 flex flex-col justify-between hover:border-[#FF5500]/40 transition-all duration-500 group"
            >
                <div class="space-y-8">
                    <Icon name="lucide:rocket" class="size-10 text-[#FF5500]" />
                    <h3
                        class="text-3xl font-black text-white uppercase tracking-tighter"
                    >
                        Inteligence Scale
                    </h3>
                    <p class="text-slate-500 leading-relaxed font-light">
                        Escala operações com IA aplicada. Automação de processos
                        cognitivos e tomada de decisão autônoma.
                    </p>
                </div>
                <a
                    href="#"
                    class="mt-12 text-xs font-black text-[#FF5500] flex items-center gap-2 group-hover:gap-4 transition-all uppercase tracking-widest"
                >
                    Conhecer Scale
                    <Icon name="lucide:arrow-right" class="size-4" />
                </a>
            </div>
        </div>
    </div>
</section>
