---

---

<section
    id="home"
    class="relative pt-32 pb-20 lg:pt-48 lg:pb-40 overflow-hidden bg-black"
>
    <!-- Grid Background -->
    <div
        class="absolute inset-0 z-0 opacity-20 pointer-events-none"
        style="background-image: radial-gradient(#FF5500 0.5px, transparent 0.5px); background-size: 30px 30px;"
    >
    </div>

    <!-- Hero Glow -->
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60rem] h-[60rem] bg-[#FF5500]/10 rounded-full blur-[120px] pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 text-center relative z-10">
        <div
            class="inline-flex items-center space-x-2 bg-white/5 border border-white/10 px-4 py-1.5 rounded-full mb-10 backdrop-blur-sm animate-fade-in"
        >
            <span class="w-1.5 h-1.5 bg-[#FF5500] rounded-full animate-pulse"
            ></span>
            <span
                class="text-[10px] font-bold tracking-[0.2em] uppercase text-slate-300"
                >Inteligência de Dados & Estratégia</span
            >
        </div>

        <h1
            class="text-[12vw] md:text-8xl lg:text-9xl font-black mb-10 leading-[1] tracking-tighter text-white animate-reveal-text"
        >
            INTELIGÊNCIA<br />
            DE DADOS<br />
            COM <span class="gradient-text italic">IA</span> PARA<br />
            DECISÕES<br />
            ESTRATÉGICAS
        </h1>

        <p
            class="max-w-2xl mx-auto text-slate-400 text-lg md:text-xl mb-12 leading-relaxed animate-fade-in-up"
            style="animation-delay: 0.2s"
        >
            Transformamos dados brutos em insights acionáveis e sistemas de
            inteligência para empresas que buscam liderança de mercado.
        </p>

        <div
            class="flex flex-col sm:flex-row items-center justify-center gap-6 animate-fade-in-up"
            style="animation-delay: 0.3s"
        >
            <a
                href="#consultoria"
                class="w-full sm:w-auto bg-[#FF5500] text-black font-black px-10 py-5 rounded-md transition-all hover:bg-[#ff661a] hover:shadow-[0_0_40px_rgba(255,85,0,0.4)] hover:-translate-y-1 uppercase tracking-wider text-sm"
            >
                Solicitar Diagnóstico
            </a>
            <a
                href="#servicos"
                class="w-full sm:w-auto border border-white/10 bg-white/5 backdrop-blur-sm text-white px-10 py-5 rounded-md font-black hover:bg-white/10 transition-all uppercase tracking-wider text-sm"
            >
                Ver Cases
            </a>
        </div>
    </div>
</section>

<style>
    .gradient-text {
        background: linear-gradient(to right, #ff5500, #ffbb00, #ff5500);
        background-size: 200% auto;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: gradient-flow 5s linear infinite;
    }

    @keyframes gradient-flow {
        0% {
            background-position: 0% 50%;
        }
        100% {
            background-position: 200% 50%;
        }
    }

    .animate-reveal-text {
        animation: revealDown 1s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes revealDown {
        0% {
            opacity: 0;
            transform: translateY(-40px);
            filter: blur(10px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fadeIn 1s ease-out forwards;
    }
    .animate-fade-in-up {
        animation: fadeInUp 1s ease-out forwards;
        opacity: 0;
    }
</style>
