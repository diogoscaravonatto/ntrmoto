---
const brand = { name: "aura", highlight: "wellness" };
const links = [{ label: "Experiência", href: "#experiencia" }];
---

<nav class="fixed top-0 w-full z-50 px-6 py-8">
    <div
        class="max-w-7xl mx-auto flex justify-between items-center text-[10px] font-bold uppercase tracking-[0.3em] text-[#8b735b]"
    >
        <a
            href={links[0].href}
            class="hover:text-[#4a3f35] transition-colors italic"
            >{links[0].label}</a
        >
        <div class="flex flex-col items-center">
            <span
                class="text-xl tracking-[0.1em] font-serif lowercase italic text-[#4a3f35]"
                >{brand.name}</span
            >
            <span
                class="mt-1 opacity-50 lowercase font-black text-[8px] tracking-[0.5em]"
                >{brand.highlight}</span
            >
        </div>
        <a
            href="#reserva"
            class="px-6 py-3 border border-[#d4bc9a] rounded-full hover:bg-[#d4bc9a] hover:text-white transition-all italic"
        >
            Reservar Agora
        </a>
    </div>
</nav>
