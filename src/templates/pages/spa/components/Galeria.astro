---
const gallery = {
    title: ["Arquitetura sensorial desenhada para o", "relaxamento."],
    description:
        "Nossos espaços foram concebidos sob os princípios da neuroarquitetura, com iluminação suave, aromas naturais e materiais orgânicos que acolhem seus sentidos desde o primeiro instante.",
    features: [
        "Águas Termais",
        "Ritual Botânico",
        "Meditação Guiada",
        "Aromaterapia",
    ],
};
---

<section id="experiencia" class="py-40 bg-white/30 backdrop-blur-sm">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-24 items-center mb-32">
            <div class="relative group">
                <div
                    class="aspect-4/5 rounded-[2.5rem] bg-zinc-100 p-1 bg-linear-to-br from-[#d4bc9a]/20 to-transparent overflow-hidden shadow-2xl skew-y-1"
                >
                    <div
                        class="w-full h-full bg-[#e2d5c3] flex items-center justify-center italic text-white text-2xl tracking-widest uppercase font-serif pointer-events-none group-hover:scale-110 transition-transform"
                    >
                        Ambiente Aura
                    </div>
                </div>
                <div
                    class="absolute -bottom-10 -right-10 w-64 aspect-square rounded-[2.5rem] overflow-hidden border-[12px] border-white shadow-xl rotate-3 hidden lg:block"
                >
                    <div
                        class="w-full h-full bg-[#f3e8e2] flex items-center justify-center text-[#d4bc9a] italic font-serif text-[10px] tracking-[0.4em] uppercase"
                    >
                        Detalhe
                    </div>
                </div>
            </div>
            <div class="space-y-10">
                <h2
                    class="text-4xl md:text-6xl font-serif text-[#4a3f35] leading-tight tracking-tight"
                >
                    {gallery.title[0]}
                    <span class="italic font-normal">{gallery.title[1]}</span>
                </h2>
                <p
                    class="text-lg text-[#7a6f65] font-light leading-relaxed italic"
                >
                    {gallery.description}
                </p>
                <div
                    class="grid grid-cols-2 gap-8 text-[11px] font-black uppercase tracking-widest text-[#d4bc9a] italic lowercase"
                >
                    {
                        gallery.features.map((f) => (
                            <div class="flex items-center gap-3">
                                <span class="size-1.5 rounded-full bg-[#d4bc9a]" />
                                {f}
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>
