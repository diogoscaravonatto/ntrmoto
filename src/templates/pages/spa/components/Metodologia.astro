---
const methodology = {
    eyebrow: "O Caminho Aura",
    title: ["Como sua jornada", "floresce."],
    description:
        "Cada visita é um ritual único. Não seguimos roteiros, ouvimos o que seu corpo pede no momento da chegada.",
    rituals: [
        {
            step: "I",
            title: "Acolhimento & Infusão",
            desc: "Iniciamos com uma cerimônia de chá orgânico e diagnóstico sensorial para personalizar seus aromas.",
        },
        {
            step: "II",
            title: "Imersão em Águas",
            desc: "Preparação do corpo em nossas termas privadas para abertura dos poros e relaxamento inicial.",
        },
        {
            step: "III",
            title: "A Terapia Integrativa",
            desc: "Aplicação da técnica escolhida, onde tempo e espaço deixam de existir.",
        },
        {
            step: "IV",
            title: "Despertar Gradual",
            desc: "Retorno suave em nossa sala de repouso com vista para o jardim zen e nutrição leve.",
        },
    ],
};
---

<section class="py-40 bg-[#faf7f5]">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-24 items-center">
            <div class="space-y-10">
                <span
                    class="text-[10px] font-bold uppercase tracking-[0.4em] text-[#d4bc9a] italic leading-none"
                    >{methodology.eyebrow}</span
                >
                <h2
                    class="text-5xl md:text-7xl font-serif text-[#4a3f35] tracking-tighter"
                >
                    {methodology.title[0]}
                    <br /><span class="italic font-normal"
                        >{methodology.title[1]}</span
                    >
                </h2>
                <p
                    class="text-lg text-[#7a6f65] font-light leading-relaxed italic"
                >
                    {methodology.description}
                </p>
                <div class="space-y-12">
                    {
                        methodology.rituals.map((ritual) => (
                            <div class="flex gap-8 group cursor-default">
                                <span class="text-2xl font-serif italic text-[#d4bc9a] opacity-50 group-hover:opacity-100 transition-opacity uppercase leading-none">
                                    {ritual.step}
                                </span>
                                <div>
                                    <h4 class="text-xl font-serif text-[#4a3f35] mb-2 tracking-tight group-hover:text-[#d4bc9a] transition-colors italic">
                                        {ritual.title}
                                    </h4>
                                    <p class="text-sm text-[#7a6f65] font-light leading-relaxed italic lowercase">
                                        {ritual.desc}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
            <div class="relative group">
                <div
                    class="aspect-3/4 rounded-[2rem] bg-zinc-100 overflow-hidden shadow-3xl"
                >
                    <div
                        class="size-full flex items-center justify-center text-white italic font-serif text-3xl p-12 text-center bg-[#e2d5c3] pointer-events-none group-hover:scale-105 transition-transform uppercase tracking-tighter"
                    >
                        A Arte do Repouso
                    </div>
                </div>
                <div
                    class="absolute -top-10 -right-10 size-40 bg-[#f3e8e2] rounded-full blur-3xl animate-pulse pointer-events-none opacity-30"
                >
                </div>
            </div>
        </div>
    </div>
</section>
