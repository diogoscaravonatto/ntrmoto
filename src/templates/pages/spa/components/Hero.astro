---
const hero = {
    badge: "Pausa • Respira • Reequilibra",
    title: ["O silêncio que sua", "alma", "precisa."],
    description:
        "Transmuta o caos do cotidiano em um estado profundo de paz. Um santuário privado dedicado à arte do bem-estar.",
    cta: "Explorar Tratamentos",
};
---

<section
    class="relative min-h-screen flex flex-col items-center justify-center pt-20 px-6 text-center"
>
    <div class="relative z-10 max-w-4xl mx-auto">
        <span
            class="inline-block mb-8 text-[11px] font-bold uppercase tracking-[0.4em] text-[#d4bc9a] animate-fade-in italic leading-none"
        >
            {hero.badge}
        </span>
        <h1
            class="text-6xl md:text-[7rem] font-serif leading-[0.9] text-[#4a3f35] mb-12 animate-slide-up tracking-tighter"
        >
            {hero.title[0]}
            <br /><span class="italic font-normal">{hero.title[1]}</span>
            {hero.title[2]}
        </h1>
        <p
            class="text-xl text-[#7a6f65] max-w-2xl mx-auto mb-16 font-light leading-relaxed animate-fade-in delay-300 italic lowercase"
        >
            {hero.description}
        </p>
        <div
            class="flex flex-col sm:flex-row items-center justify-center gap-10 animate-fade-in delay-500"
        >
            <a
                href="#menu"
                class="group flex items-center gap-4 text-sm font-black uppercase tracking-widest text-[#4a3f35] italic"
            >
                {hero.cta}
                <span
                    class="size-10 rounded-full border border-[#d4bc9a] flex items-center justify-center group-hover:bg-[#d4bc9a] group-hover:text-white transition-all text-xs"
                    >↓</span
                >
            </a>
        </div>
    </div>
</section>
