---
const footer = {
    brand: { name: "aura", highlight: "wellness" },
    social: {
        label: "Siga-nos",
        links: [
            { label: "Instagram", href: "#" },
            { label: "Pinterest", href: "#" },
        ],
    },
    location: {
        label: "Localização",
        address: "Al. das Gardênias, 840. Jardins, São Paulo.",
    },
    copy: "© 2026 Aura Wellness Santuário. Todos os ritos preservados.",
};
---

<footer class="py-20 border-t border-[#e2d5c3] bg-white/50 italic">
    <div
        class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-16 text-center md:text-left"
    >
        <div>
            <div class="flex flex-col mb-6">
                <span
                    class="text-xl tracking-[0.1em] font-serif lowercase italic text-[#4a3f35]"
                    >{footer.brand.name}</span
                >
                <span
                    class="text-[10px] uppercase font-black tracking-[0.3em] opacity-50 lowercase"
                    >{footer.brand.highlight}</span
                >
            </div>
        </div>
        <div class="space-y-4">
            <p
                class="text-[10px] font-black uppercase tracking-widest text-[#d4bc9a] italic lowercase leading-none"
            >
                {footer.social.label}
            </p>
            <div
                class="flex justify-center md:justify-start gap-6 text-xs text-[#7a6f65] italic lowercase"
            >
                {
                    footer.social.links.map((link) => (
                        <a
                            href={link.href}
                            class="hover:text-[#4a3f35] transition-colors"
                        >
                            {link.label}
                        </a>
                    ))
                }
            </div>
        </div>
        <div class="space-y-4">
            <p
                class="text-[10px] font-black uppercase tracking-widest text-[#d4bc9a] italic lowercase leading-none"
            >
                {footer.location.label}
            </p>
            <p
                class="text-sm font-light text-[#7a6f65] italic lowercase leading-relaxed"
            >
                {footer.location.address}
            </p>
        </div>
    </div>
    <div
        class="text-[9px] text-center mt-20 font-black uppercase tracking-[0.4em] opacity-30 italic lowercase leading-none"
    >
        {footer.copy}
    </div>
</footer>
