---
import Icon from "@components/Icon.astro";
---

<footer id="rodape" class="bg-black py-16 border-t border-white/5">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-24">
            <!-- Brand -->
            <div class="md:col-span-2">
                <span
                    class="text-3xl font-serif font-bold text-white tracking-tighter block mb-2"
                    >GENTLEMAN</span
                >
                <span
                    class="text-xs font-mono uppercase tracking-[0.3em] text-zinc-500 mb-8 block"
                    >Barber Club</span
                >
                <p class="text-zinc-400 max-w-sm leading-relaxed">
                    Onde a tradição encontra a modernidade. Um espaço dedicado
                    ao homem que valoriza a excelência em cada detalhe.
                </p>
            </div>

            <!-- Contact -->
            <div>
                <h4 class="text-white font-serif text-lg mb-6">Contato</h4>
                <ul class="space-y-4 text-zinc-400 text-sm font-mono">
                    <li class="flex items-center gap-3">
                        <Icon
                            name="lucide:phone"
                            class="size-4 text-amber-500"
                        />
                        (11) 99999-9999
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon
                            name="lucide:mail"
                            class="size-4 text-amber-500"
                        />
                        contato@gentleman.com.br
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon
                            name="lucide:instagram"
                            class="size-4 text-amber-500"
                        />
                        @gentleman.barber
                    </li>
                </ul>
            </div>

            <!-- Location -->
            <div>
                <h4 class="text-white font-serif text-lg mb-6">Localização</h4>
                <address
                    class="not-italic text-zinc-400 text-sm leading-relaxed"
                >
                    Av. Paulista, 1000 <br />
                    Bela Vista, São Paulo - SP <br />
                    <br />
                    <span class="text-amber-500">Seg - Sáb:</span> 09h às 20h
                </address>
            </div>
        </div>

        <div
            class="mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center text-zinc-600 text-xs font-mono uppercase tracking-wider"
        >
            <p>&copy; 2024 Gentleman Barber Club.</p>
            <p>Desenvolvido por Sniper Pages</p>
        </div>
    </div>
</footer>
