---
import { Image } from "astro:assets";
import barbeiro1 from "../../../../assets/images/templates/barbearia/barbeiro-1.png";
import barbeiro2 from "../../../../assets/images/templates/barbearia/barbeiro-2.png";
import barbeiro3 from "../../../../assets/images/templates/barbearia/barbeiro-3.png";

const team = [
  {
    name: 'Ricardo Silva',
    role: 'Master Barber & Fundador',
    image: barbeiro1,
    specialty: 'Cortes Clássicos',
  },
  {
    name: 'André "Navalha"',
    role: 'Senior Barber',
    image: barbeiro2,
    specialty: 'Barboterapia',
  },
  {
    name: 'Lucas Mendes',
    role: 'Stylist Barber',
    image: barbeiro3,
    specialty: 'Fade & Freestyle',
  },
]
---

<section id="equipe" class="py-24 bg-[#0a0a0a]">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="flex flex-col items-center mb-16 text-center">
        <span class="text-amber-500 font-mono text-xs uppercase tracking-[0.2em] mb-4">Os Mestres</span>
        <h2 class="text-4xl font-serif text-white">Nossa Equipe</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {team.map((member) => (
          <div class="group relative">
            <!-- Image Wrapper -->
            <div
              class="aspect-3/4 overflow-hidden grayscale group-hover:grayscale-0 transition-all duration-700 ease-out">
              <Image src={member.image} alt={member.name}
                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                widths={[300, 600]}
                sizes="(max-width: 768px) 100vw, 400px"
                format="webp"
              />
            </div>

            <!-- Info Overlay -->
            <div class="absolute inset-x-0 bottom-0 p-6 bg-linear-to-t from-black via-black/80 to-transparent pt-20">
              <h3 class="text-2xl font-serif text-white mb-1">{member.name}</h3>
              <p class="text-amber-500 font-mono text-xs uppercase tracking-wider mb-2">{member.role}</p>
              <p
                class="text-zinc-400 text-sm italic border-l border-amber-500 pl-3 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
                Esp: {member.specialty}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
</section>
