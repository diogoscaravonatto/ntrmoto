---
import Icon from "@components/Icon.astro";

const links = [
    { label: "O Ritual", to: "/templates/barbearia#servicos" },
    { label: "Hall of Fame", to: "/templates/barbearia#galeria" },
    { label: "Mestres", to: "/templates/barbearia#equipe" },
    { label: "Localização", to: "/templates/barbearia#rodape" },
];
---

<nav
    class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 bg-[#0a0a0a]/80 backdrop-blur-lg"
>
    <div class="max-w-7xl mx-auto px-6 md:px-12">
        <div class="flex items-center justify-between h-20">
            <!-- Logo -->
            <a href="/" class="group flex flex-col items-center">
                <span
                    class="text-2xl font-serif font-bold tracking-tighter text-white group-hover:text-amber-500 transition-colors"
                    >GENTLEMAN</span
                >
                <span
                    class="text-[0.6rem] uppercase tracking-[0.3em] text-zinc-500 group-hover:text-zinc-400 transition-colors"
                    >Barber Club</span
                >
            </a>

            <!-- Desktop Links -->
            <div class="hidden md:flex items-center gap-8">
                {
                    links.map((link) => (
                        <a
                            href={link.to}
                            class="text-xs font-mono uppercase tracking-widest text-zinc-400 hover:text-white transition-colors"
                        >
                            {link.label}
                        </a>
                    ))
                }
            </div>

            <!-- CTA & Mobile Menu -->
            <div class="flex items-center gap-4">
                <a
                    href="#agendamento"
                    class="hidden md:flex bg-amber-600/10 text-amber-500 border border-amber-500/20 rounded-none px-6 py-2.5 font-mono uppercase tracking-wider text-xs font-bold hover:bg-amber-600 hover:text-white transition-all duration-300"
                >
                    Agendar Horário
                </a>

                <button
                    id="mobile-menu-toggle"
                    class="md:hidden p-2 text-zinc-400 hover:text-white transition-colors"
                    aria-label="Menu"
                >
                    <Icon name="lucide:menu" class="size-6" />
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Menu (Client Side) -->
    <div
        id="mobile-menu"
        class="fixed inset-0 z-50 bg-[#0a0a0a] translate-x-full transition-transform duration-300 md:hidden"
    >
        <div class="flex flex-col h-full p-8 border-l border-white/10">
            <div class="flex justify-end mb-8">
                <button
                    id="mobile-menu-close"
                    class="p-2 text-zinc-400 hover:text-white transition-colors"
                >
                    <Icon name="lucide:x" class="size-6" />
                </button>
            </div>

            <div class="flex flex-col gap-6">
                {
                    links.map((link) => (
                        <a
                            href={link.to}
                            class="text-xl font-serif text-zinc-300 hover:text-amber-500 transition-colors mobile-link"
                        >
                            {link.label}
                        </a>
                    ))
                }

                <div class="h-px bg-white/10 my-4"></div>

                <a
                    href="/templates/barbearia#agendamento"
                    class="bg-amber-600 text-white py-4 text-center rounded-none font-mono uppercase font-bold mobile-link"
                >
                    Agendar Agora
                </a>
            </div>
        </div>
    </div>
</nav>

<script>
    const toggle = document.getElementById("mobile-menu-toggle");
    const close = document.getElementById("mobile-menu-close");
    const menu = document.getElementById("mobile-menu");
    const links = document.querySelectorAll(".mobile-link");

    toggle?.addEventListener("click", () => {
        menu?.classList.remove("translate-x-full");
    });

    close?.addEventListener("click", () => {
        menu?.classList.add("translate-x-full");
    });

    links.forEach((link) => {
        link.addEventListener("click", () => {
            menu?.classList.add("translate-x-full");
        });
    });
</script>
