---
const services = [
    {
        title: "Corte Signature",
        description:
            "Consulta de visagismo, corte preciso, lavagem relaxante e finalização.",
        price: "R$ 80",
    },
    {
        title: "Barboterapia Real",
        description:
            "Toalha quente, óleos essenciais, massagem facial e navalha afiada.",
        price: "R$ 65",
    },
    {
        title: "O Ritual Completo",
        description:
            "A experiência definitiva. Corte, Barba, Massagem Capilar e Drink cortesia.",
        price: "R$ 130",
    },
    {
        title: "Camuflagem Grisalha",
        description:
            "Pigmentação sutil para reduzir os brancos com naturalidade.",
        price: "R$ 90",
    },
    {
        title: "Acabamento & Pezinho",
        description: "Manutenção rápida dos contornos entre cortes.",
        price: "R$ 35",
    },
];
---

<section id="servicos" class="py-24 bg-[#0a0a0a] relative">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
        <div class="flex flex-col md:flex-row gap-16">
            <!-- Section Header -->
            <div class="md:w-1/3 md:sticky md:top-32 h-fit">
                <span
                    class="text-amber-500 font-mono text-xs uppercase tracking-[0.2em] mb-4 block"
                    >Nossa Expertise</span
                >
                <h2 class="text-5xl font-serif text-white mb-6">
                    Menu de Serviços
                </h2>
                <p class="text-zinc-400 leading-relaxed mb-8">
                    Combinamos técnicas clássicas com tendências modernas para
                    criar um visual que é autenticamente seu.
                </p>
                <div class="hidden md:block w-20 h-px bg-white/20"></div>
            </div>

            <!-- Service List -->
            <div class="md:w-2/3 flex flex-col gap-12">
                {
                    services.map((service) => (
                        <div class="group">
                            <div class="flex items-end justify-between mb-2">
                                <h3 class="text-2xl font-serif text-white group-hover:text-amber-500 transition-colors">
                                    {service.title}
                                </h3>
                                <div class="grow mx-4 border-b border-dashed border-zinc-700 mb-2 opacity-50" />
                                <span class="text-xl font-mono text-white font-bold">
                                    {service.price}
                                </span>
                            </div>
                            <p class="text-zinc-500 text-sm max-w-md">
                                {service.description}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
