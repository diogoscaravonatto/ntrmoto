---
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";
import heroImg from "../../../../assets/images/templates/barbearia/hero.png";
---

<section
    class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20"
>
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
        <Image
            src={heroImg}
            alt="Barbershop Interior"
            class="w-full h-full object-cover opacity-30 grayscale"
        />
        <div
            class="absolute inset-0 bg-linear-to-t from-[#0a0a0a] via-[#0a0a0a]/80 to-[#0a0a0a]/40"
        >
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10 w-full">
        <div class="grid md:grid-cols-12 gap-12 items-center">
            <!-- Text Content -->
            <div class="md:col-span-8 flex flex-col gap-8">
                <div class="flex items-center gap-4 animate-fade-in-up">
                    <div class="w-12 h-px bg-amber-500"></div>
                    <span
                        class="text-amber-500 font-mono text-sm uppercase tracking-[0.2em]"
                        >Desde 2014</span
                    >
                </div>

                <h1
                    class="text-[12vw] md:text-8xl lg:text-9xl font-serif text-white leading-[0.9] tracking-tight"
                >
                    Estilo <br />
                    <span class="italic text-zinc-600">Lendário</span>
                </h1>

                <p
                    class="text-xl md:text-2xl text-zinc-400 max-w-xl font-light leading-relaxed border-l-2 border-white/10 pl-6 ml-2"
                >
                    Não é apenas sobre cortar cabelo. É sobre resgatar a
                    confiança e a elegância do homem moderno.
                </p>

                <div class="flex flex-col md:flex-row gap-6 mt-8">
                    <a
                        href="#agendamento"
                        class="inline-block bg-white text-black py-5 px-10 font-mono uppercase tracking-wider font-bold hover:bg-amber-500 hover:text-black transition-all duration-300 text-center text-lg"
                    >
                        Marcar Horário
                    </a>

                    <div class="flex items-center gap-4 text-zinc-500">
                        <Icon
                            name="lucide:star"
                            class="text-amber-500 size-5"
                        />
                        <span class="font-mono text-sm uppercase tracking-wider"
                            >Avaliado 4.9/5 por 2k+ clientes</span
                        >
                    </div>
                </div>
            </div>

            <!-- Floating Badge/Element -->
            <div class="hidden md:flex md:col-span-4 justify-end">
                <div
                    class="relative w-48 h-48 rounded-full border border-white/10 flex items-center justify-center animate-spin-slow"
                >
                    <svg
                        class="absolute inset-0 w-full h-full text-zinc-700"
                        viewBox="0 0 100 100"
                    >
                        <path
                            id="curve"
                            d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0"
                            fill="transparent"></path>
                        <text
                            class="text-[0.6rem] font-mono uppercase tracking-[0.25em]"
                            fill="currentColor"
                        >
                            <textPath href="#curve">
                                Tradição • Excelência • Estilo •
                            </textPath>
                        </text>
                    </svg>
                    <Icon
                        name="lucide:scissors"
                        class="size-12 text-amber-500"
                    />
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .animate-spin-slow {
        animation: spin 20s linear infinite;
    }

    @keyframes spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }

    .animate-fade-in-up {
        animation: fadeInUp 1s ease-out;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
