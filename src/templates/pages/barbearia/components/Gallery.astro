---
import { Image } from "astro:assets";
import corte1 from "../../../../assets/images/templates/barbearia/corte-1.png";
import corte2 from "../../../../assets/images/templates/barbearia/corte-2.png";
import ambiente from "../../../../assets/images/templates/barbearia/ambiente.png";
import heroImg from "../../../../assets/images/templates/barbearia/hero.png";

const images = [corte1, corte2, ambiente, heroImg];
---

<section id="galeria" class="py-24 bg-zinc-900 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-serif text-white mb-4">
                Hall of Fame
            </h2>
            <p class="text-zinc-400 font-mono text-sm tracking-wider uppercase">
                cortes que definem personalidades
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:h-[600px]">
            <!-- Large Item -->
            <div
                class="md:col-span-2 md:row-span-2 relative group overflow-hidden bg-black aspect-square md:aspect-auto"
            >
                <Image
                    src={images[0]}
                    alt="Corte Classic Fade"
                    class="w-full h-full object-cover opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 100vw, 800px"
                    format="webp"
                />
                <div
                    class="absolute bottom-0 left-0 p-8 translate-y-full group-hover:translate-y-0 transition-transform duration-500 bg-linear-to-t from-black/80 to-transparent w-full"
                >
                    <span class="text-white font-serif text-2xl italic"
                        >Classic Fade</span
                    >
                </div>
            </div>

            <!-- Small Items -->
            <div
                class="relative group overflow-hidden bg-black aspect-square md:aspect-auto"
            >
                <Image
                    src={images[1]}
                    alt="Corte detalhe"
                    class="w-full h-full object-cover opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
                    widths={[300, 600]}
                    sizes="(max-width: 768px) 100vw, 400px"
                    format="webp"
                />
            </div>
            <div
                class="relative group overflow-hidden bg-black aspect-square md:aspect-auto"
            >
                <Image
                    src={images[2]}
                    alt="Barba detalhe"
                    class="w-full h-full object-cover opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
                    widths={[300, 600]}
                    sizes="(max-width: 768px) 100vw, 400px"
                    format="webp"
                />
            </div>

            <!-- Wide Bottom Item -->
            <div
                class="md:col-span-2 relative group overflow-hidden bg-black aspect-video md:aspect-auto"
            >
                <Image
                    src={images[3]}
                    alt="Ambiente Executivo"
                    class="w-full h-full object-cover opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 100vw, 800px"
                    format="webp"
                />
                <div
                    class="absolute bottom-0 left-0 p-6 translate-y-full group-hover:translate-y-0 transition-transform duration-500 bg-linear-to-t from-black/80 to-transparent w-full"
                >
                    <span class="text-white font-serif text-xl italic"
                        >Ambiente Executivo</span
                    >
                </div>
            </div>
        </div>
    </div>
</section>
