{
  "name": "ntr-escola-de-motores",
  "version": "0.1.0",
  "description": "Páginas oficiais da NTR Escola de Motores com Astro 7, Tailwind v4 e Cloudflare Workers Static Assets (cf CLI).",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "pnpm run clean && astro dev",
    "build": "astro build",
    "build:timings": "astro build --timings",
    "preview": "astro preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware && eslint .",
    "lint:fix": "oxlint --type-aware --fix && eslint . --fix",
    "check": "astro check",
    "test": "vitest run",
    "test:calculadoras": "node scripts/test-calculadoras.mjs",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run test && pnpm run build",
    "clean": "rm -rf node_modules/.vite dist .astro",
    "deploy": "pnpm run build && pnpm exec cf deploy ./dist",
    "deploy:dry-run": "pnpm run build && pnpm exec cf deploy ./dist --dry-run",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.2.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.3",
    "@types/node": "^24.13.2",
    "@typescript-eslint/parser": "^8.74.0",
    "astro-eslint-parser": "^3.2.0",
    "cf": "^1.0.0-rc.5",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.3.4"
}
