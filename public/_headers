# Cache de Assets Estáticos - 1 ano
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens - 1 ano
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.avif
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Fontes - 1 ano
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# JavaScript e CSS - 1 ano
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Assets legados importados do SwipePages - 1 ano (desanexa para evitar duplicidade com extensões)
/legacy-sp/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# HTML - 1 hora (para permitir atualizações rápidas)
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Página inicial - 1 hora
/
  Cache-Control: public, max-age=3600, must-revalidate

# Security Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: upgrade-insecure-requests;
  Accept-CH: Sec-CH-UA, Sec-CH-UA-Mobile, Sec-CH-UA-Platform, Sec-CH-UA-Platform-Version, Sec-CH-UA-Model, Sec-CH-UA-Full-Version-List

# Embeds da Calculadora e futuras páginas incorporadas (/embed*) na Área de Membros (Cademi)
/embed*
  ! X-Frame-Options
  ! Content-Security-Policy
  ! X-Robots-Tag
  Content-Security-Policy: upgrade-insecure-requests; frame-ancestors 'self' https://alunos.escolademotores.com.br https://core.cademi.com.br https://*.cademi.com.br;
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

